{
  "name": "slidev-theme-faris",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=53.0.0 <54"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1280,
      "colorSchema": "auto",
      "fonts": {
        "provider": "none"
      }
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "peerDependencies": {
    "@slidev/client": "^53.0.0",
    "@slidev/types": "^53.0.0",
    "vue": "^3.5.0"
  }
}
