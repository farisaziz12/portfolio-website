{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/slides/contracts.ts",
    "packages/**/*.ts",
    "packages/**/*.vue",
    "decks/**/*.ts",
    "decks/**/*.vue"
  ]
}
