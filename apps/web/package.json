{
  "name": "web",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && node scripts/ui-guardrails.mjs && node scripts/conventions.mjs --self-test && node scripts/conventions.mjs && tsx scripts/voice.ts",
    "typecheck": "astro check",
    "test": "tsx --test $(find src -name '*.test.ts' | sort)",
    "lint:ui": "node scripts/ui-guardrails.mjs",
    "lint:conventions": "node scripts/conventions.mjs --self-test && node scripts/conventions.mjs",
    "lint:voice": "tsx scripts/voice.ts",
    "voice:cms": "tsx scripts/voice.ts --cms"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.12",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@portabletext/types": "^4.0.2",
    "@react-email/components": "^1.0.12",
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/client": "^6.29.1",
    "@sanity/image-url": "^1.2.0",
    "astro": "^7.3.6",
    "astro-portabletext": "^0.12.0",
    "autoprefixer": "^10.6.1",
    "country-flag-emoji": "^1.0.3",
    "groq": "^3.99.0",
    "groq-js": "^2.0.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "satori": "^0.26.0",
    "satori-html": "^0.3.2",
    "shared": "workspace:*",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
