---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEO from '../components/shared/SEO.astro';
import PostHog from '../components/posthog.astro';
import { sanityFetch, urlFor } from '../lib/sanity/client';
import { siteSettingsQuery } from '../lib/sanity/queries';
import '../styles/global.css';

// Self-hosted fonts (was a render-blocking Google Fonts CSS request).
// Astro bundles these with hashed URLs and far-future caching; woff2 subsets
// load per-unicode-range with font-display: swap.
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';

interface SiteSettings {
  siteTitle?: string;
  tagline?: string;
  siteUrl?: string;
  metaTitle?: string;
  metaDescription?: string;
  defaultMetaDescription?: string;
  keywords?: string[];
  ogImage?: any;
  twitterHandle?: string;
  linkedinUrl?: string;
  githubUrl?: string;
  youtubeUrl?: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  /** Marks this page as the entity home (/about) — renders ProfilePage schema. */
  profilePage?: boolean;
  pathname?: string;
  publishedTime?: string;
  /** Extra schema.org nodes for the page (Event, Service, BreadcrumbList…). */
  extraSchema?: Record<string, unknown>[];
  /** Path to this page's markdown mirror (e.g. "/talks.md"). */
  markdownAlternate?: string;
}

// Fetch global site settings from Sanity
const siteSettings = await sanityFetch<SiteSettings | null>(siteSettingsQuery).catch(() => null);

// Fallback defaults if Sanity settings aren't configured
const defaultDescription = siteSettings?.metaDescription || siteSettings?.defaultMetaDescription || 'Staff Software Engineer and Conference Speaker specializing in React, Next.js, and payment systems. Based in Geneva.';
const defaultImage = siteSettings?.ogImage
  ? urlFor(siteSettings.ogImage).width(1200).height(630).url()
  : '/og/default.png';
const personImage = siteSettings?.ogImage
  ? urlFor(siteSettings.ogImage).width(800).height(800).url()
  : undefined;
const siteName = siteSettings?.siteTitle || 'Faris Aziz';
const siteUrl = siteSettings?.siteUrl?.trim() || 'https://faziz-dev.com';
const twitterHandle = siteSettings?.twitterHandle || 'farisaziz12';
const personName = siteSettings?.siteTitle || 'Faris Aziz';
const jobTitle = siteSettings?.tagline || 'Staff Software Engineer';

const {
  title,
  description = defaultDescription,
  image = defaultImage,
  imageAlt,
  article = false,
  profilePage = false,
  pathname = '',
  publishedTime,
  extraSchema = [],
  markdownAlternate,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />


    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      article={article}
      profilePage={profilePage}
      pathname={pathname}
      publishedTime={publishedTime}
      siteName={siteName}
      siteUrl={siteUrl}
      twitterHandle={twitterHandle}
      personName={personName}
      jobTitle={jobTitle}
      personImage={personImage}
      extraSchema={extraSchema}
      markdownAlternate={markdownAlternate}
      socialLinks={{
        linkedin: siteSettings?.linkedinUrl,
        github: siteSettings?.githubUrl,
        youtube: siteSettings?.youtubeUrl,
        twitterUrl: siteSettings?.twitterHandle ? `https://twitter.com/${siteSettings.twitterHandle}` : undefined,
      }}
    />

    <ViewTransitions />

    <!-- Analytics -->
    <PostHog />

    <!-- Theme: dark by default; a stored preference wins. Sets both `.dark` (Tailwind) and `data-theme` (DS v2).
         Re-applied on astro:after-swap because ViewTransitions replaces <html> attributes with the
         server-rendered ones (no class/data-theme), which would otherwise strip the applied theme on
         every client-side navigation. -->
    <script is:inline>
      (function() {
        function applyTheme() {
          var root = document.documentElement;
          root.classList.add('js');
          var stored = null;
          try { stored = localStorage.getItem('theme') || localStorage.getItem('faziz-theme'); } catch(_) {}
          var theme = stored === 'light' ? 'light' : 'dark';
          root.classList.toggle('dark', theme === 'dark');
          root.setAttribute('data-theme', theme);
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <!-- DevTools console banner — for the people who open the console (my kind of people) -->
    <script is:inline>
      (function () {
        try {
          console.log(
            '%c$ whoami%c\nFaris Aziz — Staff Software Engineer & Conference Speaker, Geneva.\n\n' +
              '%cYou opened the console. My kind of person.%c\n' +
              'Open to: tech lead · staff/senior frontend · full-stack (frontend-leaning) · payments · product engineering · founding engineer.\n\n' +
              'Say hi:   https://faziz-dev.com/contact#message (short form, straight to my inbox)\n' +
              'Doors:    https://faziz-dev.com/contact\n' +
              'Agents:   https://faziz-dev.com/llms.txt\n' +
              "P.S. the terminal on the homepage actually works — try 'hire'.",
            'color:#1FCFA6;font-family:monospace;font-weight:bold;font-size:13px;',
            'font-family:monospace;',
            'color:#6AA1FF;font-weight:bold;',
            ''
          );
        } catch (_) {}
      })();
    </script>

    <!-- Cal.com modal embed: any link to cal.com opens as an on-site modal
         instead of navigating away (the commitment moment stays on-site).
         Loader is injected lazily on first hover/click; if the embed script
         can't load, the click falls through to normal navigation. -->
    <script is:inline>
      (function () {
        var injected = false;
        function ensureCal() {
          if (injected) return;
          injected = true;
          /* Official Cal.com embed bootstrap (queues calls until embed.js loads) */
          (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
          window.Cal("init", { origin: "https://cal.com" });
          window.Cal("ui", {
            theme: document.documentElement.classList.contains("dark") ? "dark" : "light",
            hideEventTypeDetails: false,
            layout: "month_view",
          });
        }
        function calAnchor(target) {
          return target && target.closest ? target.closest('a[href^="https://cal.com/"]') : null;
        }
        // Warm the embed as soon as a cal link is hovered/touched.
        document.addEventListener("pointerover", function (e) {
          if (calAnchor(e.target)) ensureCal();
        }, { passive: true });
        document.addEventListener("click", function (e) {
          var a = calAnchor(e.target);
          if (!a) return;
          ensureCal();
          if (typeof window.Cal !== "function") return; // very defensive: navigate normally
          e.preventDefault();
          var calLink = new URL(a.href).pathname.replace(/^\//, "");
          window.Cal("modal", { calLink: calLink });
          try { window.posthog && window.posthog.capture("discovery_call_opened", { path: location.pathname }); } catch (_) {}
          // If the embed never materializes (blocked script, offline), fall back to the real page.
          setTimeout(function () {
            if (!document.querySelector("cal-modal-box")) window.open(a.href, "_blank", "noopener");
          }, 2500);
        });
      })();
    </script>

    <!-- Funnel analytics: any element with data-track fires a cta_click event.
         One document-level listener — survives ViewTransitions swaps. -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
        if (!el || !window.posthog) return;
        window.posthog.capture('cta_click', {
          cta: el.getAttribute('data-track'),
          label: el.getAttribute('data-track-label') || (el.textContent || '').trim().slice(0, 60),
          href: el.getAttribute('href') || undefined,
          path: location.pathname,
        });
      });
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <!-- Skip to content link -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded-md focus:text-body-sm focus:font-medium"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
