---
/**
 * Talk detail (V3 `Talk.dc.html`). Every talk slug gets a page, including
 * retired versions (they render a note and no booking CTA). Delivery history
 * lists SESSIONS of the talk family, each linking to its event page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PraiseCard from '../../components/v3/PraiseCard.astro';
import TalkHero from '../../components/talks/TalkHero.astro';
import DeliveryList from '../../components/talks/DeliveryList.astro';
import TalkAside from '../../components/talks/TalkAside.astro';
import TalkVersions from '../../components/talks/TalkVersions.astro';
import { getCatalogueTalks, getPraiseFor, getProfile, getTalks, getWriting, type TalkWithHistory } from '../../lib/sanity/v3';
import { breadcrumbs, talkSchema } from '../../lib/seo';
import { currentVersionOf, eventShortName, talkStatus } from '../../lib/talks';

export async function getStaticPaths() {
  const talks = await getTalks();
  return talks.map((talk) => ({ params: { slug: talk.slug }, props: { talk } }));
}

interface Props {
  talk: TalkWithHistory;
}
const { talk } = Astro.props;

const [all, catalogue, praise, writing, profile] = await Promise.all([
  getTalks(),
  getCatalogueTalks(),
  getPraiseFor({ talkId: talk._id }),
  getWriting(),
  getProfile(),
]);

const status = talkStatus(talk);
const retired = status !== 'current';
// The version that replaced this one, if this is an earlier version.
const current = currentVersionOf(talk, all);
const podcasts = writing.filter((w) => w.format === 'podcast' && w.relatedTalk?._id === talk._id).slice(0, 2);
const related = talk.relatedTalks
  .map((r) => catalogue.find((c) => c._id === r._id))
  .filter((r): r is TalkWithHistory => Boolean(r));
const premise = talk.abstract || talk.summary;
const quotes = praise.slice(0, 2);

const description = (talk.seo?.metaDescription || talk.summary || `A talk by Faris Aziz${talk.duration ? `, ${talk.duration} min` : ''}.`).slice(0, 160);
---

<BaseLayout
  title={talk.seo?.metaTitle || talk.title}
  description={description}
  image={`/og/talks/${talk.slug}.png`}
  content={{ type: 'talk', slug: talk.slug, title: talk.title, pillar: talk.pillar, status, versions: talk.versions.length, has_recording: Boolean(talk.recording) }}
  markdownAlternate={`/talks/${talk.slug}.md`}
  band={false}
  extraSchema={[
    talkSchema(talk),
    breadcrumbs([
      { name: 'Speaking', path: '/speaking' },
      { name: 'Talks', path: '/talks' },
      { name: talk.title, path: `/talks/${talk.slug}` },
    ]),
  ]}
>
  <div class="ds-wrap tpage">
    <TalkHero talk={talk} retired={retired} retiredLabel={status === 'earlier' ? 'Earlier version' : 'Retired'} />

    <div class="tpage__grid">
      <div class="tpage__main">
        {status === 'earlier' && (
          <div class="ds-stripe tpage__retired" role="note">
            <p class="tpage__retired-title">An earlier version of this talk{talk.version ? ` (${talk.version})` : ''}.</p>
            <p class="tpage__retired-body">
              {talk.versionNotes && <>{talk.versionNotes} </>}
              {current?.isBookable ? (
                <>The talk has moved on: book <a href={`/talks/${current.slug}`} class="ds-textlink">{current.title}</a>.</>
              ) : (
                <>See the <a href="/talks" class="ds-textlink">current talks</a>.</>
              )}
            </p>
          </div>
        )}
        {status === 'retired' && (
          <div class="ds-stripe tpage__retired" role="note">
            <p class="tpage__retired-title">I don't give this one any more.</p>
            <p class="tpage__retired-body">
              {talk.versionNotes || 'It stays here for the record and the recording.'} See the <a href="/talks" class="ds-textlink">current talks</a>.
            </p>
          </div>
        )}

        {premise && (
          <section class="tpage__block" aria-labelledby="premise-title">
            <h2 id="premise-title" class="tpage__h2">The premise</h2>
            <p class="tpage__premise">{premise}</p>
          </section>
        )}

        {(talk.audience || talk.takeaways.length > 0) && (
          <div class="tpage__two">
            {talk.audience && (
              <section class="tpage__col" aria-labelledby="aud-title">
                <h3 id="aud-title" class="ds-label">Who it's for</h3>
                <p class="tpage__text">{talk.audience}</p>
              </section>
            )}
            {talk.takeaways.length > 0 && (
              <section class="tpage__col" aria-labelledby="take-title">
                <h3 id="take-title" class="ds-label">You leave with</h3>
                <ul class="tpage__list">
                  {talk.takeaways.map((k) => <li>{k}</li>)}
                </ul>
              </section>
            )}
          </div>
        )}

        <TalkVersions talk={talk} />

        <DeliveryList deliveries={talk.deliveries} retired={retired} />

        {quotes.map((p) => (
          <PraiseCard praise={p} variant="stripe" full context={p.event ? `about this talk at ${eventShortName(p.event)}` : 'about this talk'} />
        ))}
      </div>

      <TalkAside talk={talk} retired={retired} setupFallback={profile.rider[0]?.body} podcasts={podcasts} related={related} />
    </div>
  </div>
</BaseLayout>

<style>
  .tpage { padding-top: 0; padding-bottom: 64px; }
  .tpage__grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 56px; padding-top: 48px; align-items: start; }
  .tpage__main { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .tpage__block { display: flex; flex-direction: column; gap: 12px; }
  .tpage__h2 { font-size: 26px; font-weight: 800; letter-spacing: -0.035em; line-height: 1.05; }
  .tpage__premise { margin: 0; font-size: 17px; line-height: 1.65; color: rgb(var(--text-muted)); max-width: 65ch; }
  .tpage__two { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .tpage__col { display: flex; flex-direction: column; gap: 10px; }
  .tpage__text { margin: 0; font-size: 15px; line-height: 1.55; color: rgb(var(--text-muted)); }
  .tpage__list { margin: 0; padding-left: 18px; list-style: disc; font-size: 15px; line-height: 1.6; color: rgb(var(--text-muted)); }
  .tpage__retired { display: flex; flex-direction: column; gap: 6px; }
  .tpage__retired-title { margin: 0; font-weight: 800; font-size: 17px; }
  .tpage__retired-body { margin: 0; font-size: 15px; line-height: 1.55; color: rgb(var(--text-muted)); }
  @media (max-width: 960px) {
    .tpage__grid { grid-template-columns: 1fr; gap: 40px; padding-top: 32px; }
  }
  @media (max-width: 720px) {
    .tpage__two { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
