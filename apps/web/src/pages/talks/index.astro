---
/**
 * Talk catalogue: the flagship talk as a yellow poster (Home's 01 pick, else
 * the most given), then every other bookable talk grouped by topic. Each row
 * lists where the talk has been given, by year. `?topic=payments` (linked
 * from /speaking) jumps to that topic's section.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TalkFlagship from '../../components/talks/TalkFlagship.astro';
import TalkRow from '../../components/talks/TalkRow.astro';
import { byPopularity } from '../../lib/talks';
import { TOPICS } from 'shared';
import { getCatalogueTalks, getHomeFeatured, getProfile, type FeaturedItem, type TalkWithHistory } from '../../lib/sanity/v3';
import { breadcrumbs, itemList } from '../../lib/seo';

const [catalogue, featured, profile] = await Promise.all([getCatalogueTalks(), getHomeFeatured(), getProfile()]);
const talks = [...catalogue].sort(byPopularity);

const picked = featured.find((f): f is Extract<FeaturedItem, { kind: 'talk' }> => f.kind === 'talk');
const flagship = (picked && talks.find((t) => t.familyId === picked.talk.familyId)) ?? talks[0];
const rest = talks.filter((t) => t._id !== flagship?._id);

const sections: { id: string; title: string; talks: TalkWithHistory[] }[] = TOPICS.map((tp) => ({
  id: `topic-${tp.value}`,
  title: tp.title,
  talks: rest.filter((t) => t.pillar === tp.value),
})).filter((s) => s.talks.length > 0);
const unfiled = rest.filter((t) => !TOPICS.some((tp) => tp.value === t.pillar));
if (unfiled.length) sections.push({ id: 'topic-other', title: 'More talks', talks: unfiled });

const description = `${talks.length} conference talks on production engineering, payments at scale, careers and community. Premise, audience, length and recordings.`;
---

<BaseLayout
  title="Talks"
  description={description}
  image="/og/talks.png"
  markdownAlternate="/talks.md"
  extraSchema={[
    breadcrumbs([
      { name: 'Speaking', path: '/speaking' },
      { name: 'Talks', path: '/talks' },
    ]),
    itemList('Talk catalogue', talks.map((t) => `/talks/${t.slug}`)),
  ]}
>
  <header class="ds-wrap thead">
    <div class="thead__main">
      <p class="ds-kicker"><a href="/speaking" class="is-muted thead__crumb">Speaking</a><span aria-hidden="true"> · </span>Talk catalogue</p>
      <h1 class="ds-h1 thead__h1">My talks</h1>
      <p class="ds-lede thead__lede">
        Every talk is designed as what I call an accordion talk: it expands in time, breadth and depth based on what your
        audience needs. Let me know how to fit it best, and treat each one as dynamic.
      </p>
    </div>
    {sections.length > 1 && (
      <nav class="thead__jump" aria-label="Talk topics">
        {sections.map((s) => <a href={`#${s.id}`} class="thead__jumplink">{s.title}</a>)}
      </nav>
    )}
  </header>

  <div class="ds-wrap tbody">
    {flagship ? (
      <TalkFlagship talk={flagship} />
    ) : (
      <p class="tempty">The catalogue is being updated. <a href="/invite" class="ds-textlink">Tell me about your event</a> and I'll suggest a talk.</p>
    )}

    {sections.map((s) => (
      <section id={s.id} class="tsec" aria-labelledby={`${s.id}-h`}>
        <h2 id={`${s.id}-h`} class="tsec__title">{s.title}</h2>
        <ul class="tlist">
          {s.talks.map((t) => <li><TalkRow talk={t} /></li>)}
        </ul>
      </section>
    ))}

    <aside class="ds-card tcustom" aria-labelledby="tcustom-title">
      <div>
        <h2 id="tcustom-title" class="tcustom__title">Need something built for your theme?</h2>
        <p class="tcustom__body">Tell me what you'd like your audience to leave with. I'll propose a talk within {profile.replyTime}.</p>
      </div>
      <a href="/invite" class="ds-btn ds-btn--yellow" data-track="talks-custom">Get in touch</a>
    </aside>
  </div>
</BaseLayout>

<script>
  // Old filter links (/talks?topic=payments, from /speaking) jump to that topic's section.
  function jumpToTopic() {
    const topic = new URL(location.href).searchParams.get('topic');
    if (topic) document.getElementById(`topic-${topic}`)?.scrollIntoView();
  }
  jumpToTopic();
  document.addEventListener('astro:page-load', jumpToTopic);
</script>

<style>
  .thead { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 40px; padding-top: 48px; padding-bottom: 32px; }
  .thead__main { display: flex; flex-direction: column; gap: 14px; max-width: 640px; min-width: 0; }
  .thead__crumb { color: rgb(var(--text-muted)); text-decoration: none; }
  .thead__crumb:hover { color: rgb(var(--text)); }
  .thead__h1 { font-size: clamp(38px, 5.8vw, 52px); }
  .thead__lede { font-size: 17px; }
  .thead__jump { display: flex; flex-direction: column; gap: 2px; padding-left: 20px; border-left: 1px solid rgb(var(--hairline)); flex: none; }
  .thead__jumplink {
    min-height: 32px; display: inline-flex; align-items: center; font-size: 13.5px; color: rgb(var(--text-muted));
    text-decoration: underline; text-decoration-color: rgb(var(--hairline-strong)); text-underline-offset: 0.25em;
  }
  .thead__jumplink:hover { color: rgb(var(--text)); text-decoration-color: rgb(var(--yellow)); }

  .tbody { padding-top: 8px; padding-bottom: 64px; }
  .tsec { padding-top: 56px; scroll-margin-top: var(--scroll-offset); }
  .tsec__title { font-size: clamp(26px, 3.2vw, 34px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.05; padding-bottom: 14px; }
  .tlist { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgb(var(--hairline)); }
  .tlist > li { border-top: 1px solid rgb(var(--hairline)); }
  .tempty { margin: 0; padding: 28px 0; color: rgb(var(--text-muted)); border-bottom: 1px solid rgb(var(--hairline)); }

  .tcustom { margin-top: 48px; display: flex; justify-content: space-between; align-items: center; gap: 16px 24px; padding: 22px 24px; }
  .tcustom__title { font-size: 18px; font-weight: 800; letter-spacing: -0.03em; }
  .tcustom__body { margin: 4px 0 0; font-size: 14px; color: rgb(var(--text-muted)); }
  .tcustom .ds-btn { flex: none; }

  @media (max-width: 860px) {
    .thead { flex-direction: column; align-items: flex-start; }
    .thead__jump { flex-direction: row; flex-wrap: wrap; gap: 0 18px; padding-left: 0; border-left: 0; }
  }
  @media (max-width: 720px) {
    .thead { padding-top: 32px; }
    .tsec { padding-top: 40px; }
    .tcustom { flex-direction: column; align-items: flex-start; }
    .thead__jumplink { min-height: 44px; }
  }
</style>
