---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/design/Kicker.astro';
import GridTexture from '../../components/design/GridTexture.astro';
import ContactPanel from '../../components/design/ContactPanel.astro';
import TalksFilter from '../../components/islands/TalksFilter';
import { sanityFetch } from '../../lib/sanity/client';
import { allTalksQuery } from '../../lib/sanity/queries';
import { availabilityLabel } from '../../lib/availability';

interface Talk {
  _id: string;
  title: string;
  slug: string;
  abstract?: string;
  topics?: string[];
  duration?: number;
  eventCount: number;
  latestEvent?: { date: string; conference: string; location: string };
}

const talks = await sanityFetch<Talk[]>(allTalksQuery).catch(() => []);

const totalTalks = talks.length;
const totalDeliveries = talks.reduce((sum, t) => sum + (t.eventCount || 0), 0);
const uniqueTopics = new Set(talks.flatMap((t) => t.topics || [])).size;
---

<BaseLayout
  title="Talks | Faris Aziz"
  description="Browse all talks by Faris Aziz on React, Next.js, payments, and developer experience. Available for conferences and meetups."
  pathname="/talks"
>
  <header class="page-hero">
    <GridTexture />
    <div class="container page-hero__inner">
      <Kicker>Talks · ready to book</Kicker>
      <h1 class="page-hero__title">
        Conference talks, <span class="accent-word">tailored</span> for your room.
      </h1>
      <p class="page-hero__lead">
        Production stories on React, Next.js, payments, and developer experience — each adaptable to your audience's depth and time slot.
      </p>

      <div class="page-hero__stats">
        <div>
          <div class="ds-stat__value" style="font-size:2.2rem;">{totalTalks}</div>
          <div class="ds-stat__label">Talks</div>
        </div>
        <div>
          <div class="ds-stat__value" style="font-size:2.2rem;">{totalDeliveries}</div>
          <div class="ds-stat__label">Deliveries</div>
        </div>
        <div>
          <div class="ds-stat__value" style="font-size:2.2rem;">{uniqueTopics}</div>
          <div class="ds-stat__label">Topics</div>
        </div>
      </div>

      <div class="page-hero__actions">
        <a href="/invite" class="ds-btn ds-btn-primary ds-btn-lg">
          Book a talk
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="/workshops" class="ds-btn ds-btn-secondary ds-btn-lg">View workshops</a>
      </div>
    </div>
  </header>

  <section class="page-section">
    <div class="container wide">
      <div class="page-section__head">
        <div>
          <Kicker>The catalogue</Kicker>
          <h2 class="page-h2">Available talks</h2>
        </div>
        {totalTalks > 0 && (
          <span class="ds-pill ds-pill--signal">
            <span class="ds-dot ds-dot--pulse"></span>
            {totalTalks} ready to book
          </span>
        )}
      </div>

      {talks.length > 0 ? (
        <TalksFilter client:load talks={talks} />
      ) : (
        <div class="page-empty">
          <h3>Coming soon</h3>
          <p>Talks will appear here once content is added to Sanity.</p>
          <a href="/invite" class="ds-btn ds-btn-primary" style="margin-top:1rem;">Contact me about speaking</a>
        </div>
      )}
    </div>
  </section>

  <section class="page-section page-section--contact">
    <div class="container">
      <div class="wide ds-reveal">
        <ContactPanel
          status={availabilityLabel('Custom talks available')}
          title="Need something tailored?"
          body="If none of these fit your audience, I can build a new talk around your theme. Tell me what you're hoping to land — I reply within two days."
          primaryHref="/invite"
          primaryLabel="Get in touch"
          secondaryHref="/workshops"
          secondaryLabel="View workshops"
        />
      </div>
    </div>
  </section>

  <script>
    function initPage() {
      document.querySelectorAll('.ds-reveal.in').forEach((el) => el.classList.remove('in'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.ds-reveal').forEach((el) => io.observe(el));
      window.setTimeout(() => {
        document.querySelectorAll('.ds-reveal:not(.in)').forEach((el) => el.classList.add('in'));
      }, 600);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage, { once: true });
    } else { initPage(); }
    document.addEventListener('astro:after-swap', initPage);
  </script>
</BaseLayout>

