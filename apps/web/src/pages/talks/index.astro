---
/**
 * Talk catalogue (V3 `Talks.dc.html`): bookable, current talk versions with
 * a track-record panel and topic filter pills (?topic=payments). Counts are
 * derived from session records; the list works without JS.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterPills from '../../components/v3/FilterPills.astro';
import TrackRecord from '../../components/talks/TrackRecord.astro';
import TalkRow from '../../components/talks/TalkRow.astro';
import { TOPICS } from 'shared';
import { getAllPraise, getCatalogueTalks, getSpeakingStats, getUpcomingEvents, numberWord } from '../../lib/sanity/v3';
import { breadcrumbs, itemList } from '../../lib/seo';

const [talks, stats, upcomingAll, praise] = await Promise.all([getCatalogueTalks(), getSpeakingStats(), getUpcomingEvents(), getAllPraise()]);

const n = talks.length;
const upcoming = upcomingAll.filter((e) => e.buckets.some((b) => b === 'spoke' || b === 'workshop' || b === 'hosted'));
const quotes = praise.filter((p) => p.topic === 'stage').slice(0, 2);
const topics = TOPICS.filter((t) => talks.some((k) => k.pillar === t.value)).map((t) => ({ value: t.value, label: t.title }));

const headline = n ? `${numberWord(n)} ${n === 1 ? 'talk' : 'talks'}, ready to book.` : 'Talks, ready to book.';
const description = `${n} conference talks on production engineering, payments at scale, careers and community. Premise, audience, length and recordings.`;
---

<BaseLayout
  title="Talks"
  description={description}
  image="/og/talks.png"
  markdownAlternate="/talks.md"
  extraSchema={[
    breadcrumbs([
      { name: 'Speaking', path: '/speaking' },
      { name: 'Talks', path: '/talks' },
    ]),
    itemList('Talk catalogue', talks.map((t) => `/talks/${t.slug}`)),
  ]}
>
  <div data-filter-root>
    <header class="ds-wrap thead">
      <div class="thead__main">
        <p class="ds-kicker"><a href="/speaking" class="is-muted thead__crumb">Speaking</a><span aria-hidden="true"> · </span>Talk catalogue</p>
        <h1 class="ds-h1 thead__h1">{headline}</h1>
        <p class="ds-lede thead__lede">
          What each talk is about, who it's for and how long it runs, with a recording when there is one. I adapt every talk to your slot and your audience.
        </p>
      </div>
      <p class="thead__meta" aria-live="polite">
        <span data-filter-shown>{n}</span> of {n} shown · {stats.talksDelivered} deliveries · {stats.countries} countries
      </p>
    </header>

    <div class="ds-wrap tbody">
      <TrackRecord stats={stats} talks={talks} upcoming={upcoming} quotes={quotes} />

      {topics.length > 1 && <FilterPills name="topic" options={topics} class="tpills" />}

      {n > 0 ? (
        <ul class="tlist">
          {talks.map((t) => (
            <li data-filter-item data-topic={t.pillar ?? ''}>
              <TalkRow talk={t} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="tempty">The catalogue is being updated. <a href="/invite" class="ds-textlink">Tell me about your event</a> and I'll suggest a talk.</p>
      )}
      <p class="tempty" data-filter-empty hidden>
        No talks in this topic yet. <button type="button" class="ds-link ds-link--sm tempty__reset" data-filter-reset>Show everything</button>
      </p>

      <aside class="ds-card tcustom" aria-labelledby="tcustom-title">
        <div>
          <h2 id="tcustom-title" class="tcustom__title">Need something built for your theme?</h2>
          <p class="tcustom__body">Tell me what you'd like your audience to leave with. I'll propose a talk within two days.</p>
        </div>
        <a href="/invite" class="ds-btn ds-btn--yellow" data-track="talks-custom">Get in touch</a>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .thead { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 40px; padding-top: 48px; padding-bottom: 28px; }
  .thead__main { display: flex; flex-direction: column; gap: 14px; max-width: 640px; min-width: 0; }
  .thead__crumb { color: rgb(var(--text-muted)); text-decoration: none; }
  .thead__crumb:hover { color: rgb(var(--text)); }
  .thead__h1 { font-size: clamp(38px, 5.8vw, 52px); }
  .thead__lede { font-size: 17px; }
  .thead__meta { margin: 0; font-size: 13px; line-height: 1.5; color: rgb(var(--text-faint)); text-align: right; flex: none; }

  .tbody { padding-top: 8px; padding-bottom: 64px; }
  .tbody :global(.trk) { margin-bottom: 36px; }
  .tbody :global(.tpills) { margin-bottom: 24px; }
  .tlist { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgb(var(--hairline)); }
  .tlist > li { border-top: 1px solid rgb(var(--hairline)); }
  .tempty { margin: 0; padding: 28px 0; color: rgb(var(--text-muted)); border-bottom: 1px solid rgb(var(--hairline)); }
  .tempty__reset { background: none; border-top: 0; border-left: 0; border-right: 0; cursor: pointer; font-family: inherit; margin-left: 6px; }

  .tcustom { margin-top: 28px; display: flex; justify-content: space-between; align-items: center; gap: 16px 24px; padding: 22px 24px; }
  .tcustom__title { font-size: 18px; font-weight: 800; letter-spacing: -0.03em; }
  .tcustom__body { margin: 4px 0 0; font-size: 14px; color: rgb(var(--text-muted)); }
  .tcustom .ds-btn { flex: none; }

  @media (max-width: 860px) {
    .thead { flex-direction: column; align-items: flex-start; }
    .thead__meta { text-align: left; }
  }
  @media (max-width: 720px) {
    .thead { padding-top: 32px; }
    .tcustom { flex-direction: column; align-items: flex-start; }
  }
</style>
