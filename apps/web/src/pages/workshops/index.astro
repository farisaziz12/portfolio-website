---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkewHero from '../../components/v3/SkewHero.astro';
import PraiseCard from '../../components/v3/PraiseCard.astro';
import WorkshopRow from '../../components/workshops/WorkshopRow.astro';
import { getPhotos, getPraiseFor, getWorkshops, numberWord } from '../../lib/sanity/v3';
import { breadcrumbs, itemList } from '../../lib/seo';
import { pastDeliveries } from '../../lib/workshops-view';

const [all, photos, praise] = await Promise.all([getWorkshops(), getPhotos(), getPraiseFor({ topic: 'workshop' })]);
// Editor order first; unordered ones by how often they've actually run.
const workshops = all
  .filter((w) => w.isBookable)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999) || pastDeliveries(b).length - pastDeliveries(a).length);
const hero = workshops.find((w) => w.image?.asset)?.image ?? photos[0]?.image;
const heroAlt = hero?.alt || 'Faris running a workshop';
// A general workshop quote here; per-workshop quotes live on their own pages.
const quote = praise.find((p) => !p.workshop) ?? praise[0];
const count = workshops.length;
const lede = count
  ? `${numberWord(count)} workshop${count === 1 ? '' : 's'} to choose from. Each edition has its own agenda, so the length you see matches the schedule on the day. Attendees keep the material afterwards.`
  : 'Each edition has its own agenda, so the length you see matches the schedule on the day. Attendees keep the material afterwards.';

const schema = [
  breadcrumbs([
    { name: 'Speaking', path: '/speaking' },
    { name: 'Workshops', path: '/workshops' },
  ]),
  ...(workshops.length ? [itemList('Workshops', workshops.map((w) => `/workshops/${w.slug}`))] : []),
];
---

<BaseLayout
  title="Hands-on workshops | Faris Aziz"
  description="Hands-on workshops by Faris Aziz, compared side by side: what you leave able to do, prerequisites, editions and group size. Book one for your event or team."
  image="/og/workshops.png"
  markdownAlternate="/workshops.md"
  extraSchema={schema}
  band={false}
>
  <SkewHero image={hero} imageAlt={heroAlt} height={440}>
    <p class="ds-kicker"><a href="/speaking" class="is-muted ws-crumb">Speaking</a><span aria-hidden="true"> · </span>Workshops</p>
    <h1 class="ds-h1 ws-h1">Hands-on workshops. You keep the repo.</h1>
    <p class="ds-lede ws-lede">{lede}</p>
  </SkewHero>

  <div class="ds-wrap ws-body">
    {workshops.length ? (
      <>
        <ul class="ws-list" role="list">
          {workshops.map((w) => <WorkshopRow workshop={w} />)}
        </ul>
      </>
    ) : (
      <p class="ds-card ds-card--dashed ws-empty">No workshops listed right now. Tell me what your team needs and I'll send a matching agenda.</p>
    )}

    <div class:list={['ws-foot', { 'ws-foot--solo': !quote }]}>
      {quote && <PraiseCard praise={quote} variant="stripe" />}
      <div class="ds-panel ws-cta">
        <div>
          <h2 class="ws-cta__title">Running a conference workshop day or a team training?</h2>
          <p class="ws-cta__body">Tell me the audience and the slot. I'll send the matching agenda.</p>
        </div>
        <a href="/invite?kind=workshop" class="ds-btn ds-btn--panel" data-track="workshops_book">Book a workshop</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .ws-crumb { text-decoration: none; }
  .ws-crumb:hover { color: rgb(var(--text)); }
  .ws-h1 { font-size: clamp(38px, 6vw, 52px); }
  .ws-lede { font-size: 17px; max-width: 44ch; }

  .ws-body { display: flex; flex-direction: column; gap: 14px; padding-top: 48px; padding-bottom: 64px; }
  .ws-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .ws-empty { margin: 0; color: rgb(var(--text-muted)); }

  .ws-foot { margin-top: 20px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: stretch; }
  .ws-foot--solo { grid-template-columns: minmax(0, 1fr); }
  .ws-foot :global(.pq-stripe) { height: 100%; }
  .ws-cta { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 24px; }
  .ws-cta__title { font-size: 20px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.2; }
  .ws-cta__body { margin: 4px 0 0; font-size: 14px; }
  .ws-cta .ds-btn { flex: none; }

  @media (max-width: 720px) {
    .ws-body { padding-top: 32px; }
    .ws-foot { grid-template-columns: minmax(0, 1fr); }
    .ws-cta { flex-direction: column; align-items: flex-start; }
  }
</style>
