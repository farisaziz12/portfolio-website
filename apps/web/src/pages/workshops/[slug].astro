---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AgendaSwitch from '../../components/workshops/AgendaSwitch.astro';
import WorkshopAside from '../../components/workshops/WorkshopAside.astro';
import PraiseCard from '../../components/v3/PraiseCard.astro';
import { getPraiseFor, getWorkshops, type WorkshopWithHistory } from '../../lib/sanity/v3';
import { breadcrumbs } from '../../lib/seo';
import { deliveryLine, excerpt, pillarLabel } from '../../lib/workshops-view';

export async function getStaticPaths() {
  const workshops = await getWorkshops();
  return workshops.map((w) => ({ params: { slug: w.slug }, props: { workshop: w } }));
}

const w = Astro.props.workshop as WorkshopWithHistory;
const praise = await getPraiseFor({ workshopId: w._id });
const intro = w.description || w.summary;
// The hero carries a short lede; a long description gets its own readable section below.
const lede = w.summary || excerpt(w.description, 200);
// When the lede is the description's opening, the section picks up after it (no repeated sentence).
const rest = !w.summary && lede && w.description?.trim().startsWith(lede) ? w.description.trim().slice(lede.length) : w.description ?? '';
const body = rest.trim() && rest.trim() !== lede ? rest.split(/\n\s*\n/).map((x) => x.trim()).filter(Boolean) : [];
// Upcoming editions first (soonest first), then delivered ones newest first.
const upcoming = w.deliveries.filter((d) => d.event.isUpcoming).reverse();
const delivered = w.deliveries.filter((d) => !d.event.isUpcoming);
const description = (w.seo?.metaDescription || w.summary || w.description || `${w.title}, a hands-on workshop by Faris Aziz.`).slice(0, 160);

const schema = [
  breadcrumbs([
    { name: 'Speaking', path: '/speaking' },
    { name: 'Workshops', path: '/workshops' },
    { name: w.title, path: `/workshops/${w.slug}` },
  ]),
  {
    '@type': 'Course',
    '@id': `https://faziz-dev.com/workshops/${w.slug}#workshop`,
    name: w.title,
    ...(intro ? { description: intro } : {}),
    provider: { '@id': 'https://faziz-dev.com/#person' },
    ...(w.prerequisites.length ? { coursePrerequisites: w.prerequisites } : {}),
  },
];
---

<BaseLayout
  title={w.seo?.metaTitle || `${w.title} · Workshop | Faris Aziz`}
  description={description}
  image={`/og/workshops/${w.slug}.png`}
  imageAlt={`${w.title}, a hands-on workshop by Faris Aziz`}
  markdownAlternate={`/workshops/${w.slug}.md`}
  extraSchema={schema}
>
  <div class="ds-wrap wsp">
    <div class="wsp__main">
      <header class="wsp__head">
        <p class="ds-kicker"><a href="/workshops" class="is-muted wsp__crumb">Workshops</a><span aria-hidden="true"> · </span>{pillarLabel(w)}</p>
        <h1 class="ds-h1 wsp__title">{w.title}</h1>
        {lede && <p class="ds-lede wsp__intro">{lede}</p>}
      </header>

      {body.length > 0 && (
        <section class="wsp__block" aria-labelledby="about-h">
          <h2 id="about-h" class="ds-label">What we'll do</h2>
          <div class="wsp__prose">{body.map((para) => <p>{para}</p>)}</div>
        </section>
      )}

      {w.outcomes.length > 0 && (
        <section class="wsp__block" aria-labelledby="out-h">
          <h2 id="out-h" class="ds-label">You leave able to</h2>
          <ul class="wsp__outcomes">{w.outcomes.map((o) => <li>{o}</li>)}</ul>
        </section>
      )}

      {w.formats.length > 0 ? (
        <AgendaSwitch formats={w.formats} />
      ) : (
        <section class="wsp__block">
          <h2 class="ds-label">Agenda</h2>
          <p class="ds-body">The agenda is tailored per edition. <a href={`/invite?kind=workshop&workshop=${encodeURIComponent(w.title)}`} class="ds-textlink">Ask for the current one</a>.</p>
        </section>
      )}

      <div class="wsp__pair">
        <section class="wsp__block" aria-labelledby="pre-h">
          <h2 id="pre-h" class="ds-label">Prerequisites</h2>
          {w.prerequisites.length ? (
            <ul class="wsp__pre">{w.prerequisites.map((p) => <li>{p}</li>)}</ul>
          ) : (
            <p class="ds-body">None listed.</p>
          )}
        </section>
        <section class="wsp__block" aria-labelledby="del-h">
          <h2 id="del-h" class="ds-label">Delivered at</h2>
          {upcoming.length + delivered.length ? (
            <ul class="wsp__del" role="list">
              {upcoming.map((d) => (
                <li><a href={`/events/${d.event.slug}`} class="wsp__del-link">{deliveryLine(d)} <span class="wsp__soon">· upcoming</span></a></li>
              ))}
              {delivered.map((d) => (
                <li><a href={`/events/${d.event.slug}`} class="wsp__del-link">{deliveryLine(d)}</a></li>
              ))}
            </ul>
          ) : (
            <p class="ds-body">No public editions listed yet.</p>
          )}
        </section>
      </div>

      {praise.slice(0, 2).map((p) => <PraiseCard praise={p} variant="stripe" />)}
    </div>

    <WorkshopAside workshop={w} />
  </div>
</BaseLayout>

<style>
  .wsp { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 56px; padding-top: 48px; padding-bottom: 64px; }
  .wsp__main { display: flex; flex-direction: column; gap: 30px; min-width: 0; }
  .wsp__head { display: flex; flex-direction: column; gap: 14px; }
  .wsp__crumb { text-decoration: none; }
  .wsp__crumb:hover { color: rgb(var(--text)); }
  .wsp__title { font-size: clamp(38px, 6vw, 52px); overflow-wrap: anywhere; }
  .wsp__intro { font-size: clamp(16px, 1.7vw, 18px); line-height: 1.55; max-width: 58ch; }
  .wsp__prose { display: flex; flex-direction: column; gap: 12px; max-width: 66ch; }
  .wsp__prose p { margin: 0; font-size: 15.5px; line-height: 1.7; color: rgb(var(--text-muted)); text-wrap: pretty; }
  .wsp__outcomes { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 28px; }
  .wsp__outcomes li { position: relative; padding-left: 18px; font-size: 15px; line-height: 1.5; color: rgb(var(--text)); }
  .wsp__outcomes li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 8px; height: 2px; background: rgb(var(--yellow)); }
  .wsp__pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .wsp__block { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .wsp__block .ds-body { margin: 0; }
  .wsp__pre { margin: 0; padding-left: 18px; list-style: disc; font-size: 15px; line-height: 1.6; color: rgb(var(--text-muted)); }
  .wsp__del { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgb(var(--hairline)); font-size: 15px; }
  .wsp__del li { border-top: 1px solid rgb(var(--hairline)); }
  .wsp__del-link { display: block; padding: 10px 0; min-height: 24px; color: rgb(var(--text)); text-decoration: none; transition: color 0.15s; }
  .wsp__del-link:hover { color: rgb(var(--accent-text)); }
  .wsp__soon { color: rgb(var(--accent-text)); font-weight: 700; }
  @media (max-width: 960px) {
    .wsp { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 36px; }
  }
  @media (max-width: 720px) {
    .wsp__pair, .wsp__outcomes { grid-template-columns: minmax(0, 1fr); }
  }
</style>
