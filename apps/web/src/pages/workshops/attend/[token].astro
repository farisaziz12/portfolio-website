---
export const prerender = false

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sanityFetch, sanityFetchFresh } from '../../../lib/sanity/client';
import { workshopAttendQuery } from '../../../lib/sanity/queries';
import { getAccessPhase, getCloseDate } from '../../../lib/workshop-access';
import {
  WORKSHOP_SESSION_COOKIE,
  verifyWorkshopSessionCookie,
} from '../../../lib/workshop-session';
import WorkshopAttend from '../../../components/islands/WorkshopAttend';

interface SectionMeta {
  _key: string;
  emoji?: string;
  title: string;
  sectionFeedbackUrl?: string;
}

interface WorkshopInstanceData {
  _id: string;
  title: string;
  event: string;
  token: string;
  workshopDate: string;
  accessDurationDays: number;
  forceClose: boolean;
  liveEndedAt?: string | null;
  liveKeepOpen?: boolean | null;
  repoUrl?: string;
  overallFeedbackUrl?: string;
  emailCaptureEnabled?: boolean;
  sections?: SectionMeta[];
}

const { token } = Astro.params;
const wantsJson = Astro.url.searchParams.get('format') === 'json';
const fetchInstance = wantsJson ? sanityFetchFresh : sanityFetch;
const instance = await fetchInstance<WorkshopInstanceData | null>(workshopAttendQuery, { token }).catch(() => null);

if (!instance) {
  if (wantsJson) {
    return new Response(JSON.stringify({ error: 'Workshop not found' }), {
      status: 404,
      headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
    });
  }
  return Astro.redirect('/404');
}

const phase = getAccessPhase(instance);
const closeDate = getCloseDate(instance);
const materialsOpen = phase === 'live' || phase === 'readonly';

if (wantsJson) {
  return new Response(
    JSON.stringify({
      phase,
      live: phase === 'live',
      closeDateISO: closeDate.toISOString(),
    }),
    {
      status: 200,
      headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
    }
  );
}

const session = verifyWorkshopSessionCookie(
  Astro.cookies.get(WORKSHOP_SESSION_COOKIE)?.value,
  instance.token
);
const initialUser = session
  ? { name: session.name, email: session.email }
  : null;

const formatDateLong = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
};
---

<BaseLayout
  title={`${instance.title} | Workshop`}
  description={`Workshop materials for ${instance.title}`}
  pathname={`/workshops/attend/${token}`}
>
  {phase === 'upcoming' && (
    <section class="min-h-[80vh] flex items-center">
      <div class="container py-20 md:py-32">
        <div class="max-w-3xl mx-auto text-center">
          <div class="ds-terminal max-w-lg mx-auto mb-8 animate-fade-in">
            <div class="ds-terminal__bar">
              <span class="ds-terminal__dots"><i></i><i></i><i></i></span>
              <span class="ds-terminal__name">workshop.sh</span>
            </div>
            <div class="ds-terminal__body">
              <span class="pr">$</span>
              <span class="cmd"> npm run workshop --session="{instance.event}"</span>
              <div class="out mt-2">Waiting for session to begin...</div>
            </div>
          </div>

          <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-ink mb-6">
            {instance.title}
          </h1>

          <p class="text-lg text-ink-muted mb-8">
            This session opens on <span class="font-semibold text-ink">{formatDateLong(instance.workshopDate)}</span>. Check back then.
          </p>
        </div>
      </div>
    </section>
  )}

  {(phase === 'closed' || phase === 'force-closed') && (
    <section class="min-h-[80vh] flex items-center">
      <div class="container py-20 md:py-32">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-ink mb-6">
            {instance.title}
          </h1>

          <p class="text-lg text-ink-muted mb-8">
            This workshop session has ended. Materials are no longer available.
          </p>

          <a href="/workshops" class="ds-btn ds-btn-primary">
            View workshops
          </a>
        </div>
      </div>
    </section>
  )}

  {materialsOpen && (
    <WorkshopAttend
      client:load
      title={instance.title}
      event={instance.event}
      token={instance.token}
      phase={phase === 'live' ? 'live' : 'readonly'}
      repoUrl={instance.repoUrl}
      overallFeedbackUrl={instance.overallFeedbackUrl}
      sections={instance.sections || []}
      closeDateISO={closeDate.toISOString()}
      sanityProjectId={import.meta.env.SANITY_STUDIO_PROJECT_ID || '94fb4yui'}
      sanityDataset={import.meta.env.SANITY_STUDIO_DATASET || 'production'}
      initialUser={initialUser}
    />
  )}
</BaseLayout>
