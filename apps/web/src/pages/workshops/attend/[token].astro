---
export const prerender = false

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sanityFetch } from '../../../lib/sanity/client';
import { allWorkshopInstancesQuery, workshopAttendQuery } from '../../../lib/sanity/workshop-queries';
import {
  resolveWorkshopShortcut,
  type WorkshopShortcutInstance,
} from '../../../lib/workshop-shortcuts';
import { getAccessStatus, getCloseDate } from '../../../lib/workshop-access';
import {
  WORKSHOP_SESSION_COOKIE,
  verifyWorkshopSessionCookie,
} from '../../../lib/workshop-session';
import { ordinalDate } from '../../../lib/ordinal';
import WorkshopAttend from '../../../components/islands/WorkshopAttend';
import '../../../components/islands/workshop/attend.css';

interface SectionMeta {
  _key: string;
  emoji?: string;
  title: string;
  sectionFeedbackUrl?: string;
}

interface WorkshopInstanceData {
  _id: string;
  title: string;
  event: string;
  token: string;
  workshopDate: string;
  accessDurationDays: number;
  forceClose: boolean;
  repoUrl?: string;
  overallFeedbackUrl?: string;
  emailCaptureEnabled?: boolean;
  sections?: SectionMeta[];
}

const { token } = Astro.params;
const instance = await sanityFetch<WorkshopInstanceData | null>(workshopAttendQuery, { token }).catch(() => null);

if (!instance) {
  // A conference keyword (`/workshops/attend/alicante`, the hero-terminal easter egg)
  // resolves to the live session's token here, so the token never ships to the client.
  const instances = await sanityFetch<WorkshopShortcutInstance[]>(allWorkshopInstancesQuery).catch(
    () => []
  );
  const shortcutToken = token ? resolveWorkshopShortcut(token, instances) : null;
  return Astro.redirect(shortcutToken ? `/workshops/attend/${shortcutToken}` : '/404');
}

const status = getAccessStatus(instance);
const closeDate = getCloseDate(instance);

const session = verifyWorkshopSessionCookie(
  Astro.cookies.get(WORKSHOP_SESSION_COOKIE)?.value,
  instance.token
);
const initialUser = session
  ? { name: session.name, email: session.email }
  : null;

const formatDateLong = (dateStr: string) => {
  return ordinalDate(new Date(dateStr), {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
};
---

<BaseLayout
  title={`${instance.title} | Workshop`}
  description={`Workshop materials for ${instance.title}`}
  pathname={`/workshops/attend/${token}`}
>
  {status === 'upcoming' && (
    <section class="ds-wrap wsa-state">
      <div class="wsa-state__inner">
        <p class="ds-kicker">Workshop · {instance.event}</p>
        <h1 class="ds-h1">{instance.title}</h1>
        <p class="ds-lede">
          The materials open on <strong>{formatDateLong(instance.workshopDate)}</strong>. See you there.
        </p>
      </div>
    </section>
  )}

  {(status === 'closed' || status === 'force-closed') && (
    <section class="ds-wrap wsa-state">
      <div class="wsa-state__inner">
        <p class="ds-kicker">Workshop · {instance.event}</p>
        <h1 class="ds-h1">{instance.title}</h1>
        <p class="ds-lede">This session has ended, so the materials are no longer on this page.</p>
        <div class="wsa-actions">
          {instance.repoUrl && (
            <a href={instance.repoUrl} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn--yellow" data-track="workshop_closed_repo">Open the repo</a>
          )}
          {instance.overallFeedbackUrl && (
            <a href={instance.overallFeedbackUrl} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn--outline" data-track="workshop_closed_feedback">Share feedback</a>
          )}
          <a href="/workshops" class="ds-btn ds-btn--outline" data-track="workshop_closed_all">All workshops</a>
        </div>
      </div>
    </section>
  )}

  {status === 'open' && (
    <WorkshopAttend
      client:load
      title={instance.title}
      event={instance.event}
      token={instance.token}
      repoUrl={instance.repoUrl}
      overallFeedbackUrl={instance.overallFeedbackUrl}
      sections={instance.sections || []}
      closeDateISO={closeDate.toISOString()}
      sanityProjectId={import.meta.env.SANITY_STUDIO_PROJECT_ID || '94fb4yui'}
      sanityDataset={import.meta.env.SANITY_STUDIO_DATASET || 'production'}
      initialUser={initialUser}
    />
  )}
</BaseLayout>
