---
export const prerender = false

import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/design/Kicker.astro';
import Terminal from '../../components/design/Terminal.astro';
import GridTexture from '../../components/design/GridTexture.astro';
import { sanityFetch } from '../../lib/sanity/client';
import { allWorkshopInstancesQuery } from '../../lib/sanity/queries';
import { getAccessStatus, getCloseDate } from '../../lib/workshop-access';

interface WorkshopInstanceRow {
  _id: string;
  title: string;
  event: string;
  slug?: string;
  token: string;
  workshopDate: string;
  accessDurationDays: number;
  forceClose: boolean;
  repoUrl: string;
  overallFeedbackUrl?: string;
  emailCaptureEnabled?: boolean;
  resendAudienceId?: string;
}

interface AudienceContactCount {
  audienceId: string;
  count: number | null;
  error?: string;
}

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD;
const RESEND_API_KEY = import.meta.env.RESEND_API_KEY;

let authError = '';
let isAuthenticated = false;

const sessionCookie = Astro.cookies.get('admin_session')?.value;
if (sessionCookie === 'valid') {
  isAuthenticated = true;
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password')?.toString() || '';

  if (ADMIN_PASSWORD && password === ADMIN_PASSWORD) {
    Astro.cookies.set('admin_session', 'valid', {
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: 'strict',
      maxAge: 28800,
      path: '/',
    });
    isAuthenticated = true;
  } else {
    authError = ADMIN_PASSWORD ? 'Incorrect password' : 'ADMIN_PASSWORD env var not set';
  }
}

let instances: WorkshopInstanceRow[] = [];
const audienceCounts = new Map<string, AudienceContactCount>();

if (isAuthenticated) {
  instances = await sanityFetch<WorkshopInstanceRow[]>(allWorkshopInstancesQuery).catch(() => []);

  // Best-effort fetch of subscriber counts from Resend per audience (with timeout).
  if (RESEND_API_KEY) {
    const uniqueAudienceIds = Array.from(
      new Set(instances.map((i) => i.resendAudienceId).filter((id): id is string => !!id))
    );
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 4000);
    try {
      await Promise.all(
        uniqueAudienceIds.map(async (audienceId) => {
          try {
            const res = await fetch(`https://api.resend.com/audiences/${audienceId}/contacts`, {
              headers: { Authorization: `Bearer ${RESEND_API_KEY}` },
              signal: controller.signal,
            });
            if (!res.ok) {
              audienceCounts.set(audienceId, { audienceId, count: null, error: `HTTP ${res.status}` });
              return;
            }
            const json = (await res.json()) as { data?: unknown[] };
            audienceCounts.set(audienceId, { audienceId, count: Array.isArray(json.data) ? json.data.length : null });
          } catch (err) {
            audienceCounts.set(audienceId, {
              audienceId,
              count: null,
              error: err instanceof Error ? err.message : 'fetch failed',
            });
          }
        })
      );
    } finally {
      clearTimeout(timeout);
    }
  }
}

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
};

const statusMeta: Record<string, { label: string; color: string }> = {
  open: { label: 'Open', color: 'var(--signal)' },
  upcoming: { label: 'Upcoming', color: 'var(--accent-bright)' },
  closed: { label: 'Closed', color: 'var(--ink-faint)' },
  'force-closed': { label: 'Force closed', color: 'var(--danger)' },
};
---

<BaseLayout title="Admin · Workshop dashboard" description="Workshop instance dashboard" pathname="/admin">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  {!isAuthenticated ? (
    <section class="auth-section">
      <div class="container">
        <div class="auth-card">
          <Terminal name="admin.sh">
            <div><span class="pr">$</span> <span class="cmd">sudo workshop-admin</span></div>
            <div class="out">Password required…</div>
          </Terminal>

          <div class="auth-card__head">
            <Kicker plain>Admin</Kicker>
            <h1 class="auth-card__title">Sign in</h1>
          </div>

          {authError && <p class="auth-card__error">{authError}</p>}

          <form method="POST" class="auth-card__form">
            <input
              type="password"
              name="password"
              placeholder="Password"
              autocomplete="current-password"
              required
              class="auth-card__input"
            />
            <button type="submit" class="ds-btn ds-btn-primary" style="width:100%;">Sign in</button>
          </form>
        </div>
      </div>
    </section>
  ) : (
    <section class="admin-section">
      <div class="container">
        <div class="admin-head">
          <Kicker>Admin · Workshops</Kicker>
          <div class="admin-head__row">
            <h1 class="admin-head__title">Workshop instances</h1>
            <div class="admin-head__meta">
              <span class="ds-dot"></span>
              <span>{instances.length} instance{instances.length !== 1 ? 's' : ''}</span>
            </div>
          </div>
          <p class="admin-head__body">Each instance can have its own Resend audience so you can broadcast to a single workshop's attendees.</p>
        </div>

        {instances.length === 0 ? (
          <div class="empty">
            <GridTexture />
            <div class="empty__inner">
              <h3 class="empty__title">No instances yet</h3>
              <p class="empty__body">Create a workshop instance in Sanity Studio to get started.</p>
              <a href="https://faziz-dev.sanity.studio" target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-primary">
                Open Sanity Studio
              </a>
            </div>
          </div>
        ) : (
          <div class="instance-list">
            {instances.map((instance) => {
              const status = getAccessStatus(instance);
              const close = getCloseDate(instance);
              const meta = statusMeta[status];
              const audienceCount = instance.resendAudienceId ? audienceCounts.get(instance.resendAudienceId) : undefined;
              const sanityEditUrl = `https://faziz-dev.sanity.studio/structure/workshopInstance;${instance._id}`;
              const resendDashboardUrl = instance.resendAudienceId
                ? `https://resend.com/audiences/${instance.resendAudienceId}`
                : null;
              const attendUrl = `https://faziz-dev.com/workshops/attend/${instance.token}`;

              return (
                <article class="instance">
                  <div class="instance__status" style={`background: rgb(${meta.color});`} aria-hidden="true"></div>
                  <div class="instance__body">
                    <header class="instance__head">
                      <div class="instance__title-block">
                        <h2 class="instance__title">{instance.title}</h2>
                        <p class="instance__event">{instance.event}</p>
                      </div>
                      <span class="instance__chip" style={`color: rgb(${meta.color}); border-color: rgb(${meta.color} / 0.4);`}>
                        <span class="ds-dot" style={`background: rgb(${meta.color}); box-shadow: 0 0 0 3px rgb(${meta.color} / 0.1);`}></span>
                        {meta.label}
                      </span>
                    </header>

                    <dl class="instance__meta-grid">
                      <div>
                        <dt>Workshop date</dt>
                        <dd>{formatDate(instance.workshopDate)}</dd>
                      </div>
                      <div>
                        <dt>Closes</dt>
                        <dd>{formatDate(close.toISOString())}</dd>
                      </div>
                      <div>
                        <dt>Duration</dt>
                        <dd>{instance.accessDurationDays} days</dd>
                      </div>
                    </dl>

                    <div class="instance__row">
                      <span class="instance__label">Access link</span>
                      <button
                        class="instance__copy"
                        data-url={attendUrl}
                        onclick="navigator.clipboard.writeText(this.dataset.url);const lbl=this.querySelector('.lbl');const prev=lbl.textContent;lbl.textContent='Copied';setTimeout(()=>{lbl.textContent=prev;},2000);"
                      >
                        <code>{attendUrl.replace('https://', '')}</code>
                        <span class="lbl">Copy</span>
                      </button>
                    </div>

                    <div class="instance__row">
                      <span class="instance__label">Resend audience</span>
                      {instance.resendAudienceId ? (
                        <div class="instance__audience">
                          <code class="instance__audience-id">{instance.resendAudienceId}</code>
                          {audienceCount && audienceCount.count !== null && (
                            <span class="instance__audience-count">{audienceCount.count} contact{audienceCount.count !== 1 ? 's' : ''}</span>
                          )}
                          {audienceCount?.error && (
                            <span class="instance__audience-error" title={audienceCount.error}>count unavailable</span>
                          )}
                          {resendDashboardUrl && (
                            <a href={resendDashboardUrl} target="_blank" rel="noopener noreferrer" class="ds-link instance__audience-link">
                              Open in Resend
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </a>
                          )}
                        </div>
                      ) : (
                        <div class="instance__audience instance__audience--empty">
                          <span>Not set — broadcasts go to the global audience only.</span>
                          <a href={sanityEditUrl} target="_blank" rel="noopener noreferrer" class="ds-link">
                            Add ID in Sanity
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </a>
                        </div>
                      )}
                    </div>

                    <footer class="instance__actions">
                      <a href={`/workshops/attend/${instance.token}`} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-secondary">
                        Preview
                      </a>
                      {instance.repoUrl && (
                        <a href={instance.repoUrl} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-secondary">
                          Repo
                        </a>
                      )}
                      <a href={sanityEditUrl} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-secondary">
                        Edit in Sanity
                      </a>
                    </footer>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .auth-section {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding-block: 4rem;
  }
  .auth-card {
    max-width: 26rem;
    margin: 0 auto;
    background: rgb(var(--surface-2));
    border: 1px solid rgb(var(--edge));
    border-radius: 14px;
    padding: 2rem;
  }
  .auth-card__head {
    text-align: center;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .auth-card__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.4rem;
    color: rgb(var(--ink));
    margin-top: 0.6rem;
  }
  .auth-card__error {
    background: rgb(var(--danger) / 0.1);
    border: 1px solid rgb(var(--danger) / 0.4);
    color: rgb(var(--danger));
    border-radius: 10px;
    padding: 0.6rem 0.8rem;
    font-size: 0.85rem;
    text-align: center;
    margin-bottom: 1rem;
  }
  .auth-card__form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .auth-card__input {
    width: 100%;
    background: rgb(var(--surface-1));
    border: 1px solid rgb(var(--edge-strong));
    border-radius: 10px;
    padding: 0.8rem 1rem;
    color: rgb(var(--ink));
    font-size: 0.98rem;
  }
  .auth-card__input:focus { outline: none; border-color: rgb(var(--accent)); }

  .admin-section { padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .admin-head { max-width: 60rem; margin-bottom: 2.5rem; }
  .admin-head__row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .admin-head__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: rgb(var(--ink));
  }
  .admin-head__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.78rem;
    color: rgb(var(--ink-faint));
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .admin-head__body {
    color: rgb(var(--ink-muted));
    margin-top: 1rem;
    max-width: 60ch;
  }

  .empty {
    position: relative;
    background: rgb(var(--surface-2));
    border: 1px solid rgb(var(--edge));
    border-radius: 14px;
    padding: 3rem;
    text-align: center;
    overflow: hidden;
  }
  .empty__inner { position: relative; }
  .empty__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.3rem;
    color: rgb(var(--ink));
  }
  .empty__body {
    color: rgb(var(--ink-muted));
    margin: 0.5rem 0 1.5rem;
  }

  .instance-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .instance {
    display: flex;
    background: rgb(var(--surface-2));
    border: 1px solid rgb(var(--edge));
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .instance:hover { border-color: rgb(var(--edge-strong)); }
  .instance__status { width: 4px; flex-shrink: 0; }
  .instance__body { padding: 1.6rem; flex: 1; min-width: 0; }
  .instance__head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .instance__title-block { min-width: 0; }
  .instance__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.1rem;
    color: rgb(var(--ink));
  }
  .instance__event {
    font-size: 0.9rem;
    color: rgb(var(--ink-muted));
    margin-top: 0.15rem;
  }
  .instance__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border: 1px solid;
    border-radius: 999px;
    background: rgb(var(--surface-1));
    flex-shrink: 0;
  }

  .instance__meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin-bottom: 1.4rem;
  }
  .instance__meta-grid dt {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--ink-faint));
    margin-bottom: 0.25rem;
  }
  .instance__meta-grid dd {
    font-size: 0.9rem;
    color: rgb(var(--ink));
    font-weight: 500;
  }

  .instance__row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--edge));
  }
  .instance__label {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--ink-faint));
    flex-shrink: 0;
    min-width: 110px;
  }
  .instance__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgb(var(--edge));
    border-radius: 8px;
    background: rgb(var(--surface-1));
    color: rgb(var(--ink-muted));
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .instance__copy:hover { border-color: rgb(var(--accent-bright)); color: rgb(var(--ink)); }
  .instance__copy code {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.75rem;
    color: rgb(var(--accent-bright));
  }
  .instance__copy .lbl {
    font-size: 0.7rem;
    color: rgb(var(--ink-faint));
  }

  .instance__audience {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .instance__audience-id {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.75rem;
    color: rgb(var(--ink));
    background: rgb(var(--surface-1));
    border: 1px solid rgb(var(--edge));
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
  }
  .instance__audience-count {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.72rem;
    color: rgb(var(--signal));
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .instance__audience-error {
    font-size: 0.72rem;
    color: rgb(var(--ink-faint));
    font-style: italic;
  }
  .instance__audience-link svg { width: 0.9em; height: 0.9em; }
  .instance__audience--empty {
    font-size: 0.85rem;
    color: rgb(var(--ink-muted));
  }

  .instance__actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgb(var(--edge));
  }
  .instance__actions .ds-btn {
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
  }
</style>
