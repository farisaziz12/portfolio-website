---
export const prerender = false

import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/design/Kicker.astro';
import Terminal from '../../components/design/Terminal.astro';
import GridTexture from '../../components/design/GridTexture.astro';
import { sanityFetch } from '../../lib/sanity/client';
import { allWorkshopInstancesQuery, speakerProfileQuery } from '../../lib/sanity/queries';
import { getAccessStatus, getCloseDate } from '../../lib/workshop-access';
import {
  ADMIN_SESSION_COOKIE,
  adminCookieOptions,
  createAdminSessionCookie,
  verifyAdminSessionCookie,
} from '../../lib/workshop-session';
import { env } from '../../lib/email';
import WorkshopInstanceOps from '../../components/islands/WorkshopInstanceOps';
import '../../styles/admin-dashboard.css';

interface WorkshopInstanceRow {
  _id: string;
  title: string;
  event: string;
  slug: string;
  token: string;
  shortPath?: string;
  workshopDate: string;
  accessDurationDays: number;
  forceClose: boolean;
  repoUrl?: string;
  overallFeedbackUrl?: string;
  emailCaptureEnabled?: boolean;
  resendAudienceId?: string;
}

interface AudienceContactCount {
  audienceId: string;
  count: number | null;
  error?: string;
}

interface AdminSpeakerProfile {
  socialLinks?: {
    twitter?: string;
    linkedin?: string;
    bluesky?: string;
    github?: string;
  };
}

const ADMIN_PASSWORD = env('ADMIN_PASSWORD');
const RESEND_API_KEY = env('RESEND_API_KEY');

let authError = '';
let isAuthenticated = verifyAdminSessionCookie(
  Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value
);

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password')?.toString() || '';

  if (ADMIN_PASSWORD && password === ADMIN_PASSWORD) {
    const cookieValue = createAdminSessionCookie(28800);
    if (!cookieValue) {
      authError = 'WORKSHOP_SESSION_SECRET or ADMIN_PASSWORD required to sign session';
    } else {
      Astro.cookies.set(ADMIN_SESSION_COOKIE, cookieValue, adminCookieOptions(28800));
      isAuthenticated = true;
    }
  } else {
    authError = ADMIN_PASSWORD ? 'Incorrect password' : 'ADMIN_PASSWORD env var not set';
  }
}

let instances: WorkshopInstanceRow[] = [];
let profile: AdminSpeakerProfile | null = null;
const audienceCounts = new Map<string, AudienceContactCount>();

if (isAuthenticated) {
  [instances, profile] = await Promise.all([
    sanityFetch<WorkshopInstanceRow[]>(allWorkshopInstancesQuery, {}, { cdn: false }).catch(() => []),
    sanityFetch<AdminSpeakerProfile | null>(speakerProfileQuery).catch(() => null),
  ]);

  // Best-effort fetch of subscriber counts from Resend per audience (with timeout).
  if (RESEND_API_KEY) {
    const uniqueAudienceIds = Array.from(
      new Set(instances.map((i) => i.resendAudienceId).filter((id): id is string => !!id))
    );
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 4000);
    try {
      await Promise.all(
        uniqueAudienceIds.map(async (audienceId) => {
          try {
            const res = await fetch(`https://api.resend.com/audiences/${audienceId}/contacts`, {
              headers: { Authorization: `Bearer ${RESEND_API_KEY}` },
              signal: controller.signal,
            });
            if (!res.ok) {
              audienceCounts.set(audienceId, { audienceId, count: null, error: `HTTP ${res.status}` });
              return;
            }
            const json = (await res.json()) as { data?: unknown[] };
            audienceCounts.set(audienceId, { audienceId, count: Array.isArray(json.data) ? json.data.length : null });
          } catch (err) {
            audienceCounts.set(audienceId, {
              audienceId,
              count: null,
              error: err instanceof Error ? err.message : 'fetch failed',
            });
          }
        })
      );
    } finally {
      clearTimeout(timeout);
    }
  }
}

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
};

const statusMeta: Record<string, { label: string; color: string }> = {
  open: { label: 'Open', color: 'var(--signal)' },
  upcoming: { label: 'Upcoming', color: 'var(--accent-bright)' },
  closed: { label: 'Closed', color: 'var(--ink-faint)' },
  'force-closed': { label: 'Force closed', color: 'var(--danger)' },
};

// ── Press kit quicklinks — deep links into /press-kit for organizer emails ──
const SITE = 'https://faziz-dev.com';

const bioQuicklinks = [
  { label: 'Short bio', url: `${SITE}/press-kit?bio=short#bios` },
  { label: 'Medium bio', url: `${SITE}/press-kit?bio=medium#bios` },
  { label: 'Full bio', url: `${SITE}/press-kit?bio=full#bios` },
];

const cropQuicklinks = [
  { label: 'Headshots', url: `${SITE}/press-kit#headshots` },
  { label: 'Square 1:1', url: `${SITE}/press-kit?crop=square#headshots` },
  { label: 'Portrait 4:5', url: `${SITE}/press-kit?crop=portrait#headshots` },
  { label: 'Wide 16:9', url: `${SITE}/press-kit?crop=wide#headshots` },
];

const socialQuicklinks = [
  { label: 'X', url: profile?.socialLinks?.twitter },
  { label: 'LinkedIn', url: profile?.socialLinks?.linkedin },
  { label: 'Bluesky', url: profile?.socialLinks?.bluesky },
  { label: 'GitHub', url: profile?.socialLinks?.github },
].filter((s): s is { label: string; url: string } => !!s.url);

const socialsBlock = socialQuicklinks.map((s) => `${s.label}: ${s.url}`).join('\n');

const copyOnClick =
  "navigator.clipboard.writeText(this.dataset.url);const lbl=this.querySelector('.lbl');const prev=lbl.textContent;lbl.textContent='Copied';setTimeout(()=>{lbl.textContent=prev;},2000);";
---

<BaseLayout title="Admin · Dashboard" description="Admin dashboard" pathname="/admin">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  {!isAuthenticated ? (
    <section class="auth-section">
      <div class="container">
        <div class="auth-card">
          <Terminal name="admin.sh">
            <div><span class="pr">$</span> <span class="cmd">sudo workshop-admin</span></div>
            <div class="out">Password required…</div>
          </Terminal>

          <div class="auth-card__head">
            <Kicker plain>Admin</Kicker>
            <h1 class="auth-card__title">Sign in</h1>
          </div>

          {authError && <p class="auth-card__error">{authError}</p>}

          <form method="POST" class="auth-card__form">
            <input
              type="password"
              name="password"
              placeholder="Password"
              autocomplete="current-password"
              required
              class="auth-card__input"
            />
            <button type="submit" class="ds-btn ds-btn-primary" style="width:100%;">Sign in</button>
          </form>
        </div>
      </div>
    </section>
  ) : (
    <section class="admin-section">
      <div class="container">
        <div class="admin-head">
          <Kicker>Admin</Kicker>
          <div class="admin-head__row">
            <h1 class="admin-head__title">Dashboard</h1>
          </div>
        </div>

        <!-- PRESS KIT QUICKLINKS -->
        <div class="admin-block">
          <h2 class="admin-block__title">Press kit quicklinks</h2>
          <p class="admin-head__body">Deep links into the <a href="/press-kit" class="ds-link">/press-kit</a>. Paste one into an organizer email and they land with the right bio or headshot crop pre-selected.</p>

          <div class="quicklinks">
            <div class="instance__row quicklinks__row">
              <span class="instance__label">Bios</span>
              <div class="quicklinks__chips">
                {bioQuicklinks.map((l) => (
                  <button class="instance__copy" data-url={l.url} title={l.url} onclick={copyOnClick}>
                    <code>{l.label}</code>
                    <span class="lbl">Copy</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="instance__row quicklinks__row">
              <span class="instance__label">Headshots</span>
              <div class="quicklinks__chips">
                {cropQuicklinks.map((l) => (
                  <button class="instance__copy" data-url={l.url} title={l.url} onclick={copyOnClick}>
                    <code>{l.label}</code>
                    <span class="lbl">Copy</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="instance__row quicklinks__row">
              <span class="instance__label">Custom</span>
              <div class="quicklinks__combo">
                <select id="ql-bio" class="quicklinks__select" aria-label="Bio length">
                  <option value="">No bio</option>
                  <option value="short">Short bio</option>
                  <option value="medium">Medium bio</option>
                  <option value="full">Full bio</option>
                </select>
                <select id="ql-crop" class="quicklinks__select" aria-label="Headshot crop">
                  <option value="">Any crop</option>
                  <option value="square">Square 1:1</option>
                  <option value="portrait">Portrait 4:5</option>
                  <option value="wide">Wide 16:9</option>
                </select>
                <button class="instance__copy" id="ql-combo-copy" type="button">
                  <code id="ql-combo-url">faziz-dev.com/press-kit</code>
                  <span class="lbl">Copy</span>
                </button>
              </div>
            </div>

            <div class="instance__row quicklinks__row">
              <span class="instance__label">Socials</span>
              {socialQuicklinks.length > 0 ? (
                <div class="quicklinks__chips">
                  {socialQuicklinks.map((s) => (
                    <button class="instance__copy" data-url={s.url} title={s.url} onclick={copyOnClick}>
                      <code>{s.label}</code>
                      <span class="lbl">Copy</span>
                    </button>
                  ))}
                  <button class="instance__copy instance__copy--primary" data-url={socialsBlock} title="Copy all social links as a text block" onclick={copyOnClick}>
                    <code>Copy all</code>
                    <span class="lbl">Copy</span>
                  </button>
                </div>
              ) : (
                <div class="instance__audience instance__audience--empty">
                  <span>No social links set.</span>
                  <a href="https://faziz-dev.sanity.studio" target="_blank" rel="noopener noreferrer" class="ds-link">
                    Add them in Sanity (Speaker Profile → Social Links)
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- WORKSHOPS -->
        <div class="admin-block">
          <div class="admin-head__row">
            <h2 class="admin-block__title">Workshop instances</h2>
            <div class="admin-head__meta">
              <span class="ds-dot"></span>
              <span>{instances.length} instance{instances.length !== 1 ? 's' : ''}</span>
            </div>
          </div>
          <p class="admin-head__body">
            Show the QR on a projector, or share the short link when set in Sanity (e.g. faziz-dev.com/survive). Materials stay available from the workshop date until the access window closes.
          </p>
        </div>

        {instances.length === 0 ? (
          <div class="empty">
            <GridTexture />
            <div class="empty__inner">
              <h3 class="empty__title">No instances yet</h3>
              <p class="empty__body">Create a workshop instance in Sanity Studio to get started.</p>
              <a href="https://faziz-dev.sanity.studio" target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-primary">
                Open Sanity Studio
              </a>
            </div>
          </div>
        ) : (
          <div class="instance-list">
            {[...instances]
              .sort((a, b) => {
                const rank = (p: string) =>
                  p === 'open' ? 0 : p === 'upcoming' ? 1 : p === 'force-closed' ? 2 : 3;
                const ra = rank(getAccessStatus(a));
                const rb = rank(getAccessStatus(b));
                if (ra !== rb) return ra - rb;
                return new Date(b.workshopDate).getTime() - new Date(a.workshopDate).getTime();
              })
              .map((instance) => {
              const status = getAccessStatus(instance);
              const close = getCloseDate(instance);
              const meta = statusMeta[status] || statusMeta.closed;
              const audienceCount = instance.resendAudienceId ? audienceCounts.get(instance.resendAudienceId) : undefined;
              const sanityEditUrl = `https://faziz-dev.sanity.studio/structure/workshopInstance;${instance._id}`;
              const resendDashboardUrl = instance.resendAudienceId
                ? `https://resend.com/audiences/${instance.resendAudienceId}`
                : null;
              const attendUrl = `https://faziz-dev.com/workshops/attend/${instance.token}`;
              const shortUrl = instance.shortPath
                ? `https://faziz-dev.com/${instance.shortPath}`
                : undefined;

              return (
                <article class="instance">
                  <div class="instance__status" style={`background: rgb(${meta.color});`} aria-hidden="true"></div>
                  <div class="instance__body">
                    <header class="instance__head">
                      <div class="instance__title-block">
                        <h2 class="instance__title">{instance.title}</h2>
                        <p class="instance__event">{instance.event}</p>
                      </div>
                      <span class="instance__chip" style={`color: rgb(${meta.color}); border-color: rgb(${meta.color} / 0.4);`}>
                        <span class="ds-dot" style={`background: rgb(${meta.color}); box-shadow: 0 0 0 3px rgb(${meta.color} / 0.1);`}></span>
                        {meta.label}
                      </span>
                    </header>

                    <dl class="instance__meta-grid">
                      <div>
                        <dt>Workshop date</dt>
                        <dd>{formatDate(instance.workshopDate)}</dd>
                      </div>
                      <div>
                        <dt>Closes</dt>
                        <dd>{formatDate(close.toISOString())}</dd>
                      </div>
                      <div>
                        <dt>Duration</dt>
                        <dd>{instance.accessDurationDays} days</dd>
                      </div>
                    </dl>

                    <WorkshopInstanceOps
                      client:load
                      attendUrl={attendUrl}
                      shortUrl={shortUrl}
                      instanceSlug={instance.slug || ''}
                      feedbackUrl={instance.overallFeedbackUrl}
                      hasAudience={Boolean(instance.resendAudienceId && instance.slug)}
                      eventLabel={instance.event}
                    />

                    <div class="instance__row">
                      <span class="instance__label">Resend audience</span>
                      {instance.resendAudienceId ? (
                        <div class="instance__audience">
                          <code class="instance__audience-id">{instance.resendAudienceId}</code>
                          {audienceCount && audienceCount.count !== null && (
                            <span class="instance__audience-count">{audienceCount.count} contact{audienceCount.count !== 1 ? 's' : ''}</span>
                          )}
                          {audienceCount?.error && (
                            <span class="instance__audience-error" title={audienceCount.error}>count unavailable</span>
                          )}
                          {resendDashboardUrl && (
                            <a href={resendDashboardUrl} target="_blank" rel="noopener noreferrer" class="ds-link instance__audience-link">
                              Open in Resend
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </a>
                          )}
                        </div>
                      ) : (
                        <div class="instance__audience instance__audience--empty">
                          <span>Not set, so broadcasts go to the global audience only.</span>
                          <a href={sanityEditUrl} target="_blank" rel="noopener noreferrer" class="ds-link">
                            Add ID in Sanity
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </a>
                        </div>
                      )}
                    </div>

                    <footer class="instance__actions">
                      {instance.repoUrl && (
                        <a href={instance.repoUrl} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-secondary">
                          Repo
                        </a>
                      )}
                      <a href={sanityEditUrl} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-secondary">
                        Edit in Sanity
                      </a>
                    </footer>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // Custom quicklink builder: bio + headshot crop → /press-kit deep link.
  function initAdminQuicklinks() {
    const bioSel = document.getElementById('ql-bio') as HTMLSelectElement | null;
    const cropSel = document.getElementById('ql-crop') as HTMLSelectElement | null;
    const urlEl = document.getElementById('ql-combo-url');
    const copyBtn = document.getElementById('ql-combo-copy');
    if (!bioSel || !cropSel || !urlEl || !copyBtn) return;

    const buildUrl = () => {
      const params = new URLSearchParams();
      if (bioSel.value) params.set('bio', bioSel.value);
      if (cropSel.value) params.set('crop', cropSel.value);
      const qs = params.toString();
      const hash = bioSel.value ? '#bios' : cropSel.value ? '#headshots' : '';
      return `https://faziz-dev.com/press-kit${qs ? `?${qs}` : ''}${hash}`;
    };
    const render = () => {
      urlEl.textContent = buildUrl().replace('https://', '');
    };

    bioSel.addEventListener('change', render);
    cropSel.addEventListener('change', render);
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(buildUrl());
      const lbl = copyBtn.querySelector('.lbl');
      if (!lbl) return;
      const prev = lbl.textContent;
      lbl.textContent = 'Copied';
      window.setTimeout(() => {
        lbl.textContent = prev;
      }, 2000);
    });
    render();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdminQuicklinks, { once: true });
  } else {
    initAdminQuicklinks();
  }
  document.addEventListener('astro:after-swap', initAdminQuicklinks);
</script>

