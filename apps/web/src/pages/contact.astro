---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import GridTexture from '../components/design/GridTexture.astro';
import { availabilityLabel, quarterLoad, formatQuarter } from '../lib/availability';
import ContactForm from '../components/islands/ContactForm';
import { sanityFetch } from '../lib/sanity/client';
import { upcomingEventsQuery } from '../lib/sanity/queries';

interface UpcomingEvent {
  date: string;
}

// Honest urgency: real confirmed-date density for the next bookable quarter.
const upcoming = await sanityFetch<UpcomingEvent[]>(upcomingEventsQuery).catch(() => []);
const load = quarterLoad(upcoming.map((e) => e.date));
const loadLine =
  load.tone === 'booked'
    ? `${load.label} is fully booked — planning the next one`
    : load.confirmed > 0
      ? `${load.label} · ${load.confirmed} date${load.confirmed === 1 ? '' : 's'} already confirmed${load.tone === 'limited' ? ' · filling up' : ''}`
      : null;

// The single front door for every way of working together. Each card routes to
// the right mechanism: the speaker-invite form, the cal.com discovery call, or
// the mentorship inquiry form — plus a plain-email fallback underneath.
const doors = [
  {
    href: '/invite',
    kicker: 'Conferences · meetups · internal events',
    title: 'Invite me to speak',
    desc: 'Keynotes, talks, panels and full-day workshops. Tell me about your crowd and I’ll tailor something to fit — big stage or tiny meetup, I love both.',
    cta: 'Send an invite',
    icon: '<path d="M9 3h6v8a3 3 0 0 1-6 0z"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M9 21h6"/>',
    external: false,
  },
  {
    href: 'https://cal.com/farisaziz12/discovery-call',
    kicker: 'Teams · startups · agencies',
    title: 'Book a consulting call',
    desc: 'A free 20-minute call about architecture, performance, payments or team enablement. No pitch, no obligation — just a chat about what’s slowing you down.',
    cta: 'Pick a time',
    icon: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
    external: true,
  },
  {
    href: '/mentorship#apply',
    kicker: 'Individual engineers',
    title: 'Get mentored',
    desc: '1:1 coaching on career strategy, skills and confidence. Tell me where you’re headed and we’ll take it from there.',
    cta: 'Send an inquiry',
    icon: '<circle cx="9" cy="8" r="3"/><path d="M3 19a6 6 0 0 1 12 0M16 7a3 3 0 0 1 0 6M18.5 19a5 5 0 0 0-3-4.6"/>',
    external: false,
  },
  {
    href: '#message',
    topic: 'role',
    kicker: 'Companies · full-time roles',
    title: 'Hire me full-time',
    desc: 'Open to tech lead, staff/senior frontend, full-stack (frontend-leaning), payments, product engineering, and founding engineer roles — tell me what you’re shipping.',
    cta: 'Tell me about it',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 20V9"/>',
    external: false,
  },
];

// FAQ — moved here from the old /services hub when the two router pages merged.
const faq = [
  {
    question: "What's the difference between consulting and mentorship?",
    answer: 'Consulting is project-focused — I work with your team on architecture, performance, and delivery. Mentorship is growth-focused — 1:1 coaching for an individual engineer\'s career and skills.',
    open: true,
  },
  {
    question: 'How do I know which door is right for me?',
    answer: "If you have a team or product challenge, start with consulting. If you're an engineer who wants to level up, choose mentorship. Not sure? Book a free 20-minute call and we'll figure it out together.",
    open: false,
  },
  {
    question: "What's your availability?",
    answer: `I take on a few engagements at a time so each one gets real attention. Next availability opens in ${formatQuarter()} — worth reaching out early if you want in.`,
    open: false,
  },
  {
    question: 'Do you offer refunds?',
    answer: "Yes. If the first session isn't valuable, you don't pay for it. Simple as that.",
    open: false,
  },
];
---

<BaseLayout
  title="Work with me — Faris Aziz"
  description="Invite Faris to speak, book a consulting call, start a mentorship inquiry, or talk to him about a full-time role — one page, four doors."
  pathname="/contact"
  image="/og/contact.png"
  markdownAlternate="/contact.md"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    })} />
  </Fragment>

  <header class="page-hero">
    <GridTexture />
    <div class="container page-hero__inner">
      <div class="contact-hero-meta">
        <Kicker>Work with me</Kicker>
        <span class="ds-pill ds-pill--signal contact-avail">
          <span class="ds-dot ds-dot--pulse"></span>
          {availabilityLabel('Available')}
        </span>
        {loadLine && (
          <span class:list={['ds-pill', 'contact-load', `contact-load--${load.tone}`]}>{loadLine}</span>
        )}
      </div>
      <h1 class="page-hero__title">Four doors, <span class="accent-word">one inbox</span>.</h1>
      <p class="page-hero__lead">
        Speaking, consulting, mentorship — or a full-time role. Pick your door: everything lands straight in my inbox, and I get back to you within two days.
      </p>
    </div>
  </header>

  <section class="page-section">
    <div class="container">
      <div class="contact-doors wide">
        {doors.map((d) => (
          <a
            href={d.href}
            class="ds-card ds-card-interactive contact-door ds-reveal"
            target={d.external ? '_blank' : undefined}
            rel={d.external ? 'noopener noreferrer' : undefined}
            data-track="contact-door"
            data-track-label={d.title}
            data-contact-topic={(d as any).topic}
          >
            <span class="contact-door__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={d.icon} />
            </span>
            <span class="contact-door__kicker">{d.kicker}</span>
            <h2 class="contact-door__title">{d.title}</h2>
            <p class="contact-door__desc">{d.desc}</p>
            <span class="contact-door__go">
              {d.cta}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <p class="contact-fallback ds-reveal">
        Not sure which door, or something else entirely?
        <a href="#message" class="ds-link">Just send me a message below</a>
        — or say hi on
        <a href="https://linkedin.com/in/farisaziz12" target="_blank" rel="noopener noreferrer" class="ds-link">LinkedIn</a>. We'll figure it out.
      </p>
    </div>
  </section>

  <!-- MESSAGE — the one form behind every door that isn't a dedicated flow -->
  <section id="message" class="page-section page-section--alt anchor-target">
    <div class="container">
      <div class="page-section__heading">
        <Kicker class="ds-reveal">Direct line</Kicker>
        <h2 class="page-h2 ds-reveal">Send me a <span class="mark">message</span></h2>
        <p class="page-hero__lead" style="margin-inline:auto;text-align:center;">Roles, ideas, questions — it all lands straight in my inbox, and I reply within two days.</p>
      </div>
      <div class="contact-form-wrap">
        <ContactForm client:visible />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="page-section">
    <div class="container">
      <div class="page-section__heading">
        <Kicker class="ds-reveal">Questions</Kicker>
        <h2 class="page-h2 ds-reveal">Frequently asked</h2>
      </div>
      <div class="svc-faq ds-reveal">
        {faq.map((item) => (
          <details open={item.open}>
            <summary>{item.question}</summary>
            <div class="svc-faq__ans">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    function initDoors() {
      document.querySelectorAll<HTMLAnchorElement>('[data-contact-topic]').forEach((a) => {
        a.addEventListener('click', () => {
          const topic = a.getAttribute('data-contact-topic');
          if (!topic) return;
          // The form hydrates lazily (client:visible) — stash the topic so its
          // mount effect can pick it up even if the event fires pre-hydration.
          (window as any).__contactTopic = topic;
          window.dispatchEvent(new CustomEvent('contact:topic', { detail: { topic } }));
        });
      });
    }
    initDoors();
    document.addEventListener('astro:after-swap', initDoors);
  </script>
</BaseLayout>

<style>
  /* Kicker + availability badge share a row with clear air between and below */
  .contact-hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem 1.4rem;
    margin-bottom: 1.6rem;
  }
  .contact-avail { display: inline-flex; }
  .contact-load { display: inline-flex; color: rgb(var(--ink-muted)); }
  .contact-load--limited {
    color: rgb(var(--warn));
    border-color: rgb(var(--warn) / 0.4);
    background: rgb(var(--warn) / 0.08);
  }
  .contact-load--booked {
    color: rgb(var(--danger));
    border-color: rgb(var(--danger) / 0.4);
    background: rgb(var(--danger) / 0.08);
  }

  .contact-doors {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }

  .contact-door {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.8rem 1.6rem;
  }

  .contact-door__icon {
    width: 26px;
    height: 26px;
    color: rgb(var(--accent-bright));
    display: inline-flex;
    margin-bottom: 0.4rem;
  }
  .contact-door__icon svg { width: 100%; height: 100%; }

  .contact-door__kicker {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgb(var(--ink-faint));
  }

  .contact-door__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: rgb(var(--ink));
  }

  .contact-door__desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgb(var(--ink-muted));
  }

  .contact-door__go {
    margin-top: auto;
    padding-top: 0.8rem;
    color: rgb(var(--accent-bright));
    font-size: 0.76rem;
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .contact-door__go svg {
    width: 13px;
    height: 13px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .contact-door:hover .contact-door__go svg { transform: translateX(3px); }

  .contact-form-wrap {
    max-width: 680px;
    margin: 0 auto;
    background: rgb(var(--surface-2));
    border: 1px solid rgb(var(--edge));
    border-radius: 14px;
    padding: clamp(1.5rem, 3vw, 2.2rem);
  }

  .contact-fallback {
    margin-top: 2.2rem;
    text-align: center;
    font-size: 0.95rem;
    color: rgb(var(--ink-muted));
  }

  @media (max-width: 860px) {
    .contact-doors { grid-template-columns: 1fr; }
  }

  /* FAQ — same .svc-faq visual as /mentorship */
  .svc-faq {
    max-width: 760px;
    margin-inline: auto;
    display: grid;
    gap: 0.7rem;
  }
  .svc-faq details {
    border: 1px solid rgb(var(--edge));
    border-radius: 10px;
    background: rgb(var(--surface-2));
    overflow: hidden;
  }
  .svc-faq summary {
    list-style: none;
    cursor: pointer;
    padding: 1.1rem 1.3rem;
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.02rem;
    color: rgb(var(--ink));
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .svc-faq summary::-webkit-details-marker { display: none; }
  .svc-faq summary::after {
    content: '+';
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    color: rgb(var(--accent-bright));
    font-size: 1.3rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .svc-faq details[open] summary::after { transform: rotate(45deg); }
  .svc-faq__ans {
    padding: 0 1.3rem 1.2rem;
    color: rgb(var(--ink-muted));
    font-size: 0.96rem;
    line-height: 1.6;
  }
</style>
