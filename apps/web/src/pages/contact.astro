---
import BaseLayout from '../layouts/BaseLayout.astro';
import Illustration from '../components/v3/Illustration.astro';
import ContactForm from '../components/islands/ContactForm';
import { getProfile } from '../lib/sanity/v3';
import { breadcrumbs } from '../lib/seo';

const profile = await getProfile();
const socials = [
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'Bluesky', href: profile.links.bluesky },
  { label: 'X', href: profile.links.twitter },
].filter((s): s is { label: string; href: string } => Boolean(s.href));
---

<BaseLayout
  title="Contact · Faris Aziz"
  description="Two ways to reach Faris Aziz: the invitation form for speaking and workshops, and a short message form for podcasts, press and everything else."
  image="/og/contact.png"
  markdownAlternate="/contact.md"
  extraSchema={[breadcrumbs([{ name: 'Contact', path: '/contact' }])]}
>
  <div class="ds-wrap contact">
    <header class="contact__intro">
      <p class="ds-kicker">Contact</p>
      <h1 class="ds-h1 contact__h1">Two doors. Pick the right one.</h1>
      <p class="ds-lede contact__lede">
        Speaking and workshops have their own form so nothing gets lost. Everything else, including podcasts and press,
        comes here or to my socials.
      </p>
      {socials.length > 0 && (
        <p class="contact__socials">{socials.map((s, i) => (<>{i > 0 && ', then '}<a class="ds-textlink" href={s.href} rel="me noopener" target="_blank" data-track={`contact_social_${s.label.toLowerCase()}`}>{s.label}</a>{i === 0 && ' is the fastest way to reach me'}</>))}.</p>
      )}
    </header>

    <div class="contact__doors">
      <a class="ds-panel contact__invite" href="/invite" data-track="contact_door_invite">
        <span class="contact__invite-text">
          <span class="ds-kicker">Speaking · workshops</span>
          <span class="contact__invite-title">Invite me to your event</span>
          <span class="contact__invite-body">Three required fields. Reply within {profile.replyTime}.</span>
        </span>
        <Illustration name="faris-speaking" width={110} class="contact__art" loading="eager" />
      </a>

      <section class="ds-card contact__else" id="message" aria-labelledby="else-h">
        <p class="ds-kicker">Everything else</p>
        <h2 id="else-h" class="contact__else-title">Podcasts, press, a question, a hello</h2>
        <ContactForm client:visible replyTime={profile.replyTime} linkedin={profile.links.linkedin} />
        <p class="ds-meta">Same rule as the invitation form: you only see a confirmation once the message is stored.</p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; align-items: start;
    padding-top: 48px; padding-bottom: 64px;
  }
  .contact__intro { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .contact__h1 { margin: 0; font-size: clamp(38px, 5.4vw, 52px); text-wrap: balance; }
  .contact__lede { font-size: 17px; max-width: 44ch; }
  .contact__socials { margin: 0; font-size: 14px; color: rgb(var(--text-faint)); }
  .contact__socials a { color: rgb(var(--text-muted)); }

  .contact__doors { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .contact__invite {
    display: grid; grid-template-columns: minmax(0, 1fr) 110px; gap: 16px; align-items: center;
    padding: 26px 28px; text-decoration: none; color: rgb(var(--panel-text));
    border: 2px solid transparent; transition: border-color 0.15s;
  }
  .contact__invite:hover { border-color: rgb(var(--yellow)); }
  .contact__invite-text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .contact__invite-title { font-size: clamp(22px, 2.4vw, 26px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.05; }
  .contact__invite:hover .contact__invite-title { text-decoration: underline; text-decoration-color: rgb(var(--yellow)); text-underline-offset: 0.12em; }
  .contact__invite-body { font-size: 14px; color: rgb(var(--panel-muted)); }
  .contact__invite :global(.contact__art) { width: 110px; height: auto; justify-self: end; }

  .contact__else { display: flex; flex-direction: column; gap: 12px; padding: 26px 28px; }
  .contact__else-title { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; text-wrap: balance; }
  .contact__else .ds-meta { margin: 0; }

  @media (max-width: 860px) { .contact { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
  @media (max-width: 720px) { .contact { padding-top: 32px; padding-bottom: 48px; } }
  @media (max-width: 420px) {
    .contact__invite { grid-template-columns: minmax(0, 1fr) 72px; padding: 22px 20px; }
    .contact__invite :global(.contact__art) { width: 72px; }
    .contact__else { padding: 22px 20px; }
  }
</style>
