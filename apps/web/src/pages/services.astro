---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import GridTexture from '../components/design/GridTexture.astro';
import IconChip from '../components/design/IconChip.astro';
import ContactPanel from '../components/design/ContactPanel.astro';
import { sanityFetch } from '../lib/sanity/client';
import { featuredImpactMetricsV2Query, allServiceLandingPagesQuery } from '../lib/sanity/queries';
import { availabilityLabel, formatQuarter } from '../lib/availability';
import { PROOF, FALLBACK_SPEAKER_STATS } from '../lib/proof';

interface ImpactMetricV2 {
  _id: string;
  title: string;
  slug: string;
  domain: 'community' | 'product' | 'leadership' | 'speaking';
  headlineNumber: number;
  unit?: 'number' | 'k' | 'm' | 'percent' | 'x' | 'chf' | 'eur' | 'usd' | 'rating';
  prefix?: string;
  label: string;
  contextNote?: string;
}

interface ServiceLandingPageLink {
  _id: string;
  title: string;
  slug: string;
  metaDescription?: string;
}

const [impactMetrics, landingPages] = await Promise.all([
  sanityFetch<ImpactMetricV2[]>(featuredImpactMetricsV2Query).catch(() => []),
  sanityFetch<ServiceLandingPageLink[]>(allServiceLandingPagesQuery).catch(() => []),
]);

const domainLabel: Record<string, string> = {
  community: 'Community',
  product: 'Product',
  leadership: 'Leadership',
  speaking: 'Speaking',
};

// Pick three diverse metrics (one per domain if possible).
const proofMetrics =
  impactMetrics.length >= 3
    ? (() => {
        const seenDomains = new Set<string>();
        const picked: ImpactMetricV2[] = [];
        for (const m of impactMetrics) {
          if (!seenDomains.has(m.domain) && picked.length < 3) {
            picked.push(m);
            seenDomains.add(m.domain);
          }
        }
        // Pad with whatever's left if we didn't fill three domains
        for (const m of impactMetrics) {
          if (picked.length >= 3) break;
          if (!picked.includes(m)) picked.push(m);
        }
        return picked;
      })()
    : null;

// Hardcoded fallback — single source in lib/proof.ts
const fallbackProof = [
  { domain: 'community', headlineNumber: PROOF.communityMembers, label: 'New members', contextNote: PROOF.communityNote, unit: 'number' as const, prefix: '' },
  { domain: 'leadership', headlineNumber: PROOF.engineersLed, label: 'Engineers led', contextNote: PROOF.engineersNote, unit: 'number' as const, prefix: '' },
  { domain: 'product', headlineNumber: PROOF.revenueMultiplier, label: 'Revenue increase', contextNote: PROOF.revenueNote, unit: 'x' as const, prefix: '' },
];

const proofItems = proofMetrics || fallbackProof;

function formatMetric(m: { headlineNumber: number; unit?: string; prefix?: string }) {
  const num = m.unit === 'x' ? m.headlineNumber.toString() : Math.round(m.headlineNumber).toLocaleString('en-US');
  const suffix = m.unit === 'x' ? '×' : m.unit === 'percent' ? '%' : m.unit === 'k' ? 'k' : m.unit === 'm' ? 'm' : '';
  return { num, suffix, prefix: m.prefix || '' };
}

const steps = [
  {
    title: 'Discovery call',
    desc: "A free 20-minute call to understand your challenge and see if we're a fit.",
    icon: '<path d="M5 4h4l2 5-3 2a11 11 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
    signal: false,
  },
  {
    title: 'Tailored proposal',
    desc: 'A clear engagement with scope, deliverables, and timeline — no fluff.',
    icon: '<path d="M9 4h6l3 3v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M9 9h6M9 13h6M9 17h3"/>',
    signal: false,
  },
  {
    title: 'Deep work',
    desc: 'Focused sessions where we tackle your specific challenges together.',
    icon: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
    signal: false,
  },
  {
    title: 'Ongoing support',
    desc: "Follow-up to make sure you're getting results and staying on track.",
    icon: '<path d="M3 17l6-6 4 4 8-8"/><path d="M21 7v5h-5"/>',
    signal: true,
  },
];

const faq = [
  {
    question: "What's the difference between consulting and mentorship?",
    answer: 'Consulting is project-focused — I work with your team on architecture, performance, and delivery. Mentorship is growth-focused — 1:1 coaching for an individual engineer\'s career and skills.',
    open: true,
  },
  {
    question: 'How do I know which service is right for me?',
    answer: "If you have a team or product challenge, start with consulting. If you're an engineer who wants to level up, choose mentorship. Not sure? Book a free 20-minute call and we'll figure it out together.",
    open: false,
  },
  {
    question: "What's your availability?",
    answer: `I take on a limited number of engagements at a time to keep quality high. Current availability opens in ${formatQuarter()} — get in touch to claim a slot.`,
    open: false,
  },
  {
    question: 'Do you offer refunds?',
    answer: "Yes. If the first session isn't valuable, you don't pay for it. Simple as that.",
    open: false,
  },
];
---

<BaseLayout
  title="Services — Consulting & Mentorship | Faris Aziz"
  description="Frontend architecture consulting, payment systems advisory, and 1:1 engineering mentorship from a Staff Engineer."
  pathname="/services"
  image="/og/services.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    })} />
  </Fragment>

  <!-- HERO -->
  <header class="svc-hero">
    <GridTexture />
    <div class="container svc-hero__inner">
      <span class="ds-pill ds-pill--signal svc-hero__badge">
        <span class="ds-dot ds-dot--pulse"></span>
        {availabilityLabel('Limited availability')}
      </span>
      <h1 class="svc-hero__title">
        Let's work<br /><span class="accent-word">together.</span>
      </h1>
      <p class="svc-hero__lead">
        I help engineers and teams ship better software — through hands-on consulting and personalized 1:1 mentorship. Backed by {impactMetrics.length > 0 ? `${impactMetrics.length}+ measured outcomes` : `${FALLBACK_SPEAKER_STATS.totalEvents} talks`} and a decade shipping payments at scale.
      </p>
      <div class="svc-hero__actions">
        <a href="#choose" class="ds-btn ds-btn-primary ds-btn-lg">
          See how I can help
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="https://cal.com/farisaziz12/discovery-call" target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-secondary ds-btn-lg">Book a free call</a>
      </div>
    </div>
  </header>

  <!-- CHOOSE -->
  <section id="choose" class="svc-section anchor-target">
    <div class="container">
      <div class="svc-section__heading">
        <Kicker class="ds-reveal">Choose your path</Kicker>
        <h2 class="svc-h2 ds-reveal">Two ways to <span class="mark">work with me</span></h2>
        <p class="svc-lead ds-reveal">Whether you need help with a specific project or want to grow as an engineer.</p>
      </div>

      <div class="svc-choose wide">
        <a href="/consulting" class="ds-card svc-choose__card ds-reveal">
          <IconChip>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </IconChip>
          <p class="svc-choose__price">For teams &amp; startups</p>
          <h3 class="svc-choose__title">Consulting</h3>
          <p class="svc-choose__body">Project-focused expertise. Architecture reviews, technical strategy, hands-on implementation, and team enablement.</p>
          <ul class="svc-choose__list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12l5 5 9-11"/></svg>Architecture reviews &amp; audits</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12l5 5 9-11"/></svg>Performance optimization</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12l5 5 9-11"/></svg>Technical strategy &amp; planning</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12l5 5 9-11"/></svg>Team workshops &amp; enablement</li>
          </ul>
          <span class="ds-link svc-choose__link">
            View consulting offers
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>

        <a href="/mentorship" class="ds-card svc-choose__card ds-reveal">
          <IconChip variant="signal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="8" r="3"/><path d="M3 19a6 6 0 0 1 12 0M16 7a3 3 0 0 1 0 6M18.5 19a5 5 0 0 0-3-4.6"/></svg>
          </IconChip>
          <p class="svc-choose__price">For individual engineers</p>
          <h3 class="svc-choose__title">Mentorship</h3>
          <p class="svc-choose__body">Growth-focused guidance. 1:1 coaching, career navigation, skill development, and real accountability.</p>
          <ul class="svc-choose__list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12l5 5 9-11"/></svg>1:1 coaching sessions</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12l5 5 9-11"/></svg>Career strategy &amp; navigation</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12l5 5 9-11"/></svg>Code &amp; portfolio reviews</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12l5 5 9-11"/></svg>Async support via Slack or email</li>
          </ul>
          <span class="ds-link svc-choose__link">
            View mentorship offers
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>

      {landingPages.length > 0 && (
        <div class="svc-landing-links">
          <span class="svc-landing-links__label">Focused offerings:</span>
          {landingPages.map((lp) => (
            <a href={`/services/${lp.slug}`} class="ds-link">
              {lp.title}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- PROVEN RESULTS -->
  <section class="svc-section svc-section--alt">
    <div class="container">
      <div class="svc-section__heading">
        <Kicker class="ds-reveal">Track record</Kicker>
        <h2 class="svc-h2 ds-reveal">Proven results</h2>
      </div>
      <div class="wide svc-proof ds-reveal">
        {proofItems.map((m) => {
          const f = formatMetric(m);
          return (
            <div class="svc-proof__cell">
              <span class="ds-tag svc-proof__tag">{domainLabel[m.domain] || m.domain}</span>
              <div class="ds-stat__value">
                {f.prefix}{f.num}{f.suffix && <span class="svc-proof__suffix">{f.suffix}</span>}
              </div>
              <div class="ds-stat__label">{m.label}</div>
              {m.contextNote && <p class="ds-stat__note">{m.contextNote}</p>}
            </div>
          );
        })}
      </div>
      <div style="text-align:center;margin-top:1.6rem;">
        <a href="/impact" class="ds-link">
          See the full track record
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="svc-section">
    <div class="container">
      <div class="svc-section__heading">
        <Kicker class="ds-reveal">How it works</Kicker>
        <h2 class="svc-h2 ds-reveal">A simple process, <span class="mark">built for results</span></h2>
      </div>
      <div class="svc-steps wide">
        {steps.map((step, i) => (
          <div class="svc-step ds-reveal">
            <IconChip variant={step.signal ? 'signal' : 'accent'}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={step.icon} />
            </IconChip>
            <span class="svc-step__n">STEP 0{i + 1}</span>
            <h4 class="svc-step__title">{step.title}</h4>
            <p class="svc-step__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="svc-section svc-section--alt">
    <div class="container">
      <div class="svc-section__heading">
        <Kicker class="ds-reveal">Questions</Kicker>
        <h2 class="svc-h2 ds-reveal">Frequently asked</h2>
      </div>
      <div class="svc-faq ds-reveal">
        {faq.map((item) => (
          <details open={item.open}>
            <summary>{item.question}</summary>
            <div class="svc-faq__ans">{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="svc-section anchor-target" id="contact">
    <div class="container">
      <div class="wide ds-reveal">
        <ContactPanel
          status={availabilityLabel('Available')}
          title="Ready to level up?"
          body="Let's have a conversation about your goals and how I can help you get there. I reply within two days."
          primaryHref="https://cal.com/farisaziz12/discovery-call"
          primaryLabel="Book a free 20-min call"
          secondaryHref="/contact#message"
          secondaryLabel="Message me instead"
        />
      </div>
    </div>
  </section>

  <script>
    document.documentElement.classList.add('js');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.ds-reveal').forEach((el) => io.observe(el));
    setTimeout(() => {
      document.querySelectorAll('.ds-reveal:not(.in)').forEach((el) => el.classList.add('in'));
    }, 500);
  </script>
</BaseLayout>

<style>
  .svc-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgb(var(--edge));
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .svc-hero__inner { position: relative; max-width: 640px; }
  .svc-hero__badge { margin-bottom: 1.6rem; }
  .svc-hero__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.025em;
    font-size: clamp(2.8rem, 7vw, 5rem);
    color: rgb(var(--ink));
    text-wrap: balance;
  }
  .svc-hero__lead {
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.6;
    color: rgb(var(--ink-muted));
    max-width: 54ch;
    margin-top: 1.5rem;
  }
  .svc-hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .svc-section { padding-block: clamp(4rem, 9vw, 7.5rem); }
  .svc-section--alt {
    background: rgb(var(--surface-1));
    border-top: 1px solid rgb(var(--edge));
    border-bottom: 1px solid rgb(var(--edge));
  }
  .svc-section__heading { text-align: center; margin-bottom: 2.6rem; }
  .svc-section__heading .kicker { justify-content: center; }
  .svc-h2 {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: rgb(var(--ink));
    margin-top: 1rem;
  }
  .svc-lead {
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.6;
    color: rgb(var(--ink-muted));
    max-width: 50ch;
    margin: 1rem auto 0;
  }

  /* Choose */
  .svc-choose {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }
  @media (max-width: 760px) {
    .svc-choose { grid-template-columns: 1fr; }
  }
  .svc-choose__card {
    padding: clamp(1.6rem, 3vw, 2.4rem);
    display: flex;
    flex-direction: column;
    color: inherit;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.22s, box-shadow 0.22s;
  }
  .svc-choose__card:hover {
    transform: translateY(-3px);
    border-color: rgb(var(--edge-strong));
    box-shadow: 0 8px 28px -10px rgba(0,0,0,.65);
  }
  .svc-choose__price {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.8rem;
    color: rgb(var(--ink-faint));
    margin: 1rem 0 0.3rem;
  }
  .svc-choose__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.3rem;
    color: rgb(var(--ink));
  }
  .svc-choose__body {
    font-size: 0.96rem;
    color: rgb(var(--ink-muted));
    margin-top: 0.4rem;
  }
  .svc-choose__list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 1.6rem;
    display: grid;
    gap: 0.7rem;
  }
  .svc-choose__list li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.96rem;
    color: rgb(var(--ink-muted));
  }
  .svc-choose__list svg {
    width: 19px;
    height: 19px;
    color: rgb(var(--signal));
    flex-shrink: 0;
    margin-top: 0.18rem;
  }
  .svc-choose__link { margin-top: auto; }

  /* Proof */
  .svc-proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgb(var(--edge));
    border: 1px solid rgb(var(--edge));
    border-radius: 14px;
    overflow: hidden;
  }
  @media (max-width: 720px) {
    .svc-proof { grid-template-columns: 1fr; }
  }
  .svc-proof__cell {
    background: rgb(var(--surface-2));
    padding: 2rem;
  }
  .svc-proof__tag { margin-bottom: 1.2rem; }
  .svc-proof__suffix { color: rgb(var(--signal)); }

  /* Steps */
  .svc-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }
  @media (max-width: 820px) {
    .svc-steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 460px) {
    .svc-steps { grid-template-columns: 1fr; }
  }
  .svc-step {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .svc-step .icon-chip { margin-bottom: 1rem; }
  .svc-step__n {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.72rem;
    color: rgb(var(--accent-bright));
    letter-spacing: 0.1em;
  }
  .svc-step__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: rgb(var(--ink));
    margin: 0.5rem 0 0.3rem;
  }
  .svc-step__desc {
    font-size: 0.9rem;
    color: rgb(var(--ink-muted));
  }

  /* FAQ */
  .svc-faq {
    max-width: 760px;
    margin-inline: auto;
    display: grid;
    gap: 0.7rem;
  }
  .svc-faq details {
    border: 1px solid rgb(var(--edge));
    border-radius: 10px;
    background: rgb(var(--surface-2));
    overflow: hidden;
  }
  .svc-faq summary {
    list-style: none;
    cursor: pointer;
    padding: 1.1rem 1.3rem;
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.02rem;
    color: rgb(var(--ink));
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .svc-faq summary::-webkit-details-marker { display: none; }
  .svc-faq summary::after {
    content: '+';
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    color: rgb(var(--accent-bright));
    font-size: 1.3rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .svc-faq details[open] summary::after { transform: rotate(45deg); }
  .svc-faq__ans {
    padding: 0 1.3rem 1.2rem;
    color: rgb(var(--ink-muted));
    font-size: 0.96rem;
    line-height: 1.6;
  }

  /* CMS-driven landing-page links under the choose cards */
  .svc-landing-links {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.6rem;
    font-size: 0.92rem;
  }
  .svc-landing-links__label { color: rgb(var(--ink-faint)); }
</style>
