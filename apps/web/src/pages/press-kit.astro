---
import BaseLayout from '../layouts/BaseLayout.astro';
import Illustration from '../components/v3/Illustration.astro';
import BioTabs from '../components/press/BioTabs.astro';
import PressPhotos from '../components/press/PressPhotos.astro';
import { getProfile } from '../lib/sanity/v3';
import { breadcrumbs } from '../lib/seo';
import { linkLabel, pressPhotoView, type PressPhotoView } from '../lib/press';

const profile = await getProfile();
const photos = profile.photos
  .map((p, i) => pressPhotoView(p, i))
  .filter((p): p is PressPhotoView => Boolean(p));

const links = [
  { kind: 'site', url: 'https://faziz-dev.com' },
  ...(['linkedin', 'bluesky', 'twitter'] as const)
    .filter((k) => profile.links[k])
    .map((k) => ({ kind: k, url: profile.links[k]! })),
].map((l) => ({ ...l, label: linkLabel(l.kind, l.url) }));
---

<BaseLayout
  title="Press kit · Faris Aziz"
  description="Faris Aziz press kit: short, medium and long bios, pronunciation, press photos with credits, and the speaker rider."
  image="/og/press-kit.png"
  markdownAlternate="/press-kit.md"
  extraSchema={[breadcrumbs([{ name: 'Speaking', path: '/speaking' }, { name: 'Press kit', path: '/press-kit' }])]}
>
  <div class="ds-wrap press">
    <header class="press__intro">
      <p class="ds-kicker"><a class="press__crumb" href="/speaking">Speaking</a> <span aria-hidden="true">·</span> Press kit</p>
      <h1 class="ds-h1 press__h1">Everything an organiser needs, on one page.</h1>
      <p class="ds-lede press__lede">
        Bios, photos and the practical bits for your programme. Take whatever you need, no need to ask.
      </p>
    </header>

    <div class="press__top">
      <BioTabs bios={profile.bios} />

      <div class="press__side">
        <section class="ds-card press__box" aria-labelledby="links-h">
          <h2 id="links-h" class="press__label">Name and links</h2>
          <dl class="ds-dl press__dl">
            <dt>Name</dt>
            <dd>{profile.name}{profile.pronunciation && <span class="press__faint"> ({profile.pronunciation})</span>}</dd>
            <dt>Title</dt>
            <dd>{profile.tagline}</dd>
            <dt>Based</dt>
            <dd>{profile.travelBase}</dd>
            <dt>Links</dt>
            <dd class="press__links">
              {links.map((l, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <a class="press__link" href={l.url} rel={l.kind === 'site' ? undefined : 'me noopener'} target={l.kind === 'site' ? undefined : '_blank'}>{l.label}</a>
                </>
              ))}
            </dd>
          </dl>
        </section>

        <section class="ds-card press__box" aria-labelledby="rider-h" id="rider">
          <h2 id="rider-h" class="press__label">Rider</h2>
          <dl class="ds-dl press__dl">
            {profile.rider.map((r) => (
              <>
                <dt>{r.label}</dt>
                <dd>{r.body}</dd>
              </>
            ))}
          </dl>
        </section>
      </div>
    </div>

    <PressPhotos photos={photos} />

    {profile.avatarNote && (
      <aside class="ds-panel press__avatar" aria-label="The cartoon version of me">
        <Illustration name="faris-speaking" width={72} class="press__avatar-art" />
        <p><strong>The cartoon version.</strong> {profile.avatarNote}</p>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .press { padding-top: 48px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 48px; }
  .press__intro { display: flex; flex-direction: column; gap: 14px; max-width: 700px; }
  .press__crumb { color: rgb(var(--text-muted)); text-decoration: none; }
  .press__crumb:hover { color: rgb(var(--text)); }
  .press__h1 { margin: 0; font-size: clamp(38px, 5.4vw, 52px); text-wrap: balance; }
  .press__lede { font-size: 17px; }

  .press__top { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 56px; align-items: start; }
  .press__side { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .press__box { padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .press__label { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--accent-text)); }
  .press__dl { grid-template-columns: auto minmax(0, 1fr); gap: 6px 14px; font-size: 14px; line-height: 1.5; }
  .press__faint { color: rgb(var(--text-faint)); }
  .press__links { overflow-wrap: anywhere; }
  .press__link { color: inherit; text-decoration: none; }
  .press__link:hover { color: rgb(var(--accent-text)); text-decoration: underline; }

  .press__avatar { display: flex; align-items: center; gap: 14px; padding: 16px 20px; }
  .press__avatar p { margin: 0; font-size: 14px; line-height: 1.5; }
  .press__avatar strong { color: rgb(var(--panel-text)); }
  .press__avatar :global(.press__avatar-art) { width: 72px; height: auto; flex: none; }

  @media (max-width: 960px) { .press__top { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
  @media (max-width: 720px) { .press { padding-top: 32px; padding-bottom: 48px; gap: 40px; } }
  @media (max-width: 420px) { .press__avatar { flex-direction: column; align-items: flex-start; } }
</style>
