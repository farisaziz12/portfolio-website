---
/** /projects/[slug]: one project (V3): what it is, my role, outcomes, screenshots. */
import { PortableText } from 'astro-portabletext';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/v3/Kicker.astro';
import SanityImg from '../../components/v3/SanityImg.astro';
import InvitePanel from '../../components/v3/InvitePanel.astro';
import Icon from '../../components/v3/Icon.astro';
import { getProjects, getProjectBySlug } from '../../lib/secondary-content';
import { yearOf } from '../../lib/sanity/v3';
import { urlFor } from '../../lib/sanity/client';
import { breadcrumbs, SITE } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params as { slug: string };
const project = await getProjectBySlug(slug);
if (!project) return Astro.redirect('/projects');

const links = [
  project.links.liveUrl && { label: 'Visit the live site', href: project.links.liveUrl, primary: true },
  project.links.githubUrl && { label: 'Source on GitHub', href: project.links.githubUrl },
  project.links.npmUrl && { label: 'npm package', href: project.links.npmUrl },
].filter(Boolean) as { label: string; href: string; primary?: boolean }[];

let ogImage = '/og/projects.png';
try {
  if (project.image?.asset) ogImage = urlFor(project.image).width(1200).height(630).fit('crop').url();
} catch {}

const facts = [
  project.role && { label: 'Role', value: project.role },
  project.category && { label: 'Type', value: project.category },
  project.date && { label: 'Year', value: String(yearOf(project.date)) },
  project.technologies.length > 0 && { label: 'Built with', value: project.technologies.join(', ') },
].filter(Boolean) as { label: string; value: string }[];

const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${SITE}/projects/${project.slug}#project`,
    name: project.title,
    ...(project.description ? { description: project.description } : {}),
    creator: { '@id': `${SITE}/#person` },
    ...(project.links.liveUrl ? { url: project.links.liveUrl } : {}),
    ...(project.technologies.length ? { keywords: project.technologies.join(', ') } : {}),
  },
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Projects', path: '/projects' },
    { name: project.title, path: `/projects/${project.slug}` },
  ]),
];
---

<BaseLayout
  title={`${project.title} | Projects | Faris Aziz`}
  description={(project.description || `${project.title}, a project by Faris Aziz.`).slice(0, 160)}
  image={ogImage}
  markdownAlternate={`/projects/${project.slug}.md`}
  extraSchema={schema}
>
  <div class="ds-wrap">
    <header class="head">
      <nav aria-label="Breadcrumb"><a href="/projects" class="ds-kicker crumb">Projects</a></nav>
      {(project.category || project.featured) && <Kicker parts={[project.category, project.featured && 'Featured']} />}
      <h1 class="ds-h1">{project.title}</h1>
      {project.description && <p class="ds-lede">{project.description}</p>}
      {links.length > 0 && (
        <div class="head__actions">
          {links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer" class={l.primary ? 'ds-btn ds-btn--yellow' : 'ds-link ds-link--sm'} data-track="project-link">
              {l.label} <Icon name="external" size={11} />
            </a>
          ))}
        </div>
      )}
    </header>

    {project.image?.asset && (
      <SanityImg image={project.image} alt={project.image.alt || ''} ratio={16 / 9} widths={[800, 1200, 1600]} sizes="(max-width: 1280px) 100vw, 1200px" loading="eager" fetchpriority="high" class="hero-img" />
    )}

    <div class="body">
      <div class="body__main">
        {project.longDescription.length > 0 && (
          <section class="prose" aria-label="About the project">
            <PortableText value={project.longDescription as never} />
          </section>
        )}
        {project.challenges && (
          <section class="block" aria-labelledby="p-challenges">
            <h2 id="p-challenges" class="ds-label">The hard part</h2>
            <p class="ds-body">{project.challenges}</p>
          </section>
        )}
        {project.outcomes.length > 0 && (
          <section class="block" aria-labelledby="p-outcomes">
            <h2 id="p-outcomes" class="ds-label">What came of it</h2>
            <ul class="outcomes">
              {project.outcomes.map((o) => <li class="ds-stripe">{o}</li>)}
            </ul>
          </section>
        )}
      </div>
      {facts.length > 0 && (
        <aside class="ds-card facts" aria-label="Project facts">
          <dl class="ds-dl">
            {facts.map((f) => (<><dt>{f.label}</dt><dd>{f.value}</dd></>))}
          </dl>
        </aside>
      )}
    </div>

    {project.screenshots.length > 0 && (
      <section class="shots" aria-labelledby="p-shots">
        <h2 id="p-shots" class="ds-label">Screenshots</h2>
        <ul class="ds-grid-2 shots__grid" role="list">
          {project.screenshots.map((s) => (
            <li>
              <figure class="shot">
                <SanityImg image={s.image} ratio={16 / 10} widths={[600, 1000]} sizes="(max-width: 720px) 100vw, 600px" class="shot__img" />
                {s.caption && <figcaption class="ds-meta">{s.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}

    <InvitePanel
      class="panel"
      kicker="Work together"
      headline="Building something like this?"
      body="Tell me what you’re working on. Advisory, a workshop for your team, or a talk about how it was built."
      primary={{ label: 'See how I can help', href: '/services' }}
      secondary={{ label: 'More projects', href: '/projects' }}
      art="faris-thinking"
      track="project-panel"
    />
  </div>
</BaseLayout>

<style>
  .head { display: flex; flex-direction: column; gap: 14px; padding-block: clamp(32px, 5vw, 52px) 32px; max-width: 820px; }
  .crumb { text-decoration: none; color: rgb(var(--text-muted)); }
  .crumb:hover { color: rgb(var(--accent-text)); }
  .head__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 6px; }
  .ds-wrap :global(.hero-img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-card); }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 32px 56px; align-items: start; padding-block: clamp(32px, 5vw, 48px); }
  .body__main { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .prose { max-width: 65ch; font-size: 17px; line-height: 1.65; color: rgb(var(--text-muted)); }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(h2), .prose :global(h3) { color: rgb(var(--text)); font-weight: 800; letter-spacing: -0.03em; margin: 1.4em 0 0.5em; }
  .prose :global(a) { color: rgb(var(--text)); text-decoration: underline; text-decoration-color: rgb(var(--yellow)); text-underline-offset: 0.2em; }
  .block { display: flex; flex-direction: column; gap: 12px; }
  .block .ds-body { margin: 0; max-width: 65ch; font-size: 16px; }
  .outcomes { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; font-size: 16px; line-height: 1.5; }
  .facts { padding: 22px; }

  .shots { display: flex; flex-direction: column; gap: 14px; padding-bottom: clamp(32px, 5vw, 48px); }
  .shots__grid { margin: 0; padding: 0; list-style: none; grid-auto-rows: auto; }
  .shot { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .shot :global(.shot__img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-card); border: 1px solid rgb(var(--hairline)); }
  .ds-wrap :global(.panel) { margin-bottom: clamp(40px, 5vw, 64px); }

  @media (max-width: 900px) { .body { grid-template-columns: 1fr; } }
</style>
