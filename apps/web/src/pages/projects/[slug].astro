---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/design/Kicker.astro';
import GridTexture from '../../components/design/GridTexture.astro';
import ContactPanel from '../../components/design/ContactPanel.astro';
import { sanityFetch, urlFor } from '../../lib/sanity/client';
import { projectBySlugQuery, allProjectsQuery } from '../../lib/sanity/queries';

interface ProjectDetail {
  _id: string;
  title: string;
  slug: string;
  description?: string;
  category?: string;
  technologies?: string[];
  image?: any;
  links?: { liveUrl?: string; githubUrl?: string; npmUrl?: string };
  featured?: boolean;
  role?: string;
  outcomes?: string[];
  screenshots?: { _key: string; image: any; title?: string; description?: string; alt?: string; caption?: string }[];
}

interface ProjectListItem { _id: string; slug: string }

export async function getStaticPaths() {
  const projects = await sanityFetch<ProjectListItem[]>(allProjectsQuery).catch(() => []);
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = await sanityFetch<ProjectDetail | null>(projectBySlugQuery, { slug }).catch(() => null);
if (!project) return Astro.redirect('/404');

const hasLive = !!project.links?.liveUrl;
const hasGithub = !!project.links?.githubUrl;
const hasNpm = !!project.links?.npmUrl;
---

<BaseLayout
  title={`${project.title} | Projects | Faris Aziz`}
  description={project.description || project.title}
  pathname={`/projects/${slug}`}
  image={project.image ? urlFor(project.image).width(1200).height(630).url() : undefined}
>
  <header class="page-hero">
    <GridTexture />
    <div class="container page-hero__inner">
      <nav class="page-crumbs" aria-label="Breadcrumb">
        <a href="/projects">Projects</a>
        <span class="page-crumbs__sep">/</span>
        <span class="page-crumbs__cur">{project.title.length > 30 ? project.title.slice(0, 28) + '…' : project.title}</span>
      </nav>

      <div class="event-tags">
        {project.category && <span class="ds-tag" style="color:rgb(var(--accent-bright));border-color:rgb(var(--accent) / 0.4);">{project.category}</span>}
        {project.featured && <span class="ds-tag">Featured</span>}
      </div>

      <h1 class="page-hero__title event-title">{project.title}</h1>
      {project.description && <p class="page-hero__lead">{project.description}</p>}

      {(hasLive || hasGithub || hasNpm) && (
        <div class="page-hero__actions">
          {hasLive && (
            <a href={project.links!.liveUrl} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-primary">
              View live
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          )}
          {hasGithub && (
            <a href={project.links!.githubUrl} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-secondary">
              <svg viewBox="0 0 24 24" fill="currentColor" style="width:1em;height:1em;" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              Source code
            </a>
          )}
          {hasNpm && (
            <a href={project.links!.npmUrl} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-secondary">npm</a>
          )}
        </div>
      )}
    </div>
  </header>

  {project.image && (
    <section class="project-image-section">
      <div class="container">
        <div class="project-image">
          <img src={urlFor(project.image).width(1200).height(675).quality(90).url()} alt={project.title} loading="eager" />
        </div>
      </div>
    </section>
  )}

  {(project.role || (project.outcomes?.length || 0) > 0 || (project.technologies?.length || 0) > 0) && (
    <section class="page-section">
      <div class="container">
        <div class="project-meta-grid">
          {project.role && (
            <div class="project-meta-block">
              <Kicker>My role</Kicker>
              <p class="project-meta-block__body">{project.role}</p>
            </div>
          )}
          {project.outcomes && project.outcomes.length > 0 && (
            <div class="project-meta-block">
              <Kicker>Key outcomes</Kicker>
              <ul class="event-list" style="max-width:none;">
                {project.outcomes.map((o) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12l5 5 9-11" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>{o}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {project.technologies && project.technologies.length > 0 && (
            <div class="project-meta-block">
              <Kicker>Built with</Kicker>
              <div class="event-tags" style="margin-bottom:0;">
                {project.technologies.map((t) => <span class="ds-tag">{t}</span>)}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {project.screenshots && project.screenshots.length > 0 && (
    <section class="page-section page-section--alt">
      <div class="container">
        <div class="page-section__head">
          <Kicker>Captured</Kicker>
          <h2 class="page-h2">Screenshots</h2>
        </div>
        <div class="page-grid-2">
          {project.screenshots.map((s) => (
            <div class="ds-card project-screenshot">
              <div class="project-screenshot__media">
                <img src={urlFor(s.image).width(800).height(500).quality(90).url()} alt={s.alt || s.title || project.title} loading="lazy" />
              </div>
              {(s.title || s.caption || s.description) && (
                <div class="project-screenshot__caption">
                  {s.title && <b>{s.title}</b>}
                  {(s.caption || s.description) && <span>{s.caption || s.description}</span>}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="page-section page-section--contact">
    <div class="container">
      <div class="wide ds-reveal">
        <ContactPanel
          status="Open for collaboration"
          title="Interested in working together?"
          body="Whether it's open source, a consulting project, or something new, tell me what you're building and I'll see how I can help."
          primaryHref="/invite"
          primaryLabel="Get in touch"
          secondaryHref="/projects"
          secondaryLabel="More projects"
        />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .event-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .event-title { max-width: 22ch; }

  .project-image-section {
    padding-block: clamp(2rem, 4vw, 3rem);
    background: rgb(var(--surface-1));
    border-bottom: 1px solid rgb(var(--edge));
  }
  .project-image {
    max-width: 1040px;
    margin: 0 auto;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgb(var(--edge));
    background: rgb(var(--surface-3));
  }
  .project-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-meta-grid {
    max-width: 760px;
    display: grid;
    gap: 2.5rem;
  }
  .project-meta-block__body {
    color: rgb(var(--ink-muted));
    line-height: 1.7;
    margin-top: 0.8rem;
  }

  .event-list {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
    display: grid;
    gap: 0.6rem;
  }
  .event-list li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    color: rgb(var(--ink-muted));
    line-height: 1.55;
  }
  .event-list svg {
    width: 20px;
    height: 20px;
    color: rgb(var(--signal));
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .project-screenshot {
    overflow: hidden;
  }
  .project-screenshot__media {
    aspect-ratio: 8 / 5;
    background: rgb(var(--surface-3));
    overflow: hidden;
  }
  .project-screenshot__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .project-screenshot__caption {
    padding: 1rem 1.2rem;
    border-top: 1px solid rgb(var(--edge));
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .project-screenshot__caption b {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-size: 0.95rem;
    color: rgb(var(--ink));
  }
  .project-screenshot__caption span {
    font-size: 0.85rem;
    color: rgb(var(--ink-muted));
  }
</style>
