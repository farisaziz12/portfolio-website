---
/** /projects: things I've built (V3). Cards link to /projects/[slug]. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/v3/Kicker.astro';
import SanityImg from '../../components/v3/SanityImg.astro';
import InvitePanel from '../../components/v3/InvitePanel.astro';
import { getProjects } from '../../lib/secondary-content';
import { getProfile } from '../../lib/sanity/v3';
import { breadcrumbs, itemList } from '../../lib/seo';

const [projects, profile] = await Promise.all([getProjects(), getProfile()]);
const github = profile.links.github ?? 'https://github.com/farisaziz12';
---

<BaseLayout
  title="Projects | Faris Aziz"
  description="Things Faris Aziz has built: the ZurichJS Conf platform, developer tools, open source and side projects, with the role and outcome of each."
  image="/og/projects.png"
  markdownAlternate="/projects.md"
  extraSchema={[
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
      { name: 'Projects', path: '/projects' },
    ]),
    ...(projects.length ? [itemList('Projects', projects.map((p) => `/projects/${p.slug}`))] : []),
  ]}
>
  <div class="ds-wrap">
    <header class="head">
      <Kicker parts={['About', 'Projects']} mutedFirst />
      <h1 class="ds-h1">Things I’ve built.</h1>
      <p class="ds-lede">
        Products, platforms and tools, from the conference platform behind ZurichJS to small open-source helpers. Each one taught me something I now talk about on stage.
      </p>
    </header>

    <section class="list" aria-label="All projects">
      {projects.length > 0 ? (
        <>
          <p class="ds-meta list__count">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
          <ul class="ds-grid-3 grid" role="list">
            {projects.map((p) => (
              <li>
                <a href={`/projects/${p.slug}`} class="ds-card ds-card--link card">
                  <SanityImg image={p.image} alt="" ratio={16 / 9} widths={[480, 800]} sizes="(max-width: 720px) 100vw, 400px" class="card__img" />
                  <div class="card__body">
                    {(p.category || p.featured) && <Kicker parts={[p.category, p.featured && 'Featured']} />}
                    <h2 class="card__title">{p.title}</h2>
                    {p.description && <p class="card__desc">{p.description}</p>}
                    {p.technologies.length > 0 && <p class="ds-meta card__tech">{p.technologies.slice(0, 5).join(' · ')}</p>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <div class="ds-card ds-card--dashed empty">
          <h2 class="ds-h3">Nothing published here yet.</h2>
          <p class="ds-body">Project write-ups are on their way. Until then, the code lives on GitHub.</p>
          <a href={github} class="ds-link ds-link--sm" target="_blank" rel="noopener noreferrer" data-track="projects-github">GitHub</a>
        </div>
      )}
    </section>

    <InvitePanel
      class="panel"
      kicker="Work together"
      headline="Building something similar?"
      body="Advisory on frontend architecture, payments and team structure, or a talk about how these were built."
      primary={{ label: 'See how I can help', href: '/services' }}
      secondary={{ label: 'Code on GitHub', href: github }}
      art="faris-thinking"
      track="projects-panel"
    />
  </div>
</BaseLayout>

<style>
  .head { display: flex; flex-direction: column; gap: 14px; padding-block: clamp(32px, 5vw, 52px) 32px; max-width: 760px; }
  .list { padding-bottom: clamp(40px, 5vw, 56px); }
  .list__count { margin: 0 0 14px; }
  .grid { margin: 0; padding: 0; list-style: none; }
  .card { height: 100%; padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .card :global(.card__img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-bottom: 1px solid rgb(var(--hairline)); }
  .card__body { display: flex; flex-direction: column; gap: 10px; padding: 20px 22px 22px; flex: 1; }
  .card__title { font-size: clamp(20px, 2vw, 22px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; }
  .card:hover .card__title { color: rgb(var(--accent-text)); }
  .card__desc { margin: 0; font-size: 14.5px; line-height: 1.5; color: rgb(var(--text-muted)); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card__tech { margin: auto 0 0; padding-top: 6px; }
  .empty { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .empty .ds-body { margin: 0; }
  .ds-wrap :global(.panel) { margin-bottom: clamp(40px, 5vw, 64px); }
</style>
