---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import ContactPanel from '../components/design/ContactPanel.astro';
import { EventRow } from '../components/events/EventRow';
import { sanityFetch } from '../lib/sanity/client';
import {
  upcomingEventsQuery,
  pastEventsQuery,
  speakingStatsQuery,
  allTalksQuery,
} from '../lib/sanity/queries';
import { topConferences } from '../lib/conferences';
import { FALLBACK_SPEAKER_STATS } from '../lib/proof';
import { bookingYears } from '../lib/availability';

interface UpcomingEvent {
  _id: string;
  title: string;
  slug: string;
  type: string;
  conference?: string;
  date: string;
  location?: { city?: string; country?: string; isOnline?: boolean };
  links?: { eventUrl?: string; videoUrl?: string };
}

interface PastEvent {
  _id: string;
  title: string;
  conference?: string;
  date: string;
}

interface SpeakingStats {
  totalEvents: number;
  upcomingEvents: number;
  countries: number;
  cities: number;
  talks: number;
  workshops: number;
}

interface TalkListItem {
  _id: string;
  title: string;
  slug: string;
  abstract?: string;
  duration?: number;
  eventCount?: number;
  latestEvent?: { conference?: string; location?: string };
}

const [upcomingEvents, pastEvents, stats, talks] = await Promise.all([
  sanityFetch<UpcomingEvent[]>(upcomingEventsQuery).catch(() => []),
  sanityFetch<PastEvent[]>(pastEventsQuery).catch(() => []),
  sanityFetch<SpeakingStats>(speakingStatsQuery).catch(() => ({ ...FALLBACK_SPEAKER_STATS })),
  sanityFetch<TalkListItem[]>(allTalksQuery).catch(() => []),
]);

const upcomingCount = upcomingEvents.length;
const conferenceWall = topConferences(pastEvents);
const nextThree = upcomingEvents.slice(0, 3);

function firstLine(abstract?: string) {
  if (!abstract) return '';
  const line = abstract.split('\n')[0].replace(/\s+/g, ' ').trim();
  return line.length > 160 ? `${line.slice(0, 157)}…` : line;
}

const featuredTalks = [...talks]
  .sort((a, b) => (b.eventCount || 0) - (a.eventCount || 0))
  .slice(0, 3);
---

<BaseLayout
  title="Speaking: Talks & Workshops | Faris Aziz"
  description={`Book Faris Aziz to speak: ${stats.totalEvents} talks across ${stats.countries} countries. Production-grade engineering, framework-agnostic, drawn from real case studies.`}
  pathname="/speaking"
  image="/og/speaking.png"
  markdownAlternate="/speaking.md"
>
  <header class="speaking-hero">
    <div class="container speaking-hero__inner">
      <Kicker>Booking {bookingYears()}</Kicker>
      <h1 class="speaking-hero__title heading-sentence">Invite me to speak.</h1>
      <p class="speaking-hero__lead">
        I speak about production and scale: the pragmatic decisions and leadership calls behind real systems, drawn from case studies rather than theory. React and Next.js are home base, but I'm framework-agnostic at heart. What I actually care about is the web, incredible UX, and lifting up the engineers who build it.
      </p>
      <p class="ds-proof">
        <b>{stats.totalEvents}</b> events across <b>{stats.countries}</b> countries
        and <b>{stats.cities}</b> cities.
      </p>

      <div class="speaking-hero__actions">
        <a href="/invite" class="ds-btn ds-btn-primary ds-btn-lg">
          Invite me to speak
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="#talks" class="ds-btn ds-btn-secondary ds-btn-lg">See the talks</a>
      </div>
    </div>
  </header>

  <section class="speaking-section">
    <div class="container wide">
      <div class="speaking-section__head">
        <h2 class="speaking-h2">What's next on the calendar.</h2>
        {upcomingCount > 0 && (
          <span class="ds-pill ds-pill--signal">
            <span class="ds-dot ds-dot--pulse"></span>
            {upcomingCount} confirmed
          </span>
        )}
      </div>

      {upcomingCount > 0 ? (
        <>
          <div class="events-list">
            {nextThree.map((e, i) => <EventRow event={e} index={i} />)}
          </div>
          <p class="speaking-more">
            <a href="/events" class="ds-link">
              Full schedule
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </>
      ) : (
        <div class="speaking-empty">
          <p>No upcoming events confirmed yet. Check back soon, or invite me directly.</p>
          <a href="/invite" class="ds-btn ds-btn-primary speaking-empty__cta">Invite me to speak</a>
        </div>
      )}
    </div>
  </section>

  {featuredTalks.length > 0 && (
    <section class="speaking-section anchor-target" id="talks">
      <div class="container">
        <h2 class="speaking-h2">A few talks I give.</h2>
        <p class="speaking-lead">
          These are the ones I get asked for most. Every talk is adapted to the room; the catalogue has the rest.
        </p>
        <ul class="speaking-talks">
          {featuredTalks.map((t) => (
            <li>
              <a href={`/talks/${t.slug}`} class="speaking-talk">
                <span class="speaking-talk__title">{t.title}</span>
                {firstLine(t.abstract) && <span class="speaking-talk__desc">{firstLine(t.abstract)}</span>}
                {(t.latestEvent?.conference || t.duration) && (
                  <span class="speaking-talk__meta">
                    {[t.latestEvent?.conference, t.duration ? `${t.duration} min` : null].filter(Boolean).join(' · ')}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
        <p class="speaking-more">
          <a href="/talks" class="ds-link">
            All bookable talks
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </p>
        {conferenceWall.length > 0 && (
          <p class="speaking-stages">
            Stages I've shared: {conferenceWall.slice(0, 8).join(', ')}.
          </p>
        )}
      </div>
    </section>
  )}

  <section class="speaking-section speaking-section--contact anchor-target" id="invite">
    <div class="container">
      <div class="wide">
        <ContactPanel
          status={`Booking ${bookingYears()} dates now`}
          title="Invite me to your event"
          body="Drop me a message on my socials, or fill in the form. I reply within two days. Community meetups are usually on the house."
          primaryHref="/invite"
          primaryLabel="Send an invite"
          secondaryHref="/talks"
          secondaryLabel="Browse my talks"
        />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .speaking-hero {
    position: relative;
    border-bottom: 1px solid rgb(var(--edge));
    padding-block: clamp(3.25rem, 7vw, 5.5rem);
  }
  .speaking-hero__inner { position: relative; }
  .speaking-hero__title { margin-top: 1.1rem; }
  .speaking-hero__lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgb(var(--ink-muted));
    max-width: 68ch;
    margin-top: 1.25rem;
  }
  .speaking-hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .speaking-section { padding-block: clamp(3.25rem, 7vw, 5.5rem); }
  .speaking-section--contact { padding-top: 0; }
  .speaking-section__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.4rem;
  }
  .speaking-h2 {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: rgb(var(--ink));
  }
  .speaking-lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgb(var(--ink-muted));
    max-width: 68ch;
    margin-top: 0.75rem;
  }

  .events-list { display: grid; gap: 0.2rem; }
  .speaking-more { margin-top: 1.4rem; }
  .speaking-empty {
    color: rgb(var(--ink-muted));
    max-width: 68ch;
  }
  .speaking-empty__cta { margin-top: 1rem; }

  .speaking-talks {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    max-width: 68ch;
    border-top: 1px solid rgb(var(--edge));
  }
  .speaking-talk {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.15rem 0.1rem;
    border-bottom: 1px solid rgb(var(--edge));
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }
  .speaking-talk:hover .speaking-talk__title,
  .speaking-talk:focus-visible .speaking-talk__title {
    color: rgb(var(--accent-bright));
  }
  .speaking-talk:focus-visible {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 2px;
  }
  .speaking-talk__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.35;
    color: rgb(var(--ink));
    letter-spacing: -0.015em;
    transition: color 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .speaking-talk__desc {
    font-size: 0.98rem;
    line-height: 1.55;
    color: rgb(var(--ink-muted));
  }
  .speaking-talk__meta {
    font-size: 0.875rem;
    color: rgb(var(--ink-faint));
  }

  .speaking-stages {
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgb(var(--ink-muted));
    max-width: 68ch;
  }
</style>
