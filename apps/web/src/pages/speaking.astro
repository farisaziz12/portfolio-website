---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import GridTexture from '../components/design/GridTexture.astro';
import ContactPanel from '../components/design/ContactPanel.astro';
import Faq from '../components/design/Faq.astro';
import Quote from '../components/design/Quote.astro';
import Bio from '../components/design/Bio.astro';
import { EventRow } from '../components/events/EventRow';
import { sanityFetch } from '../lib/sanity/client';
import {
  upcomingEventsQuery,
  pastEventsQuery,
  speakingStatsQuery,
  allTalksQuery,
  featuredSocialPostsQuery,
  featuredTestimonialsQuery,
  speakerProfileQuery,
} from '../lib/sanity/queries';
import { topConferences } from '../lib/conferences';
import { FALLBACK_SPEAKER_STATS } from '../lib/proof';
import { bookingYears } from '../lib/availability';

interface UpcomingEvent {
  _id: string;
  title: string;
  slug: string;
  type: string;
  conference?: string;
  date: string;
  location?: { city?: string; country?: string; isOnline?: boolean };
  links?: { eventUrl?: string; videoUrl?: string };
}

interface PastEvent {
  _id: string;
  title: string;
  conference?: string;
  date: string;
}

interface SpeakingStats {
  totalEvents: number;
  upcomingEvents: number;
  countries: number;
  cities: number;
  talks: number;
  workshops: number;
}

interface TalkListItem {
  _id: string;
  title: string;
  slug: string;
  abstract?: string;
  duration?: number;
  topics?: string[];
  latestEvent?: { conference?: string; location?: string };
}

interface SocialPost {
  _id: string;
  author: string;
  authorHandle?: string;
  authorRole?: string;
  content: string;
  url?: string;
}

interface Testimonial {
  _id: string;
  quote: string;
  author: string;
  role?: string;
  company?: string;
}

interface SpeakerProfile {
  bioShort?: string;
}

const [upcomingEvents, pastEvents, stats, talks, socialPosts, testimonials, profile] = await Promise.all([
  sanityFetch<UpcomingEvent[]>(upcomingEventsQuery).catch(() => []),
  sanityFetch<PastEvent[]>(pastEventsQuery).catch(() => []),
  sanityFetch<SpeakingStats>(speakingStatsQuery).catch(() => ({ ...FALLBACK_SPEAKER_STATS })),
  sanityFetch<TalkListItem[]>(allTalksQuery).catch(() => []),
  sanityFetch<SocialPost[]>(featuredSocialPostsQuery).catch(() => []),
  sanityFetch<Testimonial[]>(featuredTestimonialsQuery).catch(() => []),
  sanityFetch<SpeakerProfile | null>(speakerProfileQuery).catch(() => null),
]);

const upcomingCount = upcomingEvents.length;
const conferenceWall = topConferences(pastEvents);
const nextThree = upcomingEvents.slice(0, 3);

function talksFor(needles: string[], fallback: TalkListItem[]) {
  const hit = talks.filter((t) =>
    (t.topics || []).some((topic) => needles.some((n) => topic.toLowerCase().includes(n)))
  );
  return (hit.length ? hit : fallback).slice(0, 2);
}

const leftover = talks.slice();
const reactTalks = talksFor(['react', 'next'], leftover);
const paymentTalks = talksFor(['payment', 'fintech', 'money'], leftover.filter((t) => !reactTalks.includes(t)));
const dxTalks = talksFor(['experience', 'dx', 'tooling', 'workflow', 'performance'], leftover.filter((t) => !reactTalks.includes(t) && !paymentTalks.includes(t)));
const communityTalks = talksFor(['career', 'community', 'speaking', 'leadership'], leftover.filter((t) => !reactTalks.includes(t) && !paymentTalks.includes(t) && !dxTalks.includes(t)));

const topicBlocks = [
  { title: 'React and Next.js', desc: 'Performance and architecture at scale — React is home base, not a religion.', talks: reactTalks },
  { title: 'Payments and fintech', desc: 'Resilience and scaling money globally, from the systems I have shipped.', talks: paymentTalks },
  { title: 'Developer experience', desc: 'Tooling and workflows that make a team faster without making it fragile.', talks: dxTalks },
  { title: 'Career and community', desc: 'Growth, speaking, and building rooms people want to come back to.', talks: communityTalks },
].filter((block) => block.talks.length > 0 || talks.length === 0);

const quotes: { quote: string; author: string; handle?: string; role?: string; href?: string }[] =
  socialPosts.length > 0
    ? socialPosts.slice(0, 3).map((p) => ({
        quote: p.content,
        author: p.author,
        handle: p.authorHandle,
        role: p.authorRole,
        href: p.url,
      }))
    : testimonials.slice(0, 3).map((t) => ({
        quote: t.quote,
        author: t.author,
        role: [t.role, t.company].filter(Boolean).join(', '),
      }));

const shortBio =
  profile?.bioShort ||
  `Faris Aziz is a Staff Software Engineer and conference speaker based in Geneva. He has spoken at ${stats.totalEvents}+ events across ${stats.countries} countries, cofounded the award-winning ZurichJS community, and talks about resilient frontend systems and payment integrations.`;
---

<BaseLayout
  title="Speaking: Talks & Workshops | Faris Aziz"
  description={`Book Faris Aziz to speak: ${stats.totalEvents} talks across ${stats.countries} countries. Production-grade engineering, framework-agnostic, drawn from real case studies.`}
  pathname="/speaking"
  image="/og/speaking.png"
  markdownAlternate="/speaking.md"
>
  <header class="speaking-hero">
    <GridTexture />
    <div class="container speaking-hero__inner">
      <Kicker>Booking {bookingYears()}</Kicker>
      <h1 class="speaking-hero__title heading-sentence">Invite me to speak.</h1>
      <p class="speaking-hero__lead">
        I speak about production and scale: the pragmatic decisions and leadership calls behind real systems, drawn from case studies rather than theory. React and Next.js are home base, but I'm framework-agnostic at heart. What I actually care about is the web, incredible UX, and lifting up the engineers who build it.
      </p>
      <p class="ds-proof">
        <b>{stats.totalEvents}</b> events across <b>{stats.countries}</b> countries
        and <b>{stats.cities}</b> cities.
      </p>

      <div class="speaking-hero__actions">
        <a href="/invite" class="ds-btn ds-btn-primary ds-btn-lg">
          Invite me to speak
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="#book" class="ds-btn ds-btn-secondary ds-btn-lg">How booking works</a>
      </div>
    </div>
  </header>

  <section class="speaking-section">
    <div class="container wide">
      <div class="speaking-section__head">
        <h2 class="speaking-h2">What's next on the calendar.</h2>
        {upcomingCount > 0 && (
          <span class="ds-pill ds-pill--signal">
            <span class="ds-dot ds-dot--pulse"></span>
            {upcomingCount} confirmed
          </span>
        )}
      </div>

      {upcomingCount > 0 ? (
        <>
          <div class="events-list">
            {nextThree.map((e, i) => <EventRow event={e} index={i} />)}
          </div>
          <div class="speaking-events__toggle">
            <a href="/events" class="ds-btn ds-btn-secondary">
              View the full schedule
              <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </>
      ) : (
        <div class="speaking-empty">
          <p>No upcoming events confirmed yet. Check back soon, or invite me directly.</p>
          <a href="/invite" class="ds-btn ds-btn-primary" style="margin-top:1rem;">Invite me to speak</a>
        </div>
      )}
    </div>
  </section>

  <section class="speaking-section" id="about-talks">
    <div class="container">
      <Faq question="What do I speak about?">
        <p>Four lanes, all from work I have actually shipped. Each one links to a talk you can book.</p>
        {topicBlocks.map((block) => (
          <div class="speaking-topic-block">
            <h3 class="speaking-topic-block__title">{block.title}</h3>
            <p>{block.desc}</p>
            {block.talks.length > 0 && (
              <ul class="ds-faq__evidence">
                {block.talks.map((t) => (
                  <li>
                    <a href={`/talks/${t.slug}`}>{t.title}</a>
                    {t.latestEvent?.conference && <span> · {t.latestEvent.conference}</span>}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
        <p>
          <a href="/talks" class="ds-link">
            Browse the full catalogue
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </p>
      </Faq>

      {quotes.length > 0 && (
        <Faq question="What is a talk of mine like?" class="speaking-faq-follow">
          <p>I would rather you hear it from the room.</p>
          <div class="ds-quotes speaking-quotes">
            {quotes.map((q) => (
              <Quote quote={q.quote} author={q.author} handle={q.handle} role={q.role} href={q.href} />
            ))}
          </div>
        </Faq>
      )}

      <Faq question="How do you book me?" class="speaking-faq-follow anchor-target" id="book">
        <p>
          Email is slower than the form. Send the date, the city, the audience size, the topic you want, and how long the slot is. I reply within two days with a straight yes or no, and a number if the event needs one. Community meetups are usually on the house.
        </p>
        <p>
          <a href="/invite" class="ds-btn ds-btn-primary">
            Send an invite
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </p>
      </Faq>

      {shortBio && (
        <div class="speaking-faq-follow">
          <Bio text={shortBio} />
        </div>
      )}
    </div>
  </section>

  {conferenceWall.length > 0 && (
    <section class="speaking-section-sm">
      <div class="container">
        <p class="speaking-logos__label">Stages I've shared</p>
        <div class="speaking-logos">
          {conferenceWall.map((c) => <span>{c}</span>)}
        </div>
      </div>
    </section>
  )}

  <section class="speaking-section anchor-target" id="invite">
    <div class="container">
      <div class="wide ds-reveal">
        <ContactPanel
          status={`Booking ${bookingYears()} dates now`}
          title="Invite me to your event"
          body="Conferences, meetups, internal tech talks, workshops: tell me about your audience and I'll tailor a talk to fit. I reply within two days."
          primaryHref="/invite"
          primaryLabel="Send an invite"
          secondaryHref="/talks"
          secondaryLabel="Browse my talks"
        />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .speaking-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgb(var(--edge));
    padding-block: clamp(3.25rem, 7vw, 5.5rem);
  }
  .speaking-hero__inner { position: relative; }
  .speaking-hero__title { margin-top: 1.1rem; }
  .speaking-hero__lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgb(var(--ink-muted));
    max-width: 68ch;
    margin-top: 1.25rem;
  }
  .speaking-hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .speaking-section { padding-block: clamp(3.25rem, 7vw, 5.5rem); }
  .speaking-section-sm { padding-block: clamp(2.25rem, 5vw, 3.5rem); }
  .speaking-section__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.4rem;
  }
  .speaking-h2 {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: rgb(var(--ink));
  }

  .events-list { display: grid; gap: 0.2rem; }
  .speaking-events__toggle { text-align: center; margin-top: 1.6rem; }
  .speaking-empty {
    text-align: center;
    color: rgb(var(--ink-muted));
    padding: 3rem 1rem;
    border: 1px dashed rgb(var(--edge));
    border-radius: 14px;
  }

  .speaking-faq-follow { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .speaking-topic-block { margin-top: 1.4rem; }
  .speaking-topic-block__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.15rem;
    color: rgb(var(--ink));
    margin-bottom: 0.35rem;
  }
  .speaking-quotes { margin-top: 1.25rem; }

  .speaking-logos__label {
    text-align: center;
    margin-bottom: 1.4rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgb(var(--ink-muted));
  }
  .speaking-logos {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .speaking-logos span {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.05rem;
    color: rgb(var(--ink-muted));
  }
</style>
