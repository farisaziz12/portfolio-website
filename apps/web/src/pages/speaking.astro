---
/**
 * Speaking hub (V3 `Speaking.dc.html`): skewed hero, derived counts, the next
 * appearances, topic pillars, workshops + formats, stage quotes and the
 * cream invitation panel. Every number comes from session records.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SkewHero from '../components/v3/SkewHero.astro';
import Kicker from '../components/v3/Kicker.astro';
import StatRow from '../components/v3/StatRow.astro';
import UpcomingList from '../components/v3/UpcomingList.astro';
import PraiseCard from '../components/v3/PraiseCard.astro';
import InvitePanel from '../components/v3/InvitePanel.astro';
import PillarCards from '../components/speaking/PillarCards.astro';
import WorkshopsFormats from '../components/speaking/WorkshopsFormats.astro';
import {
  currentMonthYear,
  getAllPraise,
  getCatalogueTalks,
  getProfile,
  getSpeakingStats,
  getUpcomingEvents,
  getWorkshops,
} from '../lib/sanity/v3';
import { bookingYears } from '../lib/availability';
import { lengthRange } from '../lib/workshops-view';
import { breadcrumbs } from '../lib/seo';

const [profile, stats, upcomingAll, talks, workshops, praise] = await Promise.all([
  getProfile(),
  getSpeakingStats(),
  getUpcomingEvents(),
  getCatalogueTalks(),
  getWorkshops(),
  getAllPraise(),
]);

const photo = profile.photos.find((p) => p.tag === 'speaking' || p.tag === 'portrait') ?? profile.photos[0];
const workshopPhoto = profile.photos.find((p) => p.tag === 'workshop');
const upcoming = upcomingAll.filter((e) => e.buckets.some((b) => b !== 'attended'));
const bookableWorkshops = workshops.filter((w) => w.isBookable);

// "two working days" → "2 days"; anything else is shown as written.
const reply = /\btwo\b/i.test(profile.replyTime) ? '2 days' : profile.replyTime;

const stats4 = [
  { value: stats.talksDelivered, label: 'talks delivered', meta: `from session records, ${currentMonthYear()}` },
  { value: stats.countries, label: 'countries', meta: 'speaking and hosting' },
  { value: bookableWorkshops.length || stats.catalogueWorkshops, label: 'workshops', meta: lengthRange(bookableWorkshops) || undefined },
  { value: reply, label: 'to reply to an invitation' },
];

// "On stage": one quote about a talk, one about the stage presence.
const onTalk = praise.find((p) => p.topic === 'talk');
const onStage = praise.find((p) => p.topic === 'stage' && p !== onTalk);
const quotes = [onTalk, onStage, ...praise.filter((p) => p.topic === 'stage' || p.topic === 'talk')]
  .filter((p, i, a): p is NonNullable<typeof p> => Boolean(p) && a.indexOf(p) === i)
  .slice(0, 2);

const description = `Talks and workshops on production engineering, payments at scale and leadership. ${stats.talksDelivered} talks delivered in ${stats.countries} countries.`;
---

<BaseLayout
  title="Speaking"
  description={description}
  image="/og/speaking.png"
  markdownAlternate="/speaking.md"
  band={false}
  extraSchema={[breadcrumbs([{ name: 'Speaking', path: '/speaking' }])]}
>
  <SkewHero image={photo} imageAlt={photo?.alt ?? 'Faris speaking on stage'} height={520} bandWidth={50}>
    <Kicker parts={['Speaking', `Booking ${bookingYears()}`]} />
    <h1 class="ds-h1">Production stories, told from the inside.</h1>
    <p class="ds-lede hero__lede">
      Talks and workshops about scale, resilience, payments and the leadership calls behind real systems. React and Next.js are home base; the lessons aren't framework-specific. Every talk is adapted to its audience.
    </p>
    <div class="hero__actions">
      <a href="/invite" class="ds-btn ds-btn--cream ds-btn--lg" data-track="speaking-hero-invite">Invite me to speak</a>
      <a href="/talks" class="ds-link hero__link" data-track="speaking-hero-talks">Browse the talks</a>
    </div>
  </SkewHero>

  <StatRow stats={stats4} />

  {upcoming.length > 0 && (
    <section class="next" aria-labelledby="next-title">
      <span class="next__edge" aria-hidden="true"></span>
      <div class="ds-wrap next__wrap">
        <div class="next__head">
          <p class="ds-kicker">Next on the calendar</p>
          <h2 id="next-title" class="next__title">Come and say hello.</h2>
          <a href="/events" class="ds-link ds-link--sm next__link">Full schedule and archive</a>
        </div>
        <UpcomingList events={upcoming} limit={4} />
      </div>
    </section>
  )}

  <PillarCards pillars={profile.topicPillars} talks={talks} />

  <WorkshopsFormats workshops={bookableWorkshops} formats={profile.formats} photo={workshopPhoto} />

  <section class="ds-wrap close">
    {quotes.length > 0 && (
      <div class="close__quotes">
        {quotes.map((p) => <PraiseCard praise={p} />)}
      </div>
    )}
    <InvitePanel
      headline="Tell me about your event."
      body={`Three required fields. I reply within ${profile.replyTime}. Community meetups are usually on the house.`}
      primary={{ label: 'Invite me', href: '/invite' }}
      secondary={{ label: 'Press kit', href: '/press-kit' }}
      track="speaking-invite-panel"
    />
  </section>
</BaseLayout>

<style>
  .hero__lede { font-size: 17px; max-width: 44ch; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .hero__link { min-height: 44px; box-sizing: border-box; padding: 12px 2px 9px; font-size: 15px; }

  .next { position: relative; padding-block: 56px; }
  .next__edge { position: absolute; left: 0; top: 56px; bottom: 56px; width: 16px; background: linear-gradient(90deg, rgb(var(--yellow)) 0 12px, rgb(var(--blue)) 12px 16px); }
  .next__wrap { display: grid; grid-template-columns: minmax(0, 400px) minmax(0, 1fr); gap: 48px; padding-left: calc(var(--gutter) + 16px); }
  .next__head { display: flex; flex-direction: column; align-items: flex-start; }
  .next__title { margin-top: 10px; font-size: clamp(28px, 3.2vw, 36px); line-height: 0.98; letter-spacing: -0.04em; font-weight: 800; }
  .next__link { margin-top: 16px; }

  .close { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding-bottom: 64px; align-items: stretch; }
  .close__quotes { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

  @media (max-width: 900px) {
    .close { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 720px) {
    .next { padding-block: 40px; }
    .next__edge { top: 40px; bottom: 40px; width: 8px; background: rgb(var(--yellow)); }
    .next__wrap { grid-template-columns: 1fr; gap: 20px; padding-left: calc(var(--gutter) + 6px); }
  }
  @media (max-width: 560px) {
    .close__quotes { grid-template-columns: 1fr; }
  }
</style>
