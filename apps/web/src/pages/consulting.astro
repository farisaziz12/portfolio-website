---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import GridTexture from '../components/design/GridTexture.astro';
import IconChip from '../components/design/IconChip.astro';
import ContactPanel from '../components/design/ContactPanel.astro';
import ServiceOfferCard from '../components/services/ServiceOfferCard.astro';
import { sanityFetch } from '../lib/sanity/client';
import { consultingOffersQuery } from '../lib/sanity/queries';
import { availabilityLabel } from '../lib/availability';
import type { ServiceOffer } from '../lib/sanity/types';


const offers = await sanityFetch<ServiceOffer[]>(consultingOffersQuery).catch(() => []);

const expertise = [
  {
    title: 'React & Next.js',
    desc: 'Component architecture, rendering strategy, performance budgets — production patterns at scale.',
    icon: '<circle cx="12" cy="12" r="2.2"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>',
  },
  {
    title: 'Payment systems',
    desc: 'Orchestration, resilience, region-aware checkout flows that actually convert.',
    icon: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  },
  {
    title: 'Architecture',
    desc: 'Module boundaries, monorepos, micro-frontends — designed to evolve.',
    icon: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  },
  {
    title: 'Developer experience',
    desc: 'Build tooling, CI/CD discipline, testing strategies that scale teams.',
    icon: '<path d="M4.5 16.5 3 21l4.5-1.5M14 6l4 4M9.5 14.5 16 8a3.5 3.5 0 0 0 0-5 3.5 3.5 0 0 0-5 0l-6.5 6.5"/>',
  },
  {
    title: 'Performance',
    desc: 'Core Web Vitals, bundle optimization, caching that holds under real traffic.',
    icon: '<path d="M3 17l6-6 4 4 8-8"/><path d="M21 7v5h-5"/>',
  },
  {
    title: 'Engineering leadership',
    desc: 'Leading teams without losing the plot technically — mentoring, hiring, and scaling squads.',
    icon: '<circle cx="9" cy="8" r="3"/><path d="M3 19a6 6 0 0 1 12 0M16 7a3 3 0 0 1 0 6M18.5 19a5 5 0 0 0-3-4.6"/>',
  },
];

const audiences = [
  {
    title: 'Startup founders',
    items: ['Architecture decisions before they bite', "Pragmatic tech choices that won't trap you", 'Hiring & team scaling advice'],
  },
  {
    title: 'Engineering teams',
    items: ['Architecture reviews & audits', 'Performance optimisation', 'Workshop-style enablement'],
  },
  {
    title: 'Tech leaders',
    items: ['Frontend strategy & roadmaps', 'Mentoring senior engineers', 'Cross-team alignment'],
  },
  {
    title: 'Agencies',
    items: ['Specialist support on payments / React', 'Code review at scale', 'Architecture handoffs'],
  },
];
---

<BaseLayout
  title="Consulting | Faris Aziz"
  description="Technical consulting for teams and startups. Architecture reviews, technical strategy, and hands-on implementation."
  pathname="/consulting"
  image="/og/consulting.png"
  markdownAlternate="/consulting.md"
  extraSchema={[
    {
      '@type': 'Service',
      name: 'Technical consulting',
      serviceType: 'Software engineering consulting',
      description:
        'Architecture reviews, performance optimization, technical strategy, and hands-on implementation support for teams and startups — specializing in React, Next.js, and payment systems.',
      provider: { '@id': 'https://faziz-dev.com/#person' },
      areaServed: 'Worldwide',
      url: 'https://faziz-dev.com/consulting',
    },
  ]}
>
  <header class="page-hero">
    <GridTexture />
    <div class="container page-hero__inner">
      <nav class="page-crumbs" aria-label="Breadcrumb">
        <a href="/services">Services</a>
        <span class="page-crumbs__sep">/</span>
        <span class="page-crumbs__cur">Consulting</span>
      </nav>
      <Kicker>Consulting · for teams & startups</Kicker>
      <h1 class="page-hero__title">
        Let's get your team <span class="accent-word">unstuck</span>.
      </h1>
      <p class="page-hero__lead">
        Architecture reviews, technical strategy, hands-on pairing — whatever the problem actually needs. I've spent a decade on systems where a dropped request means lost money, so chances are I've seen a version of your fire before.
      </p>
      <div class="page-hero__actions">
        <a href="#offers" class="ds-btn ds-btn-primary ds-btn-lg">
          View offers
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="https://cal.com/farisaziz12/discovery-call" target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-secondary ds-btn-lg">Book a discovery call</a>
      </div>
    </div>
  </header>

  <section class="page-section">
    <div class="container">
      <div class="page-section__heading">
        <Kicker class="ds-reveal">Areas of expertise</Kicker>
        <h2 class="page-h2 ds-reveal">Stuff I've <span class="mark">actually shipped</span></h2>
      </div>
      <div class="workshop-topics wide">
        {expertise.map((e) => (
          <div class="ds-card workshop-topic ds-reveal">
            <IconChip>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={e.icon} />
            </IconChip>
            <h3 class="workshop-topic__title">{e.title}</h3>
            <p class="workshop-topic__desc">{e.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="offers" class="page-section page-section--alt">
    <div class="container">
      <div class="page-section__heading">
        <Kicker class="ds-reveal">The packages</Kicker>
        <h2 class="page-h2 ds-reveal">Engagement formats</h2>
        <p class="page-hero__lead" style="margin-inline:auto;text-align:center;">From a one-time architecture review to ongoing advisory — pick what fits the work.</p>
      </div>
      {offers.length > 0 ? (
        <div class="page-grid-2 wide">
          {offers.map((offer) => <ServiceOfferCard offer={offer} />)}
        </div>
      ) : (
        <div class="page-empty">
          <h3>Coming soon</h3>
          <p>Consulting packages will appear here once content is added.</p>
          <a href="https://cal.com/farisaziz12/discovery-call" target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn-primary" style="margin-top:1rem;">Book a discovery call</a>
        </div>
      )}
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="page-section__heading">
        <Kicker class="ds-reveal">Who this is for</Kicker>
        <h2 class="page-h2 ds-reveal">Who I work <span class="mark">best with</span></h2>
      </div>
      <div class="page-grid-2 wide">
        {audiences.map((a) => (
          <div class="ds-card consulting-audience ds-reveal">
            <h3 class="consulting-audience__title">{a.title}</h3>
            <ul class="event-list">
              {a.items.map((it) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12l5 5 9-11" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section page-section--contact">
    <div class="container">
      <div class="wide ds-reveal">
        <ContactPanel
          status={availabilityLabel('Available')}
          title="Tell me what's slowing you down"
          body="Free 20-minute call. You describe the problem, I tell you honestly whether I can help — and if I can't, I'll point you at someone who can. No pitch."
          primaryHref="https://cal.com/farisaziz12/discovery-call"
          primaryLabel="Book a free call"
          secondaryHref={null}
        />
        <p class="ds-crosslink">Want me at your event instead? <a href="/invite" class="ds-link">Invite me to speak</a> — or <a href="/mentorship" class="ds-link">get mentored 1:1</a>.</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* workshop-topics / workshop-topic styles are already defined on /workshops index;
     we re-use the same names here for visual consistency. Inline a fallback in case the user
     navigates straight to /consulting and that page's styles aren't loaded — Astro scopes,
     so we redeclare. */
  .workshop-topics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 1024px) { .workshop-topics { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .workshop-topics { grid-template-columns: 1fr; } }
  .workshop-topic {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .workshop-topic__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1rem;
    color: rgb(var(--ink));
    margin-top: 0.5rem;
  }
  .workshop-topic__desc {
    font-size: 0.86rem;
    color: rgb(var(--ink-muted));
    line-height: 1.5;
  }

  .consulting-audience {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .consulting-audience__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.15rem;
    color: rgb(var(--ink));
  }
  .event-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .event-list li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    color: rgb(var(--ink-muted));
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .event-list svg {
    width: 18px;
    height: 18px;
    color: rgb(var(--signal));
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
</style>
