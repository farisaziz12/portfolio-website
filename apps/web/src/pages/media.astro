---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import GridTexture from '../components/design/GridTexture.astro';
import ContactPanel from '../components/design/ContactPanel.astro';
import { sanityFetch, urlFor } from '../lib/sanity/client';
import { allMediaQuery } from '../lib/sanity/queries';
import { formatDate } from 'shared/utils';

interface MediaItem {
  _id: string;
  title?: string;
  type: string;
  image?: any;
  videoUrl?: string;
  date?: string;
  location?: { city?: string; country?: string };
  description?: string;
  event?: { _id: string; title: string; slug: string };
  credit?: string;
  featured?: boolean;
}

const media = await sanityFetch<MediaItem[]>(allMediaQuery).catch(() => []);

const photos = media.filter((m) => m.type === 'photo');
const videos = media.filter((m) => m.type === 'video');
const press = media.filter((m) => m.type === 'press');
---

<BaseLayout
  title="Media | Faris Aziz"
  description="Photos, videos, and press coverage from Faris Aziz's speaking engagements at conferences and meetups around the world."
  pathname="/media"
  image="/og/media.png"
>
  <header class="page-hero">
    <GridTexture />
    <div class="container page-hero__inner">
      <Kicker>Gallery</Kicker>
      <h1 class="page-hero__title">
        Photos, videos, and <span class="accent-word">press</span>.
      </h1>
      <p class="page-hero__lead">
        Visual record from conferences, meetups, and speaking engagements around the world. Free for organizers and press to use — credit appreciated.
        Looking for bios and headshots? They're in the <a href="/press-kit" class="ds-link">press kit</a>.
      </p>

      <div class="page-hero__stats">
        <div>
          <div class="ds-stat__value ds-stat__value--sm">{photos.length}</div>
          <div class="ds-stat__label">Photos</div>
        </div>
        <div>
          <div class="ds-stat__value ds-stat__value--sm">{videos.length}</div>
          <div class="ds-stat__label">Videos</div>
        </div>
        <div>
          <div class="ds-stat__value ds-stat__value--sm">{press.length}</div>
          <div class="ds-stat__label">Press</div>
        </div>
      </div>
    </div>
  </header>

  {media.length === 0 ? (
    <section class="page-section">
      <div class="container">
        <div class="page-empty">
          <h3>Coming soon</h3>
          <p>Media will appear here once content is added to Sanity.</p>
        </div>
      </div>
    </section>
  ) : (
    <>
      {/* VIDEOS */}
      {videos.length > 0 && (
        <section class="page-section">
          <div class="container">
            <div class="page-section__head">
              <div>
                <Kicker>Watch</Kicker>
                <h2 class="page-h2">Talk recordings</h2>
              </div>
              <span class="ds-pill">{videos.length}</span>
            </div>
            <div class="page-grid-3">
              {videos.map((m) => {
                const thumb = m.image ? urlFor(m.image).width(800).height(450).quality(90).url() : null;
                const Tag = m.videoUrl ? 'a' : 'div';
                const linkAttrs = m.videoUrl
                  ? { href: m.videoUrl, target: '_blank', rel: 'noopener noreferrer' }
                  : {};
                return (
                  <Tag {...linkAttrs} class:list={['ds-card', 'media-card', 'ds-reveal', { 'ds-card-interactive': !!m.videoUrl }]}>
                    <div class="media-card__media">
                      {thumb ? (
                        <img src={thumb} alt={m.title || 'Talk recording'} loading="lazy" />
                      ) : (
                        <div class="media-card__placeholder"><span class="ds-tag">Video</span></div>
                      )}
                      {m.videoUrl && (
                        <div class="media-card__play" aria-hidden="true">
                          <span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
                        </div>
                      )}
                    </div>
                    <div class="media-card__body">
                      <h3 class="media-card__title">{m.title || 'Untitled'}</h3>
                      {m.event?.title && <p class="media-card__event">{m.event.title}</p>}
                      <div class="media-card__meta">
                        {m.date && <span>{formatDate(m.date, { month: 'short', year: 'numeric' })}</span>}
                        {m.credit && <span>· {m.credit}</span>}
                      </div>
                    </div>
                  </Tag>
                );
              })}
            </div>
          </div>
        </section>
      )}

      {/* PHOTOS */}
      {photos.length > 0 && (
        <section class="page-section page-section--alt">
          <div class="container">
            <div class="page-section__head">
              <div>
                <Kicker>On stage</Kicker>
                <h2 class="page-h2">Photos</h2>
                <p class="media-gallery-link"><a href="/gallery" class="ds-link">Walk through the full gallery, event by event
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
              </div>
              <span class="ds-pill">{photos.length}</span>
            </div>
            <div class="photos-grid">
              {photos.map((m) => {
                const img = m.image ? urlFor(m.image).width(800).height(800).quality(90).url() : null;
                const fullImg = m.image ? urlFor(m.image).width(2400).quality(95).url() : null;
                if (!img) return null;
                return (
                  <a
                    href={fullImg || img}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="photos-grid__item ds-reveal"
                    aria-label={m.title || 'Photo'}
                  >
                    <img src={img} alt={m.title || m.description || 'Speaking photo'} loading="lazy" />
                    {(m.title || m.event?.title) && (
                      <div class="photos-grid__caption">
                        {m.title && <b>{m.title}</b>}
                        {m.event?.title && <span>{m.event.title}</span>}
                      </div>
                    )}
                  </a>
                );
              })}
            </div>
            <p class="photos-grid__note">Tap any photo to open the full-resolution version in a new tab. All photos free to use with credit — tag me on Bluesky or LinkedIn so I can share back.</p>
          </div>
        </section>
      )}

      {/* PRESS */}
      {press.length > 0 && (
        <section class="page-section">
          <div class="container">
            <div class="page-section__head">
              <div>
                <Kicker>In the press</Kicker>
                <h2 class="page-h2">Coverage</h2>
              </div>
              <span class="ds-pill">{press.length}</span>
            </div>
            <div class="page-grid-3">
              {press.map((m) => {
                const img = m.image ? urlFor(m.image).width(600).height(340).quality(90).url() : null;
                const Tag = m.videoUrl ? 'a' : 'div';
                const linkAttrs = m.videoUrl
                  ? { href: m.videoUrl, target: '_blank', rel: 'noopener noreferrer' }
                  : {};
                return (
                  <Tag {...linkAttrs} class:list={['ds-card', 'media-card', 'ds-reveal', { 'ds-card-interactive': !!m.videoUrl }]}>
                    {img && (
                      <div class="media-card__media">
                        <img src={img} alt={m.title || 'Press'} loading="lazy" />
                      </div>
                    )}
                    <div class="media-card__body">
                      <span class="ds-tag" style="margin-bottom:0.6rem;">Press</span>
                      <h3 class="media-card__title">{m.title || 'Untitled'}</h3>
                      {m.description && <p class="media-card__desc">{m.description}</p>}
                      <div class="media-card__meta">
                        {m.date && <span>{formatDate(m.date, { month: 'short', year: 'numeric' })}</span>}
                        {m.credit && <span>· {m.credit}</span>}
                      </div>
                    </div>
                  </Tag>
                );
              })}
            </div>
          </div>
        </section>
      )}
    </>
  )}

  <section class="page-section page-section--contact">
    <div class="container">
      <div class="wide ds-reveal">
        <ContactPanel
          status="Need pro shots?"
          title="Need professional photos at your event?"
          body="Happy to coordinate a photographer at conferences. Just tell me where to send them — and tag me if you publish anything."
          primaryHref="/invite"
          primaryLabel="Invite me to your event"
          secondaryHref={null}
        />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .media-gallery-link { margin-top: 0.5rem; font-size: 0.92rem; }
  .media-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .media-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: rgb(var(--surface-3));
    overflow: hidden;
    border-bottom: 1px solid rgb(var(--edge));
  }
  .media-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  /* Zoom only on cards that are actually links (ds-card-interactive is gated
     on videoUrl above) — a plain div card shouldn't imply a click. */
  .media-card.ds-card-interactive:hover .media-card__media img { transform: scale(1.04); }
  .media-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--ink-faint));
  }
  .media-card__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .media-card__play span {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: rgba(10, 12, 16, 0.55);
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .media-card__play svg {
    width: 22px;
    height: 22px;
    color: #fff;
    margin-left: 3px;
  }
  .media-card__body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }
  .media-card__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1rem;
    color: rgb(var(--ink));
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .media-card__event {
    font-size: 0.85rem;
    color: rgb(var(--ink-muted));
  }
  .media-card__desc {
    font-size: 0.86rem;
    color: rgb(var(--ink-muted));
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .media-card__meta {
    display: flex;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.7rem;
    color: rgb(var(--ink-faint));
    letter-spacing: 0.04em;
  }

  .photos-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 1024px) { .photos-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 720px) { .photos-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 440px) { .photos-grid { grid-template-columns: 1fr; } }
  .photos-grid__item {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow: hidden;
    background: rgb(var(--surface-3));
    border: 1px solid rgb(var(--edge));
    display: block;
    color: inherit;
  }
  .photos-grid__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .photos-grid__item:hover img { transform: scale(1.05); }
  .photos-grid__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.7rem 0.9rem;
    background: linear-gradient(180deg, transparent, rgba(10, 12, 16, 0.78));
    color: #fff;
    transform: translateY(8px);
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
  }
  .photos-grid__item:hover .photos-grid__caption {
    opacity: 1;
    transform: translateY(0);
  }
  .photos-grid__caption b {
    display: block;
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .photos-grid__caption span {
    font-size: 0.8rem;
    color: rgb(var(--ink-muted));
  }
  .photos-grid__note {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: rgb(var(--ink-faint));
    text-align: center;
  }
</style>
