---
/**
 * /services/[slug]: CMS-driven SEO landing pages (serviceLandingPage), restyled
 * to V3. Same content and section order as before; every section is optional.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/v3/Kicker.astro';
import SectionHead from '../../components/v3/SectionHead.astro';
import StatRow from '../../components/v3/StatRow.astro';
import InvitePanel from '../../components/v3/InvitePanel.astro';
import LandingCards from '../../components/services/LandingCards.astro';
import { getServiceLandingPages, getServiceLandingPage } from '../../lib/secondary-content';
import { urlFor } from '../../lib/sanity/client';
import { breadcrumbs, SITE } from '../../lib/seo';

export async function getStaticPaths() {
  const pages = await getServiceLandingPages();
  return pages.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params as { slug: string };
const page = await getServiceLandingPage(slug);
if (!page) return Astro.redirect('/services');

let ogImage = '/og/services.png';
try {
  if (page.ogImage?.asset) ogImage = urlFor(page.ogImage).width(1200).height(630).fit('crop').url();
} catch {}

const primary = page.heroPrimaryCta?.url ? { label: page.heroPrimaryCta.text || 'Get in touch', href: page.heroPrimaryCta.url } : undefined;
const secondary = page.heroSecondaryCta?.url ? { label: page.heroSecondaryCta.text || 'Learn more', href: page.heroSecondaryCta.url } : undefined;
const ctaHref = page.ctaButtonUrl || primary?.href || '/contact';
const ext = (href: string) => (/^https?:\/\//.test(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {});

const schema = [
  {
    '@type': 'Service',
    '@id': `${SITE}/services/${page.slug}#service`,
    name: page.heroHeadline,
    ...(page.seoDescription || page.heroSubheadline ? { description: page.seoDescription || page.heroSubheadline } : {}),
    provider: { '@id': `${SITE}/#person` },
    areaServed: 'Worldwide',
    url: `${SITE}/services/${page.slug}`,
  },
  ...(page.faqs.length
    ? [
        {
          '@type': 'FAQPage',
          mainEntity: page.faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
        },
      ]
    : []),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    { name: page.title || page.heroHeadline, path: `/services/${page.slug}` },
  ]),
];
---

<BaseLayout
  title={page.seoTitle || `${page.heroHeadline} | Faris Aziz`}
  description={(page.seoDescription || page.heroSubheadline || page.heroHeadline).slice(0, 160)}
  image={ogImage}
  markdownAlternate={`/services/${page.slug}.md`}
  extraSchema={schema}
>
  <div class="ds-wrap">
    <header class="head">
      <Kicker parts={['Services', page.heroTagline]} mutedFirst />
      <h1 class="ds-h1">{page.heroHeadline}</h1>
      {page.heroSubheadline && <p class="ds-lede">{page.heroSubheadline}</p>}
      {(primary || secondary) && (
        <div class="head__actions">
          {primary && <a href={primary.href} class="ds-btn ds-btn--yellow ds-btn--lg" data-track={`landing-${page.slug}-primary`} {...ext(primary.href)}>{primary.label}</a>}
          {secondary && <a href={secondary.href} class="ds-link" data-track={`landing-${page.slug}-secondary`} {...ext(secondary.href)}>{secondary.label}</a>}
        </div>
      )}
    </header>

    <LandingCards id="l-problem" title={page.problemTitle} fallbackTitle="Sound familiar?" items={page.painPoints} variant="rows" />
    <LandingCards id="l-expertise" title={page.expertiseTitle} fallbackTitle="Where I can help" items={page.expertiseAreas} />

    {page.serviceOfferings.length > 0 && (
      <section class="sec" aria-labelledby="l-services">
        <SectionHead id="l-services" title={page.servicesTitle || 'Ways to work together'} size="sm" />
        <ul class="ds-grid-2 offers" role="list">
          {page.serviceOfferings.map((o, i) => (
            <li class="ds-card offer">
              <span class="offer__n ds-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="offer__title">{o.name}</h3>
              <dl class="offer__dl">
                {o.bestFor && (<><dt>Best for</dt><dd>{o.bestFor}</dd></>)}
                {o.includes && o.includes.length > 0 && (
                  <>
                    <dt>Includes</dt>
                    <dd><ul class="offer__list">{o.includes.map((x) => <li>{x}</li>)}</ul></dd>
                  </>
                )}
                {o.outcome && (<><dt>You get</dt><dd class="offer__outcome">{o.outcome}</dd></>)}
              </dl>
            </li>
          ))}
        </ul>
      </section>
    )}

    <LandingCards id="l-audience" title={page.audienceTitle} fallbackTitle="Who this is for" items={page.personas} variant="grid-2" />

    {(page.stats.length > 0 || page.testimonials.length > 0) && (
      <section class="sec sec--proof" aria-labelledby="l-proof">
        <SectionHead id="l-proof" title={page.proofTitle || 'Track record'} size="sm" />
      </section>
    )}
  </div>

  {page.stats.length > 0 && <StatRow stats={page.stats.map((s) => ({ value: s.value, label: s.label }))} />}

  <div class="ds-wrap">
    {page.testimonials.length > 0 && (
      <ul class="ds-grid-2 quotes" role="list">
        {page.testimonials.map((t) => (
          <li class="ds-card">
            <figure class="ds-stripe quote">
              <blockquote class="quote__text">“{t.quote}”</blockquote>
              <figcaption class="ds-meta">{[t.author, [t.role, t.company].filter(Boolean).join(' at ')].filter(Boolean).join(' · ')}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}

    {page.faqs.length > 0 && (
      <section class="sec" aria-labelledby="l-faq">
        <SectionHead id="l-faq" title={page.faqTitle || 'Questions'} size="sm" />
        <ul class="ds-rows faq">
          {page.faqs.map((f) => (
            <li>
              <details class="faq__item">
                <summary class="faq__q">{f.question}</summary>
                <p class="faq__a">{f.answer}</p>
              </details>
            </li>
          ))}
        </ul>
      </section>
    )}

    <InvitePanel
      class="panel"
      kicker="Services"
      headline={page.ctaHeadline || 'Tell me what’s going on.'}
      body={page.ctaSubheadline || 'A sentence is enough to start. I reply within two working days.'}
      primary={{ label: page.ctaButtonText || 'Get in touch', href: ctaHref }}
      secondary={{ label: 'All services', href: '/services' }}
      note={page.ctaSecondaryText}
      art="faris-thinking"
      track={`landing-${page.slug}-panel`}
    />
  </div>
</BaseLayout>

<style>
  .head { display: flex; flex-direction: column; gap: 14px; padding-block: clamp(32px, 5vw, 56px) clamp(32px, 5vw, 48px); max-width: 820px; }
  .head__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 8px; }
  .sec { padding-block: clamp(32px, 5vw, 48px); border-top: 1px solid rgb(var(--hairline)); }
  .sec--proof { padding-bottom: 0; }
  .sec--proof :global(.shead) { margin-bottom: 22px; }

  .offers { margin: 0; padding: 0; list-style: none; }
  .offer { display: flex; flex-direction: column; gap: 12px; height: 100%; }
  .offer__n { font-size: 40px; line-height: 1; color: rgb(var(--accent-text)); }
  .offer__title { font-size: clamp(22px, 2.3vw, 26px); line-height: 1.05; letter-spacing: -0.035em; font-weight: 800; }
  .offer__dl { margin: 0; display: grid; gap: 4px; font-size: 15px; line-height: 1.55; }
  .offer__dl dt { font-size: 11.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--text-faint)); }
  .offer__dl dd { margin: 0 0 10px; color: rgb(var(--text-muted)); }
  .offer__dl .offer__outcome { color: rgb(var(--text)); font-weight: 600; }
  .offer__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  .offer__list li { position: relative; padding-left: 16px; }
  .offer__list li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 7px; height: 7px; background: rgb(var(--yellow)); border-radius: 1px; }

  .quotes { margin: 0; padding: clamp(24px, 4vw, 36px) 0 clamp(32px, 5vw, 48px); list-style: none; }
  .quote { margin: 0; }
  .quote__text { margin: 0 0 10px; font-size: 16px; line-height: 1.5; color: rgb(var(--text)); }

  .faq__item { padding-block: 4px; }
  .faq__q {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; align-items: center;
    min-height: 44px; padding-block: 14px; font-size: 17px; font-weight: 700; letter-spacing: -0.01em;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after { content: '+'; flex: none; font-size: 22px; font-weight: 700; color: rgb(var(--accent-text)); }
  .faq__item[open] .faq__q::after { content: '−'; }
  .faq__q:hover { color: rgb(var(--accent-text)); }
  .faq__a { margin: 0 0 18px; max-width: 70ch; font-size: 15.5px; line-height: 1.6; color: rgb(var(--text-muted)); }
  .ds-wrap :global(.panel) { margin-block: clamp(24px, 4vw, 40px) clamp(40px, 5vw, 64px); }
</style>
