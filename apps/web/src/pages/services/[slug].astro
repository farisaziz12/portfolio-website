---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollReveal from '../../components/animations/ScrollReveal.astro';
import Kicker from '../../components/design/Kicker.astro';
import GridTexture from '../../components/design/GridTexture.astro';
import { sanityFetch, urlFor } from '../../lib/sanity/client';
import {
  allServiceLandingPagesQuery,
  serviceLandingPageBySlugQuery,
} from '../../lib/sanity/queries';

// Types
interface ServiceLandingPage {
  _id: string;
  title: string;
  slug: string;
  seoTitle?: string;
  seoDescription?: string;
  seoKeywords?: string[];
  ogImage?: any;
  heroTagline?: string;
  heroHeadline: string;
  heroSubheadline?: string;
  heroPrimaryCta?: { text: string; url: string };
  heroSecondaryCta?: { text: string; url: string };
  problemTitle?: string;
  painPoints?: Array<{ _key: string; title: string; description: string }>;
  expertiseTitle?: string;
  expertiseAreas?: Array<{ _key: string; title: string; description: string; icon?: string }>;
  servicesTitle?: string;
  serviceOfferings?: Array<{
    _key: string;
    name: string;
    bestFor?: string;
    includes?: string[];
    outcome?: string;
    highlightColor?: string;
  }>;
  audienceTitle?: string;
  personas?: Array<{ _key: string; title: string; description: string; icon?: string }>;
  proofTitle?: string;
  stats?: Array<{ _key: string; value: string; label: string }>;
  testimonials?: Array<{
    _id: string;
    quote: string;
    author: string;
    role?: string;
    company?: string;
    avatar?: any;
  }>;
  faqTitle?: string;
  faqs?: Array<{ _key: string; question: string; answer: string }>;
  ctaHeadline?: string;
  ctaSubheadline?: string;
  ctaButtonText?: string;
  ctaButtonUrl?: string;
  ctaSecondaryText?: string;
}

// Generate static paths
export async function getStaticPaths() {
  const pages = await sanityFetch<Array<{ slug: string }>>(allServiceLandingPagesQuery);
  return pages.map((page) => ({
    params: { slug: page.slug },
  }));
}

const { slug } = Astro.params;
const page = await sanityFetch<ServiceLandingPage>(serviceLandingPageBySlugQuery, { slug });

if (!page) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={page.seoTitle || page.heroHeadline}
  description={page.seoDescription || page.heroSubheadline}
  pathname={`/services/${page.slug}`}
  image={page.ogImage ? urlFor(page.ogImage).width(1200).height(630).url() : undefined}
>
  <!-- Hero Section -->
  <header class="page-hero">
    <GridTexture />
    <div class="container page-hero__inner">
      {page.heroTagline && (
        <ScrollReveal animation="fade-up">
          <Kicker>{page.heroTagline}</Kicker>
        </ScrollReveal>
      )}

      <ScrollReveal animation="fade-up" delay={0.1}>
        <h1 class="page-hero__title">
          {page.heroHeadline}
        </h1>
      </ScrollReveal>

      {page.heroSubheadline && (
        <ScrollReveal animation="fade-up" delay={0.2}>
          <p class="page-hero__lead">
            {page.heroSubheadline}
          </p>
        </ScrollReveal>
      )}

      <ScrollReveal animation="fade-up" delay={0.3}>
        <div class="page-hero__actions">
          {page.heroPrimaryCta && (
            <a href={page.heroPrimaryCta.url} class="ds-btn ds-btn-primary ds-btn-lg">
              {page.heroPrimaryCta.text}
              <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          )}
          {page.heroSecondaryCta && (
            <a href={page.heroSecondaryCta.url} class="ds-btn ds-btn-secondary ds-btn-lg">
              {page.heroSecondaryCta.text}
            </a>
          )}
        </div>
      </ScrollReveal>
    </div>
  </header>

  <!-- Problem Section -->
  {page.painPoints && page.painPoints.length > 0 && (
    <section class="page-section page-section--alt">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          {page.problemTitle && (
            <ScrollReveal animation="fade-up">
              <div class="page-section__heading">
                <h2 class="page-h2">{page.problemTitle}</h2>
              </div>
            </ScrollReveal>
          )}

          <div class="space-y-6">
            {page.painPoints.map((point, index) => (
              <ScrollReveal animation="fade-up" delay={index * 0.1}>
                <div class="ds-card p-8 border-l-4 border-l-danger/50">
                  <h3 class="font-display font-bold text-xl text-ink mb-3">{point.title}</h3>
                  <p class="text-ink-muted leading-relaxed">{point.description}</p>
                </div>
              </ScrollReveal>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Expertise Section -->
  {page.expertiseAreas && page.expertiseAreas.length > 0 && (
    <section class="page-section">
      <div class="container">
        {page.expertiseTitle && (
          <ScrollReveal animation="fade-up">
            <div class="page-section__heading">
              <h2 class="page-h2">{page.expertiseTitle}</h2>
            </div>
          </ScrollReveal>
        )}

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {page.expertiseAreas.map((area, index) => (
            <ScrollReveal animation="fade-up" delay={index * 0.1}>
              <div class="ds-card p-8 h-full">
                {area.icon && (
                  <div class="w-12 h-12 rounded-md bg-accent/10 border border-accent/30 flex items-center justify-center mb-6">
                    <span class="text-2xl">{area.icon}</span>
                  </div>
                )}
                <h3 class="font-display font-bold text-lg text-ink mb-3">{area.title}</h3>
                <p class="text-ink-muted text-sm leading-relaxed">{area.description}</p>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Services Section -->
  {page.serviceOfferings && page.serviceOfferings.length > 0 && (
    <section class="page-section page-section--alt">
      <div class="container">
        {page.servicesTitle && (
          <ScrollReveal animation="fade-up">
            <div class="page-section__heading">
              <h2 class="page-h2">{page.servicesTitle}</h2>
            </div>
          </ScrollReveal>
        )}

        <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
          {page.serviceOfferings.map((service, index) => (
            <ScrollReveal animation="fade-up" delay={index * 0.1}>
              <div class="ds-card p-8 h-full">
                <h3 class="font-display font-bold text-xl text-ink mb-2">{service.name}</h3>
                {service.bestFor && (
                  <p class="text-sm text-ink-muted mb-4">Best for: {service.bestFor}</p>
                )}
                {service.includes && service.includes.length > 0 && (
                  <ul class="space-y-2 mb-6">
                    {service.includes.map((item) => (
                      <li class="flex items-start gap-2 text-ink-muted text-sm">
                        <svg class="w-5 h-5 text-signal flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
                {service.outcome && (
                  <div class="pt-4 border-t border-edge">
                    <p class="text-xs text-ink-faint uppercase tracking-wider mb-1">Outcome</p>
                    <p class="text-ink font-medium">{service.outcome}</p>
                  </div>
                )}
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Audience Section -->
  {page.personas && page.personas.length > 0 && (
    <section class="page-section">
      <div class="container">
        {page.audienceTitle && (
          <ScrollReveal animation="fade-up">
            <div class="page-section__heading">
              <h2 class="page-h2">{page.audienceTitle}</h2>
            </div>
          </ScrollReveal>
        )}

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {page.personas.map((persona, index) => (
            <ScrollReveal animation="fade-up" delay={index * 0.1}>
              <div class="ds-card p-8">
                <div class="flex items-center gap-4 mb-4">
                  {persona.icon && <span class="text-3xl">{persona.icon}</span>}
                  <h3 class="font-display font-bold text-lg text-ink">{persona.title}</h3>
                </div>
                <p class="text-ink-muted leading-relaxed">{persona.description}</p>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Social Proof Section -->
  {(page.stats && page.stats.length > 0) && (
    <section class="page-section page-section--alt">
      <div class="container">
        {page.proofTitle && (
          <ScrollReveal animation="fade-up">
            <div class="page-section__heading">
              <h2 class="page-h2">{page.proofTitle}</h2>
            </div>
          </ScrollReveal>
        )}

        {page.stats && page.stats.length > 0 && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto mb-12">
            {page.stats.map((stat, index) => (
              <ScrollReveal animation="fade-up" delay={index * 0.1}>
                <div class="text-center">
                  <p class="ds-stat__value">{stat.value}</p>
                  <p class="ds-stat__label">{stat.label}</p>
                </div>
              </ScrollReveal>
            ))}
          </div>
        )}

        {page.testimonials && page.testimonials.length > 0 && (
          <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
            {page.testimonials.map((testimonial, index) => (
              <ScrollReveal animation="fade-up" delay={index * 0.1}>
                <div class="ds-card p-8">
                  <blockquote class="text-ink-muted italic mb-6">"{testimonial.quote}"</blockquote>
                  <div class="flex items-center gap-4">
                    {testimonial.avatar && (
                      <img
                        src={urlFor(testimonial.avatar).width(80).height(80).url()}
                        alt={testimonial.author}
                        class="w-12 h-12 rounded-full object-cover"
                      />
                    )}
                    <div>
                      <p class="font-semibold text-ink">{testimonial.author}</p>
                      {(testimonial.role || testimonial.company) && (
                        <p class="text-ink-muted text-sm">
                          {testimonial.role}{testimonial.role && testimonial.company && ' at '}{testimonial.company}
                        </p>
                      )}
                    </div>
                  </div>
                </div>
              </ScrollReveal>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  {page.faqs && page.faqs.length > 0 && (
    <section class="page-section">
      <div class="container">
        <div class="max-w-3xl mx-auto">
          {page.faqTitle && (
            <ScrollReveal animation="fade-up">
              <div class="page-section__heading">
                <h2 class="page-h2">{page.faqTitle || 'Frequently Asked Questions'}</h2>
              </div>
            </ScrollReveal>
          )}

          <div class="space-y-4">
            {page.faqs.map((faq, index) => (
              <ScrollReveal animation="fade-up" delay={index * 0.05}>
                <details class="group ds-card">
                  <summary class="flex justify-between items-center cursor-pointer p-6 font-display font-semibold text-ink">
                    {faq.question}
                    <svg class="w-5 h-5 text-ink-muted group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="px-6 pb-6 text-ink-muted leading-relaxed">
                    {faq.answer}
                  </div>
                </details>
              </ScrollReveal>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="page-section">
    <div class="container">
      <div class="cta-panel">
        <GridTexture class="cta-panel__texture" />
        <div class="cta-panel__inner">
          {page.ctaHeadline && (
            <ScrollReveal animation="fade-up">
              <h2 class="cta-panel__title">
                {page.ctaHeadline}
              </h2>
            </ScrollReveal>
          )}

          {page.ctaSubheadline && (
            <ScrollReveal animation="fade-up" delay={0.1}>
              <p class="cta-panel__body">
                {page.ctaSubheadline}
              </p>
            </ScrollReveal>
          )}

          <ScrollReveal animation="fade-up" delay={0.2}>
            <div class="cta-panel__actions">
              {page.ctaButtonUrl && (
                <a href={page.ctaButtonUrl} class="ds-btn ds-btn-primary ds-btn-lg">
                  {page.ctaButtonText || 'Get Started'}
                  <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              )}
            </div>
          </ScrollReveal>

          {page.ctaSecondaryText && (
            <ScrollReveal animation="fade-up" delay={0.3}>
              <p class="cta-panel__note">{page.ctaSecondaryText}</p>
            </ScrollReveal>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": page.heroHeadline,
    "description": page.seoDescription || page.heroSubheadline,
    "provider": {
      "@type": "Person",
      "name": "Faris Aziz",
      "url": "https://farisaziz.com"
    },
    "areaServed": "Worldwide",
    "url": `https://farisaziz.com/services/${page.slug}`
  })} />
</BaseLayout>

<style>
  /* Neutral raised contact treatment — mirrors ContactPanel.astro so CMS-driven
     CTA fields keep their conditional rendering while matching the v2 idiom. */
  .cta-panel {
    position: relative;
    overflow: hidden;
    background: rgb(var(--surface-3));
    border: 1px solid rgb(var(--edge-strong));
    border-top: 3px solid rgb(var(--accent));
    border-radius: 20px;
    padding: clamp(3.5rem, 7vw, 5.5rem) clamp(2rem, 5vw, 4rem);
    text-align: center;
  }
  .cta-panel__texture {
    opacity: 0.35;
  }
  .cta-panel__inner {
    position: relative;
    max-width: 60ch;
    margin-inline: auto;
  }
  .cta-panel__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: rgb(var(--ink));
  }
  .cta-panel__body {
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.6;
    color: rgb(var(--ink-muted));
    margin-top: 1rem;
  }
  .cta-panel__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }
  @media (min-width: 640px) {
    .cta-panel__actions { flex-direction: row; }
  }
  .cta-panel__note {
    color: rgb(var(--ink-faint));
    font-size: 0.92rem;
    margin-top: 1.4rem;
  }
</style>
