---
/**
 * /mentorship: 1:1 mentorship, a few seats at a time. V3 Mentorship mock.
 * Right column: the cream "Apply for a seat" panel (Apply → #apply form) and "How it works".
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/v3/Kicker.astro';
import SectionHead from '../components/v3/SectionHead.astro';
import PraiseCard from '../components/v3/PraiseCard.astro';
import Illustration from '../components/v3/Illustration.astro';
import ProgramCard from '../components/services/ProgramCard.astro';
import MentorshipApply from '../components/services/MentorshipApply.astro';
import { getServiceOffers, getPraiseFor, getMetricsByDomain, getProfile } from '../lib/sanity/v3';
import { MENTORSHIP_COPY as C, MENTORCRUISE_URL, cfpMetric, mentorshipFocus, mentorshipPrograms, mentorshipDetails, offerPrice } from '../lib/services';
import { breadcrumbs, SITE } from '../lib/seo';

const [offers, praise, communityMetrics, profile] = await Promise.all([
  getServiceOffers(),
  getPraiseFor({ topic: 'mentoring' }),
  getMetricsByDomain('community'),
  getProfile(),
]);

const focus = mentorshipFocus(cfpMetric(communityMetrics));
const programs = mentorshipPrograms(offers);
const details = mentorshipDetails(programs);
const quotes = praise.slice(0, 2);
const fallbackHref = programs.find((o) => o.bookingUrl?.includes('mentorcruise'))?.bookingUrl ?? MENTORCRUISE_URL;

const schema = [
  {
    '@type': 'Service',
    '@id': `${SITE}/mentorship#service`,
    name: '1:1 engineering mentorship',
    serviceType: 'Career, craft and speaking mentorship',
    description: C.lede,
    audience: { '@type': 'Audience', audienceType: 'Individual engineers' },
    provider: { '@id': `${SITE}/#person` },
    areaServed: 'Worldwide',
    url: `${SITE}/mentorship`,
    ...(programs.length
      ? {
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: 'Mentorship programmes',
            itemListElement: programs.map((o) => ({
              '@type': 'Offer',
              name: o.title,
              ...(o.shortDescription ? { description: o.shortDescription } : {}),
              ...(o.bookingUrl ? { url: o.bookingUrl } : {}),
              ...(offerPrice(o) && o.priceFrom ? { price: o.priceFrom, priceCurrency: (o.priceCurrency || 'CHF').toUpperCase() } : {}),
            })),
          },
        }
      : {}),
  },
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    { name: 'Mentorship', path: '/mentorship' },
  ]),
];
---

<BaseLayout
  title="Mentorship: senior, lead, or your first talk | Faris Aziz"
  description="1:1 mentorship for engineers getting to senior or lead, owning systems in production, or giving their first conference talk. A few seats at a time."
  image="/og/mentorship.png"
  markdownAlternate="/mentorship.md"
  extraSchema={schema}
>
  <div class="ds-wrap">
    <div class="mgrid">
      <header class="mhead">
        <Kicker parts={C.kicker} />
        <h1 class="ds-h1 mhead__title">{C.title}</h1>
        <p class="ds-lede mhead__lede">{C.lede}</p>
      </header>

      <aside class="maside" aria-label="Apply and how it works">
        <section class="ds-panel apanel" aria-labelledby="apanel-title">
          <div class="apanel__copy">
            <p class="ds-kicker">{C.apply.kicker}</p>
            <h2 id="apanel-title" class="apanel__title">{C.apply.title}</h2>
            <p class="apanel__body">{C.apply.body}</p>
            <a href="#apply" class="ds-btn ds-btn--panel ds-btn--block" data-track="mentorship-apply">Apply</a>
          </div>
          <Illustration name="faris-thinking" width={100} class="apanel__art" loading="eager" />
        </section>

        <section class="ds-card how" aria-labelledby="how-title">
          <h2 id="how-title" class="ds-kicker">How it works</h2>
          <dl class="ds-dl how__dl">
            {details.map((d) => (<><dt>{d.label}</dt><dd>{d.value}</dd></>))}
          </dl>
        </section>
      </aside>

      <div class="mbody">
        <section aria-labelledby="focus-title">
          <h2 id="focus-title" class="sr-only">What we can work on</h2>
          <ul class="ds-grid-3 focus" role="list">
            {focus.map((f) => (
              <li class="ds-card focus__card">
                <p class="ds-kicker">{f.kicker}</p>
                <h3 class="focus__title">{f.title}</h3>
                <p class="focus__body">{f.body}</p>
              </li>
            ))}
          </ul>
        </section>

        {quotes.length > 0 && (
          <section class="praise" aria-labelledby="praise-title">
            <SectionHead
              id="praise-title"
              title="From people I've mentored and taught"
              size="label"
              link={{ label: 'All mentions', href: '/appreciation?topic=mentoring' }}
              class="praise__head"
            />
            <div class="ds-grid-2">
              {quotes.map((p) => <PraiseCard praise={p} variant="stripe" full class="praise__card" />)}
            </div>
            <p class="ds-meta praise__note">{C.praiseNote}</p>
          </section>
        )}

        {programs.length > 0 && (
          <section class="programs" aria-labelledby="programs-title">
            <SectionHead id="programs-title" title="Programmes" size="label" class="praise__head" />
            <div class="ds-grid-2">
              {programs.map((o) => <ProgramCard offer={o} />)}
            </div>
          </section>
        )}
      </div>
    </div>

    <MentorshipApply replyTime={profile.replyTime} fallbackHref={fallbackHref} />
  </div>
</BaseLayout>

<style>
  .mgrid {
    display: grid; grid-template-columns: minmax(0, 1fr) 400px; grid-template-rows: auto 1fr;
    grid-template-areas: 'head aside' 'body aside'; gap: 30px 56px;
    padding-block: clamp(32px, 5vw, 48px) clamp(40px, 5vw, 64px);
  }
  .mhead { grid-area: head; display: flex; flex-direction: column; gap: 14px; }
  .mhead__title { font-size: clamp(36px, 4.6vw, 48px); line-height: 0.98; letter-spacing: -0.04em; }
  .mhead__lede { font-size: 17px; line-height: 1.55; max-width: 58ch; }
  .maside { grid-area: aside; display: flex; flex-direction: column; gap: 14px; align-self: start; }
  .mbody { grid-area: body; display: flex; flex-direction: column; gap: 30px; min-width: 0; }

  .apanel { display: grid; grid-template-columns: minmax(0, 1fr) 100px; gap: 14px; align-items: center; padding: 24px; }
  .apanel__copy { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .apanel__title { font-size: 22px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .apanel__body { margin: 0; font-size: 14px; line-height: 1.5; }
  .apanel :global(.apanel__art) { width: 100px; height: auto; justify-self: end; }

  .how { display: flex; flex-direction: column; gap: 12px; padding: 20px; }
  .how__dl { font-size: 14px; line-height: 1.5; gap: 6px 14px; }
  .how__dl :global(dd) { color: rgb(var(--text-muted)); }

  .focus { margin: 0; padding: 0; list-style: none; }
  .focus__card { display: flex; flex-direction: column; gap: 10px; padding: 22px; }
  .focus__title { font-size: 20px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; }
  .focus__body { margin: 0; font-size: 14px; line-height: 1.5; color: rgb(var(--text-muted)); }

  .praise, .programs { display: flex; flex-direction: column; gap: 12px; }
  .mbody :global(.praise__head) { margin-bottom: 0; }
  .praise :global(.praise__card) { height: 100%; padding: 22px; }
  .praise :global(.pq-stripe__quote) { font-size: 15.5px; line-height: 1.5; }
  .praise__note { margin: 0; }

  @media (max-width: 1040px) {
    .mgrid { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: 'head' 'aside' 'body'; }
    .maside { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  }
  @media (max-width: 720px) {
    .maside { grid-template-columns: 1fr; }
  }
  @media (max-width: 380px) {
    .apanel { grid-template-columns: 1fr; }
    .apanel :global(.apanel__art) { width: 84px; grid-row: 1; }
  }
</style>
