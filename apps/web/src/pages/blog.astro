---
/**
 * Articles & podcasts: posts on this site, pieces for other publications,
 * podcasts and video, one section per format (MediaLibrary), with
 * Format/Topic filters across them.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/v3/Kicker.astro';
import MediaLibrary from '../components/writing/MediaLibrary.astro';
import { getWriting } from '../lib/sanity/v3';
import { breadcrumbs, itemList } from '../lib/seo';

const items = await getWriting();
const internal = items.filter((i) => i.isInternal);
---

<BaseLayout
  title="Articles & podcasts | Faris Aziz"
  description="Articles, guest posts, podcasts and video by Faris Aziz on engineering in production, careers and community."
  image="/og/blog.png"
  markdownAlternate="/blog.md"
  extraSchema={[
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Articles & podcasts', path: '/blog' },
    ]),
    ...(internal.length ? [itemList('Posts on faziz-dev.com', internal.map((i) => i.href))] : []),
  ]}
>
    <header class="ds-wrap wr-hero">
      <Kicker parts={['Articles & podcasts']} />
      <h1 class="ds-h1 wr-hero__title">Articles, podcasts and the odd video.</h1>
      <p class="ds-lede wr-hero__lede">
        My blog posts, articles I've written for other sites, and podcasts I've been on, all in one place, newest first.
      </p>
    </header>

    {items.length > 0 ? (
      <div class="ds-wrap wr-list">
        <MediaLibrary items={items} />
      </div>
    ) : (
      <div class="ds-wrap wr-list">
        <p class="wr-none">Nothing published here right now. The feed is still at <a class="ds-textlink" href="/rss.xml">/rss.xml</a>, and the talks are on <a class="ds-textlink" href="/talks">the talks page</a>.</p>
      </div>
    )}
</BaseLayout>

<style>
  .wr-hero { display: flex; flex-direction: column; gap: 14px; padding-top: 48px; padding-bottom: 32px; }
  .wr-hero > * { max-width: 720px; }
  .wr-hero__title { font-size: clamp(36px, 5.6vw, 52px); }
  .wr-hero__lede { max-width: 640px; font-size: 17px; }
  .wr-list { padding-bottom: 56px; }
  .wr-none { margin: 0; padding: 32px 0; border-top: 1px solid rgb(var(--hairline)); color: rgb(var(--text-muted)); font-size: 15px; }
  @media (max-width: 720px) {
    .wr-hero { padding-top: 32px; padding-bottom: 24px; }
  }
</style>
