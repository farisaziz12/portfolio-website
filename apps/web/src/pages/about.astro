---
/**
 * About ("Story"): the entity home. First-person story from the About page
 * document, a short facts box and links into the track record.
 */
import { PortableText } from 'astro-portabletext';
import BaseLayout from '../layouts/BaseLayout.astro';
import SkewHero from '../components/v3/SkewHero.astro';
import Kicker from '../components/v3/Kicker.astro';
import AboutAside from '../components/about/AboutAside.astro';
import { getAboutPage, getProfile } from '../lib/sanity/v3';
import { breadcrumbs } from '../lib/seo';

const [about, profile] = await Promise.all([getAboutPage(), getProfile()]);

const hasStory = Array.isArray(about.content) && about.content.length > 0;
// No story written yet: fall back to the medium bio, one paragraph per blank line.
const fallback = (profile.bios.medium ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const heroImage = about.heroImage?.asset ? about.heroImage : profile.photos[0];
const kicker = about.kicker.split(/\s*·\s*/);

const description =
  about.seo?.metaDescription ||
  'Faris Aziz: software engineer on frontend and payment systems, conference speaker, and co-founder of ZurichJS. The long way into tech, in his own words.';
---

<BaseLayout
  title={about.seo?.metaTitle || 'About | Faris Aziz'}
  description={description.slice(0, 160)}
  image="/og/about.png"
  profilePage={true}
  markdownAlternate="/about.md"
  band={false}
  extraSchema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }])]}
>
  <SkewHero image={heroImage} imageAlt={heroImage?.alt || 'Faris Aziz speaking at a conference'} focus="50% 20%">
    <Kicker parts={kicker} />
    <h1 class="ds-h1 about__title">{about.title}</h1>
    <p class="ds-lede about__intro">{about.intro}</p>
  </SkewHero>

  <div class="ds-wrap about__body">
    <div class="story">
      {hasStory ? (
        <PortableText value={about.content as never} />
      ) : (
        fallback.map((p) => <p>{p}</p>)
      )}
    </div>
    <AboutAside inShort={about.inShort} links={profile.links} />
  </div>
</BaseLayout>

<style>
  .about__title { margin: 0; text-wrap: balance; }
  .about__intro { max-width: 44ch; }

  .about__body {
    display: grid; grid-template-columns: minmax(0, 680px) minmax(280px, 1fr); gap: 56px;
    padding-top: 56px; padding-bottom: 64px; align-items: start;
  }
  .story { display: flex; flex-direction: column; gap: 28px; font-size: 18px; line-height: 1.7; color: rgb(var(--text)); min-width: 0; }
  .story :global(p) { margin: 0; text-wrap: pretty; }
  .story :global(h2), .story :global(h3) { margin: 12px 0 -8px; font-size: 24px; line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; }
  .story :global(ul), .story :global(ol) { margin: 0; padding-left: 1.2em; }
  .story :global(a) {
    color: rgb(var(--text)); text-decoration: underline; text-decoration-color: rgb(var(--yellow));
    text-underline-offset: 0.2em; text-decoration-thickness: 1.5px;
  }
  .story :global(a:hover) { color: rgb(var(--accent-text)); }

  @media (max-width: 960px) {
    .about__body { grid-template-columns: 1fr; gap: 40px; padding-top: 40px; }
    .story { max-width: 680px; }
  }
  @media (max-width: 720px) {
    .story { font-size: 17px; gap: 22px; }
  }
</style>
