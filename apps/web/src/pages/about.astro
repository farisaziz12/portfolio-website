---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import ContactPanel from '../components/design/ContactPanel.astro';
import { sanityFetch, urlFor } from '../lib/sanity/client';
import { PROOF } from '../lib/proof';
import { pageQuery, speakingStatsQuery, featuredTestimonialsQuery } from '../lib/sanity/queries';
import { availabilityLabel } from '../lib/availability';

interface Milestone {
  _key: string;
  title: string;
  description: string;
  emoji?: string;
}

interface PageContent {
  heroImage?: any;
  aboutHero?: {
    greeting?: string;
    name?: string;
    role?: string;
    location?: string;
    bio?: string;
    linkedinUrl?: string;
  };
  aboutJourney?: {
    title?: string;
    subtitle?: string;
    milestones?: Milestone[];
  };
  aboutCta?: {
    statusText?: string;
    title?: string;
    description?: string;
    primaryCtaText?: string;
    primaryCtaUrl?: string;
    secondaryCtaText?: string;
    secondaryCtaUrl?: string;
  };
  seo?: { metaTitle?: string; metaDescription?: string };
}

interface SpeakingStats {
  totalEvents: number;
  countries: number;
  cities: number;
  talks: number;
}

interface Testimonial {
  _id: string;
  quote: string;
  author: string;
  role?: string;
  company?: string;
}

const [pageContent, stats, testimonials] = await Promise.all([
  sanityFetch<PageContent | null>(pageQuery, { identifier: 'about' }).catch(() => null),
  sanityFetch<SpeakingStats>(speakingStatsQuery).catch(() => ({
    totalEvents: 86, countries: 20, cities: 29, talks: 0,
  })),
  sanityFetch<Testimonial[]>(featuredTestimonialsQuery).catch(() => []),
]);

const heroImage = pageContent?.heroImage;
const seo = pageContent?.seo;
const linkedinUrl = pageContent?.aboutHero?.linkedinUrl || 'https://linkedin.com/in/farisaziz12';

// Sanity milestones don't carry a year — fall back to the design's curated timeline
// when Sanity returns nothing. If Sanity has milestones we render them but with no year tag.
const sanityMilestones = pageContent?.aboutJourney?.milestones || [];
const fallbackTimeline = [
  {
    year: '2015 — 2019',
    title: 'Learning to ship',
    desc: 'Cut my teeth building frontend systems where reliability wasn\'t optional. Learned that the hard problems live at the edges — the failures, the retries, the 3am pages.',
  },
  {
    year: '2019 — 2022',
    title: 'Payments at scale',
    desc: 'Moved into fintech, building and scaling payment infrastructure across regions. Launched Alipay in APAC and watched local payment methods move real revenue.',
  },
  {
    year: '2022 — 2024',
    title: 'Leading teams',
    desc: 'Led a cross-functional squad of 15 engineers across two teams — frontend, backend, and the skip-level management in between.',
  },
  {
    year: '2024 — now',
    title: 'Staff, stages & community',
    desc: 'Staff Engineer by day; speaker, mentor, and ZurichJS organizer the rest of the time. 425 new community members and counting.',
  },
];

const timelineItems =
  sanityMilestones.length > 0
    ? sanityMilestones.map((m) => ({ year: '', title: m.title, desc: m.description }))
    : fallbackTimeline;

const fallbackTestimonials = [
  { _id: 'tk', quote: "Faris is one of the best speakers I've seen recently. An honor and delight to meet him — the guy is going places.", author: 'Tejas Kumar', role: 'DevRel', company: 'Conference host' },
  { _id: 'hh', quote: 'Whenever I need guidance about my career, there is one person I always turn to. He\'s been a mentor and a constant source of insight.', author: 'Hammad Hassan', role: 'Full-Stack Engineer' },
  { _id: 'rg', quote: 'An incredible engineer and human. I had the chance to meet Faris during the speaker session at ReactSummit.', author: 'Rajni Gediya', role: 'Staff Engineer', company: 'Mobile' },
];
const quotes = testimonials.length > 0 ? testimonials.slice(0, 6) : fallbackTestimonials;

const headlineRole = pageContent?.aboutHero?.role;
const headlineBio = pageContent?.aboutHero?.bio;
const heroLocation = pageContent?.aboutHero?.location || 'Geneva';

const ctaContent = {
  status: pageContent?.aboutCta?.statusText || availabilityLabel('Available'),
  title: pageContent?.aboutCta?.title || "Let's build something",
  body: pageContent?.aboutCta?.description || "Speaking, consulting, or mentorship — if it involves shipping resilient software, I'm interested.",
  primaryHref: pageContent?.aboutCta?.primaryCtaUrl || '/invite',
  primaryLabel: pageContent?.aboutCta?.primaryCtaText || 'Invite me to speak',
  secondaryHref: pageContent?.aboutCta?.secondaryCtaUrl || '/services',
  secondaryLabel: pageContent?.aboutCta?.secondaryCtaText || 'Explore services',
};
---

<BaseLayout
  title={seo?.metaTitle || 'About — Faris Aziz'}
  description={seo?.metaDescription || `Staff Software Engineer and Conference Speaker based in ${heroLocation}, specializing in resilient frontend systems and payment integrations.`}
  pathname="/about"
  image="/og/about.png"
  profilePage={true}
  markdownAlternate="/about.md"
>
  <!-- HERO -->
  <header class="about-hero">
    <div class="container about-hero__grid">
      <div>
        <Kicker>About</Kicker>
        <h1 class="about-hero__title">
          Engineer first.<br />
          <span class="accent-word">Speaker</span> because of it.
        </h1>
        <p class="about-hero__lead">
          {headlineBio ||
            `I'm a ${headlineRole || 'Staff Software Engineer'} based in ${heroLocation}. For a decade I've built resilient frontend systems and payment integrations — the kind where a dropped request means real money lost. Speaking came later: I had things worth saying because I'd shipped them.`}
        </p>
        <p class="about-hero__body">
          Today I split my time between deep engineering work, mentoring engineers who want to grow, and talking on stages around the world about what actually works in production.
        </p>
        {/* Declarative entity block — quotable facts for humans, search engines, and AI assistants alike. */}
        <p class="about-hero__facts">
          In numbers: {stats.totalEvents}+ speaking engagements across {stats.countries} countries,
          organizer of ZurichJS, and available for keynotes, workshops, consulting, and 1:1 mentorship.
        </p>
        <div class="about-hero__actions">
          <a href="/services" class="ds-btn ds-btn-primary">
            Work with me
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="/speaking" class="ds-btn ds-btn-secondary">See my talks</a>
        </div>
      </div>
      <div class="about-portrait">
        {heroImage ? (
          <img
            src={urlFor(heroImage).width(600).height(750).quality(90).url()}
            alt={pageContent?.aboutHero?.name || 'Faris Aziz'}
            loading="eager"
          />
        ) : (
          <div class="about-portrait__placeholder">
            <span>Portrait · 4:5</span>
          </div>
        )}
      </div>
    </div>
  </header>

  <!-- BY THE NUMBERS -->
  <section class="about-section">
    <div class="container">
      <div class="about-section__heading">
        <Kicker class="ds-reveal">By the numbers</Kicker>
        <h2 class="about-h2 ds-reveal">A decade, <span class="mark">measured</span></h2>
      </div>
      <div class="wide about-stats ds-reveal">
        <div class="about-stat">
          <div class="ds-stat__value">{stats.totalEvents}</div>
          <div class="ds-stat__label">Talks given</div>
        </div>
        <div class="about-stat">
          <div class="ds-stat__value">{stats.countries}</div>
          <div class="ds-stat__label">Countries</div>
        </div>
        <div class="about-stat">
          <div class="ds-stat__value">{PROOF.communityMembers}</div>
          <div class="ds-stat__label">Community members</div>
        </div>
        <div class="about-stat">
          <div class="ds-stat__value">{PROOF.revenueMultiplier}<span style="color:rgb(var(--signal));">×</span></div>
          <div class="ds-stat__label">Revenue impact</div>
        </div>
      </div>
    </div>
  </section>

  <!-- JOURNEY -->
  <section class="about-section about-section--alt">
    <div class="container">
      <div class="about-section__heading">
        <Kicker class="ds-reveal">{pageContent?.aboutJourney?.subtitle ? '' : 'The path'}</Kicker>
        <h2 class="about-h2 ds-reveal">
          {pageContent?.aboutJourney?.title || (<>How I got <span class="mark">here</span></>)}
        </h2>
      </div>
      <div class="about-timeline ds-reveal">
        {timelineItems.map((m) => (
          <div class="about-timeline__item">
            {m.year && <div class="about-timeline__year">{m.year}</div>}
            <h4 class="about-timeline__title">{m.title}</h4>
            <p class="about-timeline__desc">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  {quotes.length > 0 && (
    <section class="about-section">
      <div class="container">
        <div class="about-section__heading">
          <Kicker class="ds-reveal">From the community</Kicker>
          <h2 class="about-h2 ds-reveal">What people <span class="mark">say</span></h2>
        </div>
        <div class="about-quotes wide">
          {quotes.map((q) => (
            <div class="ds-card about-quote ds-reveal">
              <p>"{q.quote}"</p>
              <div class="about-quote__who">
                <span class="about-quote__avatar">
                  {q.author.split(' ').map((p) => p[0]).join('').slice(0, 2).toUpperCase()}
                </span>
                <div>
                  <b>{q.author}</b>
                  {(q.role || q.company) && (
                    <><br /><span>{[q.role, q.company].filter(Boolean).join(' · ')}</span></>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="about-section about-section--contact">
    <div class="container">
      <div class="wide ds-reveal">
        <ContactPanel
          status={ctaContent.status}
          title={ctaContent.title}
          body={ctaContent.body}
          primaryHref={ctaContent.primaryHref}
          primaryLabel={ctaContent.primaryLabel}
          secondaryHref={ctaContent.secondaryHref}
          secondaryLabel={ctaContent.secondaryLabel}
        />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .about-hero {
    border-bottom: 1px solid rgb(var(--edge));
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .about-hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 840px) {
    .about-hero__grid { grid-template-columns: 1fr; }
  }
  .about-hero__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.025em;
    font-size: clamp(2.6rem, 5.5vw, 4.2rem);
    color: rgb(var(--ink));
    margin-top: 1.2rem;
    text-wrap: balance;
  }
  .about-hero__lead {
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.6;
    color: rgb(var(--ink-muted));
    max-width: 52ch;
    margin-top: 1.5rem;
  }
  .about-hero__body {
    color: rgb(var(--ink-muted));
    max-width: 52ch;
    margin-top: 1.2rem;
  }
  .about-hero__facts {
    color: rgb(var(--ink-faint));
    font-size: 0.92rem;
    max-width: 52ch;
    margin-top: 1rem;
    padding-left: 0.9rem;
    border-left: 2px solid rgb(var(--accent) / 0.5);
  }
  .about-hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .about-portrait {
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    background: rgb(var(--surface-3));
    box-shadow: inset 0 0 0 1px rgb(var(--edge));
  }
  .about-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .about-portrait__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--ink-faint));
    font-size: 0.85rem;
  }

  /* Section primitives */
  .about-section { padding-block: clamp(4rem, 9vw, 7.5rem); }
  .about-section--alt {
    background: rgb(var(--surface-1));
    border-top: 1px solid rgb(var(--edge));
    border-bottom: 1px solid rgb(var(--edge));
  }
  .about-section--contact { padding-top: 0; }
  .about-section__heading {
    text-align: center;
    margin-bottom: 2.6rem;
  }
  .about-section__heading .kicker { justify-content: center; }
  .about-h2 {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: rgb(var(--ink));
    margin-top: 1rem;
  }

  /* Stats */
  .about-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgb(var(--edge));
    border: 1px solid rgb(var(--edge));
    border-radius: 14px;
    overflow: hidden;
  }
  @media (max-width: 760px) {
    .about-stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 460px) {
    .about-stats { grid-template-columns: 1fr; }
  }
  .about-stat {
    background: rgb(var(--surface-1));
    padding: 1.8rem;
    text-align: center;
  }
  .about-stat .ds-stat__value {
    font-size: 2.4rem;
  }

  /* Timeline */
  .about-timeline {
    max-width: 760px;
    margin-inline: auto;
    position: relative;
    padding-left: 2rem;
  }
  .about-timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: rgb(var(--edge));
  }
  .about-timeline__item {
    position: relative;
    padding-bottom: 2rem;
  }
  .about-timeline__item:last-child { padding-bottom: 0; }
  .about-timeline__item::before {
    content: '';
    position: absolute;
    left: -1.79rem;
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: rgb(var(--accent));
    box-shadow: 0 0 0 4px rgb(var(--bg));
  }
  .about-timeline__year {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: rgb(var(--accent-bright));
  }
  .about-timeline__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: rgb(var(--ink));
    margin: 0.3rem 0;
  }
  .about-timeline__desc {
    font-size: 0.95rem;
    color: rgb(var(--ink-muted));
    line-height: 1.6;
  }

  /* Testimonials */
  .about-quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  @media (max-width: 900px) {
    .about-quotes { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .about-quotes { grid-template-columns: 1fr; }
  }
  .about-quote {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .about-quote p {
    font-size: 0.95rem;
    color: rgb(var(--ink));
    line-height: 1.6;
  }
  .about-quote__who {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: auto;
    padding-top: 1.2rem;
  }
  .about-quote__who b {
    font-size: 0.85rem;
    color: rgb(var(--ink));
  }
  .about-quote__who span {
    font-size: 0.78rem;
    color: rgb(var(--ink-faint));
  }
  .about-quote__avatar {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: rgb(var(--surface-3));
    border: 1px solid rgb(var(--edge));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.8rem;
    color: rgb(var(--ink-muted));
    flex-shrink: 0;
  }
</style>
