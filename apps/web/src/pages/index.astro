---
// Home page is server-rendered + ISR-cached at the edge so the "Next up" strip
// stays fresh without a redeploy. Revalidates every hour (configured in astro.config.mjs).
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFeatured from '../components/home/HomeFeatured.astro';
import HomePraise from '../components/home/HomePraise.astro';
import HomeCommunity from '../components/home/HomeCommunity.astro';
import HomeWriting from '../components/home/HomeWriting.astro';
import Opener from '../components/home/Opener.astro';
import { eventSchema, itemList } from '../lib/seo';
import {
  getHomePage,
  getHomeFeatured,
  getHomePraise,
  getPrimaryCommunity,
  getMetricsByDomain,
  getUpcomingEvents,
  getSpeakingStats,
  getWriting,
  getSiteSettings,
  getProfile,
  homeHeroPhotos,
  type FeaturedItem,
} from '../lib/sanity/v3';

const home = await getHomePage();
const [settings, profile, featured, praise, community, communityMetrics, upcoming, stats, writing] = await Promise.all([
  getSiteSettings(),
  getProfile(),
  getHomeFeatured(),
  getHomePraise(),
  getPrimaryCommunity(home.communityId),
  getMetricsByDomain('community'),
  getUpcomingEvents(),
  getSpeakingStats(),
  getWriting(),
]);

const kicker = home.kicker || settings.nowLine;

// Community tiles: the community's own dated metrics, else the approved community-domain ones.
const metrics = (community?.metrics.length ? community.metrics : communityMetrics).filter((m) => m.dateLabel);

// Recent writing: the two newest pieces not already on a poster (articles first, like the design).
const onPosters = new Set(featured.filter((f): f is Extract<FeaturedItem, { kind: 'writing' }> => f.kind === 'writing').map((f) => f.item._id));
const fresh = writing.filter((w) => !onPosters.has(w._id));
const latest = [...fresh.filter((w) => w.format === 'article'), ...fresh.filter((w) => w.format !== 'article')].slice(0, 2);

// Hero photos: the Home page picks, else the press photos.
const heroPhotos = homeHeroPhotos(home.heroPhotos, profile.photos);

const next = upcoming.slice(0, 5);
const extraSchema = next.length
  ? [itemList('Upcoming appearances', next.map((e) => `/events/${e.slug}`)), ...next.map((e) => eventSchema(e))]
  : [];
---

<BaseLayout
  title="Faris Aziz · software engineer, speaker, ZurichJS co-founder"
  description={settings.metaDescription}
  pathname=""
  image="/og/home.png"
  markdownAlternate="/home.md"
  band={false}
  extraSchema={extraSchema}
>
  {settings.introEnabled && <Opener name={profile.name} line={kicker} />}

  <HomeHero home={home} photos={heroPhotos} kicker={kicker} upcoming={upcoming} />

  <HomeFeatured items={featured} quote={praise.underPosters} podcasts={stats.podcasts} />

  <HomePraise spotlight={praise.spotlight} cards={praise.cards} />

  {community && <HomeCommunity community={community} metrics={metrics} />}

  <HomeWriting items={latest} invite={home.invitePanel} />
</BaseLayout>
