  <script>
    // Re-run on initial load AND on every Astro ViewTransitions swap, so that
    // navigating back to / via in-app links re-fires the reveal + count-up.
    function initHome() {
      document.documentElement.classList.add('js');

      // Reset prior state on swap-back so animations actually re-play
      document.querySelectorAll('.ds-reveal.in').forEach((el) => el.classList.remove('in'));
      document.querySelectorAll<HTMLElement>('.cu').forEach((el) => {
        el.textContent = '0';
      });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.ds-reveal').forEach((el) => io.observe(el));

      const revealFailsafe = window.setTimeout(() => {
        document.querySelectorAll('.ds-reveal:not(.in)').forEach((el) => el.classList.add('in'));
      }, 700);

      function countUp(el: HTMLElement) {
        const to = parseFloat(el.dataset.to || '0');
        const dec = parseInt(el.dataset.dec || '0', 10);
        const dur = 1400;
        const t0 = performance.now();
        function tick(now: number) {
          let p = Math.min(1, (now - t0) / dur);
          p = 1 - Math.pow(1 - p, 3);
          el.textContent = (to * p).toFixed(dec);
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = to.toFixed(dec);
        }
        requestAnimationFrame(tick);
      }

      const cuObs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            countUp(e.target as HTMLElement);
            cuObs.unobserve(e.target);
          }
        });
      }, { threshold: 0.4 });
      document.querySelectorAll<HTMLElement>('.cu').forEach((el) => cuObs.observe(el));

      // Immediate fallback for stats that are above-the-fold and may have
      // been considered "already visible" before the observer attached.
      // Trigger them ~50ms after init so the animation still reads.
      window.setTimeout(() => {
        document.querySelectorAll<HTMLElement>('.cu').forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0 && el.textContent === '0') {
            cuObs.unobserve(el);
            countUp(el);
          }
        });
      }, 80);

      const cuFailsafe = window.setTimeout(() => {
        document.querySelectorAll<HTMLElement>('.cu').forEach((el) => {
          if (el.textContent === '0') {
            el.textContent = parseFloat(el.dataset.to || '0').toFixed(parseInt(el.dataset.dec || '0', 10));
          }
        });
      }, 3000);

      // Clean up timers if the page is swapped away again.
      document.addEventListener('astro:before-swap', () => {
        window.clearTimeout(revealFailsafe);
        window.clearTimeout(cuFailsafe);
      }, { once: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHome, { once: true });
    } else {
      initHome();
    }
    document.addEventListener('astro:after-swap', initHome);
  </script>
