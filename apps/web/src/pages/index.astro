---
// Home page is server-rendered + ISR-cached at the edge so the "Next up" event band
// stays fresh without a redeploy. Revalidates every hour (configured in astro.config.mjs).
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import GridTexture from '../components/design/GridTexture.astro';
import IconChip from '../components/design/IconChip.astro';
import ContactPanel from '../components/design/ContactPanel.astro';
import HeroTerminal from '../components/islands/HeroTerminal';
import AudienceRouter from '../components/home/AudienceRouter.astro';
import FeaturedTalk from '../components/home/FeaturedTalk.astro';
import ReachMap from '../components/home/ReachMap.astro';
import SocialWallIsland from '../components/islands/SocialWallIsland';
import { isRealConference } from '../lib/conferences';
import { PROOF, FALLBACK_SPEAKER_STATS } from '../lib/proof';
import { sanityFetch, urlFor } from '../lib/sanity/client';
import {
  upcomingEventsQuery,
  speakingStatsQuery,
  featuredMediaQuery,
  featuredTestimonialsQuery,
  featuredSocialPostsQuery,
  featuredTalkQuery,
  reachMapDataQuery,
  pastEventsQuery,
} from '../lib/sanity/queries';

interface UpcomingEvent {
  _id: string;
  title: string;
  slug: string;
  type: string;
  conference: string;
  date: string;
  location?: { city?: string; country?: string };
}
interface SpeakingStats {
  totalEvents: number;
  upcomingEvents: number;
  countries: number;
  cities: number;
  talks: number;
  workshops: number;
}
interface Media { _id: string; image?: any; description?: string }
interface Testimonial { _id: string; quote: string; author: string; role?: string; company?: string; image?: any }
interface SocialPost {
  _id: string;
  url: string;
  platform: 'linkedin' | 'twitter';
  author: string;
  authorHandle?: string;
  authorImage?: any;
  authorRole?: string;
  postImage?: any;
  content: string;
  tweetId?: string;
  postDate?: string;
  relatedTalk?: { title: string; slug: string };
  relatedEvent?: { title: string; slug: string; conference: string };
}
interface FeaturedTalkData {
  _id: string;
  title: string;
  slug: string;
  abstract?: string;
  duration?: number;
  viewCount?: number;
  assets?: { videoUrl?: string; thumbnailImage?: any };
  latestEvent?: { conference?: string; city?: string };
}
interface PastEvent { _id: string; conference?: string; featured?: boolean }

const [upcomingEvents, stats, media, testimonials, socialPosts, featured, pastEvents, reachCities] = await Promise.all([
  sanityFetch<UpcomingEvent[]>(upcomingEventsQuery).catch(() => []),
  sanityFetch<SpeakingStats>(speakingStatsQuery).catch(() => ({ ...FALLBACK_SPEAKER_STATS })),
  sanityFetch<Media[]>(featuredMediaQuery).catch(() => []),
  sanityFetch<Testimonial[]>(featuredTestimonialsQuery).catch(() => []),
  sanityFetch<SocialPost[]>(featuredSocialPostsQuery).catch(() => []),
  sanityFetch<FeaturedTalkData | null>(featuredTalkQuery).catch(() => null),
  sanityFetch<PastEvent[]>(pastEventsQuery).catch(() => []),
  sanityFetch<string[]>(reachMapDataQuery).catch(() => []),
]);

// Pre-process image URLs for the social wall React island (urlFor can't run client-side).
const socialPostImages: Record<string, string> = {};
for (const p of socialPosts) {
  if (p.authorImage) {
    try { socialPostImages[p._id] = urlFor(p.authorImage).width(48).height(48).url(); } catch {}
  }
}
const testimonialImages: Record<string, string> = {};
for (const t of testimonials) {
  if (t.image) {
    try { testimonialImages[t._id] = urlFor(t.image).width(48).height(48).url(); } catch {}
  }
}

const normalizedSocialPosts = socialPosts.map((p) => ({
  _id: p._id,
  platform: p.platform,
  author: p.author,
  authorRole: p.authorRole,
  authorHandle: p.authorHandle,
  content: p.content,
  url: p.url,
  postDate: p.postDate,
}));
const normalizedTestimonials = testimonials.map((t) => ({
  _id: t._id,
  quote: t.quote,
  author: t.author,
  role: t.role,
  company: t.company,
}));
const hasSocialContent = normalizedSocialPosts.length > 0 || normalizedTestimonials.length > 0;

const nextEvent = upcomingEvents[0] || null;

// Logo wall — top conferences from past events.
// Aggressive dedupe key: strip all non-alphanumeric chars so "ZurichJS" and "Zurich JS"
// collapse to the same entry, but "ZurichJS Pro" stays distinct.
// Track `featured` as a logical OR across the conference's events — if ANY event
// for that conference was marked featured in Sanity, the conference earns a star.
interface ConferenceAgg { display: string; count: number; featured: boolean }
const conferenceCounts = new Map<string, ConferenceAgg>();
for (const e of pastEvents) {
  const raw = e.conference?.trim();
  if (!isRealConference(raw)) continue;
  const key = raw!.toLowerCase().replace(/[^a-z0-9]+/g, '');
  if (!key) continue;
  const existing = conferenceCounts.get(key);
  if (existing) {
    existing.count += 1;
    if (e.featured) existing.featured = true;
  } else {
    conferenceCounts.set(key, { display: raw!, count: 1, featured: !!e.featured });
  }
}
const topConferences = Array.from(conferenceCounts.values())
  // Featured first, then by frequency
  .sort((a, b) => (Number(b.featured) - Number(a.featured)) || b.count - a.count)
  .slice(0, 6);

// Topic cards (line-icons, no emoji)
const topics = [
  {
    title: 'React & Next.js',
    desc: 'Performance, architecture, and production patterns at scale.',
    icon: '<circle cx="12" cy="12" r="2.2"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>',
  },
  {
    title: 'Payments & Fintech',
    desc: 'Orchestration, resilience, and scaling money globally.',
    icon: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  },
  {
    title: 'Developer Experience',
    desc: 'Tooling, productivity, and workflows engineers actually love.',
    icon: '<path d="M4.5 16.5 3 21l4.5-1.5M14 6l4 4M9.5 14.5 16 8a3.5 3.5 0 0 0 0-5 3.5 3.5 0 0 0-5 0l-6.5 6.5"/>',
  },
  {
    title: 'Career & Community',
    desc: 'Growth, public speaking, and building communities that last.',
    icon: '<circle cx="12" cy="8" r="3.2"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/>',
  },
];

const socials = [
  { name: 'GitHub', href: 'https://github.com/farisaziz12', path: 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z' },
  { name: 'LinkedIn', href: 'https://linkedin.com/in/farisaziz12', path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  { name: 'X', href: 'https://twitter.com/FarisAziz12', path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
  { name: 'YouTube', href: 'https://www.youtube.com/@faziz-dev', path: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
  { name: 'Bluesky', href: 'https://bsky.app/profile/farisaziz.com', path: 'M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026' },
];

const formatEventDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return { day: d.getDate().toString(), month: d.toLocaleString('en-US', { month: 'short' }) };
};
---

<BaseLayout
  title="Faris Aziz — Staff Engineer & Conference Speaker"
  description={`Staff Software Engineer and Conference Speaker. ${stats.totalEvents} talks across ${stats.countries} countries. Based in Geneva.`}
  pathname=""
  image="/og/home.png"
  markdownAlternate="/home.md"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': 'https://faziz-dev.com/#faris',
          name: 'Faris Aziz',
          jobTitle: 'Staff Software Engineer & Conference Speaker',
          url: 'https://faziz-dev.com',
          address: { '@type': 'PostalAddress', addressLocality: 'Geneva', addressCountry: 'CH' },
          knowsAbout: ['React', 'Next.js', 'Payment Systems', 'Frontend Architecture', 'Web Performance', 'Developer Experience'],
          sameAs: [
            'https://github.com/farisaziz12',
            'https://linkedin.com/in/farisaziz12',
            'https://twitter.com/FarisAziz12',
            'https://www.youtube.com/@faziz-dev',
            'https://bsky.app/profile/farisaziz.com',
          ],
        },
        {
          '@type': 'WebSite',
          '@id': 'https://faziz-dev.com/#website',
          url: 'https://faziz-dev.com',
          name: 'Faris Aziz',
          publisher: { '@id': 'https://faziz-dev.com/#faris' },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://faziz-dev.com' },
            { '@type': 'ListItem', position: 2, name: 'Speaking', item: 'https://faziz-dev.com/speaking' },
            { '@type': 'ListItem', position: 3, name: 'Services', item: 'https://faziz-dev.com/services' },
          ],
        },
      ],
    })} />
  </Fragment>

  <!-- HERO — split with full-width mosaic that takes the right column (lg+) and stacks full-width on mobile/tablet -->
  <header class="hero-split-mosaic relative home-hero-v2">
    <div class="hero-split-mosaic__content">
      <div class="home-hero__content-inner">
        <div class="home-hero__terminal">
          <HeroTerminal client:idle />
        </div>

        <h1 class="home-hero__title">
          <span class="ln">Faris</span>
          <span class="ln accent-word">Aziz</span>
        </h1>

        <p class="home-hero__lead">
          Staff Software Engineer and Conference Speaker. I help teams ship resilient frontend systems and payment integrations — then I go talk about how on stage.
        </p>

        <div class="home-hero__stats">
          <div class="home-stat-inline">
            <b class="cu" data-to={stats.totalEvents}>0</b>
            <span>Events</span>
          </div>
          <div class="home-stat-inline">
            <b class="cu" data-to={stats.countries}>0</b>
            <span>Countries</span>
          </div>
          <div class="home-stat-inline">
            <b class="cu" data-to={stats.cities}>0</b>
            <span>Cities</span>
          </div>
        </div>

        <div class="home-hero__socials">
          {socials.map((s) => (
            <a href={s.href} class="ds-social" target="_blank" rel="noopener noreferrer" aria-label={s.name}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
            </a>
          ))}
          <span class="home-hero__socials-label">Follow my journey</span>
        </div>

        <div class="home-hero__actions">
          <a href="/invite" class="ds-btn ds-btn-primary ds-btn-lg">
            Invite me to speak
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="/speaking" class="ds-btn ds-btn-secondary ds-btn-lg">View upcoming events</a>
        </div>
      </div>
    </div>

    <div class="hero-split-mosaic__images">
      <div class="hero-mosaic-grid">
        {media.length > 0 ? (
          <>
            <div class="hero-mosaic-grid__item hero-mosaic-grid__item--large">
              {media[0]?.image && (
                <img
                  src={urlFor(media[0].image).width(1200).height(1200).quality(90).url()}
                  alt={media[0].description || 'Speaking at conference'}
                  loading="eager"
                  fetchpriority="high"
                  width="1200"
                  height="1200"
                />
              )}
            </div>
            <div class="hero-mosaic-grid__item">
              {media[1]?.image && (
                <img
                  src={urlFor(media[1].image).width(600).height(600).quality(90).url()}
                  alt={media[1].description || 'Conference moment'}
                  loading="eager"
                />
              )}
            </div>
            <div class="hero-mosaic-grid__item">
              {media[2]?.image && (
                <img
                  src={urlFor(media[2].image).width(600).height(600).quality(90).url()}
                  alt={media[2].description || 'Workshop'}
                  loading="eager"
                />
              )}
            </div>
            <div class="hero-mosaic-grid__item">
              {media[3]?.image && (
                <img
                  src={urlFor(media[3].image).width(600).height(600).quality(90).url()}
                  alt={media[3].description || 'Tech talk'}
                  loading="eager"
                />
              )}
            </div>
            <div class="hero-mosaic-grid__item">
              {media[4]?.image && (
                <img
                  src={urlFor(media[4].image).width(600).height(600).quality(90).url()}
                  alt={media[4].description || 'Speaking'}
                  loading="lazy"
                />
              )}
            </div>
            <div class="hero-mosaic-grid__item hero-mosaic-grid__item--wide">
              {media[5]?.image && (
                <img
                  src={urlFor(media[5].image).width(1200).height(600).quality(90).url()}
                  alt={media[5].description || 'Conference'}
                  loading="lazy"
                />
              )}
            </div>
            <div class="hero-mosaic-grid__item">
              {media[6]?.image && (
                <img
                  src={urlFor(media[6].image).width(600).height(600).quality(90).url()}
                  alt={media[6].description || 'Event'}
                  loading="lazy"
                />
              )}
            </div>
            <div class="hero-mosaic-grid__item">
              {media[7]?.image && (
                <img
                  src={urlFor(media[7].image).width(600).height(600).quality(90).url()}
                  alt={media[7].description || 'Presentation'}
                  loading="lazy"
                />
              )}
            </div>
          </>
        ) : (
          <>
            <div class="hero-mosaic-grid__item hero-mosaic-grid__item--large"></div>
            <div class="hero-mosaic-grid__item"></div>
            <div class="hero-mosaic-grid__item"></div>
            <div class="hero-mosaic-grid__item"></div>
            <div class="hero-mosaic-grid__item"></div>
            <div class="hero-mosaic-grid__item hero-mosaic-grid__item--wide"></div>
            <div class="hero-mosaic-grid__item"></div>
            <div class="hero-mosaic-grid__item"></div>
          </>
        )}
      </div>
    </div>
  </header>

  {nextEvent && (
    <section class="eventband">
      <div class="container">
        <div class="wide eventband__row">
          <Kicker plain variant="signal">
            <span class="ds-dot ds-dot--pulse"></span>Next up
          </Kicker>
          <div class="eventband__event">
            <div class="eventband__date">
              <b>{formatEventDate(nextEvent.date).day}</b>
              <span>{formatEventDate(nextEvent.date).month}</span>
            </div>
            <div>
              <div class="eventband__title">{nextEvent.title}</div>
              <div class="eventband__meta">
                {nextEvent.location?.city && `${nextEvent.location.city}${nextEvent.location.country ? ', ' + nextEvent.location.country : ''} · `}
                {nextEvent.conference}
              </div>
            </div>
          </div>
          <a href="/speaking" class="ds-link">
            All upcoming events
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- AUDIENCE ROUTER -->
  <section class="home-section home-section--router">
    <div class="container">
      <div class="home-section__head">
        <h2 class="home-section__title-sm">What brings you here?</h2>
        <span class="home-section__hint mono">Pick a path →</span>
      </div>
      <AudienceRouter />
    </div>
  </section>

  <!-- LOGO WALL -->
  {topConferences.length > 0 && (
    <section class="home-section-sm">
      <div class="container">
        <p class="home-logos__label">Trusted on stages at</p>
        <div class="home-logos">
          {topConferences.map((c) => (
            <span class={c.featured ? 'home-logos__item home-logos__item--featured' : 'home-logos__item'}>
              {c.featured && (
                <svg class="home-logos__star" viewBox="0 0 24 24" fill="currentColor" aria-label="Featured event">
                  <path d="M12 2l2.95 6.7L22 9.6l-5.2 4.9 1.3 7.1L12 18.2 5.9 21.6l1.3-7.1L2 9.6l7.05-.9z" />
                </svg>
              )}
              <span>{c.display}</span>
            </span>
          ))}
        </div>
        {topConferences.some((c) => c.featured) && (
          <p class="home-logos__legend">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l2.95 6.7L22 9.6l-5.2 4.9 1.3 7.1L12 18.2 5.9 21.6l1.3-7.1L2 9.6l7.05-.9z" />
            </svg>
            <span>Featured event</span>
          </p>
        )}
      </div>
    </section>
  )}

  <!-- FEATURED TALK -->
  {featured && <FeaturedTalk talk={featured} />}

  <!-- TOPICS -->
  <section class="home-section home-section--alt">
    <div class="container">
      <div class="home-section__heading">
        <Kicker class="ds-reveal">Topics &amp; Expertise</Kicker>
        <h2 class="home-h2 ds-reveal">What I <span class="mark">speak about</span></h2>
        <p class="home-lead ds-reveal">From technical deep-dives to career guidance — real systems I've shipped, on stage.</p>
      </div>
      <div class="home-topics">
        {topics.map((topic) => (
          <a href="/talks" class="ds-card ds-card-interactive home-topic ds-reveal">
            <IconChip>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={topic.icon} />
            </IconChip>
            <h3 class="home-topic__title">{topic.title}</h3>
            <p class="home-topic__desc">{topic.desc}</p>
          </a>
        ))}
      </div>
      <div class="home-topics__cta">
        <a href="/talks" class="ds-btn ds-btn-secondary">Explore all talks</a>
      </div>
    </div>
  </section>

  <!-- GLOBAL REACH MAP -->
  {reachCities.length > 0 && (
    <section class="home-section">
      <div class="container">
        <div class="home-section__heading">
          <Kicker class="ds-reveal">Global reach</Kicker>
          <h2 class="home-h2 ds-reveal">Talks across <span class="mark">{stats.countries} countries</span></h2>
          <p class="home-lead ds-reveal">From San Francisco to Singapore — {stats.totalEvents} events, {stats.cities} cities, all routed from a home base in Geneva.</p>
        </div>
        <ReachMap cities={reachCities} />
      </div>
    </section>
  )}

  <!-- IMPACT STATS -->
  <section class="home-section">
    <div class="container">
      <div class="home-section__heading">
        <Kicker class="ds-reveal">Measurable results</Kicker>
        <h2 class="home-h2 ds-reveal">Impact, in <span class="mark">plain numbers</span></h2>
      </div>
      <div class="wide home-impact ds-reveal">
        <div class="home-impact__cell">
          <span class="ds-tag">Community</span>
          <div class="ds-stat__value"><span class="cu" data-to={PROOF.communityMembers}>0</span></div>
          <div class="ds-stat__label">New members</div>
          <p class="ds-stat__note">{PROOF.communityNote}</p>
        </div>
        <div class="home-impact__cell">
          <span class="ds-tag">Leadership</span>
          <div class="ds-stat__value"><span class="cu" data-to={PROOF.engineersLed}>0</span></div>
          <div class="ds-stat__label">Engineers led</div>
          <p class="ds-stat__note">{PROOF.engineersNote}</p>
        </div>
        <div class="home-impact__cell">
          <span class="ds-tag">Product</span>
          <div class="ds-stat__value">
            <span class="cu" data-to={PROOF.revenueMultiplier} data-dec="1">0</span><span class="home-impact__signal">×</span>
          </div>
          <div class="ds-stat__label">Revenue increase</div>
          <p class="ds-stat__note">{PROOF.revenueNote}</p>
        </div>
      </div>
