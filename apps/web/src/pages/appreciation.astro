---
/**
 * What people say: every praise item, styled like the network it was posted
 * on and linked to the original. Topic + platform pills filter instantly and
 * sync to the URL (?topic=mentoring&platform=linkedin); without JS, all show.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/v3/Kicker.astro';
import PraiseCard from '../components/v3/PraiseCard.astro';
import FilterPills from '../components/v3/FilterPills.astro';
import { getAllPraise, currentMonthYear, PLATFORM_LABEL } from '../lib/sanity/v3';
import { praiseFilters, joinList } from '../lib/appreciation';
import { breadcrumbs } from '../lib/seo';

const praise = await getAllPraise();
const { topics, platforms } = praiseFilters(praise);

const present = new Set(praise.map((p) => p.platform));
const social = (['linkedin', 'x', 'bluesky'] as const).filter((p) => present.has(p)).map((p) => PLATFORM_LABEL[p]);
const others = [present.has('mentorcruise') && 'MentorCruise reviews', present.has('direct') && 'notes sent directly'].filter(
  (s): s is string => Boolean(s)
);
const allLinked = praise.length > 0 && praise.every((p) => p.url);
const lede = `${social.length ? `Public posts from ${joinList(social)}` : 'Kind words'}${others.length ? `, plus ${joinList(others)}` : ''}, shown the way they were posted${allLinked ? ', each linked to the original' : ''}.`;
---

<BaseLayout
  title="What people say | Faris Aziz"
  description="What people have said about Faris Aziz's talks, workshops, mentoring and ZurichJS, shown as posted and linked to the original."
  image="/og/appreciation.png"
  markdownAlternate="/appreciation.md"
  extraSchema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }, { name: 'What people say', path: '/appreciation' }])]}
>
  <div class="ds-wrap praise" data-filter-root>
    <header class="praise__head">
      <div class="praise__intro">
        <Kicker parts={['What people say']} />
        <h1 class="ds-h1 praise__title">What people have said about Faris.</h1>
        <p class="ds-lede">{lede}</p>
      </div>
      {praise.length > 0 && (
        <p class="ds-meta praise__count" aria-live="polite">
          <span data-filter-shown>{praise.length}</span> of {praise.length} shown · last checked {currentMonthYear()}
        </p>
      )}
    </header>

    {praise.length > 0 ? (
      <>
        <div class="praise__filters">
          {topics.length > 1 && <FilterPills name="topic" label="Topic" options={topics} allCount={praise.length} />}
          {platforms.length > 1 && <FilterPills name="platform" label="Platform" options={platforms} allLabel="All platforms" />}
        </div>

        <ul class="praise__grid" role="list">
          {praise.map((p) => (
            <li class="praise__item" data-filter-item data-topic={p.topic} data-platform={p.platform}>
              <PraiseCard praise={p} variant="platform" />
            </li>
          ))}
        </ul>

        <div class="ds-card ds-card--dashed praise__empty" data-filter-empty hidden>
          <p>Nothing matches both filters yet.</p>
          <button type="button" class="ds-btn ds-btn--outline ds-btn--sm" data-filter-reset>Show everything</button>
        </div>
      </>
    ) : (
      <div class="ds-card ds-card--dashed praise__empty">
        <p>No quotes collected yet. When someone posts about a talk, a workshop or ZurichJS, it will show up here, linked to the original.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .praise { padding-top: 48px; padding-bottom: 64px; }
  .praise__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px 40px; flex-wrap: wrap; margin-bottom: 24px; }
  .praise__intro { display: flex; flex-direction: column; gap: 14px; max-width: 680px; }
  .praise__intro :global(.ds-kicker) { margin: 0; }
  .praise__title { margin: 0; font-size: clamp(38px, 6vw, 52px); text-wrap: balance; }
  .praise__count { margin: 0; text-align: right; font-size: 13px; }
  .praise__filters { display: flex; justify-content: space-between; align-items: center; gap: 12px 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .praise__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 14px; }
  .praise__item { min-width: 0; }
  .praise__item > :global(*) { height: 100%; }
  .praise__empty { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .praise__empty p { margin: 0; color: rgb(var(--text-muted)); max-width: 60ch; }
  .praise__empty[hidden] { display: none; }

  @media (max-width: 1000px) {
    .praise__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .praise { padding-top: 32px; padding-bottom: 48px; }
    .praise__grid { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .praise__count { text-align: left; }
  }
</style>
