---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import GridTexture from '../components/design/GridTexture.astro';
import ContactPanel from '../components/design/ContactPanel.astro';
import AppreciationFilter from '../components/islands/AppreciationFilter';
import { client, urlFor } from '../lib/sanity/client';
import { allSocialPostsQuery, allTestimonialsQuery } from '../lib/sanity/queries';

const [socialPosts, testimonials] = await Promise.all([
  client.fetch(allSocialPostsQuery),
  client.fetch(allTestimonialsQuery),
]);

const platforms = [...new Set(socialPosts.map((p: any) => p.platform))];
const stats = {
  total: socialPosts.length + testimonials.length,
  posts: socialPosts.length,
  testimonials: testimonials.length,
  platforms: platforms.length,
};

const socialPostImages: Record<string, string> = {};
socialPosts.forEach((post: any) => {
  if (post.authorImage) {
    try { socialPostImages[post._id] = urlFor(post.authorImage).width(48).height(48).url(); } catch {}
  }
});
const testimonialImages: Record<string, string> = {};
testimonials.forEach((t: any) => {
  if (t.image) {
    try { testimonialImages[t._id] = urlFor(t.image).width(72).height(72).url(); } catch {}
  }
});
---

<BaseLayout
  title="Wall of appreciation | Faris Aziz"
  description="Kind words and mentions from the community about my talks and work."
  pathname="/appreciation"
>
  <header class="page-hero">
    <GridTexture />
    <div class="container page-hero__inner">
      <Kicker>From the community</Kicker>
      <h1 class="page-hero__title">
        The wall of <span class="accent-word">kind words</span>.
      </h1>
      <p class="page-hero__lead">
        Real feedback from conferences and colleagues. Every mention motivates me to keep sharing.
      </p>

      <div class="page-hero__stats">
        <div>
          <div class="ds-stat__value" style="font-size:2.2rem;">{stats.posts}</div>
          <div class="ds-stat__label">Social posts</div>
        </div>
        <div>
          <div class="ds-stat__value" style="font-size:2.2rem;">{stats.testimonials}</div>
          <div class="ds-stat__label">Testimonials</div>
        </div>
        <div>
          <div class="ds-stat__value" style="font-size:2.2rem;">{stats.platforms}</div>
          <div class="ds-stat__label">Platforms</div>
        </div>
      </div>

      <div class="page-hero__actions">
        <a href="#content" class="ds-btn ds-btn-primary ds-btn-lg">
          Explore feedback
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </header>

  <section id="content" class="page-section">
    <div class="container">
      <div class="page-section__heading">
        <Kicker class="ds-reveal">Community feedback</Kicker>
        <h2 class="page-h2 ds-reveal">What people <span class="mark">say</span></h2>
      </div>
      <AppreciationFilter
        client:load
        socialPosts={socialPosts}
        testimonials={testimonials}
        socialPostImages={socialPostImages}
        testimonialImages={testimonialImages}
      />
    </div>
  </section>

  <section class="page-section page-section--contact">
    <div class="container">
      <div class="wide ds-reveal">
        <ContactPanel
          status="Loved my work? Share it"
          title="Want to share your experience?"
          body="If you've attended one of my talks or worked with me, tag me on Bluesky or LinkedIn — I read every mention."
          primaryHref="https://bsky.app/profile/farisaziz.com"
          primaryLabel="Tag me on Bluesky"
          secondaryHref="https://linkedin.com/in/farisaziz12"
          secondaryLabel="Connect on LinkedIn"
        />
      </div>
    </div>
  </section>

  <script>
    function initPage() {
      document.querySelectorAll('.ds-reveal.in').forEach((el) => el.classList.remove('in'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.ds-reveal').forEach((el) => io.observe(el));
      window.setTimeout(() => {
        document.querySelectorAll('.ds-reveal:not(.in)').forEach((el) => el.classList.add('in'));
      }, 600);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage, { once: true });
    } else { initPage(); }
    document.addEventListener('astro:after-swap', initPage);
  </script>
</BaseLayout>
