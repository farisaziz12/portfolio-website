---
/**
 * Article: calm register. Kicker, title, lede, cover figure with caption,
 * dated corrections near the top, a 65ch body, the cream panel, then a
 * quiet related/share line. The band stays at the page edge only.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/v3/Kicker.astro';
import SanityImg from '../../components/v3/SanityImg.astro';
import PortableTextRenderer from '../../components/blog/PortableTextRenderer.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import Corrections from '../../components/blog/Corrections.astro';
import ArticleInvite from '../../components/blog/ArticleInvite.astro';
import ArticleFoot from '../../components/blog/ArticleFoot.astro';
import { TOPIC_SHORT } from 'shared';
import type { PortableTextBlock, ArbitraryTypedObject } from '@portabletext/types';
import { getWriting, fullDate } from '../../lib/sanity/v3';
import { getWritingPost } from '../../lib/writing-post';
import { breadcrumbs, SITE } from '../../lib/seo';

export async function getStaticPaths() {
  const items = await getWriting();
  return items.filter((i) => i.isInternal && i.href.startsWith('/blog/')).map((i) => ({ params: { slug: i.href.slice('/blog/'.length) } }));
}

const { slug } = Astro.params as { slug: string };
const [post, writing] = await Promise.all([getWritingPost(slug), getWriting()]);
if (!post) return Astro.redirect('/blog');

const item = writing.find((i) => i.href === `/blog/${slug}`);
const minutes = post.minutes ?? item?.minutes;
const related = writing
  .filter((i) => i.href !== `/blog/${slug}` && i.topic === post.topic)
  .slice(0, post.relatedTalk || post.relatedEvent ? 2 : 3);
const url = `${SITE}/blog/${slug}`;
const cover = post.coverImage?.asset ? post.coverImage : undefined;
const caption = cover ? [cover.caption || cover.alt, cover.credit ? `Photo: ${cover.credit}` : ''].filter(Boolean).join(' · ') : '';
const description = (post.seoDescription || post.excerpt || `${post.title}, by Faris Aziz.`).slice(0, 160);
---

<BaseLayout
  title={`${post.seoTitle || post.title} | Faris Aziz`}
  description={description}
  image={`/og/blog/${slug}.png`}
  imageAlt={post.title}
  article={true}
  publishedTime={post.publishedAt}
  markdownAlternate={`/blog/${slug}.md`}
  extraSchema={[
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Writing', path: '/blog' },
      { name: post.title, path: `/blog/${slug}` },
    ]),
    {
      '@type': 'BlogPosting',
      '@id': `${url}#article`,
      headline: post.title,
      description,
      url,
      mainEntityOfPage: { '@id': `${url}#page` },
      datePublished: post.publishedAt,
      ...(post.updatedAt ? { dateModified: post.updatedAt } : post.corrections.at(-1)?.date ? { dateModified: post.corrections.at(-1)!.date } : {}),
      author: { '@id': `${SITE}/#person` },
      image: `${SITE}/og/blog/${slug}.png`,
      ...(post.topic ? { articleSection: TOPIC_SHORT[post.topic] } : {}),
      ...(post.tags.length ? { keywords: post.tags.join(', ') } : {}),
      ...(minutes ? { timeRequired: `PT${minutes}M` } : {}),
    },
  ]}
>
  <div class="ds-wrap">
    <article class="art">
      <header class="art__head">
        <Kicker
          parts={[
            'Writing',
            post.topic ? TOPIC_SHORT[post.topic] : null,
            fullDate(post.publishedAt),
            minutes ? `${minutes} min read` : null,
          ]}
          mutedFirst
        />
        <h1 class="art__title">{post.title}</h1>
        {post.excerpt && <p class="art__lede">{post.excerpt}</p>}
        {post.updatedAt && <p class="ds-meta">Updated <time datetime={post.updatedAt}>{fullDate(post.updatedAt)}</time></p>}
      </header>

      <Corrections corrections={post.corrections} />

      {cover && (
        <figure class="art__cover">
          <SanityImg image={cover} alt={cover.alt ?? ''} ratio={2} widths={[480, 800, 1200, 1400]} sizes="(max-width: 760px) 100vw, 680px" loading="eager" fetchpriority="high" class="art__cover-img" />
          {caption && <figcaption class="art__caption">{caption}</figcaption>}
        </figure>
      )}

      <TableOfContents body={post.body as (PortableTextBlock | ArbitraryTypedObject)[]} />

      <PortableTextRenderer value={post.body as (PortableTextBlock | ArbitraryTypedObject)[]} />

      <ArticleInvite talk={post.relatedTalk} />

      <ArticleFoot post={post} url={url} related={related} />
    </article>
  </div>
</BaseLayout>

<style>
  .art { max-width: 680px; margin: 0 auto; padding: 64px 0 80px; display: flex; flex-direction: column; gap: 28px; }
  .art__head { display: flex; flex-direction: column; gap: 22px; }
  .art__title { font-size: clamp(36px, 6vw, 54px); line-height: 0.98; letter-spacing: -0.045em; font-weight: 800; }
  .art__lede { margin: 0; font-size: clamp(18px, 2vw, 21px); line-height: 1.45; color: rgb(var(--text-muted)); }
  .art__cover { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .art__cover :global(.art__cover-img) { width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; border-radius: var(--radius-card); }
  .art__caption { font-size: 12.5px; line-height: 1.45; color: rgb(var(--text-faint)); }
  .art :global(.ainv) { margin-top: 14px; }
  @media (max-width: 720px) {
    .art { padding: 36px 0 56px; gap: 22px; }
    .art__head { gap: 16px; }
  }
</style>
