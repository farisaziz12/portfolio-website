---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/design/Kicker.astro';
import GridTexture from '../components/design/GridTexture.astro';
import InviteForm from '../components/islands/InviteForm';
import HeadshotDownloader from '../components/islands/HeadshotDownloader';
import { sanityFetch, urlFor } from '../lib/sanity/client';
import {
  pastEventsQuery,
  featuredTestimonialsQuery,
  speakerProfileQuery,
  upcomingEventsQuery,
} from '../lib/sanity/queries';
import { topConferences } from '../lib/conferences';
import { bookingYears } from '../lib/availability';

interface PastEvent { _id: string; conference?: string }
interface Testimonial { _id: string; quote: string; author: string; role?: string; company?: string }

interface Headshot {
  _key?: string;
  asset: unknown;
  style?: 'formal' | 'casual' | 'speaking' | 'headshot';
  downloadable?: boolean;
  alt?: string;
}

interface PortableTextChild { text?: string }
interface PortableTextBlock { _type?: string; children?: PortableTextChild[] }

interface SpeakerProfile {
  bioShort?: string;
  bioMedium?: string;
  bioFull?: PortableTextBlock[];
  headshots?: Headshot[];
}

interface UpcomingEvent { _id: string; date: string }

const [pastEvents, testimonials, profile, upcomingEvents] = await Promise.all([
  sanityFetch<PastEvent[]>(pastEventsQuery).catch(() => []),
  sanityFetch<Testimonial[]>(featuredTestimonialsQuery).catch(() => []),
  sanityFetch<SpeakerProfile | null>(speakerProfileQuery).catch(() => null),
  sanityFetch<UpcomingEvent[]>(upcomingEventsQuery).catch(() => []),
]);

// ── Bios — three lengths, easy-copy ──────────────────────────────────────────
function portableTextToPlain(blocks: PortableTextBlock[] | undefined): string {
  if (!blocks) return '';
  return blocks
    .filter((b) => b._type === 'block')
    .map((b) => b.children?.map((c) => c.text || '').join('') || '')
    .join('\n\n');
}

const bios = [
  { id: 'short', label: 'Short', wordCount: '~50 words', text: profile?.bioShort || '' },
  { id: 'medium', label: 'Medium', wordCount: '~150 words', text: profile?.bioMedium || '' },
  { id: 'full', label: 'Full', wordCount: '300+ words', text: portableTextToPlain(profile?.bioFull) },
].filter((b) => b.text);

// ── Headshots — gallery + multi-resolution downloads ─────────────────────────
const styleLabels: Record<string, string> = {
  formal: 'Formal',
  casual: 'Casual',
  speaking: 'Speaking',
  headshot: 'Portrait',
};

const headshotResolutions = [
  { name: 'Small', width: 400, label: 'S', tooltip: 'Small (400px) — social & thumbnails' },
  { name: 'Medium', width: 800, label: 'M', tooltip: 'Medium (800px) — web use' },
  { name: 'Large', width: 1200, label: 'L', tooltip: 'Large (1200px) — print & high-res' },
  { name: 'Original', width: 0, label: 'XL', tooltip: 'Original — full resolution' },
];

const downloadableHeadshots: Headshot[] = (profile?.headshots ?? []).filter(
  (h) => h.downloadable !== false
);

const headshotData = downloadableHeadshots.map((headshot, index) => ({
  index,
  style: headshot.style || 'headshot',
  alt: headshot.alt || 'Faris Aziz speaker headshot',
  previewUrl: urlFor(headshot.asset as never).width(400).height(400).url(),
  fullUrl: urlFor(headshot.asset as never).width(1600).format('jpg').quality(95).url(),
  resolutions: headshotResolutions.map((res) => ({
    name: res.name,
    label: res.label,
    tooltip: res.tooltip,
    url: res.width > 0
      ? urlFor(headshot.asset as never).width(res.width).format('jpg').quality(95).url()
      : urlFor(headshot.asset as never).format('jpg').url(),
    filename: `faris-aziz-${headshot.style || 'headshot'}-${res.name.toLowerCase()}.jpg`,
  })),
}));

// ── Availability — 12-month calendar from upcoming events ────────────────────
const now = new Date();
const months = Array.from({ length: 12 }, (_, i) => {
  const date = new Date(now.getFullYear(), now.getMonth() + i, 1);
  const count = upcomingEvents.filter((e) => {
    const d = new Date(e.date);
    return d.getMonth() === date.getMonth() && d.getFullYear() === date.getFullYear();
  }).length;
  return {
    name: date.toLocaleString('en-US', { month: 'short' }),
    year: date.getFullYear(),
    count,
  };
});

type AvailabilityTone = 'open' | 'limited' | 'booked';
function getAvailabilityTone(count: number): { tone: AvailabilityTone; label: string } {
  if (count <= 2) return { tone: 'open', label: 'Open' };
  if (count <= 4) return { tone: 'limited', label: 'Limited' };
  return { tone: 'booked', label: 'Booked' };
}

// Top 6 conferences for the proof logo wall — shared aggregation (lib/conferences.ts).
const conferenceWall = topConferences(pastEvents);

// Pick up to 3 testimonials for the proof block (no hardcoded fallback — section
// only renders when Sanity actually returns content).
const proofQuotes = testimonials.slice(0, 3);
---

<BaseLayout
  title="Invite me to speak — Faris Aziz"
  description="Book Faris Aziz for your conference, meetup, or internal tech talk. Talks and workshops on production, scale, web performance, and engineering leadership."
  pathname="/invite"
  image="/og/invite.png"
  markdownAlternate="/invite.md"
>
  <!-- HERO -->
  <header class="invite-hero">
    <GridTexture />
    <div class="container invite-hero__inner">
      <nav class="invite-crumbs" aria-label="Breadcrumb">
        <a href="/speaking">Speaking</a>
        <span class="invite-crumbs__sep">/</span>
        <span class="invite-crumbs__cur">Invite me</span>
      </nav>
      <span class="ds-pill ds-pill--signal">
        <span class="ds-dot ds-dot--pulse"></span>
        Booking {bookingYears()} dates
      </span>
      <h1 class="invite-hero__title">
        Invite me to <span class="accent-word">your event</span>.
      </h1>
      <p class="invite-hero__lead">
        Conferences, meetups, internal tech talks, workshops — tell me about your audience and I'll tailor something to fit. I reply within two days.
      </p>
    </div>
  </header>

  <!-- FORM + WHAT YOU GET -->
  <section class="invite-main">
    <div class="container invite-grid wide">
      <!-- LEFT: what organizers get -->
      <aside class="invite-aside">
        <Kicker>What organizers get</Kicker>
        <h2 class="invite-h2">More than a talk</h2>
        <ul class="invite-offers">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5 9-11" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <div>
              <b>A talk tailored to your audience</b>
              <span>Not a canned deck — I adapt the case studies and depth to your crowd.</span>
            </div>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5 9-11" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <div>
              <b>Workshop option</b>
              <span>Most talks come with a hands-on, full-day workshop version.</span>
            </div>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5 9-11" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <div>
              <b>Promotion to my audience</b>
              <span>I'll share your event with engineers across my channels.</span>
            </div>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5 9-11" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <div>
              <b>An easy person to work with</b>
              <span>Clear comms, on time, and genuinely invested in making your event great.</span>
            </div>
          </li>
        </ul>

        <div class="invite-divider"></div>

        <dl class="invite-meta">
          <div>
            <dt>Formats</dt>
            <dd>Keynote · Talk · Workshop · Panel</dd>
          </div>
          <div>
            <dt>Travel from</dt>
            <dd>Geneva</dd>
          </div>
          <div>
            <dt>Topics</dt>
            <dd>Performance, payments, leadership, DX</dd>
          </div>
          <div>
            <dt>Notice</dt>
            <dd>4–6 weeks ideal</dd>
          </div>
        </dl>

        <p class="invite-crosslink">
          Not booking an event? I also do
          <a href="/consulting" class="ds-link">consulting</a> and
          <a href="/mentorship" class="ds-link">mentorship</a>.
        </p>
      </aside>

      <!-- RIGHT: form card -->
      <div class="invite-card">
        <InviteForm client:load />
      </div>
    </div>
  </section>

  <!-- AVAILABILITY -->
  <section class="invite-availability" id="availability">
    <div class="container">
      <header class="invite-section-head">
        <Kicker variant="signal">Booking calendar</Kicker>
        <h2 class="invite-h2">When I'm available</h2>
        <p class="invite-section-lead">Twelve months ahead. Tighter dates may still work — just ask.</p>
      </header>

      <div class="cal-grid">
        {months.map((m) => {
          const { tone, label } = getAvailabilityTone(m.count);
          return (
            <div class={`cal-month cal-month--${tone}`}>
              <div class="cal-month__top">
                <span class="cal-month__name">{m.name}</span>
                <span class="cal-month__year">{m.year}</span>
              </div>
              <span class={`cal-month__status cal-month__status--${tone}`}>
                <span class="cal-month__dot"></span>
                {label}
              </span>
              {m.count > 0 && (
                <span class="cal-month__count">{m.count} event{m.count > 1 ? 's' : ''}</span>
              )}
            </div>
          );
        })}
      </div>

      <div class="cal-legend">
        <span class="cal-legend__item cal-legend__item--open"><span class="cal-month__dot"></span>Open (0–2)</span>
        <span class="cal-legend__item cal-legend__item--limited"><span class="cal-month__dot"></span>Limited (3–4)</span>
        <span class="cal-legend__item cal-legend__item--booked"><span class="cal-month__dot"></span>Booked (5+)</span>
      </div>
    </div>
  </section>

  <!-- BIOS -->
  {bios.length > 0 && (
    <section class="invite-bios" id="bios">
      <div class="container">
        <header class="invite-section-head">
          <Kicker>Press kit · Bios</Kicker>
          <h2 class="invite-h2">Copy-paste a bio</h2>
          <p class="invite-section-lead">Three lengths for programs, websites, and intros. One click to copy.</p>
        </header>

        <div class="bio-card">
          <div class="bio-header">
            <div class="bio-pills" role="tablist" aria-label="Bio length">
              {bios.map((bio, i) => (
                <button
                  type="button"
                  class={`bio-pill ${i === 0 ? 'active' : ''}`}
                  data-bio-id={bio.id}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  {bio.label}
                  <span class="bio-pill__count">{bio.wordCount}</span>
                </button>
              ))}
            </div>
            <button type="button" class="bio-copy" id="bio-copy-btn" data-text={bios[0].text}>
              <svg class="bio-copy__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2"/>
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
              </svg>
              <span class="bio-copy__label">Copy</span>
            </button>
          </div>

          <div class="bio-content">
            {bios.map((bio, i) => (
              <div
                class={`bio-text ${i === 0 ? 'active' : ''}`}
                data-bio-content={bio.id}
                data-text={bio.text}
              >
                <p>{bio.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- SPEAKER RIDER -->
  <section class="invite-rider anchor-target" id="rider">
    <div class="container">
      <header class="invite-section-head">
        <Kicker>Press kit · Rider</Kicker>
        <h2 class="invite-h2">The stuff I love to know</h2>
        <p class="invite-section-lead">None of this is a dealbreaker — it just saves us a round of emails. If something doesn't fit your event, tell me and we'll figure it out.</p>
      </header>

      <div class="rider-grid wide">
        <div class="ds-card rider-item">
          <h3 class="rider-item__title">Honorarium</h3>
          <p class="rider-item__body">Let's talk — it scales with the event and your budget. Community meetups are usually on the house, and if budget is tight, just say so. I'd rather make it work than miss a great event.</p>
        </div>
        <div class="ds-card rider-item">
          <h3 class="rider-item__title">Travel &amp; lodging</h3>
          <p class="rider-item__body">For in-person events outside the Geneva / Zurich area, I'll ask you to cover travel and a place to sleep. Economy is totally fine — direct routes are a nice bonus.</p>
        </div>
        <div class="ds-card rider-item">
          <h3 class="rider-item__title">Code of conduct</h3>
          <p class="rider-item__body">I love events with a published, enforced code of conduct. Don't have one yet? No stress — I'm happy to point you at great templates.</p>
        </div>
        <div class="ds-card rider-item">
          <h3 class="rider-item__title">Recording &amp; slides</h3>
          <p class="rider-item__body">Please record it! Just send me the link after — I love sharing talks. Slides stay mine, but share them with your attendees as much as you like.</p>
        </div>
        <div class="ds-card rider-item">
          <h3 class="rider-item__title">A/V setup</h3>
          <p class="rider-item__body">HDMI or USB-C and we're good. For workshops, a lapel or headset mic and solid attendee Wi-Fi make everything ten times better.</p>
        </div>
        <div class="ds-card rider-item">
          <h3 class="rider-item__title">Promotion</h3>
          <p class="rider-item__body">I'll shout about your event to my audience before and after. Tag me in your posts and I'll amplify them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HEADSHOTS -->
  {headshotData.length > 0 && (
    <section class="invite-headshots" id="headshots">
      <div class="container">
        <header class="invite-section-head">
          <Kicker>Press kit · Headshots</Kicker>
          <h2 class="invite-h2">Headshots</h2>
          <p class="invite-section-lead">High-resolution photos for event programs and promotion. Click to preview, pick a size to download.</p>
        </header>

        <div class="headshot-gallery">
          {headshotData.map((data) => (
            <article class="headshot-card" data-headshot-index={data.index} data-full-url={data.fullUrl}>
              <button type="button" class="headshot-card__image" aria-label={`Preview ${styleLabels[data.style] || data.style} headshot`}>
                <img src={data.previewUrl} alt={data.alt} loading="lazy" />
                <span class="headshot-card__overlay">
                  <span class="headshot-card__expand" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
                    </svg>
                  </span>
                </span>
              </button>
              <div class="headshot-card__info">
                <span class="headshot-card__style">{styleLabels[data.style] || data.style}</span>
                <HeadshotDownloader
                  client:load
                  resolutions={data.resolutions}
                  previewUrl={data.previewUrl}
                />
              </div>
            </article>
          ))}
        </div>

        <p class="headshot-guide">
          <span>Size guide:</span> S · social · M · web · L · print · XL · original
        </p>
      </div>
    </section>
  )}

  <!-- Lightbox (rendered only if headshots exist) -->
  {headshotData.length > 0 && (
    <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-label="Headshot preview">
      <button type="button" class="lightbox__btn lightbox__close" aria-label="Close preview">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <button type="button" class="lightbox__btn lightbox__prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button type="button" class="lightbox__btn lightbox__next" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      <div class="lightbox__content">
        <img class="lightbox__image" src="" alt="" />
      </div>
      <div class="lightbox__counter"></div>
    </div>
  )}

  <!-- PROOF -->
  {(conferenceWall.length > 0 || proofQuotes.length > 0) && (
    <section class="invite-proof">
      <div class="container">
        {conferenceWall.length > 0 && (
          <>
            <p class="invite-proof__label">Recently on stage at</p>
            <div class="invite-proof__logos">
              {conferenceWall.map((c) => <span>{c}</span>)}
            </div>
          </>
        )}
        {proofQuotes.length > 0 && (
          <div class="invite-proof__quotes">
            {proofQuotes.map((q) => (
              <div class="ds-card invite-proof__quote ds-reveal">
                <p>"{q.quote}"</p>
                <p class="invite-proof__quote-who">
                  {q.author}{(q.role || q.company) && ` · ${[q.role, q.company].filter(Boolean).join(' · ')}`}
                </p>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <script>
    function initInvite() {
      // ── Scroll-reveal ─────────────────────────────────────────────────────
      document.querySelectorAll('.ds-reveal.in').forEach((el) => el.classList.remove('in'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.ds-reveal').forEach((el) => io.observe(el));
      window.setTimeout(() => {
        document.querySelectorAll('.ds-reveal:not(.in)').forEach((el) => el.classList.add('in'));
      }, 600);

      // ── Bio pills ─────────────────────────────────────────────────────────
      const copyBtn = document.getElementById('bio-copy-btn');
      document.querySelectorAll('.bio-pill').forEach((pill) => {
        pill.addEventListener('click', () => {
          const bioId = pill.getAttribute('data-bio-id');
          if (!bioId) return;
          document.querySelectorAll('.bio-pill').forEach((p) => {
            p.classList.remove('active');
            p.setAttribute('aria-selected', 'false');
          });
          pill.classList.add('active');
          pill.setAttribute('aria-selected', 'true');
          document.querySelectorAll('.bio-text').forEach((t) => t.classList.remove('active'));
          const active = document.querySelector(`[data-bio-content="${bioId}"]`);
          active?.classList.add('active');
          const text = active?.getAttribute('data-text') || '';
          if (copyBtn) copyBtn.setAttribute('data-text', text);
        });
      });

      // ── Copy button ───────────────────────────────────────────────────────
      copyBtn?.addEventListener('click', async () => {
        const text = copyBtn.getAttribute('data-text') || '';
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          // Fallback: textarea trick for older browsers
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch { /* ignore */ }
          document.body.removeChild(ta);
        }
        const label = copyBtn.querySelector('.bio-copy__label');
        if (!label) return;
        const original = label.textContent;
        label.textContent = 'Copied';
        copyBtn.classList.add('bio-copy--done');
        window.setTimeout(() => {
          label.textContent = original;
          copyBtn.classList.remove('bio-copy--done');
        }, 1500);
      });

      // ── Lightbox ──────────────────────────────────────────────────────────
      const lightbox = document.getElementById('lightbox');
      if (lightbox) {
        const image = lightbox.querySelector('.lightbox__image') as HTMLImageElement | null;
        const counter = lightbox.querySelector('.lightbox__counter') as HTMLElement | null;
        const cards = Array.from(document.querySelectorAll('[data-headshot-index]'));
        const urls = cards.map((el) => el.getAttribute('data-full-url') || '');
        const alts = cards.map((el) => el.querySelector('img')?.getAttribute('alt') || '');
        let current = 0;

        const open = (i: number) => {
          if (!image || !urls[i]) return;
          current = i;
          image.src = urls[i];
          image.alt = alts[i] || '';
          if (counter) counter.textContent = `${i + 1} / ${urls.length}`;
          lightbox.classList.add('open');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        };
        const close = () => {
          lightbox.classList.remove('open');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        };
        const nav = (dir: number) => open((current + dir + urls.length) % urls.length);

        cards.forEach((card) => {
          card.querySelector('.headshot-card__image')?.addEventListener('click', () => {
            const idx = parseInt(card.getAttribute('data-headshot-index') || '0', 10);
            open(idx);
          });
        });
        lightbox.querySelector('.lightbox__close')?.addEventListener('click', close);
        lightbox.querySelector('.lightbox__prev')?.addEventListener('click', () => nav(-1));
        lightbox.querySelector('.lightbox__next')?.addEventListener('click', () => nav(1));
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) close();
        });
        document.addEventListener('keydown', (e) => {
          if (!lightbox.classList.contains('open')) return;
          if (e.key === 'Escape') close();
          if (e.key === 'ArrowLeft') nav(-1);
          if (e.key === 'ArrowRight') nav(1);
        });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initInvite, { once: true });
    } else {
      initInvite();
    }
    document.addEventListener('astro:after-swap', initInvite);
  </script>
</BaseLayout>

<style is:global>
  /* Form styles are also declared in global.css so the MentorshipInquiryForm on
     /mentorship picks them up. Kept here too as a safety net during the migration. */
  .invite-form { display: block; }
  .invite-form__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.3rem;
    color: rgb(var(--ink));
    margin-bottom: 1.4rem;
  }
  .invite-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  @media (max-width: 540px) {
    .invite-form__grid { grid-template-columns: 1fr; }
  }
  .invite-form__field { display: flex; flex-direction: column; gap: 0.45rem; }
  .invite-form__field--full { grid-column: 1 / -1; }
  .invite-form__field label,
  .invite-form__label {
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--ink-faint));
  }
  .invite-form__input {
    width: 100%;
    background: rgb(var(--surface-1));
    border: 1px solid rgb(var(--edge-strong));
    border-radius: 10px;
    padding: 0.8rem 1rem;
    color: rgb(var(--ink));
    font-family: inherit;
    font-size: 0.98rem;
    transition: border-color 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }
