---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import InviteForm from '../components/islands/InviteForm';
import AvailabilityCard from '../components/invite/AvailabilityCard.astro';
import duckCelebrating from '../assets/illustrations/duck-celebrating.png';
import { getAvailability, getProfile, getUpcomingEngagements } from '../lib/sanity/v3';
import { breadcrumbs } from '../lib/seo';

const [profile, availability, upcoming] = await Promise.all([getProfile(), getAvailability(), getUpcomingEngagements()]);

// The island can't use <Illustration>, so hand it the optimised asset.
const duck1x = await getImage({ src: duckCelebrating, width: 120, format: 'webp', quality: 82 });
const duck2x = await getImage({ src: duckCelebrating, width: 240, format: 'webp', quality: 82 });
const art = {
  src: duck1x.src,
  srcset: `${duck1x.src} 120w, ${duck2x.src} 240w`,
  width: 120,
  height: Math.round((120 * duckCelebrating.height) / duckCelebrating.width),
};

const booked = upcoming.slice(0, 6);
// CMS lead time (availability doc) wins over the profile's "Lead time" row.
const lead = availability.leadTime;
const goodToKnow = profile.goodToKnow.some((r) => /lead time/i.test(r.label))
  ? profile.goodToKnow.map((r) => (lead && /lead time/i.test(r.label) ? { ...r, body: lead } : r))
  : [...profile.goodToKnow, ...(lead ? [{ label: 'Lead time', body: lead }] : [])];
const description = `Invite Faris Aziz to a conference, meetup, podcast, workshop, panel or interview. Tell him a bit about it; he replies within ${profile.replyTime}.`;
---

<BaseLayout
  title="Invite me · Faris Aziz"
  description={description.length > 160 ? description.slice(0, 157) + '…' : description}
  image="/og/invite.png"
  markdownAlternate="/invite.md"
  extraSchema={[breadcrumbs([{ name: 'Speaking', path: '/speaking' }, { name: 'Invite me', path: '/invite' }])]}
>
  <div class="ds-wrap invite">
    <div class="invite__main">
      <header class="invite__intro">
        <p class="ds-kicker"><a class="invite__crumb" href="/speaking">Speaking</a> <span aria-hidden="true">·</span> Invite me <span aria-hidden="true">·</span> talks, podcasts, panels and more</p>
        <h1 class="ds-h1 invite__h1">What did you have in mind?</h1>
        <p class="ds-lede invite__lede">
          A conference or a meetup, a podcast or livestream, a workshop for your team, a panel, a guest piece, or something
          that doesn’t fit a box. Tell me a bit about it and I’ll reply within {profile.replyTime}.
        </p>
      </header>

      <InviteForm client:idle replyTime={profile.replyTime} art={art} pressKitHref="/press-kit" linkedin={profile.links.linkedin} />
    </div>

    <aside class="invite__aside" aria-label="Before you send">
      <section class="ds-card invite__know" aria-labelledby="know-h">
        <h2 id="know-h" class="invite__label">Good to know</h2>
        <dl class="ds-dl invite__dl">
          {goodToKnow.map((row) => (
            <>
              <dt>{row.label}</dt>
              <dd>{row.body}</dd>
            </>
          ))}
        </dl>
      </section>

      <AvailabilityCard months={availability.months} booked={booked} />

      <a class="ds-card invite__press" href="/press-kit" data-track="invite_press_kit">
        <span class="invite__label">Press kit</span>
        <span class="invite__press-title">Bios, headshots, stage photos, rider</span>
      </a>
    </aside>
  </div>
</BaseLayout>

<style>
  .invite {
    display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 56px;
    padding-top: 48px; padding-bottom: 64px; align-items: start;
  }
  .invite__main { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .invite__intro { display: flex; flex-direction: column; gap: 14px; }
  .invite__crumb { color: rgb(var(--text-muted)); text-decoration: none; }
  .invite__crumb:hover { color: rgb(var(--text)); }
  .invite__h1 { margin: 0; font-size: clamp(38px, 5.4vw, 52px); text-wrap: balance; }
  .invite__lede { font-size: 17px; max-width: 56ch; }

  .invite__aside { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .invite__label { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--accent-text)); }
  .invite__know { padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .invite__dl { grid-template-columns: auto 1fr; gap: 6px 14px; font-size: 14px; line-height: 1.5; }
  .invite__press { padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; }
  .invite__press-title { font-weight: 800; font-size: 16px; }

  @media (max-width: 960px) {
    .invite { grid-template-columns: minmax(0, 1fr); gap: 40px; }
  }
  @media (max-width: 720px) {
    .invite { padding-top: 32px; padding-bottom: 48px; }
  }
</style>
