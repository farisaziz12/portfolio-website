---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SessionCard from '../../components/events/SessionCard.astro';
import EventResources from '../../components/events/EventResources.astro';
import EventAside from '../../components/events/EventAside.astro';
import PraiseCard from '../../components/v3/PraiseCard.astro';
import Icon from '../../components/v3/Icon.astro';
import {
  eventPlace,
  fullDate,
  getAllEvents,
  getPhotos,
  getPraiseFor,
  getTalks,
  getUpcomingEvents,
  getWorkshops,
  weekday,
  type EventEdition,
  type Session,
} from '../../lib/sanity/v3';
import { kindLabel, sessionSummary } from '../../lib/events-view';
import { breadcrumbs, eventSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const events = await getAllEvents();
  return events.map((e) => ({ params: { slug: e.slug }, props: { event: e } }));
}

const e = Astro.props.event as EventEdition;
const [talks, workshops, photos, praise, upcoming] = await Promise.all([
  getTalks(),
  getWorkshops(),
  getPhotos(),
  getPraiseFor({ eventId: e._id }),
  getUpcomingEvents(),
]);

function describe(s: Session): string | undefined {
  if (s.talk) {
    const t = talks.find((x) => x._id === s.talk!._id);
    return t?.summary || t?.abstract || s.talk.summary;
  }
  if (s.workshop) {
    const w = workshops.find((x) => x._id === s.workshop!._id);
    return w?.summary || w?.description;
  }
  return s.title ? s.detail : undefined;
}

const eventPhotos = photos.filter((p) => p.event?._id === e._id);
const cover = e.coverImage?.asset ? e.coverImage : eventPhotos[0]?.image;
const coverAlt = (e.coverImage?.asset ? e.coverImage.alt : eventPhotos[0]?.image.alt) || `${e.title}`;
const next = upcoming.find((x) => x.slug !== e.slug);
const place = eventPlace(e, { venue: true });
const dates = e.endDate && e.endDate !== e.date ? `${fullDate(e.date)} – ${fullDate(e.endDate)}` : fullDate(e.date);
const days = e.endDate && e.endDate !== e.date ? `${weekday(e.date)} – ${weekday(e.endDate)}` : weekday(e.date);

const summary = sessionSummary(e);
const description = [
  `${e.title}, ${fullDate(e.date)}${place ? `, ${place}` : ''}.`,
  summary ? `${summary}.` : '',
  e.isUpcoming ? 'Upcoming.' : '',
]
  .filter(Boolean)
  .join(' ')
  .slice(0, 160);
---

<BaseLayout
  title={`${e.title} · ${fullDate(e.date)} | Faris Aziz`}
  description={description}
  image={`/og/events/${e.slug}.png`}
  content={{ type: 'event', slug: e.slug, title: e.title, upcoming: e.isUpcoming, roles: e.buckets.join(' '), country: e.location.country }}
  markdownAlternate={`/events/${e.slug}.md`}
  extraSchema={[
    eventSchema(e),
    breadcrumbs([
      { name: 'Speaking', path: '/speaking' },
      { name: 'Events', path: '/events' },
      { name: e.title, path: `/events/${e.slug}` },
    ]),
  ]}
>
  <div class="ds-wrap evp">
    <div class="evp__main">
      <header class="evp__head">
        <p class="ds-kicker">
          <a href="/events" class="is-muted evp__crumb">Schedule</a><span aria-hidden="true"> · </span>{kindLabel(e)}<span aria-hidden="true"> · </span>{e.isUpcoming ? 'Upcoming' : 'Past'}
        </p>
        <h1 class="ds-h1 evp__title">{e.title}</h1>
        <p class="evp__facts">
          <span><strong><time datetime={e.date}>{dates}</time></strong> · {days}</span>
          {place && <span>{place}</span>}
          {e.url && (
            <span>
              <a href={e.url} class="evp__site" target="_blank" rel="noopener noreferrer" data-track="event_site">
                Event site <Icon name="external" size={11} /><span class="sr-only"> (opens in a new tab)</span>
              </a>
            </span>
          )}
        </p>
        {e.description && <p class="ds-body evp__desc">{e.description}</p>}
      </header>

      <section class="evp__sessions" aria-labelledby="sess-h">
        <h2 id="sess-h" class="ds-label">My sessions at this edition</h2>
        {e.sessions.length ? (
          e.sessions.map((s) => <SessionCard event={e} session={s} description={describe(s)} />)
        ) : (
          <p class="ds-body">No session recorded for this edition.</p>
        )}
      </section>

      <EventResources event={e} photoCount={eventPhotos.length} photosCredited={eventPhotos.length > 0 && eventPhotos.every((p) => p.credit || p.image.credit)} />

      {praise.length > 0 && (
        <section class="evp__praise" aria-labelledby="praise-h">
          <h2 id="praise-h" class="ds-label">From this edition</h2>
          {praise.slice(0, 2).map((p) => <PraiseCard praise={p} variant="stripe" />)}
        </section>
      )}
    </div>

    <EventAside event={e} cover={cover} coverAlt={coverAlt} next={next} />
  </div>
</BaseLayout>

<style>
  .evp { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 56px; padding-top: 48px; padding-bottom: 64px; }
  .evp__main { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .evp__head { display: flex; flex-direction: column; gap: 14px; }
  .evp__crumb { text-decoration: none; }
  .evp__crumb:hover { color: rgb(var(--text)); }
  .evp__title { font-size: clamp(38px, 6vw, 52px); overflow-wrap: anywhere; }
  .evp__facts { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 0; font-size: 15px; color: rgb(var(--text-muted)); }
  .evp__facts strong { color: rgb(var(--text)); }
  .evp__site { color: rgb(var(--text)); text-decoration: underline; text-underline-offset: 0.2em; text-decoration-color: rgb(var(--yellow)); display: inline-flex; align-items: center; gap: 4px; }
  .evp__site:hover { color: rgb(var(--accent-text)); }
  .evp__desc { margin: 0; max-width: 60ch; }
  .evp__sessions, .evp__praise { display: flex; flex-direction: column; gap: 12px; }
  @media (max-width: 960px) {
    .evp { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 36px; }
  }
</style>
