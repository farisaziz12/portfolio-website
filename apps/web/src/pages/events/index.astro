---
/**
 * Schedule: the next stage appearance on the skewed band, the rest of the
 * calendar as a tour list, then the archive as one city block per year.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NextOnStage from '../../components/events/NextOnStage.astro';
import ThenList from '../../components/events/ThenList.astro';
import ArchiveTour from '../../components/events/ArchiveTour.astro';
import EventTotals from '../../components/events/EventTotals.astro';
import { getPastEvents, getSpeakingStats, getUpcomingEvents, speakingLine } from '../../lib/sanity/v3';
import { isOnStage } from '../../lib/events-view';
import { breadcrumbs, itemList } from '../../lib/seo';

const [upcoming, past, stats] = await Promise.all([getUpcomingEvents(), getPastEvents(), getSpeakingStats()]);

// Upcoming is soonest first: the hero is the next talk or workshop, everything else follows.
const lead = upcoming.find(isOnStage);
const then = upcoming.filter((e) => e !== lead);

const line = speakingLine(stats);
const archiveTitle = `${line.charAt(0).toUpperCase()}${line.slice(1)}${stats.hosted ? `, plus ${stats.hosted} hosted` : ''}.`;

const schema = [
  breadcrumbs([
    { name: 'Speaking', path: '/speaking' },
    { name: 'Events', path: '/events' },
  ]),
  ...(upcoming.length ? [itemList('Upcoming appearances', upcoming.map((e) => `/events/${e.slug}`))] : []),
];
---

<BaseLayout
  title="Schedule: upcoming and past events | Faris Aziz"
  description="Upcoming talks and workshops by Faris Aziz, plus the full archive of conferences and meetups with my role at each: spoke, ran a workshop, hosted or attended."
  image="/og/events.png"
  markdownAlternate="/events.md"
  extraSchema={schema}
>
  <div class="ds-wrap">
    <header class="ev-hero">
      <div class="ev-hero__main">
        <p class="ds-kicker"><a href="/speaking" class="is-muted ev-crumb">Speaking</a><span aria-hidden="true"> · </span>Schedule</p>
        <h1 class="ds-h1">My upcoming events, and all the past ones.</h1>
      </div>
      <p class="ds-lede ev-hero__lede">
        The next few are at the top. Below that is every event I've been part of, whether I gave a talk, ran a
        workshop, hosted, or just went to listen.
      </p>
    </header>

    {past.length > 0 && !stats.fallback && <EventTotals stats={stats} events={past.length} />}

    {lead && <NextOnStage event={lead} />}

    {then.length > 0 && <ThenList events={then} heading={lead ? 'Then' : 'Upcoming'} />}

    {!upcoming.length && (
      <p class="ds-card ds-card--dashed ev-up__empty">
        No public dates confirmed right now. <a href="/invite" class="ds-textlink" data-track="events_empty_invite">Invite me to yours</a>.
      </p>
    )}

    <section class="ev-arch" aria-labelledby="ev-arch-h">
      <div class="ev-arch__head">
        <p class="ds-kicker">Archive</p>
        <h2 id="ev-arch-h" class="ev-arch__title">{archiveTitle}</h2>
      </div>
      {past.length ? <ArchiveTour events={past} /> : <p class="ev-empty">Nothing here yet.</p>}
    </section>
  </div>
</BaseLayout>

<style>
  .ev-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px 48px; padding: 48px 0 36px; }
  .ev-hero__main { display: flex; flex-direction: column; gap: 14px; max-width: 700px; }
  .ev-crumb { text-decoration: none; }
  .ev-crumb:hover { color: rgb(var(--text)); }
  .ev-hero .ds-h1 { font-size: clamp(38px, 6vw, 52px); }
  .ev-hero__lede { font-size: 15px; max-width: 34ch; margin: 0; color: rgb(var(--text-muted)); }

  .ev-up__empty { margin: 0 0 48px; font-size: 15px; color: rgb(var(--text-muted)); }

  .ev-arch { display: flex; flex-direction: column; gap: 20px; padding: 16px 0 64px; }
  .ev-arch__head { display: flex; flex-direction: column; gap: 10px; }
  .ev-arch__title { font-size: clamp(26px, 3.2vw, 34px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.08; max-width: 26ch; text-wrap: balance; }
  .ev-empty { margin: 0; padding: 24px 0; font-size: 17px; font-weight: 800; letter-spacing: -0.02em; border-top: 1px solid rgb(var(--hairline)); }

  @media (max-width: 860px) {
    .ev-hero { flex-direction: column; align-items: flex-start; }
    .ev-hero__lede { max-width: 60ch; }
  }
</style>
