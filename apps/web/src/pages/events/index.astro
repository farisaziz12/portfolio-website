---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterPills from '../../components/v3/FilterPills.astro';
import UpcomingCard from '../../components/events/UpcomingCard.astro';
import ArchiveRow from '../../components/events/ArchiveRow.astro';
import { ROLE_BUCKETS } from 'shared';
import { getPastEvents, getSpeakingStats, getUpcomingEvents, yearOf, type EventEdition } from '../../lib/sanity/v3';
import { breadcrumbs, itemList } from '../../lib/seo';
import { countryCode, getCountryFlag } from '../../lib/flags';

const [upcoming, past, stats] = await Promise.all([getUpcomingEvents(), getPastEvents(), getSpeakingStats()]);

const FLAG_LIMIT = 18;
const flagged = stats.countryList.filter((c) => countryCode(c));
const flags = flagged.slice(0, FLAG_LIMIT).map((c) => ({ country: c, flag: getCountryFlag(c) }));
const moreFlags = flagged.length - flags.length;

// Archive: past only, grouped by year (newest first; loaders return date-desc).
const years: { year: number; events: EventEdition[] }[] = [];
for (const e of past) {
  const y = yearOf(e.date);
  const g = years.find((x) => x.year === y);
  if (g) g.events.push(e);
  else years.push({ year: y, events: [e] });
}
const roleOptions = ROLE_BUCKETS.map((b) => ({ value: b.value, label: b.title }));

const schema = [
  breadcrumbs([
    { name: 'Speaking', path: '/speaking' },
    { name: 'Events', path: '/events' },
  ]),
  ...(upcoming.length ? [itemList('Upcoming appearances', upcoming.map((e) => `/events/${e.slug}`))] : []),
];
---

<BaseLayout
  title="Schedule: where I'll be, and where I've been | Faris Aziz"
  description="Upcoming talks and workshops by Faris Aziz, plus the full archive of events with my role at each: spoke, ran a workshop, hosted or attended."
  image="/og/events.png"
  markdownAlternate="/events.md"
  extraSchema={schema}
>
  <div class="ds-wrap">
    <header class="ev-hero">
      <p class="ds-kicker"><a href="/speaking" class="is-muted ev-crumb">Speaking</a><span aria-hidden="true"> · </span>Schedule</p>
      <h1 class="ds-h1">Where I'll be, and where I've been.</h1>
      <p class="ds-lede">
        Upcoming first. The archive separates what I did at each event: spoke, ran a workshop, hosted, or just attended.
        Status is computed from the event's own timezone, so Alicante doesn't stay “upcoming” a week late.
      </p>
    </header>

    {stats.countries > 0 && (
      <div class="ev-flags">
        <span class="ds-kicker">{stats.countries} {stats.countries === 1 ? 'country' : 'countries'}</span>
        <span class="ev-flags__row" role="img" aria-label={`Countries: ${flagged.join(', ')}`}>
          {flags.map((f) => <span title={f.country}>{f.flag}</span>)}
        </span>
        {moreFlags > 0 && <span class="ev-flags__more" aria-hidden="true">+{moreFlags}</span>}
      </div>
    )}

    <section class="ev-up" aria-labelledby="ev-up-h">
      <h2 id="ev-up-h" class="ev-label">Upcoming · {upcoming.length} confirmed</h2>
      {upcoming.length ? (
        <ul class="ds-grid-2 ev-up__grid" role="list">
          {upcoming.map((e) => <li><UpcomingCard event={e} /></li>)}
        </ul>
      ) : (
        <p class="ds-card ds-card--dashed ev-up__empty">
          No public dates confirmed right now. <a href="/invite" class="ds-textlink" data-track="events_empty_invite">Invite me to yours</a>.
        </p>
      )}
    </section>

    <section class="ev-arch" aria-labelledby="ev-arch-h" data-filter-root>
      <div class="ev-arch__head">
        <h2 id="ev-arch-h" class="ev-label">
          Archive · <span data-filter-shown>{past.length}</span> shown · {stats.eventRecords} records total
        </h2>
        <FilterPills name="role" options={roleOptions} />
      </div>

      {years.map((g) => (
        <section class="ev-year" data-filter-group aria-label={String(g.year)}>
          <h3 class="ev-year__label">{g.year}</h3>
          <ol class="ds-rows">
            {g.events.map((e) => <ArchiveRow event={e} />)}
          </ol>
        </section>
      ))}

      <div class="ev-empty" data-filter-empty hidden>
        <p>Nothing here yet.</p>
        <button type="button" class="ds-btn ds-btn--outline ds-btn--sm" data-filter-reset>Show everything</button>
      </div>
      {!past.length && <p class="ev-empty">Nothing here yet.</p>}
    </section>
  </div>
</BaseLayout>

<style>
  .ev-hero { display: flex; flex-direction: column; gap: 14px; max-width: 700px; padding: 48px 0 28px; }
  .ev-crumb { text-decoration: none; }
  .ev-crumb:hover { color: rgb(var(--text)); }
  .ev-hero .ds-h1 { font-size: clamp(38px, 6vw, 52px); }
  .ev-hero .ds-lede { font-size: 17px; }

  .ev-flags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin-bottom: 32px; }
  .ev-flags .ds-kicker { margin-right: 8px; }
  .ev-flags__row { display: inline-flex; flex-wrap: wrap; gap: 0 4px; font-size: 20px; line-height: 1.3; }
  .ev-flags__more { font-size: 13px; color: rgb(var(--text-faint)); }

  .ev-label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--accent-text)); margin: 0; }
  .ev-up { display: flex; flex-direction: column; gap: 14px; padding: 8px 0 40px; }
  .ev-up__grid { list-style: none; margin: 0; padding: 0; }
  .ev-up__empty { margin: 0; font-size: 15px; color: rgb(var(--text-muted)); }

  .ev-arch { display: flex; flex-direction: column; gap: 16px; padding-bottom: 64px; }
  .ev-arch__head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px 20px; }
  .ev-year__label { font-size: 13px; font-weight: 700; letter-spacing: 0.12em; color: rgb(var(--text-faint)); padding: 10px 0 8px; }
  .ev-year + .ev-year { margin-top: 8px; }
  .ev-empty { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 24px 0; border-top: 1px solid rgb(var(--hairline)); }
  .ev-empty p, p.ev-empty { margin: 0; font-size: 17px; font-weight: 800; letter-spacing: -0.02em; }
  .ev-empty[hidden] { display: none; }
</style>
