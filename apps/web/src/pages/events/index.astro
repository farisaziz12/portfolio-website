---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/design/Kicker.astro';
import GridTexture from '../../components/design/GridTexture.astro';
import ContactPanel from '../../components/design/ContactPanel.astro';
import EventsFilter from '../../components/islands/EventsFilter';
import { sanityFetch } from '../../lib/sanity/client';
import { allEventsQuery, speakingStatsQuery } from '../../lib/sanity/queries';

interface SanityEvent {
  _id: string;
  title: string;
  slug: string;
  type: string;
  conference: string;
  date: string;
  location?: { city?: string; country?: string; isOnline?: boolean };
  description?: string;
  talk?: { _id: string; title: string; slug: string };
  links?: { eventUrl?: string; videoUrl?: string; slidesUrl?: string };
  featured?: boolean;
}

interface SpeakingStats {
  totalEvents: number;
  upcomingEvents: number;
  countries: number;
  cities: number;
  talks: number;
  workshops: number;
}

let events: SanityEvent[] = [];
let stats: SpeakingStats | null = null;
try {
  const [eventsData, statsData] = await Promise.all([
    sanityFetch<SanityEvent[]>(allEventsQuery),
    sanityFetch<SpeakingStats>(speakingStatsQuery),
  ]);
  events = eventsData || [];
  stats = statsData || null;
} catch (error) {
  console.error('Failed to fetch events data:', error);
}

const totalEvents = stats?.totalEvents ?? events.length;
const countries = stats?.countries ?? new Set(events.map((e) => e.location?.country).filter(Boolean)).size;
const cities = stats?.cities ?? new Set(events.map((e) => e.location?.city).filter(Boolean)).size;
---

<BaseLayout
  title="All events | Faris Aziz"
  description="Complete archive of speaking engagements by Faris Aziz — conferences and meetups around the world, plus workshops along the way."
  pathname="/events"
>
  <header class="page-hero">
    <GridTexture />
    <div class="container page-hero__inner">
      <Kicker>Speaking · archive</Kicker>
      <h1 class="page-hero__title">
        Every stage, in <span class="accent-word">one place</span>.
      </h1>
      <p class="page-hero__lead">
        Conferences, meetups, workshops, panels — the full record, filterable by format and ordered by date.
      </p>

      <div class="page-hero__stats">
        <div>
          <div class="ds-stat__value" style="font-size:2.2rem;">{totalEvents}</div>
          <div class="ds-stat__label">Events</div>
        </div>
        <div>
          <div class="ds-stat__value" style="font-size:2.2rem;">{countries}</div>
          <div class="ds-stat__label">Countries</div>
        </div>
        <div>
          <div class="ds-stat__value" style="font-size:2.2rem;">{cities}</div>
          <div class="ds-stat__label">Cities</div>
        </div>
      </div>

      <div class="page-hero__actions">
        <a href="/invite" class="ds-btn ds-btn-primary ds-btn-lg">
          Invite me to speak
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="/talks" class="ds-btn ds-btn-secondary ds-btn-lg">Browse talks</a>
      </div>
    </div>
  </header>

  <section class="page-section">
    <div class="container wide">
      <div class="page-section__head">
        <div>
          <Kicker>Archive</Kicker>
          <h2 class="page-h2">Every event</h2>
        </div>
        <span class="ds-pill ds-pill--signal">
          <span class="ds-dot ds-dot--pulse"></span>
          {totalEvents} total
        </span>
      </div>

      {events.length > 0 ? (
        <EventsFilter client:load events={events} splitByTime={true} />
      ) : (
        <div class="page-empty">
          <h3>Coming soon</h3>
          <p>Events will appear here once content is migrated to Sanity.</p>
          <a href="/invite" class="ds-btn ds-btn-primary" style="margin-top:1rem;">Invite me to speak</a>
        </div>
      )}
    </div>
  </section>

  <section class="page-section page-section--contact">
    <div class="container">
      <div class="wide ds-reveal">
        <ContactPanel
          status="Currently accepting invitations"
          title="Want me at your event?"
          body="Always open to new conferences and meetups. Tell me about your audience and I'll tailor a talk to fit."
          primaryHref="/invite"
          primaryLabel="Invite me to speak"
          secondaryHref="/talks"
          secondaryLabel="Browse my talks"
        />
      </div>
    </div>
  </section>

  <script>
    function initPage() {
      document.querySelectorAll('.ds-reveal.in').forEach((el) => el.classList.remove('in'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.ds-reveal').forEach((el) => io.observe(el));
      window.setTimeout(() => {
        document.querySelectorAll('.ds-reveal:not(.in)').forEach((el) => el.classList.add('in'));
      }, 600);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage, { once: true });
    } else { initPage(); }
    document.addEventListener('astro:after-swap', initPage);
  </script>
</BaseLayout>
