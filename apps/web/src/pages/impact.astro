---
/**
 * Track record: every number here is derived (speaking) or an approved,
 * dated metric (engineering, community). No photo in the hero; the
 * countries count sits on the yellow band.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SkewHero from '../components/v3/SkewHero.astro';
import Kicker from '../components/v3/Kicker.astro';
import StatRow, { type Stat } from '../components/v3/StatRow.astro';
import EngineeringWins from '../components/impact/EngineeringWins.astro';
import CareerTimeline from '../components/impact/CareerTimeline.astro';
import RecognitionStages from '../components/impact/RecognitionStages.astro';
import { impactData } from '../lib/impact';
import { breadcrumbs } from '../lib/seo';

const d = await impactData();

const stats: Stat[] = [
  { value: d.stats.talksDelivered, label: 'talks delivered', meta: 'from session records' },
  ...(d.stats.podcasts > 0 ? [{ value: d.stats.podcasts, label: 'podcast appearances', meta: d.podcastPeriod }] : []),
  ...d.communityMetrics.map((m) => ({ value: m.value, label: m.label, meta: [d.community?.name, m.dateLabel].filter(Boolean).join(' · ') })),
];
---

<BaseLayout
  title="Track record | Faris Aziz"
  description={`Dated, defined numbers: ${d.stats.talksDelivered} talks delivered in ${d.stats.countries} countries, engineering wins, the career timeline and recognition.`.slice(0, 160)}
  image="/og/impact.png"
  markdownAlternate="/impact.md"
  band={false}
  extraSchema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }, { name: 'Track record', path: '/impact' }])]}
>
  <SkewHero bandWidth={36} height={400} class="impact-hero">
    <Kicker parts={['Track record']} />
    <h1 class="ds-h1 impact-hero__title">The work, the stages, the community.</h1>
    <p class="ds-lede impact-hero__lede">
      Everything here is dated and defined. Speaking counts only delivered sessions; community numbers belong to everyone who built {d.community?.name ?? 'the community'} with me.
    </p>
    <div slot="aside" class="impact-hero__aside">
      <p class="impact-hero__num">{d.stats.countries}</p>
      <p class="impact-hero__label">countries spoken in</p>
      <p class="impact-hero__meta">{d.stats.cities} cities · {d.asOf}</p>
    </div>
  </SkewHero>

  <StatRow stats={stats} />

  <EngineeringWins metrics={d.engineering} />
  <CareerTimeline career={d.career} />
  <RecognitionStages awards={d.awards} quote={d.quote} moreQuotes={d.moreQuotes} stages={d.stages} podcasts={d.podcastSources} />
</BaseLayout>

<style>
  .impact-hero__title { margin: 0; max-width: 15ch; text-wrap: balance; }
  .impact-hero__lede { max-width: 52ch; }
  .impact-hero__aside { display: flex; flex-direction: column; gap: 4px; padding-left: 40px; }
  .impact-hero__aside p { margin: 0; color: rgb(var(--c-ink)); }
  .impact-hero__num { font-size: 88px; font-weight: 800; letter-spacing: -0.06em; line-height: 0.85; }
  .impact-hero__label { font-size: 15px; font-weight: 700; }
  .impact-hero__meta { font-size: 13px; opacity: 0.78; }
  @media (max-width: 720px) {
    .impact-hero__aside { padding-left: 0; }
    .impact-hero__num { font-size: 64px; }
  }
</style>
