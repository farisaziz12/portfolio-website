---
import { sanityFetch, urlFor } from '../../lib/sanity/client';
import { employersQuery } from '../../lib/sanity/queries';
import type { SanityImageSource } from '@sanity/image-url/lib/types/types';

interface SanityImage {
  asset?: SanityImageSource;
  alt?: string;
}

interface Employer {
  _id: string;
  companyName: string;
  companyUrl?: string;
  role: string;
  startDate?: string;
  endDate?: string;
  current?: boolean;
  summary?: string;
  companyLogo?: SanityImage;
}

const employers = await sanityFetch<Employer[]>(employersQuery).catch(() => []);

// Component is purely additive — if Sanity has no employers yet, render nothing
// so the about page is unchanged during the gap between deploy and content entry.
if (employers.length === 0) {
  return null;
}

const current = employers.find((e) => e.current) ?? employers[0];
const past = employers.filter((e) => e._id !== current._id);

function formatTenure(e: Employer): string {
  const startY = e.startDate ? new Date(e.startDate).getFullYear() : '';
  const endY = e.current ? 'now' : e.endDate ? new Date(e.endDate).getFullYear() : '';
  if (!startY && !endY) return '';
  return `${startY}${endY ? ` — ${endY}` : ''}`;
}

function safeLogo(image: SanityImage | undefined, w: number, h: number): string | null {
  if (!image?.asset) return null;
  try {
    return urlFor(image).width(w).height(h).fit('max').url();
  } catch {
    return null;
  }
}

const currentLogo = safeLogo(current.companyLogo, 140, 60);
---

<section class="credential-strip">
  <div class="container">
    <div class="credential-strip__inner">
      <div class="credential-strip__current">
        <span class="credential-strip__kicker">Currently</span>
        <div class="credential-strip__current-row">
          {currentLogo && (
            <img
              src={currentLogo}
              alt={current.companyLogo?.alt || current.companyName}
              class="credential-strip__current-logo"
              loading="lazy"
            />
          )}
          <div>
            <p class="credential-strip__current-role">
              <span class="credential-strip__role">{current.role}</span>
              <span class="credential-strip__sep"> at </span>
              {current.companyUrl ? (
                <a href={current.companyUrl} target="_blank" rel="noopener noreferrer" class="credential-strip__company">
                  {current.companyName}
                </a>
              ) : (
                <span class="credential-strip__company">{current.companyName}</span>
              )}
            </p>
            {current.summary && (
              <p class="credential-strip__summary">{current.summary}</p>
            )}
          </div>
        </div>
      </div>

      {past.length > 0 && (
        <div class="credential-strip__past">
          <span class="credential-strip__kicker">Previously</span>
          <ul class="credential-strip__logos">
            {past.map((e) => {
              const logo = safeLogo(e.companyLogo, 120, 48);
              const tenure = formatTenure(e);
              const tooltip = [e.role, e.companyName, tenure].filter(Boolean).join(' · ');
              return (
                <li class="credential-strip__logo-item">
                  {e.companyUrl ? (
                    <a
                      href={e.companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="credential-strip__logo-link"
                      title={tooltip}
                    >
                      {logo ? (
                        <img src={logo} alt={e.companyName} loading="lazy" />
                      ) : (
                        <span class="credential-strip__logo-fallback">{e.companyName}</span>
                      )}
                    </a>
                  ) : (
                    <span class="credential-strip__logo-link" title={tooltip}>
                      {logo ? (
                        <img src={logo} alt={e.companyName} loading="lazy" />
                      ) : (
                        <span class="credential-strip__logo-fallback">{e.companyName}</span>
                      )}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .credential-strip {
    padding-block: clamp(2rem, 4vw, 3rem);
    background: rgb(var(--surface-1));
    border-top: 1px solid rgb(var(--edge));
    border-bottom: 1px solid rgb(var(--edge));
  }
  .credential-strip__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  @media (max-width: 840px) {
    .credential-strip__inner { grid-template-columns: 1fr; }
  }

  .credential-strip__kicker {
    display: inline-block;
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--accent-bright));
    margin-bottom: 0.6rem;
  }

  .credential-strip__current-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .credential-strip__current-logo {
    width: 56px;
    height: 56px;
    object-fit: contain;
    background: rgb(var(--surface-2));
    border: 1px solid rgb(var(--edge));
    border-radius: 10px;
    padding: 6px;
    flex-shrink: 0;
  }
  .credential-strip__current-role {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: rgb(var(--ink));
    line-height: 1.25;
  }
  .credential-strip__role { color: rgb(var(--ink)); }
  .credential-strip__sep { color: rgb(var(--ink-faint)); }
  .credential-strip__company {
    color: rgb(var(--accent-bright));
  }
  a.credential-strip__company:hover { text-decoration: underline; }
  .credential-strip__summary {
    color: rgb(var(--ink-muted));
    font-size: 0.92rem;
    margin-top: 0.4rem;
    max-width: 48ch;
  }

  .credential-strip__logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.4rem;
    align-items: center;
  }
  .credential-strip__logo-item { display: flex; }
  .credential-strip__logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    color: rgb(var(--ink-faint));
    transition: filter 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    filter: grayscale(100%) brightness(0.85);
    opacity: 0.7;
  }
  .credential-strip__logo-link:hover {
    filter: grayscale(0%) brightness(1);
    opacity: 1;
  }
  .credential-strip__logo-link img {
    max-height: 32px;
    width: auto;
    object-fit: contain;
  }
  .credential-strip__logo-fallback {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 0.9rem;
    color: rgb(var(--ink-muted));
    letter-spacing: -0.005em;
  }
</style>
