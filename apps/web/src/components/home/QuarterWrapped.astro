---
import Kicker from '../design/Kicker.astro';
import type { QuarterActivity } from '../../lib/sanity/types';

interface Props {
  /** e.g. "Q3 2026" */
  label: string;
  activity: QuarterActivity | null;
}

const { label, activity } = Astro.props;

const events = activity?.events ?? [];
const external = activity?.external ?? [];
const blogs = activity?.blogs ?? [];

if (events.length + external.length + blogs.length === 0) return null;

// Line-art icons (no emoji — house rule), keyed by item flavor.
const ICONS: Record<string, string> = {
  // microphone
  podcast:
    '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3.5M8.5 21.5h7"/>',
  // play circle
  video: '<circle cx="12" cy="12" r="9.5"/><path d="M10 8.5l6 3.5-6 3.5z"/>',
  // document
  article:
    '<path d="M7 2.5h7L19 7.5v14H7z"/><path d="M14 2.5v5h5M10 12h6M10 15.5h6"/>',
  // pen nib
  blog: '<path d="M4.5 16.5 3 21l4.5-1.5M14 6l4 4M9.5 14.5 16 8a3.5 3.5 0 0 0 0-5 3.5 3.5 0 0 0-5 0l-6.5 6.5"/>',
  // presentation board
  event: '<path d="M3 4h18M5 4v11h14V4M12 15v3M8.5 21l3.5-3 3.5 3"/>',
};

// Headphones — used for the podcast "Listen now" CTA.
const HEADPHONES = '<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="2.5" y="13.5" width="4.5" height="7" rx="1.6"/><rect x="17" y="13.5" width="4.5" height="7" rx="1.6"/>';

const EVENT_TYPE_LABELS: Record<string, string> = {
  conference: 'Conference talk',
  workshop: 'Workshop',
  meetup: 'Meetup',
  podcast: 'Podcast',
  webinar: 'Webinar',
  panel: 'Panel',
  hosting: 'Hosting',
  judging: 'Judging',
  mentoring: 'Mentoring',
  attending: 'Attending',
};
const EXTERNAL_TYPE_LABELS: Record<string, string> = {
  article: 'Article',
  podcast: 'Podcast',
  video: 'Video',
  panel: 'Panel',
  interview: 'Interview',
};
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

interface WrappedItem {
  id: string;
  badge: string;
  icon: string;
  title: string;
  meta?: string;
  date: string;
  href: string;
  external: boolean;
  upcoming: boolean;
  podcast: boolean;
  action: string;
}

const todayISO = new Date().toISOString().slice(0, 10);

const eventItems: WrappedItem[] = events.map((e) => {
  const upcoming = e.date.slice(0, 10) >= todayISO;
  const isPodcast = e.type === 'podcast';
  const place = e.location?.isOnline
    ? 'Online'
    : [e.location?.city, e.location?.country].filter(Boolean).join(', ');
  return {
    id: e._id,
    badge: (e.type && EVENT_TYPE_LABELS[e.type]) || (e.type ? capitalize(e.type) : 'Event'),
    icon: isPodcast ? ICONS.podcast : ICONS.event,
    title: e.title,
    meta: [e.conference, place].filter(Boolean).join(' · '),
    date: e.date,
    href: `/events/${e.slug}`,
    external: false,
    upcoming,
    podcast: isPodcast,
    action: isPodcast ? (upcoming ? 'Coming up' : 'Listen now') : upcoming ? 'Details' : e.videoUrl ? 'Watch' : 'Recap',
  };
});

const externalItems: WrappedItem[] = external.map((p) => {
  const kind = p.type && EXTERNAL_TYPE_LABELS[p.type] ? p.type : 'article';
  const isPodcast = kind === 'podcast';
  return {
    id: p._id,
    badge: EXTERNAL_TYPE_LABELS[kind] || capitalize(kind),
    icon: ICONS[kind] || ICONS.article,
    title: p.title,
    meta: p.source,
    date: p.publishedAt,
    href: p.url,
    external: true,
    upcoming: false,
    podcast: isPodcast,
    action: isPodcast ? 'Listen now' : kind === 'video' ? 'Watch' : 'Read',
  };
});

const blogItems: WrappedItem[] = blogs.map((b) => ({
  id: b._id,
  badge: 'Blog post',
  icon: ICONS.blog,
  title: b.title,
  meta: [b.category ? capitalize(b.category.replace(/-/g, ' ')) : null, b.estimatedReadingTime ? `${b.estimatedReadingTime} min read` : null]
    .filter(Boolean)
    .join(' · '),
  date: b.publishedAt,
  href: `/blog/${b.slug}`,
  external: false,
  upcoming: false,
  podcast: false,
  action: 'Read',
}));

// Newest first — upcoming events naturally float to the top of the quarter.
const items = [...eventItems, ...externalItems, ...blogItems].sort((a, b) =>
  b.date.localeCompare(a.date)
);

// Progressive disclosure: show the first slice, reveal the rest on demand.
// The server renders every item; the collapse is applied only when JS is on
// (html.js), so no-JS visitors still see the full list and no content is lost.
const INITIAL_VISIBLE = 6;
const overflowCount = Math.max(0, items.length - INITIAL_VISIBLE);

// Summary chips — only the non-zero ones.
const podcastCount =
  external.filter((p) => p.type === 'podcast').length +
  events.filter((e) => e.type === 'podcast').length;
const stageCount = events.filter((e) => e.type !== 'podcast').length;
const pressCount = external.filter((p) => p.type !== 'podcast').length;
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const chips = [
  stageCount > 0 ? plural(stageCount, 'event', 'events') : null,
  podcastCount > 0 ? plural(podcastCount, 'podcast', 'podcasts') : null,
  pressCount > 0 ? plural(pressCount, 'article & interview', 'articles & interviews') : null,
  blogs.length > 0 ? plural(blogs.length, 'blog post', 'blog posts') : null,
].filter(Boolean) as string[];

const formatDay = (dateStr: string) => {
  const d = new Date(dateStr);
  return { day: String(d.getUTCDate()), month: d.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' }) };
};
---

<section class="qw-section" aria-labelledby="quarter-wrapped-title">
  <div class="container">
    <div class="qw-heading">
      <Kicker class="ds-reveal">This quarter</Kicker>
      <h2 class="qw-h2 ds-reveal" id="quarter-wrapped-title">
        {label}, <span class="mark">wrapped</span>
      </h2>
      <p class="qw-lead ds-reveal">
        Talks, podcasts, articles, and everything else from the past few months — plus what's still coming up.
        {podcastCount > 0 && ' Tap any podcast to listen now.'}
      </p>
      {chips.length > 0 && (
        <div class="qw-chips ds-reveal">
          {chips.map((chip) => <span class="ds-tag">{chip}</span>)}
        </div>
      )}
    </div>

    <ol class="qw-list" data-collapsed={overflowCount > 0 ? 'true' : undefined}>
      {items.map((item, i) => {
        const { day, month } = formatDay(item.date);
        const overflow = i >= INITIAL_VISIBLE;
        return (
          <li class:list={['ds-reveal', 'qw-row', { 'qw-row--overflow': overflow }]}>
            <a
              class:list={['qw-item', { 'qw-item--podcast': item.podcast }]}
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              <span class="qw-item__date" aria-hidden="true">
                <b>{day}</b>
                <span>{month}</span>
              </span>
              <span class="qw-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
              </span>
              <span class="qw-item__body">
                <span class="qw-item__tags">
                  <span class:list={['ds-tag', { 'qw-tag--podcast': item.podcast }]}>{item.badge}</span>
                  {item.upcoming && (
                    <span class="qw-item__upcoming">
                      <span class="ds-dot ds-dot--pulse"></span>
                      Upcoming
                    </span>
                  )}
                </span>
                <span class="qw-item__title">{item.title}</span>
                {item.meta && <span class="qw-item__meta">{item.meta}</span>}
              </span>
              {item.podcast ? (
                <span class="qw-listen">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={HEADPHONES} />
                  {item.action}
                </span>
              ) : (
                <span class="qw-item__action">
                  {item.action}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ol>

    {overflowCount > 0 && (
      <div class="qw-disclosure">
        <button type="button" class="qw-toggle" aria-expanded="false" data-qw-toggle data-count={overflowCount}>
          <span class="qw-toggle__label">Show {overflowCount} more</span>
          <svg class="qw-toggle__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    )}

    <div class="qw-cta ds-reveal">
      <a href="/speaking" class="ds-btn ds-btn-secondary">All speaking</a>
      <a href="/blog" class="ds-btn ds-btn-secondary">All writing &amp; podcasts</a>
    </div>
  </div>
</section>

<script>
  // Progressive disclosure toggle. The list ships fully rendered; here we wire
  // the "show more / show less" control that flips the [data-collapsed] flag.
  document.querySelectorAll('[data-qw-toggle]').forEach((btn) => {
    const section = btn.closest('.qw-section');
    const list = section?.querySelector('.qw-list');
    const label = btn.querySelector('.qw-toggle__label');
    if (!list || !label) return;
    const count = btn.getAttribute('data-count') ?? '';
    btn.addEventListener('click', () => {
      const collapsed = list.getAttribute('data-collapsed') === 'true';
      if (collapsed) {
        list.removeAttribute('data-collapsed');
        btn.setAttribute('aria-expanded', 'true');
        label.textContent = 'Show less';
      } else {
        list.setAttribute('data-collapsed', 'true');
        btn.setAttribute('aria-expanded', 'false');
        label.textContent = `Show ${count} more`;
        section?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });
</script>

<style>
  /* Section primitives mirror index.astro's .home-section — Astro scoped
     styles don't cross component boundaries, so they're re-declared here. */
  .qw-section {
    padding-block: clamp(4rem, 9vw, 7.5rem);
  }
  .qw-heading {
    text-align: center;
    margin-bottom: 2.4rem;
  }
  .qw-h2 {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: rgb(var(--ink));
    margin-top: 0.9rem;
  }
  .qw-lead {
    color: rgb(var(--ink-muted));
    max-width: 52ch;
    margin: 1rem auto 0;
  }
  .qw-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }

  .qw-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 860px;
    display: grid;
    gap: 0.7rem;
  }
  /* Collapse overflow rows only when JS is available (html.js), so no-JS
     visitors keep the full, server-rendered list. */
  :global(html.js) .qw-list[data-collapsed='true'] .qw-row--overflow {
    display: none;
  }

  .qw-item {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 1.1rem;
    padding: 0.95rem 1.2rem;
    border: 1px solid rgb(var(--edge));
    border-radius: 14px;
    background: rgb(var(--surface-1));
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s;
  }
  .qw-item:hover {
    border-color: rgb(var(--edge-strong));
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -18px rgb(var(--bg) / 0.9);
  }
  .qw-item__date {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    text-align: center;
    min-width: 2.6rem;
  }
  .qw-item__date b {
    display: block;
    font-size: 1.1rem;
    font-weight: 600;
    color: rgb(var(--ink));
    line-height: 1.1;
  }
  .qw-item__date span {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(var(--ink-faint));
  }
  .qw-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgb(var(--surface-2));
    box-shadow: inset 0 0 0 1px rgb(var(--edge));
    color: rgb(var(--accent-bright));
    flex-shrink: 0;
  }
  .qw-item__icon svg {
    width: 20px;
    height: 20px;
  }
  .qw-item__body {
    display: grid;
    gap: 0.28rem;
    min-width: 0;
  }
  .qw-item__tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .qw-item__upcoming {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(var(--signal));
  }
  .qw-item__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.25;
    color: rgb(var(--ink));
  }
  .qw-item__meta {
    font-size: 0.86rem;
    color: rgb(var(--ink-muted));
  }
  .qw-item__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(var(--ink-faint));
    white-space: nowrap;
    transition: color 0.2s;
  }
  .qw-item__action svg {
    width: 15px;
    height: 15px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .qw-item:hover .qw-item__action {
    color: rgb(var(--accent-bright));
  }
  .qw-item:hover .qw-item__action svg {
    transform: translateX(3px);
  }

  /* ── Podcast highlight ─────────────────────────────────────────────── */
  .qw-item--podcast {
    background: rgb(var(--accent) / 0.06);
    border-color: rgb(var(--accent) / 0.3);
  }
  .qw-item--podcast:hover {
    border-color: rgb(var(--accent) / 0.55);
    box-shadow: 0 12px 34px -18px rgb(var(--accent) / 0.5);
  }
  .qw-item--podcast .qw-item__icon {
    background: rgb(var(--accent) / 0.14);
    color: rgb(var(--accent-bright));
    box-shadow: inset 0 0 0 1px rgb(var(--accent) / 0.35);
  }
  .qw-tag--podcast {
    color: rgb(var(--accent-bright));
    border-color: rgb(var(--accent) / 0.4);
    background: rgb(var(--accent) / 0.1);
  }
  .qw-listen {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: rgb(var(--accent) / 0.14);
    border: 1px solid rgb(var(--accent) / 0.45);
    color: rgb(var(--accent-bright));
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.74rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s;
  }
  .qw-listen svg {
    width: 15px;
    height: 15px;
  }
  .qw-item--podcast:hover .qw-listen {
    background: rgb(var(--accent) / 0.24);
    border-color: rgb(var(--accent) / 0.7);
  }

  /* ── Disclosure toggle ─────────────────────────────────────────────── */
  .qw-disclosure {
    display: none;
    justify-content: center;
    margin-top: 1.4rem;
  }
  /* Only useful with JS — the list is fully rendered without it. */
  :global(html.js) .qw-disclosure {
    display: flex;
  }
  .qw-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--edge-strong));
    background: transparent;
    color: rgb(var(--ink-muted));
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .qw-toggle:hover {
    color: rgb(var(--ink));
    border-color: rgb(var(--accent) / 0.5);
    background: rgb(var(--surface-2));
  }
  .qw-toggle__chevron {
    width: 16px;
    height: 16px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .qw-toggle[aria-expanded='true'] .qw-toggle__chevron {
    transform: rotate(180deg);
  }

  .qw-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }

  @media (max-width: 640px) {
    .qw-item {
      grid-template-columns: auto 1fr;
      gap: 0.85rem;
      padding: 0.9rem 1rem;
    }
    /* Hide the decorative icon and subtle action on mobile — but keep the
       podcast "Listen now" CTA, which is the whole point of the highlight. */
    .qw-item__icon,
    .qw-item__action {
      display: none;
    }
    .qw-item--podcast {
      grid-template-columns: auto 1fr auto;
    }
    .qw-listen {
      padding: 0.4rem 0.7rem;
      font-size: 0.68rem;
    }
    .qw-listen svg {
      width: 13px;
      height: 13px;
    }
  }
</style>
