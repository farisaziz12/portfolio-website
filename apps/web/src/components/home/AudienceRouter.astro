---
const items = [
  {
    href: '/speaking',
    title: 'I speak at conferences.',
    desc: 'Keynotes, talks, and workshops — invite me to your stage.',
  },
  {
    href: '/consulting',
    title: 'I work with teams.',
    desc: 'Architecture reviews, payments, and hands-on help.',
  },
  {
    href: '/mentorship',
    title: 'I mentor engineers.',
    desc: '1:1 coaching to grow your career and your craft.',
  },
  {
    href: '/blog',
    title: 'I write.',
    desc: 'Notes on frontend, payments, and engineering life.',
  },
];
---

<nav class="ds-claims ds-reveal" aria-label="Where to next">
  {items.map((item) => (
    <a class="ds-claim" href={item.href}>
      <span class="ds-claim__title">{item.title}</span>
      <span class="ds-claim__desc">{item.desc}</span>
      <svg class="ds-claim__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  ))}
</nav>
