---
/**
 * "What people say": the spotlight quote across the top beside the stripe
 * rule (attribution and "All mentions" to its right on wide screens), then
 * the quote cards in a three-column grid with equal rows.
 */
import PraiseCard from '../v3/PraiseCard.astro';
import { PLATFORM_LABEL, monthYear, shortQuote, type Praise } from '../../lib/sanity/v3';

interface Props {
  spotlight?: Praise;
  cards: Praise[];
}

const { spotlight, cards } = Astro.props;
const meta = spotlight
  ? [
      PLATFORM_LABEL[spotlight.platform] !== 'Direct' ? PLATFORM_LABEL[spotlight.platform] : null,
      monthYear(spotlight.date),
      spotlight.event ? `after ${spotlight.event.title}` : null,
    ]
      .filter(Boolean)
      .join(' · ')
  : '';
---

{spotlight && (
  <section class="hp" aria-labelledby="home-praise">
    <div class="ds-wrap ds-section hp__grid">
      <figure class="hp__spot ds-stripe">
        <h2 id="home-praise" class="ds-kicker hp__kicker">What people say</h2>
        <blockquote class="hp__quote">“{shortQuote(spotlight, 180)}”</blockquote>
        <div class="hp__side">
          <figcaption class="hp__who">
            <strong>{spotlight.author.name}</strong>
            {spotlight.author.headline && <span class="hp__role">{spotlight.author.headline}</span>}
            {meta && (
              <span class="hp__meta">
                {spotlight.url ? <a href={spotlight.url} target="_blank" rel="noopener noreferrer">{meta}</a> : meta}
              </span>
            )}
          </figcaption>
          <a href="/appreciation" class="ds-link ds-link--sm hp__all" data-track="home-praise-all">All mentions</a>
        </div>
      </figure>
      {cards.length > 0 && (
        <ul class="hp__cards" role="list">
          {cards.map((p) => (
            <li><PraiseCard praise={p} /></li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}

<style>
  .hp { border-top: 1px solid rgb(var(--hairline)); }
  .hp__grid { display: flex; flex-direction: column; gap: 28px; }
  /* Spotlight: kicker, then the quote with the attribution beside it. */
  .hp__spot {
    margin: 0; padding-left: 24px; display: grid; gap: 10px 56px; align-items: end;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px); grid-template-areas: 'kicker kicker' 'quote side';
  }
  .hp__kicker { grid-area: kicker; }
  .hp__quote { grid-area: quote; max-width: 44ch; }
  .hp__side { grid-area: side; display: flex; flex-direction: column; gap: 12px; padding-bottom: 6px; }
  .hp__role { display: block; color: rgb(var(--text-muted)); }
  .hp__spot.ds-stripe::before { top: 0; bottom: 0; border-radius: 2px; }
  .hp__spot .ds-kicker { margin: 0; }
  .hp__quote { margin: 0; font-size: clamp(22px, 2.4vw, 32px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.1; text-wrap: balance; color: rgb(var(--text)); }
  .hp__who { font-size: 14px; line-height: 1.4; color: rgb(var(--text)); }
  .hp__meta { display: block; color: rgb(var(--text-faint)); }
  .hp__meta a { color: inherit; text-decoration: none; }
  .hp__meta a:hover { color: rgb(var(--text)); text-decoration: underline; }
  .hp__all { align-self: flex-start; }
  .hp__cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 12px; }
  .hp__cards li { min-width: 0; }
  .hp__cards :global(.pq) { padding: 20px; gap: 10px; }
  .hp__cards :global(.pq .ds-kicker) { font-size: 11.5px; letter-spacing: 0.1em; margin: 0; }
  .hp__cards :global(.pq__quote) { font-size: 15px; line-height: 1.5; }

  @media (max-width: 1100px) { .hp__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) {
    .hp__grid { gap: 32px; }
    .hp__spot { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'kicker' 'quote' 'side'; }
  }
  @media (max-width: 560px) {
    .hp__cards { grid-template-columns: 1fr; grid-auto-rows: auto; }
    /* Phone: three quotes, the rest live on /appreciation. */
    .hp__cards li:nth-child(n + 4) { display: none; }
  }
</style>
