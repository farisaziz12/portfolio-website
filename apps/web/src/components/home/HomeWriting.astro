---
/**
 * Recent writing (two rows beside the stripe rule) next to the cream
 * invitation panel.
 */
import InvitePanel from '../v3/InvitePanel.astro';
import { TOPIC_SHORT } from 'shared';
import { fullDate, monthYear, type WritingItem } from '../../lib/sanity/v3';

interface Props {
  items: WritingItem[];
  invite: { headline: string; body: string };
}

const { items, invite } = Astro.props;
const when = (w: WritingItem) => (w.isInternal ? fullDate(w.date) : monthYear(w.date));
---

<section class="ds-wrap ds-section hw" aria-label="Recent writing and invitation">
  <div class="hw__list">
    <h2 class="ds-h2 ds-h2--sm hw__h2">Recent writing.</h2>
    {items.length > 0 ? (
      <ul class="hw__rows" role="list">
        {items.map((w, i) => (
          <li>
            <a href={w.href} class:list={['hw__row', { 'hw__row--blue': i % 2 === 1 }]} data-track="home-writing" {...(w.isInternal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
              <span class="hw__stripe" aria-hidden="true"></span>
              <span>
                <span class="hw__meta">{[w.topic ? TOPIC_SHORT[w.topic] : w.isInternal ? null : w.source, when(w), w.minutes ? `${w.minutes} min` : null].filter(Boolean).join(' · ')}</span>
                <span class="hw__title">{w.title}</span>
                {w.excerpt && <span class="hw__excerpt">{w.excerpt}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="ds-body">New writing is on its way.</p>
    )}
    <a href="/blog" class="ds-link ds-link--sm hw__all" data-track="home-writing-all">All writing</a>
  </div>
  <InvitePanel headline={invite.headline} body={invite.body} track="home-invite-panel" class="hw__panel" />
</section>

<style>
  .hw { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .hw__list { display: flex; flex-direction: column; }
  .hw__h2 { margin: 0 0 22px; }
  .hw__rows { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgb(var(--hairline)); }
  .hw__row {
    display: grid; grid-template-columns: 8px minmax(0, 1fr); gap: 20px; padding: 18px 0; border-top: 1px solid rgb(var(--hairline));
    color: rgb(var(--text)); text-decoration: none;
  }
  .hw__stripe { background: var(--stripe); border-radius: 2px; }
  .hw__row--blue .hw__stripe { background: repeating-linear-gradient(180deg, rgb(var(--blue)) 0 10px, transparent 10px 16px); }
  .hw__meta { display: block; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--text-faint)); }
  .hw__title { display: block; margin-top: 6px; font-size: clamp(20px, 2vw, 24px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.08; transition: color 0.15s; text-wrap: balance; }
  .hw__row:hover .hw__title { color: rgb(var(--accent-text)); }
  .hw__excerpt { display: block; margin-top: 6px; font-size: 15px; line-height: 1.5; color: rgb(var(--text-muted)); text-wrap: pretty; }
  .hw__all { margin-top: 20px; align-self: flex-start; }
  .hw :global(.hw__panel) { padding: 34px 36px; }

  @media (max-width: 960px) {
    .hw { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 720px) {
    .hw :global(.hw__panel) { padding: 22px; }
  }
</style>
