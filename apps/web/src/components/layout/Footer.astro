---
/**
 * Footer: primary routes, secondary pages (Track record, Projects, Gallery…
 * live here and on About, not in the primary nav), profiles, theme toggle.
 * No newsletter: signup UI is deliberately out of scope.
 */
import ThemeToggle from '../islands/ThemeToggle';
import { FOOTER_PRIMARY, FOOTER_SECONDARY } from '../../lib/nav';
import { getSiteSettings } from '../../lib/sanity/v3';

const settings = await getSiteSettings();
const profiles = [
  { label: 'LinkedIn', href: settings.links.linkedin },
  { label: 'Bluesky', href: settings.links.bluesky },
  { label: 'X', href: settings.twitterHandle ? `https://x.com/${settings.twitterHandle}` : undefined },
  { label: 'GitHub', href: settings.links.github },
].filter((p): p is { label: string; href: string } => Boolean(p.href));
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="ds-wrap">
    <div class="ftr__row">
      <nav class="ftr__links" aria-label="Footer">
        {FOOTER_PRIMARY.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="ftr__profiles">
        {profiles.map((p, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={p.href} target="_blank" rel="me noopener noreferrer">{p.label}</a>
          </>
        ))}
        <a href="/about#terminal" class="ftr__sh" aria-label="Open the faris.sh terminal on About">faris.sh ›</a>
      </div>
    </div>
    <div class="ftr__row ftr__row--meta">
      <nav class="ftr__links ftr__links--secondary" aria-label="More pages">
        {FOOTER_SECONDARY.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="ftr__meta">
        <span>&copy; {year} {settings.siteTitle} · Geneva</span>
        <ThemeToggle client:visible />
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr { margin-top: auto; border-top: 1px solid rgb(var(--hairline)); padding-block: 28px 32px; font-size: 13px; }
  .ftr__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 28px; }
  .ftr__row--meta { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgb(var(--hairline)); }
  .ftr__links { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .ftr a { color: rgb(var(--text-muted)); text-decoration: none; display: inline-flex; align-items: center; min-height: 32px; }
  .ftr a:hover { color: rgb(var(--text)); }
  .ftr__links--secondary a { color: rgb(var(--text-faint)); }
  .ftr__profiles { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; color: rgb(var(--text-faint)); }
  .ftr .ftr__sh { color: rgb(var(--accent-text)); font-family: var(--font-mono); margin-left: 10px; }
  .ftr__meta { display: flex; align-items: center; gap: 14px; color: rgb(var(--text-faint)); }
  @media (max-width: 720px) {
    .ftr__row { flex-direction: column; align-items: flex-start; }
    .ftr__links { gap: 0 16px; }
    .ftr a { min-height: 40px; }
  }
</style>
