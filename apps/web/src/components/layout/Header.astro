---
import ThemeToggle from '../islands/ThemeToggle';
import CommandPalette from '../islands/CommandPalette';
import {
  availabilityFromCount,
  formatQuarter,
  bookingYears,
  getQuarterEventCount,
} from '../../lib/availability';
import { sanityFetch } from '../../lib/sanity/client';
import { upcomingEventDatesQuery } from '../../lib/sanity/queries';

const pathname = Astro.url.pathname;
const quarterLabel = formatQuarter();
const bookingYearsLabel = bookingYears();

// Derive Open vs Limited from real bookings in the next bookable quarter.
// Falls through to "Open" if Sanity is unreachable so the header pill never
// hard-fails.
const upcomingDates = await sanityFetch<{ date?: string }[]>(upcomingEventDatesQuery).catch(() => []);
const quarterEventCount = getQuarterEventCount(upcomingDates);
const availLabel = availabilityFromCount(quarterEventCount);

const isActive = (prefix: string) => {
  if (prefix === '/') return pathname === '/';
  return pathname === prefix || pathname.startsWith(prefix + '/');
};

// "Speaking" lights up for talks/events/workshops/invite too
const speakingActive = ['/speaking', '/talks', '/events', '/workshops', '/invite'].some(isActive);
const servicesActive = ['/services', '/consulting', '/mentorship', '/impact'].some(isActive);
const writingActive = ['/blog', '/newsletter', '/subscribe'].some(isActive);
---

<header class="site-nav" id="siteNav">
  <div class="container site-nav__inner">
    <a href="/" class="site-nav__brand" aria-label="Faris Aziz home">
      <span>Faris Aziz</span>
    </a>

    <div class="site-nav__links" id="siteNavLinks">
      <a href="/" class:list={['site-nav__link', { 'is-active': isActive('/') }]} aria-current={isActive('/') ? 'page' : undefined}>Home</a>

      <div class="site-nav__item nav-mega-item">
        <a href="/speaking" class:list={['site-nav__link', { 'is-active': speakingActive }]} aria-current={speakingActive ? 'page' : undefined}>
          Speaking
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <div class="megamenu" role="menu">
          <a class="mm-row" href="/events" role="menuitem">
            <span class="mm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg></span>
            <span><b>Upcoming events</b><span>Where I'm speaking next</span></span>
          </a>
          <a class="mm-row" href="/talks" role="menuitem">
            <span class="mm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4.5v15l13-7.5z" fill="currentColor" stroke="none"/></svg></span>
            <span><b>Talks</b><span>Recorded sessions &amp; slides</span></span>
          </a>
          <a class="mm-row" href="/workshops" role="menuitem">
            <span class="mm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 3h6v8a3 3 0 0 1-6 0z"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M9 21h6"/></svg></span>
            <span><b>Workshops</b><span>Hands-on, full-day training</span></span>
          </a>
          <div class="mm-foot">
            <span class="small">Booking {bookingYearsLabel} dates</span>
            <a class="ds-link" href="/invite">Invite me
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="site-nav__item nav-mega-item">
        <a href="/services" class:list={['site-nav__link', { 'is-active': servicesActive }]} aria-current={servicesActive ? 'page' : undefined}>
          Services
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <div class="megamenu" role="menu">
          <a class="mm-row" href="/consulting" role="menuitem">
            <span class="mm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span>
            <span><b>Consulting</b><span>Architecture, strategy &amp; hands-on help</span></span>
          </a>
          <a class="mm-row" href="/mentorship" role="menuitem">
            <span class="mm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="8" r="3"/><path d="M3 19a6 6 0 0 1 12 0M16 7a3 3 0 0 1 0 6M18.5 19a5 5 0 0 0-3-4.6"/></svg></span>
            <span><b>Mentorship</b><span>1:1 coaching for engineers</span></span>
          </a>
          <a class="mm-row" href="/impact" role="menuitem">
            <span class="mm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 17l6-6 4 4 8-8"/><path d="M21 7v5h-5"/></svg></span>
            <span><b>Impact</b><span>The full track record &amp; metrics</span></span>
          </a>
          <div class="mm-foot">
            <span class="small">Available {quarterLabel}</span>
            <a class="ds-link" href="/services">Explore services
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="site-nav__item nav-mega-item">
        <a href="/blog" class:list={['site-nav__link', { 'is-active': writingActive }]} aria-current={writingActive ? 'page' : undefined}>
          Writing
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <div class="megamenu" role="menu">
          <a class="mm-row" href="/blog" role="menuitem">
            <span class="mm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16v14H4z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg></span>
            <span><b>Blog</b><span>Essays &amp; deep technical writing</span></span>
          </a>
          <a class="mm-row" href="/newsletter" role="menuitem">
            <span class="mm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
            <span><b>Newsletter archive</b><span>Every past issue, in one place</span></span>
          </a>
          <div class="mm-foot">
            <span class="small">One email, occasionally</span>
            <a class="ds-link" href="/subscribe">Subscribe
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>

      <a href="/about" class:list={['site-nav__link', { 'is-active': isActive('/about') }]} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
    </div>

    <div class="site-nav__right">
      <button type="button" class="site-nav__kbd" id="paletteBtn" aria-label="Open command palette" title="Search (⌘K)">
        <span>Search</span>
        <kbd>⌘K</kbd>
      </button>

      <ThemeToggle client:load />

      <a href="/invite" class="ds-btn ds-btn-primary site-nav__cta">Invite me</a>

      <button type="button" class="site-nav__burger" id="burgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileDrawer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

</header>

<!-- Mobile drawer -->
<div class="mobile-drawer" id="mobileDrawer">
  <div class="mobile-drawer__head">
    <span class="site-nav__brand">Faris Aziz</span>
    <button type="button" class="ds-social" id="drawerClose" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <div class="mobile-drawer__links">
    <a class="mobile-drawer__link" href="/">Home</a>
    <a class="mobile-drawer__link" href="/speaking">Speaking <span class="sub">Talks · Events · Workshops</span></a>
    <a class="mobile-drawer__link" href="/services">Services <span class="sub">Consulting · Mentorship</span></a>
    <a class="mobile-drawer__link" href="/impact">Impact <span class="sub">The track record</span></a>
    <a class="mobile-drawer__link" href="/blog">Writing <span class="sub">Blog · Newsletter · Subscribe</span></a>
    <a class="mobile-drawer__link" href="/newsletter">Newsletter</a>
    <a class="mobile-drawer__link" href="/subscribe">Subscribe</a>
    <a class="mobile-drawer__link" href="/about">About</a>
    <a class="mobile-drawer__link" href="/now">Now <span class="sub">What I'm focused on</span></a>
  </div>
  <div class="mobile-drawer__foot">
    <span class="ds-pill ds-pill--signal" style="margin-bottom:1rem;display:inline-flex;">
      <span class="ds-dot ds-dot--pulse"></span>{availLabel}
    </span>
    <a href="/invite" class="ds-btn ds-btn-primary ds-btn-lg" style="width:100%;">
      Invite me to speak
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</div>

<CommandPalette client:idle />

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, rgb(var(--bg)) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgb(var(--edge));
    transition: box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site-nav--scrolled { box-shadow: 0 8px 28px -10px rgba(0,0,0,.65); }
  .site-nav--scrolled .site-nav__inner { height: 56px; }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    transition: height 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    gap: 1rem;
  }

  .site-nav__brand {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: rgb(var(--ink));
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .site-nav__link {
    font-size: 0.92rem;
    color: rgb(var(--ink-muted));
    transition: color 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0;
  }
  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: rgb(var(--ink));
  }
  .site-nav__link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -22px;
    height: 2px;
    background: rgb(var(--accent));
  }
  .site-nav__link .chev {
    width: 13px;
    height: 13px;
    opacity: 0.55;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site-nav__item { position: relative; display: flex; align-items: center; }
  .site-nav__item:hover .chev,
  .site-nav__item.open .chev { transform: rotate(180deg); }

  .site-nav__right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site-nav__kbd {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid rgb(var(--edge));
    border-radius: 6px;
    padding: 0.4rem 0.55rem;
    color: rgb(var(--ink-faint));
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.7rem;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .site-nav__kbd:hover { border-color: rgb(var(--edge-strong)); color: rgb(var(--ink-muted)); }
  .site-nav__kbd kbd {
    font-family: inherit;
    font-size: inherit;
  }

  .site-nav__avail {
    font-family: var(--font-sans, 'Hanken Grotesk', system-ui, sans-serif);
  }

  .site-nav__cta {
    padding: 0.55rem 1rem !important;
    font-size: 0.88rem !important;
  }

  .site-nav__burger {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    color: rgb(var(--ink));
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .site-nav__burger svg { width: 24px; height: 24px; }

  @media (max-width: 980px) {
    #siteNavLinks, .site-nav__kbd, .site-nav__avail, .site-nav__cta { display: none; }
    .site-nav__burger { display: inline-flex; }
  }
</style>

<script>
  function setupNav() {
    const nav = document.getElementById('siteNav');
    if (!nav) return;

    function onScroll() {
      nav!.classList.toggle('site-nav--scrolled', window.scrollY > 16);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mega-menu: tap to open on coarse pointers (mobile-ish desktop)
    document.querySelectorAll<HTMLElement>('.nav-mega-item').forEach((item) => {
      const trigger = item.querySelector<HTMLAnchorElement>('.site-nav__link');
      if (!trigger) return;
      trigger.addEventListener('click', (e) => {
        if (window.matchMedia('(hover: none)').matches) {
          e.preventDefault();
          item.classList.toggle('open');
        }
      });
    });
    document.addEventListener('click', (e) => {
      document.querySelectorAll('.nav-mega-item.open').forEach((i) => {
        if (!i.contains(e.target as Node)) i.classList.remove('open');
      });
    });

    // Command palette button → dispatches cmdk:open
    const paletteBtn = document.getElementById('paletteBtn');
    paletteBtn?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('cmdk:open'));
    });

    // Mobile drawer
    const drawer = document.getElementById('mobileDrawer');
    const burger = document.getElementById('burgerBtn');
    const close = document.getElementById('drawerClose');

    function setDrawer(open: boolean) {
      drawer?.classList.toggle('open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      burger?.setAttribute('aria-expanded', String(open));
    }
    burger?.addEventListener('click', () => setDrawer(true));
    close?.addEventListener('click', () => setDrawer(false));
    drawer?.querySelectorAll<HTMLAnchorElement>('.mobile-drawer__link').forEach((a) => {
      a.addEventListener('click', () => setDrawer(false));
    });
  }

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>
