---
/**
 * Site header: brand · five primary links · Invite me. Sections with
 * children get a pill sub-nav, then the 8px band (skipped on pages whose
 * hero carries the skewed band itself). Mobile: a native <dialog> drawer —
 * focus is trapped, Esc and backdrop taps close it. Opening: a skewed yellow
 * band sweeps across (the opener's wipe), the panel slides in and the links
 * cascade; closing plays a quick reverse before the dialog closes. Only
 * transform/opacity animate; reduced motion gets a plain fade.
 */
import ThemeToggle from '../islands/ThemeToggle';
import CommandPalette from '../islands/CommandPalette';
import { PRIMARY_NAV, INVITE_CTA, sectionFor, activeChild } from '../../lib/nav';

interface Props {
  band?: boolean;
  /** Offer "Replay intro" to returning visitors (the opener is enabled). */
  introEnabled?: boolean;
  /** Short bio (Sanity) for the command palette's "Copy short bio". */
  bio?: string;
}

const { band = true, introEnabled = false, bio } = Astro.props;
const pathname = Astro.url.pathname;
const section = sectionFor(pathname);
const activePill = activeChild(section, pathname);
const onInvite = pathname.replace(/\/$/, '') === '/invite';
const cta = onInvite ? { label: 'Press kit', href: '/press-kit' } : INVITE_CTA;
---

<header class="hdr">
  <div class="ds-wrap hdr__row">
    <a href="/" class="hdr__brand">Faris Aziz</a>

    <nav class="hdr__nav" aria-label="Primary">
      {PRIMARY_NAV.map((s) => (
        <a href={s.href} class="hdr__link" aria-current={section?.href === s.href ? 'page' : undefined}>{s.label}</a>
      ))}
    </nav>

    <div class="hdr__right">
      {introEnabled && (
        <a href="/?intro=replay" class="hdr__replay" data-replay-intro hidden>Replay intro</a>
      )}
      <ThemeToggle client:idle />
      {onInvite ? (
        <a href={cta.href} class="ds-link ds-link--sm hdr__cta-link" data-track="header-cta" data-track-label={cta.label}>{cta.label}</a>
      ) : (
        <a href={cta.href} class="ds-btn ds-btn--yellow ds-btn--sm hdr__cta" data-track="header-cta" data-track-label={cta.label}>{cta.label}</a>
      )}
      <button type="button" class="hdr__menu" data-drawer-open aria-haspopup="dialog" aria-controls="siteDrawer">Menu</button>
    </div>
  </div>

  {section?.children && (
    <div class="ds-wrap hdr__sub">
      <span class="hdr__sub-label">{section.label}</span>
      <nav class="hdr__pills" aria-label={`${section.label} pages`}>
        {section.children.map((c) => (
          <a href={c.href} class="hdr__pill" aria-current={activePill === c.href ? 'page' : undefined}>{c.label}</a>
        ))}
      </nav>
    </div>
  )}
  {band && <span class="ds-band" aria-hidden="true"></span>}
</header>

<dialog id="siteDrawer" class="drawer" aria-label="Site menu">
  <span class="drawer__wipe" aria-hidden="true"></span>
  <div class="drawer__head">
    <a href="/" class="hdr__brand">Faris Aziz</a>
    <button type="button" class="hdr__menu" data-drawer-close>Close</button>
  </div>
  <nav class="drawer__nav" aria-label="Site">
    {PRIMARY_NAV.map((s) => (
      <div class="drawer__group">
        <a href={s.href} class="drawer__link" aria-current={section?.href === s.href ? 'page' : undefined}>{s.label}</a>
        {s.children && (
          <div class="drawer__children">
            {s.children.filter((c) => c.href !== s.href).map((c) => <a href={c.href}>{c.label}</a>)}
          </div>
        )}
      </div>
    ))}
  </nav>
  <div class="drawer__foot">
    <a href={INVITE_CTA.href} class="ds-btn ds-btn--yellow ds-btn--lg ds-btn--block" data-track="drawer-cta">{INVITE_CTA.label}</a>
  </div>
</dialog>

<CommandPalette client:idle bio={bio} />

<style>
  .hdr { position: relative; z-index: 20; background: rgb(var(--ground)); }
  .hdr__row { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: var(--header-height); }
  .hdr__brand { font-weight: 800; font-size: 17px; letter-spacing: -0.03em; color: rgb(var(--text)); text-decoration: none; white-space: nowrap; }
  .hdr__nav { display: flex; gap: 28px; font-size: 14px; font-weight: 600; }
  .hdr__link {
    color: rgb(var(--text-muted)); text-decoration: none; padding: 6px 0 2px;
    border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s;
  }
  .hdr__link:hover { color: rgb(var(--text)); border-bottom-color: rgb(var(--hairline-strong)); }
  .hdr__link[aria-current='page'] { color: rgb(var(--text)); border-bottom-color: rgb(var(--yellow)); }
  .hdr__right { display: flex; align-items: center; gap: 14px; }
  .hdr__replay { font-size: 12.5px; font-weight: 600; color: rgb(var(--text-muted)); text-underline-offset: 0.25em; }
  .hdr__replay:hover { color: rgb(var(--text)); }
  .hdr__menu {
    display: none; min-height: 44px; min-width: 44px; padding: 0 12px; border-radius: var(--radius-btn);
    border: 1px solid rgb(var(--hairline-strong)); background: transparent; color: rgb(var(--text));
    font: 800 13px var(--font); cursor: pointer;
  }
  .hdr__menu:hover { border-color: rgb(var(--yellow)); }

  .hdr__sub { display: flex; align-items: center; gap: 18px; padding-bottom: 14px; overflow-x: auto; scrollbar-width: none; }
  .hdr__sub::-webkit-scrollbar { display: none; }
  .hdr__sub-label { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(var(--text-faint)); flex: none; }
  .hdr__pills { display: flex; gap: 6px; flex: none; }
  .hdr__pill {
    display: inline-flex; align-items: center; min-height: 32px; padding: 0 12px; border-radius: 999px;
    font-size: 13.5px; font-weight: 700; color: rgb(var(--text)); text-decoration: none; white-space: nowrap;
  }
  .hdr__pill:hover { color: rgb(var(--accent-text)); }
  .hdr__pill[aria-current='page'] { background: rgb(var(--yellow)); color: rgb(var(--on-yellow)); }

  .drawer {
    width: 100%; max-width: 100%; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0;
    background: transparent; color: rgb(var(--text)); overscroll-behavior: contain; overflow: hidden;
  }
  .drawer[open] { display: flex; flex-direction: column; }
  /* The panel is the dialog's content; it slides while the dialog itself stays put. */
  .drawer > :not(.drawer__wipe) { position: relative; z-index: 1; background: rgb(var(--ground)); }
  .drawer__nav { background: rgb(var(--ground)); }
  .drawer::backdrop { background: rgb(var(--c-ink) / 0); transition: background-color 0.3s ease; }
  .drawer.is-open::backdrop { background: rgb(var(--c-ink) / 0.6); }

  .drawer > :not(.drawer__wipe) { transform: translate3d(0, -14px, 0); opacity: 0; transition: transform 0.42s var(--ease-out-soft), opacity 0.3s ease; }
  .drawer.is-open > :not(.drawer__wipe) { transform: none; opacity: 1; }
  .drawer__group, .drawer__foot { transform: translate3d(0, 16px, 0); opacity: 0; transition: transform 0.45s var(--ease-out-soft), opacity 0.35s ease; }
  .drawer.is-open .drawer__group, .drawer.is-open .drawer__foot { transform: none; opacity: 1; }
  .drawer.is-open .drawer__group:nth-child(1) { transition-delay: 0.12s; }
  .drawer.is-open .drawer__group:nth-child(2) { transition-delay: 0.16s; }
  .drawer.is-open .drawer__group:nth-child(3) { transition-delay: 0.2s; }
  .drawer.is-open .drawer__group:nth-child(4) { transition-delay: 0.24s; }
  .drawer.is-open .drawer__group:nth-child(5) { transition-delay: 0.28s; }
  .drawer.is-open .drawer__group:nth-child(n + 6) { transition-delay: 0.32s; }
  .drawer.is-open .drawer__foot { transition-delay: 0.3s; }
  /* Closing: everything leaves together, faster than it arrived. */
  .drawer.is-closing > :not(.drawer__wipe), .drawer.is-closing .drawer__group, .drawer.is-closing .drawer__foot {
    transition-duration: 0.22s; transition-delay: 0s; transition-timing-function: ease-in;
  }

  /* Brand wipe: a skewed yellow band with the blue edge sweeps across once on open. */
  .drawer__wipe {
    position: fixed; inset: -10% auto -10% 0; z-index: 2; width: 70vw; pointer-events: none;
    background: linear-gradient(90deg, rgb(var(--blue)) 0 10%, rgb(var(--yellow)) 10% 100%);
    transform: translate3d(-140%, 0, 0) skewX(var(--skew)); visibility: hidden; will-change: transform;
  }
  .drawer.is-open .drawer__wipe { visibility: visible; animation: drawer-wipe 0.56s cubic-bezier(0.7, 0, 0.3, 1) both; }
  @keyframes drawer-wipe {
    from { transform: translate3d(-140%, 0, 0) skewX(var(--skew)); }
    to { transform: translate3d(260%, 0, 0) skewX(var(--skew)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer__wipe { display: none; }
    .drawer > :not(.drawer__wipe), .drawer__group, .drawer__foot { transform: none !important; transition: opacity 0.15s ease !important; transition-delay: 0s !important; }
  }
  .drawer__head { display: flex; align-items: center; justify-content: space-between; padding: 0 var(--gutter); min-height: var(--header-height); border-bottom: 8px solid transparent; border-image: var(--band) 1; }
  .drawer__head .hdr__menu { display: inline-flex; align-items: center; }
  .drawer__nav { flex: 1; overflow-y: auto; padding: 12px var(--gutter) 24px; }
  .drawer__group { padding: 12px 0; border-bottom: 1px solid rgb(var(--hairline)); }
  .drawer__link { display: flex; align-items: center; min-height: 44px; font-size: 26px; font-weight: 800; letter-spacing: -0.03em; color: rgb(var(--text)); text-decoration: none; }
  .drawer__link[aria-current='page'] { color: rgb(var(--accent-text)); }
  .drawer__children { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .drawer__children a { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600; color: rgb(var(--text-muted)); text-decoration: none; }
  .drawer__foot { padding: 16px var(--gutter) max(16px, env(safe-area-inset-bottom)); border-top: 1px solid rgb(var(--hairline)); }

  @media (max-width: 900px) {
    .hdr__nav, .hdr__replay, .hdr__right :global(.theme-toggle) { display: none; }
    .hdr__menu { display: inline-flex; align-items: center; }
    .hdr__right { gap: 8px; }
  }
</style>

<script>
  function setupHeader() {
    const drawer = document.getElementById('siteDrawer') as HTMLDialogElement | null;
    if (!drawer || drawer.dataset.ready) return;
    drawer.dataset.ready = '1';
    const opener = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    let closing = 0;

    const open = () => {
      if (drawer.open) return;
      window.clearTimeout(closing);
      drawer.classList.remove('is-open', 'is-closing');
      drawer.showModal();
      opener?.setAttribute('aria-expanded', 'true');
      // Next frame, so the transition starts from the closed state.
      requestAnimationFrame(() => requestAnimationFrame(() => drawer.classList.add('is-open')));
    };
    const close = (instant = false) => {
      if (!drawer.open || drawer.classList.contains('is-closing')) return;
      if (instant) {
        drawer.classList.remove('is-open');
        drawer.close();
        return;
      }
      drawer.classList.add('is-closing');
      drawer.classList.remove('is-open');
      closing = window.setTimeout(() => {
        drawer.classList.remove('is-closing');
        drawer.close();
      }, reduced() ? 150 : 230);
    };

    opener?.addEventListener('click', open);
    // Esc: play the same close instead of the dialog's instant one.
    drawer.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    drawer.addEventListener('close', () => {
      drawer.classList.remove('is-open', 'is-closing');
      opener?.setAttribute('aria-expanded', 'false');
      opener?.focus({ preventScroll: true });
    });
    drawer.querySelector('[data-drawer-close]')?.addEventListener('click', () => close());
    // Tap on the backdrop (outside the content box) closes.
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) close();
    });
    // Navigating: close at once so the next page isn't covered mid-animation.
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close(true)));
    // Leaving the mobile breakpoint with the drawer open would strand it.
    window.matchMedia('(min-width: 901px)').addEventListener('change', (m) => m.matches && close(true));

    // "Replay intro" only for returning visitors (the intro already played).
    const replay = document.querySelector<HTMLAnchorElement>('[data-replay-intro]');
    let seen = false;
    try { seen = sessionStorage.getItem('introSeen') === '1'; } catch { /* storage blocked */ }
    if (replay && seen) replay.hidden = false;
    replay?.addEventListener('click', (e) => {
      if (location.pathname === '/') {
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('intro:replay'));
      }
    });
  }
  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
