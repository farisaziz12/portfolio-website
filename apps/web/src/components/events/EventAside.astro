---
/**
 * Event page right column: cover (event cover → a photo from the day →
 * striped placeholder), the "Practical" box, and the next other upcoming
 * edition.
 */
import SanityImg from '../v3/SanityImg.astro';
import { dayMonth, primarySession, yearOf, type EventEdition, type SanityImage } from '../../lib/sanity/v3';
import { kindLabel } from '../../lib/events-view';

interface Props {
  event: EventEdition;
  cover?: SanityImage;
  coverAlt: string;
  next?: EventEdition;
}
const { event: e, cover, coverAlt, next } = Astro.props;
const nextSession = next ? primarySession(next) : undefined;
const nextWhat = nextSession?.talk?.title ?? nextSession?.workshop?.title ?? nextSession?.title;
---

<aside class="evside" aria-label="About this edition">
  <div class:list={['evside__cover', { 'is-empty': !cover?.asset }]}>
    <SanityImg image={cover} alt={coverAlt} ratio={4 / 3} widths={[400, 760]} sizes="(max-width: 960px) 100vw, 380px" class="evside__img" />
  </div>

  <div class="ds-card evside__box">
    <h2 class="evside__kicker">Practical</h2>
    <dl class="ds-dl evside__dl">
      {e.seriesName && (
        <>
          <dt>Series</dt>
          <dd>{e.seriesName} · {yearOf(e.date)} edition</dd>
        </>
      )}
      {!e.seriesName && (
        <>
          <dt>Format</dt>
          <dd>{kindLabel(e)}</dd>
        </>
      )}
      {e.language && (
        <>
          <dt>Language</dt>
          <dd>{e.language}</dd>
        </>
      )}
      {e.isUpcoming && (
        <>
          <dt>Add to</dt>
          <dd><a href={`/events/${e.slug}.ics`} class="ds-textlink" download={`${e.slug}.ics`} data-track="event_ics">Calendar (.ics)</a></dd>
        </>
      )}
    </dl>
  </div>

  {next && (
    <a href={`/events/${next.slug}`} class="ds-card evside__next" data-track="event_also_coming_up">
      <span class="evside__kicker">Also coming up</span>
      <span class="evside__next-title">{[next.title, dayMonth(next.date), next.location.isOnline ? 'Online' : next.location.city].filter(Boolean).join(' · ')}</span>
      {nextWhat && <span class="evside__next-what">{nextWhat}</span>}
    </a>
  )}
</aside>

<style>
  .evside { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .evside__cover { aspect-ratio: 4 / 3; border-radius: var(--radius-card); overflow: hidden; border: 1px solid rgb(var(--hairline)); background: rgb(var(--surface)); }
  .evside__cover :global(.evside__img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 960px) { .evside__cover.is-empty { display: none; } }
  .evside__box { display: flex; flex-direction: column; gap: 10px; padding: 20px; }
  .evside__kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--accent-text)); margin: 0; }
  .evside__dl { font-size: 14px; line-height: 1.5; gap: 6px 14px; }
  .evside__dl dd { overflow-wrap: anywhere; }
  .evside__next { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; }
  .evside__next-title { font-weight: 800; font-size: 16px; line-height: 1.3; }
  .evside__next-what { font-size: 13px; color: rgb(var(--text-muted)); }
</style>
