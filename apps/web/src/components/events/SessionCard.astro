---
/**
 * "My sessions at this edition": format · length · time (or the explicit
 * TBA line), the talk/workshop title linking to its page, a one-paragraph
 * description, and an explicit role badge.
 */
import type { EventEdition, Session } from '../../lib/sanity/v3';
import { roleName, sessionHref, sessionMeta, sessionTitle } from '../../lib/events-view';

interface Props {
  event: EventEdition;
  session: Session;
  /** Talk summary / abstract or workshop summary, resolved by the page. */
  description?: string;
}
const { event, session: s, description } = Astro.props;
const href = sessionHref(s);
---

<article class:list={['ds-card sess', { 'is-cancelled': s.status === 'cancelled' }]}>
  <div class="sess__main">
    <p class="sess__meta">{sessionMeta(event, s)}</p>
    <h3 class="sess__title">
      {href ? <a href={href} class="sess__link">{sessionTitle(s)}</a> : sessionTitle(s)}
    </h3>
    {description && <p class="sess__desc">{description}</p>}
  </div>
  <span class="ds-badge sess__badge">Role: {roleName(s)}</span>
</article>

<style>
  .sess { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 20px; align-items: start; padding: 24px; }
  .sess__main { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .sess__meta { margin: 0; font-size: 12px; color: rgb(var(--text-muted)); }
  .sess__title { font-size: clamp(22px, 2.4vw, 26px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.05; overflow-wrap: anywhere; }
  .sess__link { color: rgb(var(--text)); text-decoration: none; transition: color 0.15s; }
  .sess__link:hover { color: rgb(var(--accent-text)); }
  .sess__desc { margin: 0; font-size: 15px; line-height: 1.55; color: rgb(var(--text-muted)); max-width: 60ch; }
  .sess__badge { padding: 6px 12px; color: rgb(var(--text-muted)); }
  .is-cancelled .sess__title { text-decoration: line-through; color: rgb(var(--text-faint)); }
  @media (max-width: 560px) {
    .sess { grid-template-columns: 1fr; gap: 14px; padding: 20px; }
    .sess__badge { justify-self: start; grid-row: 1; }
  }
</style>
