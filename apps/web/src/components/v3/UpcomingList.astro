---
/**
 * Upcoming appearances as hairline rows: big day + month, title, one meta
 * line (kind · place · what), and an explicit role badge.
 */
import { EVENT_KINDS, titleFor } from 'shared';
import { eventPlace, primarySession, sessionLine, monthYear, type EventEdition } from '../../lib/sanity/v3';
import { getCountryFlag } from '../../lib/flags';
import { bucketBadge } from '../../lib/events-view';

interface Props {
  events: EventEdition[];
  limit?: number;
  flags?: boolean;
  class?: string;
}
const { events, limit = 4, flags = false, class: className } = Astro.props;
const rows = events.slice(0, limit).map((e) => {
  const s = primarySession(e);
  return {
    e,
    day: Number(e.date.slice(8, 10)),
    month: monthYear(e.date),
    meta: [titleFor(EVENT_KINDS, e.kind) || null, eventPlace(e, { venue: true }), s ? sessionLine(s) : null].filter(Boolean).join(' · '),
    bucket: s?.bucket,
    badge: bucketBadge(s?.bucket, e.isUpcoming),
  };
});
---

<ol class:list={['ds-rows uplist', className]} data-until-group>
  {rows.map((r) => (
    <li data-until={r.e.endsAt}>
      <a href={`/events/${r.e.slug}`} class="ds-row uplist__row">
        <span class="uplist__date"><span class="uplist__day">{r.day}</span><span class="uplist__month">{r.month}</span></span>
        <span class="uplist__main">
          <span class="ds-row__title uplist__title">{flags && <span aria-hidden="true">{getCountryFlag(r.e.location.country)} </span>}{r.e.title}</span>
          <span class="uplist__meta">{r.meta}</span>
        </span>
        {r.badge && <span class="ds-role" data-bucket={r.bucket}>{r.badge}</span>}
      </a>
    </li>
  ))}
</ol>

<style>
  .uplist__row { display: grid; grid-template-columns: 84px 1fr auto; gap: 18px; align-items: center; padding: 16px 0; }
  .uplist__date { display: flex; flex-direction: column; }
  .uplist__day { font-size: 26px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .uplist__month { font-size: 12.5px; font-weight: 600; color: rgb(var(--text-muted)); }
  .uplist__main { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .uplist__title { font-size: 18px; font-weight: 800; letter-spacing: -0.02em; transition: color 0.15s; }
  .uplist__meta { font-size: 13.5px; color: rgb(var(--text-muted)); }
  @media (max-width: 560px) {
    .uplist__row { grid-template-columns: 56px 1fr; }
    .uplist__row .ds-role { grid-column: 2; justify-self: start; }
  }
</style>
