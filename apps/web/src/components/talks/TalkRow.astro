---
/**
 * One catalogue row inside a topic section: thumbnail (talk image, else the
 * recording's YouTube frame, else the striped placeholder) with the yellow
 * edge, title, next / premiere date, summary, audience, where it's been given
 * by year, then length and a Watch / Details action. The title link stretches
 * over the row; event links and the action stay their own targets.
 */
import { youtubeThumb, type TalkWithHistory } from '../../lib/sanity/v3';
import { audienceLine, lengthLabel, upcomingLine } from '../../lib/talks';
import SanityImg from '../v3/SanityImg.astro';
import DeliveryYears from './DeliveryYears.astro';

interface Props {
  talk: TalkWithHistory;
}
const { talk: t } = Astro.props;
const href = `/talks/${t.slug}`;
const yt = t.thumbnail?.asset ? undefined : youtubeThumb(t.recording?.url);
const next = upcomingLine(t);
const length = lengthLabel(t);
const audience = audienceLine(t);
---

<article class="trow">
  <span class="trow__thumb">
    {t.thumbnail?.asset ? (
      <SanityImg image={t.thumbnail} alt="" ratio={16 / 10} widths={[240, 400]} sizes="150px" class="trow__img" />
    ) : yt ? (
      <img src={yt} alt="" width="480" height="360" loading="lazy" decoding="async" class="trow__img" />
    ) : (
      <span class="ds-img-ph trow__img" aria-hidden="true"></span>
    )}
    <span class="trow__edge" aria-hidden="true"></span>
  </span>
  <div class="trow__main">
    <h3 class="trow__title"><a href={href} class="trow__link">{t.title}</a></h3>
    {next && <p class="trow__next">{next}</p>}
    {t.summary && <p class="trow__summary">{t.summary}</p>}
    {audience && <p class="trow__aud">{audience}</p>}
    <DeliveryYears talk={t} limit={6} class="trow__deliveries" />
  </div>
  <div class="trow__side">
    {length && <span class="trow__len">{length}</span>}
    <a
      href={t.recording ? `${href}#recording` : href}
      class="ds-btn ds-btn--outline ds-btn--sm trow__action"
      data-track={t.recording ? 'talks-row-watch' : 'talks-row-details'}
      aria-label={`${t.recording ? 'Watch' : 'Details'}: ${t.title}`}
    >{t.recording ? 'Watch' : 'Details'}</a>
  </div>
</article>

<style>
  .trow { position: relative; display: grid; grid-template-columns: 150px minmax(0, 1fr) 140px; gap: 24px; align-items: start; padding: 24px 0; }
  .trow__thumb { position: relative; display: block; aspect-ratio: 16 / 10; border-radius: var(--radius-btn); overflow: hidden; background: rgb(var(--surface)); }
  .trow__thumb :global(.trow__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .trow__edge { position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: rgb(var(--yellow)); }
  .trow__main { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .trow__title { font-size: clamp(19px, 2vw, 22px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.12; text-wrap: balance; }
  .trow__link { color: rgb(var(--text)); text-decoration: none; transition: color 0.15s; }
  .trow__link::after { content: ''; position: absolute; inset: 0; }
  .trow:hover .trow__link { color: rgb(var(--accent-text)); }
  .trow__link:focus-visible { outline: none; }
  .trow__link:focus-visible::after { outline: 3px solid rgb(var(--yellow)); outline-offset: 2px; border-radius: var(--radius-btn); }
  .trow__next { margin: 0; font-size: 13px; font-weight: 700; color: rgb(var(--accent-text)); }
  .trow__summary { margin: 0; font-size: 14.5px; line-height: 1.5; color: rgb(var(--text-muted)); max-width: 68ch; }
  .trow__aud { margin: 0; font-size: 13px; color: rgb(var(--text-faint)); }
  .trow__main :global(.trow__deliveries) { margin-top: 10px; max-width: 560px; }
  .trow__side { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .trow__len { font-size: 13px; font-weight: 700; color: rgb(var(--text)); white-space: nowrap; }

  @media (max-width: 860px) {
    .trow { grid-template-columns: 120px minmax(0, 1fr); }
    .trow__side { grid-column: 2; flex-direction: row; align-items: center; justify-content: space-between; }
  }
  @media (max-width: 720px) {
    .trow { grid-template-columns: 96px minmax(0, 1fr); gap: 12px 16px; padding: 18px 0; }
    .trow__main { grid-column: 1 / -1; }
    .trow__thumb { grid-row: 1; }
    .trow__side { grid-column: 2; grid-row: 1; flex-direction: column; align-items: flex-start; justify-content: flex-start; }
    .trow__action { min-height: 44px; }
    .trow__edge { width: 4px; }
  }
</style>
