---
/**
 * Talks catalogue "Track record" panel: derived counts + two short stage
 * quotes on the left; "Next up" flag chips and "Been there" flags right.
 */
import { currentMonthYear, dayMonth, type EventEdition, type Praise, type SpeakingStats, type TalkWithHistory } from '../../lib/sanity/v3';
import { getCountryFlag, shortCountry } from '../../lib/flags';
import { eventShortName, firstSentence } from '../../lib/talks';

interface Props {
  stats: SpeakingStats;
  talks: TalkWithHistory[];
  upcoming: EventEdition[];
  quotes: Praise[];
  /** Flag chips shown before the "+N" chip. */
  flagLimit?: number;
}
const { stats, talks, upcoming, quotes, flagLimit = 16 } = Astro.props;

const topics = new Set(talks.flatMap((t) => t.tags.map((x) => x.toLowerCase()))).size;
const most = [...talks].sort((a, b) => b.deliveredCount - a.deliveredCount)[0];
const numbers = [
  { value: stats.talksDelivered, label: `talks delivered · ${currentMonthYear()}` },
  { value: stats.countries, label: stats.cities ? `countries, ${stats.cities} cities` : 'countries' },
  { value: talks.length, label: `talks in the catalogue${topics ? ` · ${topics} topics` : ''}` },
  ...(most && most.deliveredCount > 1 ? [{ value: `${most.deliveredCount}×`, label: most.shortTitle || most.title }] : []),
];
const flags = stats.countryList.slice(0, flagLimit);
const rest = stats.countryList.length - flags.length;
---

<section class="trk" aria-labelledby="trk-title">
  <span class="trk__edge" aria-hidden="true"></span>
  <div class="trk__grid">
    <div class="trk__col">
      <h2 id="trk-title" class="ds-kicker">Track record</h2>
      <dl class="trk__nums">
        {numbers.map((n) => (
          <div>
            <dt class="trk__label">{n.label}</dt>
            <dd class="trk__num">{n.value}</dd>
          </div>
        ))}
      </dl>
      {quotes.length > 0 && (
        <ul class="trk__quotes" role="list">
          {quotes.map((q) => (
            <li>
              <figure class="trk__quote">
                <blockquote class="trk__q"><p>{firstSentence(q)}</p></blockquote>
                <figcaption class="trk__who">
                  <span class="trk__name">{q.author.name}</span>
                  {q.author.headline && <span class="trk__role">{q.author.headline}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div class="trk__col">
      {upcoming.length > 0 && (
        <div data-until-group>
          <div class="trk__head">
            <h3 class="ds-kicker">Next up</h3>
            <a href="/events" class="trk__all">Full schedule</a>
          </div>
          <ul class="trk__next">
            {upcoming.slice(0, 4).map((e) => (
              <li data-until={e.endsAt}>
                <a href={`/events/${e.slug}`} class="trk__nextcard">
                  <span class="trk__flag" aria-hidden="true">{e.location.isOnline ? '' : getCountryFlag(e.location.country)}</span>
                  <span>
                    <span class="trk__place">{e.location.isOnline ? 'Online' : [shortCountry(e.location.country), e.location.city].filter(Boolean).join(' · ')}</span>
                    <span class="trk__ev">{eventShortName(e)} · {dayMonth(e.date)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      {flags.length > 0 && (
        <>
          <h3 class="ds-kicker trk__been">Been there</h3>
          <ul class="trk__flags">
            {flags.map((c) => (
              <li class="ds-chip trk__chip" title={c}><span class="trk__cflag" aria-hidden="true">{getCountryFlag(c)}</span>{shortCountry(c)}</li>
            ))}
            {rest > 0 && <li class="ds-chip ds-chip--dashed trk__chip">+{rest} from the event records</li>}
          </ul>
        </>
      )}
    </div>
  </div>
</section>

<style>
  .trk { position: relative; overflow: hidden; background: rgb(var(--surface)); border: 1px solid rgb(var(--hairline)); border-radius: var(--radius-card); }
  .trk__edge { position: absolute; left: 0; top: 0; bottom: 0; width: 16px; background: linear-gradient(90deg, rgb(var(--yellow)) 0 12px, rgb(var(--blue)) 12px 16px); }
  .trk__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 40px; padding: 28px 32px 28px 48px; }
  .trk__col { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .trk__nums { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 20px; margin: 0; }
  .trk__nums > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .trk__num { margin: 0; font-size: 40px; font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
  .trk__label { margin-top: 4px; font-size: 12.5px; color: rgb(var(--text-muted)); }
  /* One quote per block: the words, then who said them on their own line. */
  .trk__quotes { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .trk__quote { margin: 0; padding-left: 14px; border-left: 3px solid rgb(var(--yellow)); display: flex; flex-direction: column; gap: 6px; }
  .trk__q { margin: 0; }
  .trk__q p { margin: 0; font-size: 14.5px; line-height: 1.5; color: rgb(var(--text)); text-wrap: pretty; }
  .trk__q p::before { content: '“'; }
  .trk__q p::after { content: '”'; }
  .trk__who { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; font-size: 12.5px; }
  .trk__name { font-weight: 800; color: rgb(var(--text)); }
  .trk__name::before { content: '— '; color: rgb(var(--text-faint)); font-weight: 600; }
  .trk__role { color: rgb(var(--text-faint)); }
  .trk__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .trk__all { font-size: 12.5px; color: rgb(var(--text-muted)); text-decoration: none; border-bottom: 1px solid rgb(var(--hairline-strong)); }
  .trk__all:hover { color: rgb(var(--text)); border-color: rgb(var(--yellow)); }
  .trk__next, .trk__flags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; }
  .trk__next { gap: 10px; }
  .trk__nextcard {
    display: flex; gap: 12px; align-items: center; min-height: 44px; box-sizing: border-box; padding: 10px 14px;
    background: rgb(var(--ground)); border: 1px solid rgb(var(--hairline)); border-radius: var(--radius-card);
    color: rgb(var(--text)); text-decoration: none; transition: border-color 0.15s;
  }
  .trk__nextcard:hover { border-color: rgb(var(--yellow)); }
  .trk__flag { font-size: 28px; line-height: 1; }
  .trk__place { display: block; font-weight: 800; font-size: 15px; }
  .trk__ev { display: block; font-size: 12.5px; color: rgb(var(--text-muted)); }
  .trk__been { margin-top: 4px; }
  .trk__flags { gap: 6px; }
  .trk__chip { min-height: 30px; padding: 4px 10px 4px 6px; gap: 6px; font-size: 13px; font-weight: 500; color: rgb(var(--text-muted)); }
  .trk__chip.ds-chip--dashed { padding: 4px 12px; color: rgb(var(--text-faint)); }
  .trk__cflag { font-size: 18px; line-height: 1; }
  @media (max-width: 900px) {
    .trk__grid { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 720px) {
    .trk__edge { width: 8px; background: rgb(var(--yellow)); }
    .trk__grid { padding: 22px 18px 22px 30px; }
    .trk__num { font-size: 34px; }
  }
</style>
