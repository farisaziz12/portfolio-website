---
/**
 * Talk detail hero: full-width card with the yellow/blue left edge, the
 * talk photo as a dimmed backdrop when there is one, kicker, big title and
 * the recording / slides actions. Recordings link out (no embed, no autoplay).
 */
import { monthYear, recordingHost, type TalkWithHistory } from '../../lib/sanity/v3';
import { eventShortName, pillarTitle } from '../../lib/talks';
import SanityImg from '../v3/SanityImg.astro';
import Icon from '../v3/Icon.astro';

interface Props {
  talk: TalkWithHistory;
  retired?: boolean;
  retiredLabel?: string;
}
const { talk: t, retired = false, retiredLabel = 'Retired' } = Astro.props;
const rec = t.recording;
const recEvent = rec?.event;
const watchLabel = recEvent ? `Watch · ${eventShortName(recEvent)}, ${monthYear(recEvent.date)}` : 'Watch the recording';
const host = recordingHost(rec?.url);
const slidesLabel = t.slidesUrl && /\.pdf($|\?)/i.test(t.slidesUrl) ? 'Slides (PDF)' : 'Slides';
const hasPhoto = Boolean(t.thumbnail?.asset);
---

<section class:list={['thero', { 'thero--photo': hasPhoto }]} id="recording">
  {hasPhoto && (
    <>
      <SanityImg image={t.thumbnail} alt={t.thumbnail?.alt ?? ''} widths={[800, 1200, 1600]} sizes="(max-width: 1280px) 100vw, 1200px" loading="eager" fetchpriority="high" class="thero__img" />
      <span class="thero__scrim" aria-hidden="true"></span>
    </>
  )}
  <span class="thero__edge" aria-hidden="true"></span>
  <div class="thero__body">
    <p class="ds-kicker">
      <a href="/talks" class="thero__crumb">Talks</a>
      {t.pillar && <><span aria-hidden="true"> · </span>{pillarTitle(t.pillar)}</>}
      {t.duration && <><span aria-hidden="true"> · </span>{t.duration} min</>}
      {retired && <><span aria-hidden="true"> · </span><span class="thero__retired">{retiredLabel}</span></>}
    </p>
    <div class="thero__foot">
      <h1 class="thero__title">{t.title}</h1>
      {(rec || t.slidesUrl) && (
        <div class="thero__actions">
          {rec && (
            <a href={rec.url} class="ds-btn ds-btn--yellow ds-btn--lg" target="_blank" rel="noopener noreferrer" data-track="talk-watch">
              <Icon name="play" size={13} />{watchLabel}
            </a>
          )}
          {t.slidesUrl && (
            <a href={t.slidesUrl} class="ds-link ds-link--sm" target="_blank" rel="noopener noreferrer" data-track="talk-slides">{slidesLabel}</a>
          )}
        </div>
      )}
      {rec && host && <p class="thero__host">Recording on {host}{rec.minutes ? ` · ${rec.minutes} min` : ''}</p>}
    </div>
  </div>
</section>

<style>
  .thero { position: relative; overflow: hidden; background: rgb(var(--surface)); border: 1px solid rgb(var(--hairline)); border-radius: var(--radius-card); }
  .thero--photo { aspect-ratio: 16 / 7; min-height: 420px; }
  .thero :global(.thero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; opacity: 0.7; }
  .thero__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(var(--ground) / 0.92) 0%, rgb(var(--ground) / 0.6) 45%, rgb(var(--ground) / 0.1) 100%); }
  .thero__edge { position: absolute; left: 0; top: 0; bottom: 0; width: 16px; background: linear-gradient(90deg, rgb(var(--yellow)) 0 12px, rgb(var(--blue)) 12px 16px); }
  .thero__body { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 48px; height: 100%; box-sizing: border-box; padding: 40px 40px 40px 44px; max-width: 700px; }
  .thero:not(.thero--photo) .thero__body { min-height: 300px; }
  .thero__crumb { color: rgb(var(--text-muted)); text-decoration: none; }
  .thero__crumb:hover { color: rgb(var(--text)); }
  .thero__retired { color: rgb(var(--text-muted)); }
  .thero__foot { display: flex; flex-direction: column; gap: 16px; }
  .thero__title { font-size: clamp(32px, 4.6vw, 48px); line-height: 0.96; letter-spacing: -0.045em; font-weight: 800; overflow-wrap: anywhere; hyphens: auto; }
  .thero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; }
  .thero__actions .ds-btn { white-space: normal; text-align: left; }
  .thero__host { margin: 0; font-size: 12.5px; color: rgb(var(--text-muted)); }
  @media (max-width: 720px) {
    .thero--photo { aspect-ratio: auto; min-height: 0; }
    .thero__scrim { background: linear-gradient(180deg, rgb(var(--ground) / 0.55) 0%, rgb(var(--ground) / 0.94) 60%); }
    .thero__edge { width: 8px; background: rgb(var(--yellow)); }
    .thero__body { padding: 24px 20px 24px 28px; gap: 32px; }
    .thero:not(.thero--photo) .thero__body, .thero--photo .thero__body { min-height: 320px; }
  }
</style>
