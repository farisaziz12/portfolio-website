---
import type { Props as BaseProps, TypedObject } from 'astro-portabletext/types';

interface YouTubeBlock extends TypedObject {
  _type: 'youtube';
  url?: string;
  caption?: string;
}

type Props = BaseProps<YouTubeBlock>;

const { node } = Astro.props;

function extractVideoId(url: string): string | null {
  const match = url.match(/(?:youtube\.com\/(?:[^/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?/\s]{11})/);
  return match?.[1] ?? null;
}

const videoId = node.url ? extractVideoId(node.url) : null;
---
{videoId && (
  <figure class="pt-figure">
    <div class="pt-video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${videoId}`}
        title={node.caption || 'YouTube video'}
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      />
    </div>
    <figcaption class="pt-caption">
      {node.caption && <>{node.caption} · </>}<a href={node.url} class="ds-textlink" target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
    </figcaption>
  </figure>
)}
