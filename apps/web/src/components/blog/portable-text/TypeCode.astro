---
import type { Props as BaseProps, TypedObject } from 'astro-portabletext/types';

interface CodeBlock extends TypedObject {
  _type: 'code';
  language?: string;
  filename?: string;
  code?: string;
  highlightedLines?: string;
}

type Props = BaseProps<CodeBlock>;

const { node } = Astro.props;
const codeString = node.code ?? '';
const label = node.filename || node.language || 'Code';
---
<figure class="pt-code">
  <figcaption class="pt-code__bar">
    <span class="pt-code__name">{label}</span>
    <button type="button" class="pt-code__copy" data-code-copy aria-label={`Copy ${label}`}>Copy</button>
  </figcaption>
  <pre tabindex="0"><code class={`language-${node.language ?? 'text'}`}>{codeString}</code></pre>
</figure>

<script>
  function wireCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-code-copy]').forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = '1';
      btn.addEventListener('click', async () => {
        const code = btn.closest('.pt-code')?.querySelector('code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Select and copy';
        }
        setTimeout(() => (btn.textContent = 'Copy'), 1600);
      });
    });
  }
  wireCopy();
  document.addEventListener('astro:page-load', wireCopy);
</script>
