---
/**
 * Callouts read as asides in the system (stripe rule + bold lead-in),
 * not coloured boxes. The duck is reserved for technical tips.
 */
import type { Props as BaseProps, TypedObject } from 'astro-portabletext/types';

type CalloutType = 'info' | 'warning' | 'success' | 'error' | 'tip';

interface CalloutBlock extends TypedObject {
  _type: 'callout';
  type?: CalloutType;
  title?: string;
  content?: string;
}

type Props = BaseProps<CalloutBlock>;

const { node } = Astro.props;
const LEAD: Record<CalloutType, string> = { info: 'Aside.', warning: 'Heads up.', success: 'Result.', error: 'Watch out.', tip: 'Tip.' };
const lead = node.title ? `${node.title.replace(/[.:]\s*$/, '')}.` : LEAD[node.type ?? 'info'];
---
<aside class="pt-aside ds-stripe" aria-label={node.title || 'Aside'}>
  <p><strong>{lead}</strong> {node.content}</p>
</aside>
