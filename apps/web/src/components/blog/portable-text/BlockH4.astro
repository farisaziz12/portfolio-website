---
import type { Props as $, Block } from 'astro-portabletext/types';
import { generateHeadingIdFromBlock } from '../../../lib/portable-text-utils';

type Props = $<Block>;

const { node } = Astro.props;
const id = generateHeadingIdFromBlock(node);
---
<h4 id={id} class="pt-h pt-h4"><a href={`#${id}`} class="pt-anchor"><slot /></a></h4>
