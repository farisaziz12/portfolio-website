---
import type { MarkProps } from 'astro-portabletext/types';

interface LinkMarkDef extends Record<string, unknown> {
  href?: string;
  openInNewTab?: boolean;
}

type Props = MarkProps<LinkMarkDef>;

const { node } = Astro.props;
const href = node.markDef?.href ?? '#';
const isInternal = href.startsWith('/') || href.startsWith('#') || /^https?:\/\/(www\.)?faziz-dev\.com/.test(href);
const newTab = !isInternal && (node.markDef?.openInNewTab ?? true);
---
<a href={href} class="ds-textlink" target={newTab ? '_blank' : undefined} rel={newTab ? 'noopener noreferrer' : undefined}><slot /></a>
