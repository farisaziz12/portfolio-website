---
import type { Props as BaseProps, TypedObject } from 'astro-portabletext/types';
import SanityImg from '../../v3/SanityImg.astro';
import type { SanityImage } from '../../../lib/sanity/v3';

interface ImageBlock extends TypedObject, Omit<SanityImage, '_type'> {
  _type: 'image';
  caption?: string;
}

type Props = BaseProps<ImageBlock>;

const { node } = Astro.props;
const caption = [node.caption, node.credit ? `Photo: ${node.credit}` : ''].filter(Boolean).join(' · ');
---
{node.asset && (
  <figure class="pt-figure">
    <SanityImg image={node} alt={node.alt ?? ''} widths={[480, 800, 1200, 1400]} sizes="(max-width: 760px) 100vw, 680px" class="pt-figure__img" />
    {caption && <figcaption class="pt-caption">{caption}</figcaption>}
  </figure>
)}
