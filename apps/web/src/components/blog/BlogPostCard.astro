---
/**
 * Card for an internal blog post — used by the /blog index grid and the
 * "Keep reading" strip on post pages. Extracted because the styles used to
 * live scoped inside blog.astro, so the same class names rendered completely
 * unstyled on blog/[slug].astro.
 */
import { formatDate, formatReadingTime } from 'shared/utils';
import { urlFor } from '../../lib/sanity/client';

interface Props {
  post: {
    title: string;
    slug: string;
    excerpt?: string;
    coverImage?: any;
    publishedAt?: string;
    estimatedReadingTime?: number;
    category?: string;
  };
}

const CATEGORY_LABELS: Record<string, string> = {
  engineering: 'Engineering',
  career: 'Career',
  speaking: 'Speaking',
  community: 'Community',
  payments: 'Payments',
  retrospective: 'Retrospective',
  opinion: 'Opinion',
  tutorial: 'Tutorial',
};

const { post } = Astro.props;

let cover: string | null = null;
try {
  cover = post.coverImage?.asset ? urlFor(post.coverImage).width(600).height(340).url() : null;
} catch {}
---

<a href={`/blog/${post.slug}`} class="ds-card ds-card-interactive blog-post-card ds-reveal">
  <div class="blog-post-card__media">
    {cover ? (
      <img src={cover} alt={post.title} loading="lazy" />
    ) : (
      <div class="blog-post-card__placeholder"><span class="ds-tag">Post</span></div>
    )}
    {post.category && (
      <span class="blog-post-card__category">{CATEGORY_LABELS[post.category] || post.category}</span>
    )}
  </div>
  <div class="blog-post-card__body">
    <h3 class="blog-post-card__title">{post.title}</h3>
    {post.excerpt && <p class="blog-post-card__excerpt">{post.excerpt}</p>}
    <div class="blog-post-card__meta">
      {post.publishedAt && <span>{formatDate(post.publishedAt, { month: 'short', year: 'numeric' })}</span>}
      {post.publishedAt && post.estimatedReadingTime && <span>·</span>}
      {post.estimatedReadingTime && <span>{formatReadingTime(post.estimatedReadingTime)}</span>}
    </div>
  </div>
</a>

<style>
  .blog-post-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  .blog-post-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgb(var(--surface-3));
    border-bottom: 1px solid rgb(var(--edge));
  }

  .blog-post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-post-card:hover .blog-post-card__media img { transform: scale(1.04); }

  .blog-post-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--ink-faint));
  }

  .blog-post-card__category {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: inline-flex;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgb(var(--accent));
    color: #fff;
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .blog-post-card__body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .blog-post-card__title {
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1rem;
    color: rgb(var(--ink));
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-post-card__excerpt {
    font-size: 0.86rem;
    color: rgb(var(--ink-muted));
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-post-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.6rem;
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.7rem;
    color: rgb(var(--ink-faint));
  }
</style>
