---
/**
 * "In this post": a quiet hairline list of the H2/H3s, shown only when a
 * post is long enough to need one (3+ headings).
 */
import type { PortableTextBlock, ArbitraryTypedObject } from '@portabletext/types';
import { extractHeadings } from '../../lib/portable-text-utils';

interface Props {
  body: (PortableTextBlock | ArbitraryTypedObject)[];
  min?: number;
}

const { body, min = 3 } = Astro.props;
const headings = extractHeadings(body).filter((h) => h.level <= 3);
---

{headings.length >= min && (
  <nav class="toc" aria-labelledby="toc-title">
    <p id="toc-title" class="toc__title">In this post</p>
    <ol class="toc__list">
      {headings.map((h) => (
        <li class:list={['toc__item', { 'toc__item--sub': h.level === 3 }]}>
          <a href={`#${h.id}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc { border-block: 1px solid rgb(var(--hairline)); padding: 16px 0; }
  .toc__title { margin: 0 0 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(var(--text-faint)); }
  .toc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .toc__item a { display: inline-block; padding: 6px 0; min-height: 24px; font-size: 15px; font-weight: 600; color: rgb(var(--text-muted)); text-decoration: none; }
  .toc__item a:hover { color: rgb(var(--accent-text)); }
  .toc__item--sub a { padding-left: 16px; font-weight: 500; font-size: 14px; }
</style>
