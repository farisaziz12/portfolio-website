---
/**
 * Article body. Calm register: a 65ch column, 18px / 1.7 body, headings
 * that step down quietly, captions under figures, asides on the stripe
 * rule. Nothing decorative inside the column.
 */
import { PortableText } from 'astro-portabletext';
import type { PortableTextBlock, ArbitraryTypedObject } from '@portabletext/types';
import type { SomePortableTextComponents } from 'astro-portabletext/types';

import BlockH2 from './portable-text/BlockH2.astro';
import BlockH3 from './portable-text/BlockH3.astro';
import BlockH4 from './portable-text/BlockH4.astro';
import BlockNormal from './portable-text/BlockNormal.astro';
import BlockQuote from './portable-text/BlockQuote.astro';
import MarkLink from './portable-text/MarkLink.astro';
import MarkCode from './portable-text/MarkCode.astro';
import TypeImage from './portable-text/TypeImage.astro';
import TypeCode from './portable-text/TypeCode.astro';
import TypeCallout from './portable-text/TypeCallout.astro';
import TypeYouTube from './portable-text/TypeYouTube.astro';

interface Props {
  value: (PortableTextBlock | ArbitraryTypedObject)[];
  class?: string;
}

const { value, class: className } = Astro.props;

const components: SomePortableTextComponents = {
  block: { h2: BlockH2, h3: BlockH3, h4: BlockH4, normal: BlockNormal, blockquote: BlockQuote },
  mark: { link: MarkLink, code: MarkCode },
  type: { image: TypeImage, code: TypeCode, callout: TypeCallout, youtube: TypeYouTube },
};
---

<div class:list={['pt', className]}>
  <PortableText value={value} components={components} />
</div>

<style>
  .pt { font-size: clamp(17px, 1.6vw, 18px); line-height: 1.7; color: rgb(var(--text)); max-width: 65ch; }
  .pt > :global(* + *) { margin-top: 1.1em; }
  .pt :global(.pt-p) { margin-bottom: 0; }
  .pt :global(strong) { font-weight: 700; }

  .pt :global(.pt-h) { color: rgb(var(--text)); font-weight: 800; letter-spacing: -0.03em; scroll-margin-top: var(--scroll-offset); }
  .pt :global(.pt-h2) { font-size: clamp(24px, 2.6vw, 28px); line-height: 1.1; margin-top: 2em; }
  .pt :global(.pt-h3) { font-size: 21px; line-height: 1.2; margin-top: 1.7em; }
  .pt :global(.pt-h4) { font-size: 18px; line-height: 1.3; margin-top: 1.5em; letter-spacing: -0.01em; }
  .pt :global(.pt-anchor) { color: inherit; text-decoration: none; }
  .pt :global(.pt-anchor:hover) { color: rgb(var(--accent-text)); }

  .pt :global(ul), .pt :global(ol) { padding-left: 1.3em; margin-bottom: 0; }
  .pt :global(li + li) { margin-top: 0.4em; }
  .pt :global(li::marker) { color: rgb(var(--text-faint)); }

  .pt :global(.pt-quote) { margin: 1.6em 0 0; font-size: 1.08em; line-height: 1.55; color: rgb(var(--text-muted)); }
  .pt :global(.pt-aside) { margin: 1.6em 0 0; font-size: 15px; line-height: 1.55; color: rgb(var(--text-muted)); }
  .pt :global(.pt-aside p) { margin: 0; }
  .pt :global(.pt-aside strong) { color: rgb(var(--text)); }

  .pt :global(.pt-figure) { margin: 1.8em 0 0; display: flex; flex-direction: column; gap: 10px; }
  .pt :global(.pt-figure__img) { width: 100%; height: auto; border-radius: var(--radius-card); }
  .pt :global(.pt-caption) { font-size: 12.5px; line-height: 1.45; color: rgb(var(--text-faint)); }
  .pt :global(.pt-video) { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-card); overflow: hidden; background: rgb(var(--surface)); }
  .pt :global(.pt-video iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .pt :global(.pt-code-inline) {
    font-family: var(--font-mono); font-size: 0.86em; padding: 0.12em 0.36em;
    background: rgb(var(--surface)); border: 1px solid rgb(var(--hairline)); border-radius: 4px;
  }
  .pt :global(.pt-code) { margin: 1.6em 0 0; border: 1px solid rgb(var(--hairline)); border-radius: var(--radius-card); background: rgb(var(--surface)); overflow: hidden; }
  .pt :global(.pt-code__bar) { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 4px 6px 4px 14px; border-bottom: 1px solid rgb(var(--hairline)); }
  .pt :global(.pt-code__name) { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(var(--text-faint)); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pt :global(.pt-code__copy) {
    min-height: 36px; padding: 6px 12px; border: 0; border-radius: var(--radius-btn); background: transparent;
    color: rgb(var(--text-muted)); font: 700 13px/1 var(--font); cursor: pointer;
  }
  .pt :global(.pt-code__copy:hover) { color: rgb(var(--accent-text)); }
  .pt :global(.pt-code pre) { margin: 0; padding: 16px; overflow-x: auto; font-size: 14px; line-height: 1.6; }
  .pt :global(.pt-code code) { font-family: var(--font-mono); color: rgb(var(--text)); }
</style>
