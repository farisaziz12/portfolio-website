---
/**
 * One timeline for written, podcasts and video: Format + Topic pills over
 * year groups (huge faded year on the left), each row a 56px format tile,
 * month, title, source, topic and the action. Filters sync to the URL
 * (?format=podcast&topic=community) and everything shows without JS.
 */
import { TOPICS, TOPIC_SHORT, type PublicationFormat } from 'shared';
import FilterPills from '../v3/FilterPills.astro';
import Icon from '../v3/Icon.astro';
import { monthShort, yearOf, writingAction, type WritingItem } from '../../lib/sanity/v3';

interface Props {
  items: WritingItem[];
}

const { items } = Astro.props;

const FORMAT_LABEL: Record<PublicationFormat, string> = { article: 'Written', podcast: 'Podcasts', video: 'Video' };
const formats = (Object.keys(FORMAT_LABEL) as PublicationFormat[])
  .map((f) => ({ value: f, label: FORMAT_LABEL[f], count: items.filter((i) => i.format === f).length }))
  .filter((f) => f.count > 0);
const topics = TOPICS.filter((t) => items.some((i) => i.topic === t.value)).map((t) => ({ value: t.value, label: TOPIC_SHORT[t.value] }));

const years = [...new Set(items.map((i) => yearOf(i.date)))].sort((a, b) => b - a);
const groups = years.map((year) => ({ year, items: items.filter((i) => yearOf(i.date) === year) }));
const ext = (i: WritingItem) => (i.isInternal ? {} : { target: '_blank', rel: 'noopener noreferrer' });
---

<div class="wt" data-filter-root>
  <div class="wt__filters">
    {formats.length > 1 && <FilterPills name="format" label="Format" options={formats} allCount={items.length} />}
    {topics.length > 1 && <FilterPills name="topic" label="Topic" options={topics} />}
  </div>

  {groups.map((g) => (
    <section class="wt__year" data-filter-group aria-labelledby={`y-${g.year}`}>
      <h2 class="wt__yearlabel" id={`y-${g.year}`}>{g.year}</h2>
      <ul class="wt__list">
        {g.items.map((i) => (
          <li data-filter-item data-format={i.format} data-topic={i.topic ?? ''}>
            <a href={i.href} class="wt__row" data-track={i.isInternal ? 'writing-read' : `writing-${i.format}`} {...ext(i)}>
              <span class:list={['ds-tile', `ds-tile--${i.format === 'article' ? 'written' : i.format}`, 'wt__tile']} aria-hidden="true">
                {i.format === 'article' ? 'Aa' : <Icon name={i.format === 'podcast' ? 'listen' : 'play'} size={20} />}
              </span>
              <span class="wt__month">{monthShort(i.date)}</span>
              <span class="wt__main">
                <span class="wt__title">{i.title}</span>
                <span class="wt__source"><span class="wt__m-inline">{monthShort(i.date)} · </span>{[i.source, i.sourceNote].filter(Boolean).join(' · ')}</span>
              </span>
              <span class="wt__topic">{i.topic ? TOPIC_SHORT[i.topic] : ''}</span>
              <span class:list={['wt__action', { 'wt__action--play': i.format !== 'article' }]}>
                {i.format !== 'article' && <Icon name="play" size={10} />}
                {writingAction(i)}
              </span>
              {!i.isInternal && <span class="sr-only"> (opens in a new tab)</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="wt__empty" data-filter-empty hidden>
    Nothing in that combination yet. <button type="button" class="wt__reset" data-filter-reset>Show everything</button>
  </p>
</div>

<style>
  .wt__filters {
    display: flex; justify-content: space-between; align-items: center; gap: 16px 24px; flex-wrap: wrap;
    border-top: 1px solid rgb(var(--hairline)); padding: 28px 0 20px;
  }
  .wt__year { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 24px; border-top: 1px solid rgb(var(--hairline)); padding-top: 18px; margin-top: 10px; }
  .wt__yearlabel { font-size: 34px; font-weight: 800; letter-spacing: -0.05em; line-height: 1; color: rgb(var(--hairline-strong)); font-variant-numeric: tabular-nums; }
  .wt__list { list-style: none; margin: 0; padding: 0; }
  .wt__list > li { border-bottom: 1px solid rgb(var(--hairline) / 0.7); }
  .wt__row {
    display: grid; grid-template-columns: 56px 70px minmax(0, 1fr) 130px 120px; grid-template-areas: 'tile month main topic action';
    gap: 18px; align-items: center; padding: 14px 0; color: rgb(var(--text)); text-decoration: none;
  }
  .wt__tile { grid-area: tile; box-sizing: border-box; }
  /* The cream tile disappears on the cream light-theme ground without an edge. */
  .wt__tile.ds-tile--written { border: 1px solid rgb(var(--hairline-strong)); }
  .wt__month { grid-area: month; font-size: 13px; color: rgb(var(--text-faint)); }
  .wt__main { grid-area: main; min-width: 0; }
  .wt__title { display: block; font-weight: 800; font-size: 17px; line-height: 1.25; text-wrap: pretty; transition: color 0.15s; }
  .wt__row:hover .wt__title { color: rgb(var(--accent-text)); }
  .wt__source { display: block; font-size: 13px; color: rgb(var(--text-faint)); margin-top: 3px; }
  .wt__m-inline { display: none; }
  .wt__topic { grid-area: topic; font-size: 12.5px; font-weight: 700; color: rgb(var(--text-muted)); }
  .wt__action {
    grid-area: action; justify-self: end; display: inline-flex; align-items: center; gap: 6px;
    font-size: 13px; font-weight: 800; border-radius: var(--radius-btn); padding: 8px 12px; white-space: nowrap;
    border: 2px solid rgb(var(--text)); color: rgb(var(--text)); transition: background-color 0.15s, color 0.15s;
  }
  .wt__action--play { border-color: rgb(var(--yellow)); color: rgb(var(--accent-text)); }
  .wt__row:hover .wt__action { background: rgb(var(--text)); color: rgb(var(--ground)); }
  .wt__row:hover .wt__action--play { background: rgb(var(--yellow)); color: rgb(var(--on-yellow)); }
  .wt__empty { padding: 32px 0; margin: 0; font-size: 15px; color: rgb(var(--text-faint)); border-top: 1px solid rgb(var(--hairline)); }
  .wt__reset { min-height: 44px; background: none; border: 0; padding: 0 4px; color: rgb(var(--accent-text)); font: 700 15px var(--font); cursor: pointer; }
  .wt__reset:hover { text-decoration: underline; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 960px) {
    .wt__year { grid-template-columns: 80px minmax(0, 1fr); gap: 16px; }
    .wt__yearlabel { font-size: 28px; }
    .wt__row { grid-template-columns: 56px 44px minmax(0, 1fr) 110px; grid-template-areas: 'tile month main action'; }
    .wt__topic { display: none; }
  }
  @media (max-width: 720px) {
    .wt__filters { flex-direction: column; align-items: flex-start; }
    .wt__year { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .wt__yearlabel { font-size: 40px; }
    .wt__row {
      grid-template-columns: 56px minmax(0, 1fr); grid-template-areas: 'tile main' 'tile action';
      gap: 8px 14px; align-items: start; padding: 16px 0;
    }
    .wt__month { display: none; }
    .wt__m-inline { display: inline; }
    .wt__action { justify-self: start; padding: 6px 10px; font-size: 12.5px; }
  }
</style>
