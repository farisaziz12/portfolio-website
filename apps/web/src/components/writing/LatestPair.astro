---
/**
 * The two equal cards at the top of Writing: the latest thing to read
 * (photo backdrop, band edge) and the latest thing to listen to (yellow).
 */
import { TOPIC_SHORT } from 'shared';
import SanityImg from '../v3/SanityImg.astro';
import Icon from '../v3/Icon.astro';
import { monthYear, writingAction, type WritingItem } from '../../lib/sanity/v3';

interface Props {
  read?: WritingItem;
  listen?: WritingItem;
}

const { read, listen } = Astro.props;
const ext = (i: WritingItem) => (i.isInternal ? {} : { target: '_blank', rel: 'noopener noreferrer' });
const kicker = (lead: string, i: WritingItem, middle?: string) => [lead, middle, monthYear(i.date)].filter(Boolean).join(' · ');
---

{(read || listen) && (
  <div class:list={['lp', { 'lp--one': !(read && listen) }]}>
    {read && (
      <a href={read.href} class:list={['lp__card lp__read', { 'lp__read--photo': read.image?.asset }]} data-track="writing-latest-read" {...ext(read)}>
        {read.image?.asset && <SanityImg image={read.image} alt="" ratio={16 / 9} widths={[600, 900, 1200]} sizes="(max-width: 720px) 100vw, 50vw" class="lp__img" loading="eager" />}
        <span class="lp__shade" aria-hidden="true"></span>
        <span class="lp__edge" aria-hidden="true"></span>
        <span class="lp__body">
          <span class="lp__kicker">{kicker('Latest to read', read, read.topic ? TOPIC_SHORT[read.topic] : undefined)}</span>
          <span class="lp__title">{read.title}</span>
          <span class="lp__foot">
            {read.excerpt && <span class="lp__excerpt">{read.excerpt}</span>}
            <span class="lp__btn lp__btn--cream">{writingAction(read)}</span>
          </span>
        </span>
        {!read.isInternal && <span class="sr-only"> (opens in a new tab)</span>}
      </a>
    )}
    {listen && (
      <a href={listen.href} class="lp__card lp__listen" data-track="writing-latest-listen" {...ext(listen)}>
        <span class="lp__ring" aria-hidden="true"></span>
        <span class="lp__kicker lp__kicker--ink">{kicker('Latest to listen', listen, listen.source)}</span>
        <span class="lp__body lp__body--flow">
          <span class="lp__title lp__title--narrow">{listen.title}</span>
          <span class="lp__foot">
            {listen.excerpt && <span class="lp__excerpt lp__excerpt--ink">{listen.excerpt}</span>}
            <span class="lp__btn lp__btn--ink"><Icon name="play" size={11} /> {writingAction(listen)}</span>
          </span>
        </span>
        {!listen.isInternal && <span class="sr-only"> (opens in a new tab)</span>}
      </a>
    )}
  </div>
)}

<style>
  .lp { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .lp--one { grid-template-columns: minmax(0, 1fr); max-width: 50%; }
  .lp__card {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end; aspect-ratio: 16 / 9; box-sizing: border-box;
    border-radius: var(--radius-card); overflow: hidden; text-decoration: none; border: 1px solid transparent; transition: border-color 0.15s;
  }
  .lp__read { background: rgb(var(--surface)); color: rgb(var(--c-cream)); border-color: rgb(var(--hairline)); padding: 24px 28px 24px 36px; }
  .lp__read:hover { border-color: rgb(var(--yellow)); }
  .lp__read :global(.lp__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lp__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(var(--c-ink) / 0.1) 20%, rgb(var(--c-ink) / 0.95)); }
  .lp__read:not(.lp__read--photo) { color: rgb(var(--text)); }
  .lp__read:not(.lp__read--photo) .lp__shade { display: none; }
  .lp__edge { position: absolute; left: 0; top: 0; bottom: 0; width: 8px; background: var(--band-v); }
  .lp__body { position: relative; display: flex; flex-direction: column; gap: 8px; }
  .lp__body--flow { gap: 14px; }
  .lp__kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--c-yellow)); line-height: 1.3; }
  .lp__read:not(.lp__read--photo) .lp__kicker { color: rgb(var(--accent-text)); }
  .lp__kicker--ink { position: relative; color: rgb(var(--c-ink)); }
  .lp__title { font-size: clamp(24px, 2.6vw, 30px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.02; text-wrap: balance; }
  .lp__title--narrow { max-width: 18ch; }
  .lp__foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .lp__excerpt { font-size: 14.5px; line-height: 1.4; color: rgb(var(--c-muted)); text-wrap: pretty; }
  .lp__read:not(.lp__read--photo) .lp__excerpt { color: rgb(var(--text-muted)); }
  .lp__excerpt--ink { color: rgb(var(--c-ink)); }
  .lp__btn { flex: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 800; font-size: 13px; padding: 8px 12px; border-radius: var(--radius-btn); white-space: nowrap; transition: background-color 0.15s, color 0.15s; }
  .lp__btn--cream { background: rgb(var(--c-cream)); color: rgb(var(--c-ink)); }
  .lp__read:hover .lp__btn--cream { background: rgb(var(--yellow)); color: rgb(var(--on-yellow)); }
  .lp__listen { justify-content: space-between; background: rgb(var(--yellow)); color: rgb(var(--c-ink)); padding: 24px 28px; }
  .lp__listen:hover { border-color: rgb(var(--c-ink)); }
  .lp__ring { position: absolute; right: -60px; top: -60px; width: 260px; height: 260px; border-radius: 50%; border: 26px solid rgb(var(--c-ink)); opacity: 0.08; box-sizing: border-box; }
  .lp__btn--ink { background: rgb(var(--c-ink)); color: rgb(var(--c-cream)); }
  .lp__listen:hover .lp__btn--ink { background: rgb(var(--c-cream)); color: rgb(var(--c-ink)); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 900px) {
    .lp__card { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 720px) {
    .lp, .lp--one { grid-template-columns: minmax(0, 1fr); max-width: none; }
    .lp__card { aspect-ratio: auto; min-height: 280px; }
    .lp__read { padding: 20px 20px 20px 28px; }
    .lp__listen { padding: 20px; gap: 28px; }
    .lp__foot { flex-direction: column; align-items: flex-start; gap: 12px; }
    .lp__btn { min-height: 40px; }
  }
</style>
