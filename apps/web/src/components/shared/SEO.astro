---
import { communityOrganization, personContactPoints } from '../../lib/seo';

interface SocialLinks {
  twitterUrl?: string;
  linkedin?: string;
  bluesky?: string;
  github?: string;
  youtube?: string;
  mentorcruise?: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Alt text for the social card image. */
  imageAlt?: string;
  article?: boolean;
  /** Marks this page as the entity home (renders ProfilePage instead of WebPage). */
  profilePage?: boolean;
  pathname?: string;
  publishedTime?: string;
  siteName?: string;
  siteUrl?: string;
  twitterHandle?: string;
  personName?: string;
  jobTitle?: string;
  personImage?: string;
  /** "Geneva, Switzerland" (speaker profile → Based in). */
  basedIn?: { city: string; country?: string };
  /** Profile URLs for sameAs (speaker profile → Links). */
  socialLinks?: SocialLinks;
  /** The community the person co-founded, for affiliation. */
  community?: { name: string; url?: string; city?: string };
  /** Optional extra schema.org nodes appended to the @graph (Event, Service, BreadcrumbList…). */
  extraSchema?: Record<string, unknown>[];
  /** Optional markdown mirror of this page, exposed for AI agents. */
  markdownAlternate?: string;
  /** Person description (the reviewed short bio). */
  personDescription?: string;
  /** Confirmed awards only; unconfirmed wording never ships. */
  awards?: string[];
  noindex?: boolean;
}

const {
  title,
  description = 'Staff Software Engineer, Conference Speaker & Workshop Instructor specializing in React, Next.js, and payments.',
  image = '/og/default.png',
  imageAlt,
  article = false,
  profilePage = false,
  pathname = '',
  publishedTime,
  siteName = 'Faris Aziz',
  siteUrl: propSiteUrl,
  twitterHandle = 'farisaziz12',
  personName = 'Faris Aziz',
  jobTitle = 'Staff Software Engineer',
  personImage,
  basedIn = { city: 'Geneva', country: 'Switzerland' },
  socialLinks = {},
  community = { name: 'ZurichJS', url: 'https://zurichjs.com', city: 'Zurich' },
  extraSchema = [],
  markdownAlternate,
  personDescription,
  awards = [],
  noindex = false,
} = Astro.props;

const siteUrl = propSiteUrl || import.meta.env.SITE || 'https://faziz-dev.com';
const canonicalUrl = new URL(pathname, siteUrl).href;
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const ogImageAlt = imageAlt || `${fullTitle} (social card)`;

// Entity graph. Stable @id anchors so every page reinforces the same Person
// entity — this is what lets search engines and AI answer engines resolve
// "Faris Aziz" to this site (the entity home) and cite it.
const PERSON_ID = `${siteUrl}/#person`;
const WEBSITE_ID = `${siteUrl}/#website`;

const sameAs = [
  socialLinks.bluesky,
  socialLinks.linkedin,
  socialLinks.github,
  socialLinks.twitterUrl,
  socialLinks.youtube,
  socialLinks.mentorcruise,
  community.url,
].filter((u): u is string => Boolean(u));

const person: Record<string, unknown> = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: personName,
  url: siteUrl,
  jobTitle,
  address: { '@type': 'PostalAddress', addressLocality: basedIn.city, ...(basedIn.country ? { addressCountry: basedIn.country } : {}) },
  description:
    personDescription ||
    `Software engineer and conference speaker based in ${basedIn.city}. Works on frontend and payment systems at scale, co-founded ${community.name}, and chairs ${community.name} Conf.`,
  ...(awards.length ? { award: awards.length === 1 ? awards[0] : awards } : {}),
  contactPoint: personContactPoints(siteUrl),
  affiliation: communityOrganization(community, personName),
  knowsAbout: [
    'React',
    'Next.js',
    'Frontend architecture',
    'Payment systems',
    'Fintech',
    'Web performance',
    'Developer experience',
    'Engineering leadership',
    'Public speaking',
    'Community building',
  ],
  sameAs,
};
if (personImage) person.image = { '@type': 'ImageObject', url: personImage };

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  url: siteUrl,
  name: siteName,
  publisher: { '@id': PERSON_ID },
};

const pageNode: Record<string, unknown> = {
  '@type': profilePage ? 'ProfilePage' : article ? 'Article' : 'WebPage',
  '@id': `${canonicalUrl}#page`,
  url: canonicalUrl,
  name: fullTitle,
  headline: title,
  description,
  image: imageUrl,
  isPartOf: { '@id': WEBSITE_ID },
  ...(profilePage ? { mainEntity: { '@id': PERSON_ID } } : { about: { '@id': PERSON_ID } }),
  ...(article
    ? {
        author: { '@id': PERSON_ID },
        ...(publishedTime ? { datePublished: publishedTime } : {}),
      }
    : {}),
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [person, website, pageNode, ...extraSchema],
};
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{markdownAlternate && (
  <link rel="alternate" type="text/markdown" href={new URL(markdownAlternate, siteUrl).href} title={`${title} (Markdown)`} />
)}

<!-- Open Graph / Facebook / LinkedIn / Bluesky -->
<meta property="og:type" content={profilePage ? 'profile' : article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{article && <meta property="article:author" content={new URL('/about', siteUrl).href} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={`@${twitterHandle}`} />
<meta name="twitter:creator" content={`@${twitterHandle}`} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- JSON-LD entity graph -->
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
