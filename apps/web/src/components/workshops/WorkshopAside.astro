---
/**
 * Workshop page right column: "Book this workshop" (length, group, room,
 * after + Request a date), the attendee-resources note, and the talk version.
 */
import type { WorkshopWithHistory } from '../../lib/sanity/v3';
import { groupLine, lengthLine, workshopInviteHref } from '../../lib/workshops-view';

interface Props {
  workshop: WorkshopWithHistory;
}
const { workshop: w } = Astro.props;
const rows = [
  { k: 'Length', v: lengthLine(w) },
  { k: 'Group', v: groupLine(w) },
  { k: 'Room', v: w.room },
  { k: 'After', v: w.after },
].filter((r) => r.v);
const talk = w.relatedTalk;
---

<aside class="wsa" aria-label="Booking">
  <div class="ds-card wsa__box">
    <h2 class="wsa__kicker">Book this workshop</h2>
    {rows.length > 0 && (
      <dl class="ds-dl wsa__dl">
        {rows.map((r) => (
          <>
            <dt>{r.k}</dt>
            <dd>{r.v}</dd>
          </>
        ))}
      </dl>
    )}
    <a href={workshopInviteHref(w)} class="ds-btn ds-btn--yellow ds-btn--block" data-track="workshop_request_date">Request a date</a>
  </div>

  <div class="ds-card ds-card--dashed wsa__att">
    <h2 class="wsa__kicker is-muted">Attendees</h2>
    <p class="wsa__att-title">Resources for your edition</p>
    <p class="wsa__att-body">
      Use the link from your session. Access is per delivery and separate from anything else on this site; nobody is added to a mailing list by attending.
    </p>
  </div>

  {talk && (
    <a href={`/talks/${talk.slug}`} class="ds-card wsa__talk" data-track="workshop_related_talk">
      <span class="wsa__kicker">{talk.duration ? `The ${talk.duration}-minute version` : 'The talk version'}</span>
      <span class="wsa__talk-title">{talk.title.split(':')[0]}</span>
    </a>
  )}
</aside>

<style>
  .wsa { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .wsa__box { display: flex; flex-direction: column; gap: 12px; padding: 20px; }
  .wsa__kicker { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--accent-text)); }
  .wsa__kicker.is-muted { color: rgb(var(--text-faint)); }
  .wsa__dl { font-size: 14px; line-height: 1.5; gap: 8px 14px; }
  .wsa__att { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; background: rgb(var(--surface)); }
  .wsa__att-title { margin: 0; font-weight: 700; font-size: 15px; }
  .wsa__att-body { margin: 0; font-size: 13.5px; line-height: 1.5; color: rgb(var(--text-muted)); }
  .wsa__talk { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; }
  .wsa__talk-title { font-weight: 800; font-size: 16px; line-height: 1.25; }
</style>
