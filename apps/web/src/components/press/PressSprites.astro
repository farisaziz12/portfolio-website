---
/**
 * The cartoon sprites: each on the cream panel it was drawn for, with a
 * download of the original PNG.
 */
import { Image } from 'astro:assets';
import { SPRITES } from '../../lib/sprites';
---

<section class="ds-card spr" aria-labelledby="sprites-h" id="sprites">
  <div class="spr__head">
    <h2 id="sprites-h" class="spr__label">Sprites · {SPRITES.length}</h2>
    <p class="spr__note">Use them as they are: no flipping, recolouring or extra logos.</p>
  </div>
  <ul class="spr__grid" role="list">
    {SPRITES.map((s) => (
      <li class="spr__item">
        <div class="ds-panel spr__art">
          <Image src={s.image} alt={s.alt} width={200} widths={[200, 400]} sizes="(max-width: 520px) 40vw, 200px" format="webp" quality={82} loading="lazy" class="spr__img" />
        </div>
        <a class="ds-btn ds-btn--outline ds-btn--sm ds-btn--block spr__dl" href={s.image.src} download={s.file} data-track="press_sprite_download" data-track-label={s.key}>
          <span>{s.label}</span>
          <span class="spr__meta">PNG · {s.image.width}×{s.image.height}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .spr { padding: 20px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .spr__head { display: flex; flex-direction: column; gap: 4px; }
  .spr__label { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--accent-text)); }
  .spr__note { margin: 0; font-size: 13.5px; line-height: 1.5; color: rgb(var(--text-muted)); }
  .spr__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(150px, 40%), 1fr)); gap: 12px; }
  .spr__item { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .spr__art { display: grid; place-items: center; aspect-ratio: 1; padding: 12px; }
  .spr__art :global(.spr__img) { width: 100%; height: 100%; object-fit: contain; }
  .spr__dl { justify-content: space-between; flex-wrap: wrap; gap: 2px 8px; height: auto; }
  .spr__meta { font-weight: 500; font-size: 12px; color: rgb(var(--text-faint)); }
</style>
