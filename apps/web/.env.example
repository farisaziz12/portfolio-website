# ─────────────────────────────────────────────────────────────
# Sanity Configuration
# Get these from https://sanity.io/manage
# ─────────────────────────────────────────────────────────────
# Required. Falls back to a hardcoded "94fb4yui" if unset — set this explicitly
# in your own env so you're not silently reading from someone else's project.
SANITY_STUDIO_PROJECT_ID=your_project_id
SANITY_STUDIO_DATASET=production

# Optional. Only needed for draft content, private datasets, or authenticated writes.
# Generate at https://sanity.io/manage → API → Tokens (Viewer role is enough for reads).
# SANITY_API_TOKEN=sk_xxx

# ─────────────────────────────────────────────────────────────
# Resend — transactional email
# ─────────────────────────────────────────────────────────────
# Required for the /invite, /mentorship and workshop-subscribe endpoints to send mail.
RESEND_API_KEY=re_your_api_key_here

# Required. Verified Resend sender — must be on a domain you've added to Resend.
# Used as the From: address on every outbound email.
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Optional. If set, every workshop subscriber is also added to this Resend audience
# (in addition to any per-instance audience configured in Sanity).
RESEND_AUDIENCE_ID=your_audience_id_here

# Optional inbox overrides. Defaults to faris@zurichjs.com when unset.
# Set these per-environment (preview/staging) to keep test submissions out of your inbox.
# INVITE_INBOX=you@yourdomain.com
# MENTORSHIP_INBOX=mentorship@yourdomain.com

# ─────────────────────────────────────────────────────────────
# Admin panel (/admin)
# ─────────────────────────────────────────────────────────────
# Required for the workshop instance dashboard at /admin.
ADMIN_PASSWORD=your-secure-password-here
