# ─────────────────────────────────────────────────────────────
# Root .env.example — convenience copy for the monorepo.
# The web app reads env from apps/web/.env.local and the Studio reads from
# apps/studio/.env (or .env.local). This file documents both side-by-side.
# ─────────────────────────────────────────────────────────────

# ── Sanity ────────────────────────────────────────────────────
# Used by both apps/web (read-only client) and apps/studio (Studio config).
SANITY_STUDIO_PROJECT_ID=your_project_id
SANITY_STUDIO_DATASET=production

# Optional. Only needed for draft content, private datasets, or authenticated writes.
# SANITY_API_TOKEN=sk_xxx

# ── Resend — apps/web only ────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_AUDIENCE_ID=your_audience_id_here

# Optional inbox overrides. Default: faris@zurichjs.com
# INVITE_INBOX=you@yourdomain.com
# MENTORSHIP_INBOX=mentorship@yourdomain.com

# ── Admin panel — apps/web only ───────────────────────────────
ADMIN_PASSWORD=your-secure-password-here
