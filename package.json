{
  "name": "faziz-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel -r dev",
    "build": "pnpm run -r build",
    "lint": "eslint . && pnpm --filter web lint:ui && pnpm --filter web lint:conventions",
    "typecheck": "pnpm run -r typecheck",
    "studio": "pnpm --filter studio dev",
    "web": "pnpm --filter web dev",
    "migrate": "node --env-file=.env --import tsx scripts/migrate-content.ts",
    "remove-duplicates": "tsx --env-file=.env scripts/remove-duplicates.ts",
    "enrich-podcasts": "tsx --env-file=.env scripts/enrich-podcasts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@sanity/client": "^6.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "6.5.2"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.4"
}
