{
  "name": "faziz-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel -r dev",
    "build": "pnpm run -r build",
    "lint": "eslint . && pnpm --filter web lint:ui && pnpm --filter web lint:conventions && pnpm --filter web lint:voice",
    "typecheck": "pnpm run -r typecheck",
    "studio": "pnpm --filter studio dev",
    "web": "pnpm --filter web dev",
    "migrate": "node --env-file=.env --import tsx scripts/migrate-content.ts",
    "remove-duplicates": "tsx --env-file=.env scripts/remove-duplicates.ts",
    "migrate:v3": "tsx scripts/migrate-v3/run.ts",
    "test:migrate": "tsx --test scripts/migrate-v3/transform.test.ts",
    "test": "pnpm --filter web test && pnpm test:migrate",
    "voice:cms": "pnpm --filter web voice:cms",
    "knip": "knip"
  },
  "dependencies": {
    "@sanity/client": "^6.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "6.5.2",
      "path-to-regexp@<6.3.0": "^6.3.0",
      "prismjs@<1.30.0": "^1.30.0",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "uuid@<11.1.1": "^11.1.1",
      "adm-zip@<0.6.1": "^0.6.1",
      "postcss-selector-parser@<7.1.6": "^7.1.6"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.4"
}
